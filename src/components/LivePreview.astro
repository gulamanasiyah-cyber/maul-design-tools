---
interface Props {
  slug?: string;
  large?: boolean;
}
const { slug, large = false } = Astro.props;

const previews = import.meta.glob('./previews/*.astro', { eager: true });
const mod = slug ? previews[`./previews/${slug}.astro`] : undefined;
const Preview = mod?.default;
---

{
  Preview ? (
    <div class:list={['live-preview', { large }]}>
      <Preview />
    </div>
  ) : (
    <div class="live-preview missing">
      <p>No preview component yet.</p>
      <code>src/components/previews/{slug || '<preview-slug>'}.astro</code>
    </div>
  )
}

<style>
  .live-preview {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    background: #101214;
    border-radius: inherit;
  }
  .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--muted);
    font-size: 13px;
    padding: 24px;
    min-height: 220px;
    border: 1px dashed var(--line);
    border-radius: 12px;
  }
  .missing code {
    font-size: 12px;
    color: #cfd3d7;
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 6px;
  }
</style>
