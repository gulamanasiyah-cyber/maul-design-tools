---
import type { CollectionEntry } from 'astro:content';
import LivePreview from './LivePreview.astro';

interface Props {
  ref: CollectionEntry<'references'>;
}
const { ref } = Astro.props;
const d = ref.data;
---

<div class="card">
  <a class="stretch" href={`/ref/${ref.id}/`} aria-label={d.name}></a>
  <div class="preview-holder">
    <LivePreview slug={d.preview} />
  </div>
  <div class="meta">
    <h3>{d.name}</h3>
    <p class="family">{d.family}</p>
    <div class="row">
      <span class="dots">
        {d.palette.slice(0, 6).map((hex) => (
          <span class="dot" style={`background:${hex}`} title={hex} />
        ))}
      </span>
      <span class="actions">
        {d.preview && (
          <a
            class="preview-btn"
            href={`/preview/${d.preview}/`}
            target="_blank"
            rel="noopener noreferrer"
            title="Open full-page preview"
          >Preview ↗</a>
        )}
        <span class="count">{d.prompts.length} prompt{d.prompts.length === 1 ? '' : 's'}</span>
      </span>
    </div>
    {d.tags.length > 0 && (
      <p class="tags">{d.tags.slice(0, 4).join(' · ')}</p>
    )}
  </div>
</div>

<style>
  .card {
    display: block;
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
    height: 100%;
  }
  .stretch {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: #3a4046;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
  }
  .preview-holder {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    pointer-events: none;
  }
  .preview-holder :global(.live-preview) {
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }
  .meta {
    padding: 16px 18px 18px;
  }
  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }
  .family {
    margin: 4px 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 10px;
    color: var(--accent);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 2;
  }
  .preview-btn {
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--muted);
    font: 600 11px/1 var(--ui-font);
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border-radius: 999px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .preview-btn:hover {
    color: var(--text);
    border-color: #3a4046;
  }
  .dots {
    display: inline-flex;
    gap: 5px;
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: inline-block;
  }
  .count {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tags {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 12px;
  }
</style>
