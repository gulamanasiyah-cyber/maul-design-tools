---
interface Props {
  label: string;
  text: string;
}
const { label, text } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const rows = Math.max(4, Math.min(12, Math.ceil(text.length / 88) + text.split('\n').length));
---

<figure class="promptbox">
  <figcaption>
    <span class="plabel">{label}</span>
    <button class="copy-btn" data-copy={`pb-${uid}`}>Copy prompt</button>
  </figcaption>
  <textarea id={`pb-${uid}`} readonly rows={rows}>{text}</textarea>
</figure>

<style>
  .promptbox {
    margin: 0 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }
  .plabel {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    font-weight: 600;
  }
  textarea {
    display: block;
    width: 100%;
    border: 0;
    background: transparent;
    color: #cfd3d7;
    font: 400 13.5px/1.65 var(--ui-font);
    padding: 16px;
    resize: vertical;
    outline: none;
    white-space: pre-wrap;
  }
</style>
