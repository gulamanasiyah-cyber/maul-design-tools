---
// Scalter Retro Specimen — 100% Exact 1:1 Pixel-Perfect Recreation
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Bungee&family=Fraunces:ital,opsz,wght,SOFT@0,9..144,700..900,100;1,9..144,700..900,100&family=Pacifico&family=Plus+Jakarta+Sans:wght@700;800;900&family=Righteous&family=Rubik+Mono+One&family=Shrikhand&family=Space+Grotesk:wght@700;900&family=Syne:wght@800;900&family=Titan+One&family=Yellowtail&display=swap" rel="stylesheet">

<div class="scalter-page">

  <!-- ================================================================= -->
  <!-- 1. TOP ORANGE HEADER STRIP                                        -->
  <!-- ================================================================= -->
  <header class="sc-top-bar">
    <div class="sc-top-text">
      <b>SERIF</b> <i>+</i> <strong>SANS</strong> <i>+</i> <em>Script</em> <i>+</i> <b>SERIF</b> <i>+</i> <strong>SANS</strong> <i>+</i> <em>Script</em> <i>+</i> <b>SERIF</b> <i>+</i> <strong>SANS</strong> <i>+</i> <em>Script</em> <i>+</i> <b>SERIF</b> <i>+</i> <strong>SANS</strong> <i>+</i> <em>Script</em>
    </div>
  </header>

  <!-- ================================================================= -->
  <!-- 2. HERO BLUE GRID SECTION                                         -->
  <!-- ================================================================= -->
  <section class="sc-hero-section">
    <div class="sc-hero-content">

      <!-- Top Row: 42 Font Style / INTRODUCING / 4 Style 5 Widths -->
      <div class="sc-hero-top-row">
        <!-- 42 Font Style -->
        <div class="sc-pill-badge badge-left">
          <span class="sc-badge-42">42</span>
          <span class="sc-badge-lbl">
            <span>Font</span>
            <span>Style</span>
          </span>
        </div>

        <!-- INTRODUCING Arc -->
        <div class="sc-introducing-box">
          <svg viewBox="0 0 320 54" class="sc-svg-icon">
            <path id="sc-intro-path" d="M 10,48 Q 160,12 310,48" fill="none" />
            <!-- Shadow Layer -->
            <text font-family="'Titan One', 'Impact', sans-serif" font-size="29" font-weight="900" letter-spacing="3" fill="#E64400" stroke="#000000" stroke-width="7" paint-order="stroke fill" dy="3.5">
              <textPath href="#sc-intro-path" startOffset="50%" text-anchor="middle">INTRODUCING</textPath>
            </text>
            <!-- Face Layer -->
            <text font-family="'Titan One', 'Impact', sans-serif" font-size="29" font-weight="900" letter-spacing="3" fill="#FFDE00" stroke="#000000" stroke-width="3" paint-order="stroke fill">
              <textPath href="#sc-intro-path" startOffset="50%" text-anchor="middle">INTRODUCING</textPath>
            </text>
          </svg>
        </div>

        <!-- 4 Style 5 Widths -->
        <div class="sc-pill-badge badge-right">
          <span class="sc-badge-lbl-center">
            <span>4 Style</span>
            <span>5 Widhts</span>
          </span>
        </div>
      </div>

      <!-- MAIN 3D SCALTER TITLE -->
      <div class="sc-scalter-title-box">
        <h1 class="sc-3d-scalter-text">SCALTER</h1>
      </div>

      <!-- DIRTYLINE STUDIO ROW -->
      <div class="sc-dirtyline-row">
        <!-- Left Glove Hand Pointing Right -->
        <div class="sc-glove-icon glove-l">
          <svg viewBox="0 0 90 50" class="sc-svg-icon">
            <path d="M 8,16 C 4,26 8,36 14,40 C 22,42 26,38 26,18 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 26,16 C 35,12 55,10 70,16 C 84,20 88,24 88,28 C 88,32 80,35 65,34 L 50,34 C 54,40 50,45 42,46 C 34,47 28,42 24,36 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 52,20 L 86,24 C 88,25 88,29 84,30 L 52,30" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 34,22 L 32,32 M 42,24 L 40,34 M 50,26 L 48,34" stroke="#000000" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Center Badge -->
        <div class="sc-dirtyline-badge-wrap">
          <div class="sc-mfg-pill">MANUFACTURE BY :</div>
          <div class="sc-dirtyline-script-text">Dirtyline Studio</div>
        </div>

        <!-- Right Glove Hand Pointing Left -->
        <div class="sc-glove-icon glove-r">
          <svg viewBox="0 0 90 50" class="sc-svg-icon flip-x">
            <path d="M 8,16 C 4,26 8,36 14,40 C 22,42 26,38 26,18 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 26,16 C 35,12 55,10 70,16 C 84,20 88,24 88,28 C 88,32 80,35 65,34 L 50,34 C 54,40 50,45 42,46 C 34,47 28,42 24,36 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 52,20 L 86,24 C 88,25 88,29 84,30 L 52,30" fill="#FFFFFF" stroke="#000000" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M 34,22 L 32,32 M 42,24 L 40,34 M 50,26 L 48,34" stroke="#000000" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
      </div>

      <!-- Sneaker Kicking In & Smiley Face -->
      <div class="sc-sneaker-decor">
        <svg viewBox="0 0 110 140" class="sc-svg-icon">
          <polygon points="0,0 40,28 18,62 0,44" fill="#FFCC00" stroke="#000000" stroke-width="4" stroke-linejoin="round"/>
          <polygon points="18,62 40,28 54,40 32,74" fill="#FFFFFF" stroke="#000000" stroke-width="4" stroke-linejoin="round"/>
          <line x1="22" y1="54" x2="44" y2="34" stroke="#FF0033" stroke-width="4"/>
          <line x1="28" y1="62" x2="50" y2="42" stroke="#0066FF" stroke-width="4"/>
          <path d="M 32,74 C 40,62 58,58 72,72 C 88,86 102,102 110,120 C 114,132 100,138 80,138 C 54,138 36,128 24,108 C 14,92 18,78 32,74 Z" fill="#0035A8" stroke="#000000" stroke-width="4" stroke-linejoin="round"/>
          <path d="M 76,114 C 88,118 98,124 108,128 C 102,136 90,138 78,138 C 68,128 72,118 76,114 Z" fill="#FFCC00" stroke="#000000" stroke-width="3.5"/>
          <path d="M 42,70 Q 60,84 62,104" stroke="#33CC33" stroke-width="7.5" stroke-linecap="round"/>
          <line x1="40" y1="78" x2="54" y2="72" stroke="#FF0044" stroke-width="3.5" stroke-linecap="round"/>
          <line x1="48" y1="88" x2="64" y2="82" stroke="#FF0044" stroke-width="3.5" stroke-linecap="round"/>
          <path d="M 24,108 C 44,130 72,142 110,128 C 108,140 80,144 42,138 C 24,132 18,118 24,108 Z" fill="#FF0044" stroke="#000000" stroke-width="4" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="sc-smiley-decor">
        <svg viewBox="0 0 90 90" class="sc-svg-icon">
          <circle cx="45" cy="45" r="41" fill="#FFDE00" stroke="#000000" stroke-width="5"/>
          <ellipse cx="31" cy="34" rx="4.5" ry="8.5" fill="#000000"/>
          <ellipse cx="59" cy="34" rx="4.5" ry="8.5" fill="#000000"/>
          <path d="M 23,50 Q 45,76 67,50" fill="none" stroke="#000000" stroke-width="5" stroke-linecap="round"/>
          <path d="M 19,47 L 25,52 M 71,47 L 65,52" stroke="#000000" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Subtitle -->
      <div class="sc-hero-sub">
        CONSENdED - EXPANDED - SLANT
      </div>

    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 3. MARQUEE DIVIDER STRIP                                          -->
  <!-- ================================================================= -->
  <div class="sc-marquee-bar">
    <div class="sc-marquee-inner">
      <span>VARIABLE FONT * VARIABLE FONT * VARIABLE FONT * VARIABLE FONT * VARIABLE FONT * VARIABLE FONT * VARIABLE FONT * VARIABLE FONT *</span>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- 4. SECTION 2: STICKER BOMB (BLUE BG + ROUNDED ORANGE CARD)        -->
  <!-- ================================================================= -->
  <section class="sc-stickers-section">
    <div class="sc-stickers-card-wrap">
      <div class="sc-orange-badge-card">

        <!-- 1. UFO Weekend Warrior (Top-Left) -->
        <div class="sc-stk stk-ufo-pos">
          <svg viewBox="0 0 130 130" class="sc-svg-icon">
            <circle cx="65" cy="65" r="58" fill="#FFA500" stroke="#000000" stroke-width="5"/>
            <path id="sc-ufo-arc-t" d="M 22,65 A 43,43 0 0 1 108,65" fill="none"/>
            <text font-family="'Titan One', sans-serif" font-size="15" font-weight="900" fill="#000000" letter-spacing="2">
              <textPath href="#sc-ufo-arc-t" startOffset="50%" text-anchor="middle">WEEKEND</textPath>
            </text>
            <ellipse cx="65" cy="62" rx="30" ry="11" fill="#FF5500" stroke="#000000" stroke-width="3"/>
            <path d="M 44,60 Q 65,38 86,60 Z" fill="#2B3D99" stroke="#000000" stroke-width="3"/>
            <line x1="48" y1="68" x2="40" y2="84" stroke="#000000" stroke-width="3"/>
            <line x1="65" y1="72" x2="65" y2="88" stroke="#000000" stroke-width="3"/>
            <line x1="82" y1="68" x2="90" y2="84" stroke="#000000" stroke-width="3"/>
            <path id="sc-ufo-arc-b" d="M 22,65 A 43,43 0 0 0 108,65" fill="none"/>
            <text font-family="'Titan One', sans-serif" font-size="13" font-weight="900" fill="#000000" letter-spacing="2">
              <textPath href="#sc-ufo-arc-b" startOffset="50%" text-anchor="middle">WARRIOR</textPath>
            </text>
          </svg>
        </div>

        <!-- 2. Isolated Mind Starburst (Top-Center) -->
        <div class="sc-stk stk-iso-pos">
          <svg viewBox="0 0 170 170" class="sc-svg-icon starburst-svg-shape">
            <polygon points="85,5 101,37 133,15 131,51 166,41 148,74 170,90 143,106 160,135 127,130 127,163 99,143 85,170 71,143 43,163 43,130 10,135 27,106 0,90 22,74 4,41 39,51 37,15 69,37" fill="#000000" stroke="#000000" stroke-width="2"/>
          </svg>
          <div class="sc-iso-text-block">
            <span class="iso-w1">ISOLATED</span>
            <span class="iso-w2">MIND</span>
          </div>
        </div>

        <!-- 3. Hello Scalter (Top-Right) -->
        <div class="sc-stk stk-hello-pos">
          <div class="sc-hello-red-top">
            <span class="sc-hello-txt">HELLO</span>
            <span class="sc-nameis-txt">My Name Is</span>
          </div>
          <div class="sc-hello-white-bot">
            SCALTER
          </div>
        </div>

        <!-- 4. 20 20 (Mid-Left) -->
        <div class="sc-stk stk-2020-pos">
          <div class="sc-green-2020-badge">
            <span>20</span>
            <span>20</span>
          </div>
        </div>

        <!-- 5. Movie Club (Center) -->
        <div class="sc-stk stk-movie-pos">
          <div class="sc-black-movie-badge">
            <span class="m-txt-1">MOVIE</span>
            <span class="m-txt-2">CLUB</span>
          </div>
        </div>

        <!-- 6. Stay Home (Mid-Right) -->
        <div class="sc-stk stk-stay-pos">
          <div class="sc-stay-home-wrapper">
            <span class="sc-stay-word">Stay</span>
            <span class="sc-home-word">Home</span>
          </div>
        </div>

        <!-- 7. Mental Vacation (Bottom-Left) -->
        <div class="sc-stk stk-mental-pos">
          <svg viewBox="0 0 170 110" class="sc-svg-icon">
            <defs>
              <clipPath id="sc-mv-clip-lg">
                <rect width="170" height="110" rx="10" />
              </clipPath>
            </defs>
            <g clip-path="url(#sc-mv-clip-lg)">
              <rect width="170" height="110" fill="#FFA500"/>
              <polygon points="85,110 0,0 30,0" fill="#E62B1E"/>
              <polygon points="85,110 60,0 90,0" fill="#E62B1E"/>
              <polygon points="85,110 120,0 150,0" fill="#E62B1E"/>
              <polygon points="85,110 170,0 170,30" fill="#E62B1E"/>
              <polygon points="85,110 170,60 170,90" fill="#E62B1E"/>
              <polygon points="85,110 0,60 0,90" fill="#E62B1E"/>
              <polygon points="85,110 0,0 0,30" fill="#E62B1E"/>
            </g>
            <rect width="170" height="110" rx="10" fill="none" stroke="#FFFFFF" stroke-width="7"/>
            <rect width="170" height="110" rx="10" fill="none" stroke="#000000" stroke-width="3"/>
          </svg>
          <div class="sc-mental-text-block">
            <span class="l1">MENTAL</span>
            <span class="l2">VACATION</span>
            <span class="l3">2020</span>
          </div>
        </div>

        <!-- 8. Distance Stamp & Pointer Hand (Bottom-Right) -->
        <div class="sc-stk stk-distance-pos">
          <svg viewBox="0 0 190 95" class="sc-svg-icon">
            <ellipse cx="95" cy="47" rx="88" ry="40" fill="#1B2D92" stroke="#FFFFFF" stroke-width="5"/>
            <ellipse cx="95" cy="47" rx="80" ry="33" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-dasharray="4 2.5"/>
            <path id="sc-stamp-top-lg" d="M 26,47 A 69,25 0 0 1 164,47" fill="none"/>
            <text font-family="'Space Grotesk', sans-serif" font-size="9.5" font-weight="900" fill="#FFFFFF" letter-spacing="1.2">
              <textPath href="#sc-stamp-top-lg" startOffset="50%" text-anchor="middle">DISTANCES DISTANCES DISTANCES</textPath>
            </text>
            <text x="95" y="55" font-family="'Titan One', sans-serif" font-size="19" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="1.5">DISTANCE®</text>
            <path id="sc-stamp-bot-lg" d="M 26,47 A 69,25 0 0 0 164,47" fill="none"/>
            <text font-family="'Space Grotesk', sans-serif" font-size="9.5" font-weight="900" fill="#FFFFFF" letter-spacing="1.2">
              <textPath href="#sc-stamp-bot-lg" startOffset="50%" text-anchor="middle">DISTANCE DISTANCE DISTANCE</textPath>
            </text>
          </svg>
        </div>

        <!-- Pointer Glove Hand Pointing Left to Distance -->
        <div class="sc-stk stk-pointer-pos">
          <svg viewBox="0 0 85 50" class="sc-svg-icon">
            <path d="M 74,15 C 78,23 74,34 70,38 C 62,42 58,38 58,15 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3" stroke-linejoin="round"/>
            <path d="M 58,15 C 48,11 26,9 11,15 C 2,18 0,23 2,27 C 4,31 15,33 29,31 L 40,31 C 36,37 38,42 44,43 C 50,45 56,41 60,35 Z" fill="#FFFFFF" stroke="#000000" stroke-width="3" stroke-linejoin="round"/>
            <path d="M 40,17 L 9,21 C 4,22 4,26 9,27 L 40,27" fill="#FFFFFF" stroke="#000000" stroke-width="3" stroke-linejoin="round"/>
            <path d="M 44,19 L 46,29 M 36,21 L 38,31 M 28,23 L 30,31" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 5. SECTION 3: SPECIMEN ROWS (ORANGE GRID)                         -->
  <!-- ================================================================= -->
  <section class="sc-specimen-section">
    <div class="sc-specimen-container">

      <!-- Row 1: EMANUELA (Bold / Normal) -->
      <div class="sc-spec-row">
        <div class="sc-spec-meta">
          <span>Bold /</span>
          <span>Normal</span>
        </div>
        <div class="sc-spec-word">
          <div class="font-emanuela">EMANUELA</div>
        </div>
      </div>

      <!-- Row 2: AUTHENTICÖ (Black / Semi Condensed) -->
      <div class="sc-spec-row">
        <div class="sc-spec-meta">
          <span>Black /</span>
          <span>Semi</span>
          <span>Condensed</span>
        </div>
        <div class="sc-spec-word">
          <div class="font-authentico">AUTHENTICÖ</div>
        </div>
      </div>

      <!-- Row 3: QUEEN (Serif / Semi Expanded) -->
      <div class="sc-spec-row">
        <div class="sc-spec-meta">
          <span>Serif /</span>
          <span>Semi</span>
          <span>Expanded</span>
        </div>
        <div class="sc-spec-word">
          <div class="font-queen">QUEEN</div>
        </div>
      </div>

      <!-- Row 4: FIASOVÁ (Bold / Slant Expanded) -->
      <div class="sc-spec-row">
        <div class="sc-spec-meta">
          <span>Bold /</span>
          <span>Slant</span>
          <span>Expanded</span>
        </div>
        <div class="sc-spec-word">
          <div class="font-fiasova">FIASOVÁ</div>
        </div>
      </div>

    </div>
  </section>

</div>

<style is:global>
  /* Base reset */
  html, body {
    margin: 0 !important;
    padding: 0 !important;
    background: #FF5500 !important;
    width: 100% !important;
    overflow-x: hidden !important;
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .scalter-page {
    --c-blue: #1B2D92;
    --c-blue-grid: rgba(255, 255, 255, 0.14);
    --c-orange: #FF5500;
    --c-orange-card: #F15A24;
    --c-orange-grid: rgba(0, 0, 0, 0.08);
    --c-yellow: #FFDE00;
    --c-green: #39B54A;
    --c-black: #000000;
    --c-white: #FFFFFF;

    width: 100%;
    background: var(--c-blue);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    display: block;
    position: relative;
  }

  .scalter-page * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .sc-svg-icon {
    width: 100%;
    height: 100%;
    display: block;
  }

  .flip-x {
    transform: scaleX(-1);
  }

  /* 1. TOP STRIP */
  .sc-top-bar {
    width: 100%;
    background: var(--c-orange);
    border-bottom: 3.5px solid var(--c-black);
    padding: 10px 0;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
  }

  .sc-top-text {
    font-size: 15px;
    font-weight: 900;
    color: var(--c-black);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sc-top-text b {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'SOFT' 100;
    font-weight: 900;
  }

  .sc-top-text strong {
    font-family: 'Anton', 'Impact', sans-serif;
    letter-spacing: 1.5px;
  }

  .sc-top-text em {
    font-family: 'Yellowtail', 'Pacifico', cursive;
    font-style: normal;
    text-transform: none;
    font-size: 18px;
    margin: 0 2px;
  }

  .sc-top-text i {
    font-style: normal;
    font-size: 13px;
    margin: 0 4px;
  }

  /* 2. HERO BLUE GRID */
  .sc-hero-section {
    width: 100%;
    background-color: var(--c-blue);
    background-image: 
      linear-gradient(var(--c-blue-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-blue-grid) 1px, transparent 1px);
    background-size: 30px 30px;
    padding: 34px 20px 28px;
    border-bottom: 3.5px solid var(--c-black);
    position: relative;
    overflow: hidden;
  }

  .sc-hero-content {
    max-width: 860px;
    margin: 0 auto;
    position: relative;
  }

  .sc-hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 5;
  }

  .sc-pill-badge {
    border: 2.5px solid var(--c-yellow);
    border-radius: 999px;
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--c-yellow);
    background: rgba(27, 45, 146, 0.7);
  }

  .sc-badge-42 {
    font-family: 'Anton', sans-serif;
    font-size: 24px;
    line-height: 1;
    font-weight: 900;
  }

  .sc-badge-lbl {
    display: flex;
    flex-direction: column;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .sc-badge-lbl-center {
    display: flex;
    flex-direction: column;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .sc-introducing-box {
    width: 290px;
    height: 52px;
  }

  /* 3D SCALTER TITLE */
  .sc-scalter-title-box {
    text-align: center;
    margin: 10px 0 16px;
    position: relative;
    z-index: 4;
  }

  .sc-3d-scalter-text {
    font-family: 'Titan One', 'Fraunces', cursive, sans-serif;
    font-size: clamp(68px, 13vw, 138px);
    line-height: 0.9;
    letter-spacing: 3px;
    color: var(--c-yellow);
    -webkit-text-stroke: 3.5px var(--c-black);
    text-shadow: 
      0 0 0 var(--c-black),
      -2px -2px 0 #FF6600,
      2px -2px 0 #FF6600,
      -2px 2px 0 #FF6600,
      2px 2px 0 #FF6600,
      0 5px 0 #FF6600,
      0 9px 0 #E64400,
      0 13px 0 #CC3300,
      0 17px 0 var(--c-black),
      -4px 17px 0 var(--c-black),
      4px 17px 0 var(--c-black),
      0 22px 12px rgba(0, 0, 0, 0.6);
  }

  /* DIRTYLINE ROW */
  .sc-dirtyline-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin: 8px 0 18px;
    position: relative;
    z-index: 5;
  }

  .sc-glove-icon {
    width: 64px;
    height: 38px;
    filter: drop-shadow(2.5px 3px 0 #000);
    flex-shrink: 0;
  }

  .sc-dirtyline-badge-wrap {
    text-align: center;
    position: relative;
  }

  .sc-mfg-pill {
    background: #E62B1E;
    color: var(--c-white);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid var(--c-black);
    display: inline-block;
    margin-bottom: -8px;
    position: relative;
    z-index: 2;
  }

  .sc-dirtyline-script-text {
    font-family: 'Pacifico', 'Yellowtail', cursive;
    font-size: clamp(34px, 5.5vw, 48px);
    color: var(--c-green);
    line-height: 1.1;
    -webkit-text-stroke: 2px var(--c-black);
    text-shadow: 
      -1.5px -1.5px 0 var(--c-white),
