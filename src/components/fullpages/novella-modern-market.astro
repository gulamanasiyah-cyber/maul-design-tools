    </div>
  </section>

  <!-- ============ PROMO CARDS (WITH REAL CUTOUT PNGs) ============ -->
  <section class="sec promos" id="deals">
    <div class="promo-row">
      <!-- Card 1: Deal of the Day -->
      <article class="promo light-pink">
        <div class="p-text">
          <span class="p-eyebrow">Deal of the Day</span>
