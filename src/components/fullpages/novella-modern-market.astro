    gap: 8px;
    align-self: flex-start;
    background: #171513;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 9px 22px;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .pill:hover { transform: translateY(-2px); background: #332d29; }
  .pill i { font-style: normal; }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .t-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #524b43;
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .t-item svg { color: #2b2620; }

  .hero-media {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
  }
  .pendant-lamp {
    position: absolute;
    top: 0;
    right: 28%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }
  .cord {
    width: 2px;
    height: 38px;
    background: #4a4036;
  }
  .shade {
    width: 54px;
    height: 48px;
    background: radial-gradient(circle at 50% 30%, #be9c7b 0%, #9c7b5b 70%, #765a3e 100%);
    border-radius: 50% 50% 35% 35% / 60% 60% 40% 40%;
    box-shadow: 0 10px 20px rgba(70, 50, 30, 0.25);
    border: 1px solid rgba(0,0,0,0.08);
  }
  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 65%;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.85) 16%, black 36%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.85) 16%, black 36%);
  }

  /* ============ SECTIONS ============ */
  .sec {
    max-width: 1320px;
    margin: 0 auto;
    padding: 38px clamp(18px, 4vw, 56px) 10px;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .sec-head h2 {
    margin: 0;
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2vw, 24px);
    color: #1e1b18;
  }
  .viewall {
    color: #70685e;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .viewall:hover { color: var(--ink); }

  /* ---- CATEGORY ORBS ---- */
  .orbs {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 16px;
  }
  .orb {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #2b2620;
    transition: transform 0.18s ease;
  }
  .orb:hover { transform: translateY(-3px); }
  .orb-img {
    display: block;
    width: 86px; height: 86px; margin: 0 auto 10px;
    border-radius: 50%; overflow: hidden;
    background: #f4ede4;
    border: 1px solid #ede5da;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
  }
  .orb-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.25s ease;
  }
  .orb:hover .orb-img img { transform: scale(1.08); }
  .orb-label { font-size: 12px; font-weight: 600; }

  /* ---- PROMO CARDS (WITH PNG CUTOUTS) ---- */
  .promos { padding-top: 26px; }
  .promo-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .promo {
    position: relative;
    border-radius: 16px;
    min-height: 190px;
    padding: 22px 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 115px;
    align-items: center;
    gap: 10px;
  }
  .promo.light-pink {
    background: #fbeee9;
  }
  .promo.light-cream {
    background: #f7f2ea;
  }
  .promo.dark {
    background: #1c1a17;
    color: #ffffff;
  }
  .p-text {
    position: relative;
    z-index: 2;
    min-width: 0;
  }
  .p-eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #a85834;
    display: block;
    margin-bottom: 5px;
  }
  .p-eyebrow.gold {
    color: #d4a75e;
  }
  .promo h3 {
    margin: 0 0 5px;
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 21px;
    line-height: 1.15;
  }
  .p-line {
    margin: 0 0 14px;
    font-size: 11.5px;
