          <p class="p-line">On selected items only</p>
          <a class="p-link" href="#trending">Shop Deals <i>→</i></a>
        </div>
        <div class="p-cutout">
          <img class="p-png watch" src="/assets/novella/promo-watch.png" alt="Smart Watch Pink" />
        </div>
      </article>

      <!-- Card 2: New Arrivals -->
      <article class="promo light-cream">
        <div class="p-text">
          <span class="p-eyebrow">New Arrivals</span>
          <h3>Fresh Finds</h3>
          <p class="p-line">Check out the latest products just for you</p>
          <a class="p-link" href="#trending">Explore Now <i>→</i></a>
        </div>
        <div class="p-cutout">
          <img class="p-png shoe" src="/assets/novella/promo-shoe.png" alt="Fresh Sneakers" />
        </div>
      </article>

      <!-- Card 3: Member Exclusive -->
      <article class="promo dark">
        <div class="p-text">
          <span class="p-eyebrow gold">Member Exclusive</span>
          <h3>Extra 10% Off</h3>
          <p class="p-line">On prepaid orders this weekend</p>
          <a class="p-link ghost" href="#footer">Shop Now <i>→</i></a>
        </div>
        <div class="p-cutout">
          <img class="p-png percent" src="/assets/novella/percent-gold.png" alt="Discount Percentage Badge" />
        </div>
      </article>
    </div>
  </section>

