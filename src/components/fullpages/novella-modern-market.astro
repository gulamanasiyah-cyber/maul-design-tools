---
// Novella Modern Market — FULL-PAGE recreation of the marketplace reference:
// utility bar, header with centered search, category nav, warm cream hero board
// with real lifestyle interior photography & trust items, Shop by Category orbs,
// 3 promo cards with transparent PNG product cutouts, Trending Now / Recommended
// product grids, feature trust bar, newsletter card with stationery cutout, dark footer.
---

<div class="page">
  <!-- ============ UTILITY BAR ============ -->
  <div class="utility">
    <span class="u-left"><i class="dot"></i> Free shipping on orders over $50 <em>|</em> <i class="dot"></i> Easy 30-day returns</span>
    <span class="u-right"><a href="#footer">Track Order</a> <em>|</em> <a href="#footer">Help Center</a> <em>|</em> <a href="#footer">Sell on Novella</a></span>
  </div>

  <!-- ============ HEADER ============ -->
  <header class="header">
    <a class="brand" href="#top">
      <svg class="mark" viewBox="0 0 24 24"><path d="M12 1l4 4.5L12 10 8 5.5zM12 6l3.5 4L12 14 8.5 10zM9 13h6l2 6h-10z" fill="none" stroke="#241B12" stroke-width="1.6" stroke-linejoin="round"/></svg>
      NOVELLA
    </a>
    <div class="search">
      <span class="ph">Search products, brands and more…</span>
      <button class="sgo" aria-label="Search">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      </button>
    </div>
    <div class="icons">
      <a class="ic" href="#footer" aria-label="Account">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Account</span>
      </a>
      <a class="ic" href="#trending" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        <span>Wishlist</span>
      </a>
      <a class="ic cart" href="#trending" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
        <em>2</em>
        <span>Cart</span>
      </a>
    </div>
  </header>

  <!-- ============ CATEGORY NAV ============ -->
  <nav class="cats" id="top">
    <a class="cat menu-btn" href="#categories">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      Categories
    </a>
    <a class="cat" href="#trending">New Arrivals</a>
    <a class="cat hot" href="#deals">Top Deals <span class="hot-badge">Hot</span></a>
    <a class="cat" href="#trending">Best Sellers</a>
    <a class="cat" href="#categories">Home Essentials</a>
    <a class="cat" href="#categories">Electronics</a>
    <a class="cat" href="#categories">Fashion</a>
    <a class="cat" href="#categories">Beauty</a>
    <a class="cat" href="#categories">Baby &amp; Kids</a>
  </nav>

  <!-- ============ HERO BOARD ============ -->
  <section class="hero-wrap">
    <div class="hero">
      <div class="copy">
        <span class="eyebrow">QUALITY. STYLE. EVERYDAY.</span>
        <h1>Everything You Love,<br /><span class="accent-line">All in One Place.</span></h1>
        <p>Shop top-quality products across all categories with unbeatable prices and a seamless experience.</p>
        <a class="pill" href="#trending">Shop Now <i>→</i></a>

        <div class="hero-trust">
          <span class="t-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/><circle cx="12" cy="16" r="1.5"/></svg>
            Secure Payments
          </span>
          <span class="t-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="9" r="6"/><path d="M8.5 14.5l-2.5 6.5 6-3 6 3-2.5-6.5"/><path d="M9.5 9l1.8 1.8 3.5-3.5"/></svg>
            Premium Quality
          </span>
          <span class="t-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Fast Delivery
          </span>
        </div>
      </div>
      <div class="hero-media">
        <div class="pendant-lamp" aria-hidden="true">
          <span class="cord"></span>
          <span class="shade"></span>
        </div>
        <img class="hero-photo" src="/assets/novella/hero-room.jpg" alt="Aesthetic warm living room with modern sofa, coffee table and indoor plant" />
      </div>
    </div>
  </section>

  <!-- ============ SHOP BY CATEGORY ============ -->
  <section class="sec" id="categories">
    <div class="sec-head">
      <h2>Shop by Category</h2>
      <a class="viewall" href="#categories">View all categories →</a>
    </div>
    <div class="orbs">
      <a class="orb" href="#categories">
        <span class="orb-img"><img src="/assets/novella/cat-electronics.jpg" alt="Electronics" /></span>
        <span class="orb-label">Electronics</span>
      </a>
      <a class="orb" href="#categories">
        <span class="orb-img"><img src="/assets/novella/cat-fashion.jpg" alt="Fashion" /></span>
        <span class="orb-label">Fashion</span>
      </a>
      <a class="orb" href="#categories">
        <span class="orb-img"><img src="/assets/novella/cat-home.jpg" alt="Home & Living" /></span>
        <span class="orb-label">Home &amp; Living</span>
      </a>
      <a class="orb" href="#categories">
        <span class="orb-img"><img src="/assets/novella/cat-beauty.jpg" alt="Beauty" /></span>
        <span class="orb-label">Beauty</span>
      </a>
      <a class="orb" href="#categories">
        <span class="orb-img"><img src="/assets/novella/cat-baby.jpg" alt="Baby & Kids" /></span>
        <span class="orb-label">Baby &amp; Kids</span>
