    transition: background 0.15s ease;
  }
  .sgo:hover { background: #3a3530; }
  .icons { display: inline-flex; gap: 20px; flex: none; align-items: center; }
  .ic {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: #4a443c;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    position: relative;
    transition: color 0.15s ease;
  }
  .ic:hover { color: var(--ink); }
  .ic.cart em {
    position: absolute; top: -4px; right: 2px;
    width: 15px; height: 15px; border-radius: 50%;
    background: var(--ink); color: #fff; font-size: 9px; font-weight: 700;
    display: grid; place-items: center; font-style: normal;
  }

  /* ============ CATEGORY NAV ============ */
  .cats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 26px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 4px clamp(18px, 4vw, 56px) 16px;
    border-bottom: 1px solid #f0ebe2;
  }
  .cat {
    font-size: 12.5px;
    font-weight: 600;
    color: #3b3630;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cat:hover { color: var(--orange); }
  .cat.hot { color: var(--orange); }
  .hot-badge {
    background: #e25822;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  /* ============ HERO BOARD ============ */
  .hero-wrap {
    max-width: 1320px;
    margin: 14px auto 0;
    padding: 0 clamp(18px, 4vw, 56px);
  }
