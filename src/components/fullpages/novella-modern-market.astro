    padding: 8px clamp(18px, 4vw, 56px);
  }
  .utility em { opacity: 0.4; margin: 0 4px; }
  .u-left, .u-right { display: inline-flex; align-items: center; gap: 4px; }
  .u-right a:hover { color: var(--ink); text-decoration: underline; }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: #9c9489; margin-right: 4px; }

  /* ============ HEADER ============ */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 18px clamp(18px, 4vw, 56px) 14px;
  }
  .brand {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 23px;
    letter-spacing: 0.12em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    color: var(--ink);
  }
  .mark { width: 24px; height: 24px; }
  .search {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #e5ded3;
    background: #ffffff;
    padding: 4px 6px 4px 18px;
    border-radius: 999px;
    max-width: 580px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }
  .search .ph { color: #9c9489; font-size: 13.5px; }
  .sgo {
    width: 34px; height: 34px; border: 0;
