<script>
  const words = ['data teams', 'business teams', 'the whole org'];
  const rotor = document.getElementById('rotor');
  let wi = 0;
  setInterval(() => {
    wi = (wi + 1) % words.length;
    rotor.classList.remove('fade');
    void rotor.offsetWidth;
    rotor.textContent = words[wi];
    rotor.classList.add('fade');
  }, 2600);

  document.querySelectorAll('.acc-head').forEach((head) => {
    head.addEventListener('click', () => {
      const item = head.parentElement;
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.acc-item.open').forEach((o) => {
        o.classList.remove('open');
        o.querySelector('.acc-head').setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen) {
        item.classList.add('open');
        head.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  .page {
    /* Mode's real tokens */
    --g1: #EEF2E3;  /* sage ground */
    --g2: #C8F169;  /* lime accent */
    --g3: #78C51C;
    --g4: #2A6F2B;
    --g5: #043F2E;  /* deep green ink */
    --gray2: #F3F3F3; --gray3: #E7E7E6; --gray5: #CECFCD;
    --gray7: #80827D; --gray8: #6B6D68; --gray9: #5A5C58;
    --white: #FCFCFC;
    --r: 8px;

    background: var(--g1);
    color: var(--g5);
    font-family: 'Hanken Grotesk', system-ui, sans-serif; /* Graphik stand-in */
    overflow-x: clip;
  }
  .page a { text-decoration: none; }
  .page img { display: block; max-width: 100%; }
  .wrap { max-width: 1200px; margin: 0 auto; padding-left: clamp(20px, 4vw, 48px); padding-right: clamp(20px, 4vw, 48px); }

  /* ---- buttons: square 4px, like the real site ---- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 4px; padding: 17px 24px; border: 1px solid transparent;
    font: 500 14px/1.1 'Hanken Grotesk', sans-serif; cursor: pointer; white-space: nowrap;
    transition: background-color .25s ease-in-out, color .25s ease-in-out;
  }
  .btn-dark { background: var(--g5); color: var(--g2); }
  .btn-dark:hover { background: #0a5a44; }
  .btn-line { background: transparent; border-color: var(--g5); color: var(--g5); }
  .btn-line:hover { background: rgba(4, 63, 46, 0.08); }
  .btn-lime { background: var(--g2); color: var(--g5); }
  .btn-ghostlight { background: transparent; border-color: rgba(252,252,252,.55); color: var(--white); }
  .btn-ghostlight:hover { background: rgba(252,252,252,.1); }

  /* ---- announcement: lime bar ---- */
  .announce { background: var(--g2); text-align: center; padding: 10px 16px; position: relative; z-index: 20; }
  .announce p { font: 500 14px/1.4 'Hanken Grotesk', sans-serif; color: var(--g5); }
  .announce a { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  /* ---- nav ---- */
  .nav {
    position: sticky; top: 0; z-index: 30;
    background: rgba(238, 242, 227, 0.92); backdrop-filter: blur(10px);
  }
  .nav-inner { display: flex; align-items: center; gap: 28px; padding-top: 12px; padding-bottom: 12px; }
  .logo svg { height: 22px; width: auto; display: block; }
  .links { display: flex; gap: 26px; margin: 0 auto; }
  .links a { font: 500 14px/1 'Hanken Grotesk', sans-serif; color: var(--g5); display: inline-flex; align-items: center; gap: 5px; padding: 10px 0; }
  .links a:hover { opacity: .72; }
  .links i { font-style: normal; font-size: 9px; opacity: .6; }
  .actions { display: flex; align-items: center; gap: 12px; }
  .signin { font: 500 14px/1 'Hanken Grotesk', sans-serif; color: var(--g5); padding: 10px 4px; }
  .nav .btn { padding: 12px 18px; }

  /* ---- hero: serif on stacked lime pills ---- */
  .hero { padding: clamp(40px, 6vw, 84px) 0 0; }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 72px); align-items: end;
  }
  .pills { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .pill {
    font-family: 'Fraunces', Georgia, serif; /* Grenette stand-in */
    font-weight: 500; color: var(--g5);
    background: var(--g2); border-radius: var(--r);
    font-size: clamp(38px, 5.4vw, 68px); line-height: .9; letter-spacing: -.02em;
    padding: 12px 20px; display: inline-block;
  }
  .pill-1 { border-bottom-right-radius: 0; }
  .pill-2 { border-top-left-radius: 0; border-top-right-radius: 0; }
  .rotor { display: inline-block; min-width: 5.2ch; }
  .rotor.fade { animation: wordIn .45s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes wordIn { from { opacity: 0; transform: translateY(.18em); } to { opacity: 1; transform: none; } }

  .hero-side { padding-bottom: 10px; }
  .hero-side p { font: 400 18px/1.5 'Hanken Grotesk', sans-serif; max-width: 42ch; }
  .hero-side .row { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }

  .shot { margin-top: clamp(36px, 5vw, 64px); }
  .shot img {
    border-radius: var(--r) var(--r) 0 0;
    background: var(--white); max-width: 1000px; margin-left: auto;
    box-shadow: 0 30px 60px rgba(4, 63, 46, .14);
  }

  /* ---- section headings ---- */
  section { padding: clamp(64px, 8vw, 110px) 0; }
  .kicker { font: 600 12px/1 'Hanken Grotesk', sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--g4); margin-bottom: 18px; }
  .big { font: 500 clamp(34px, 4.4vw, 56px)/1.03 'Fraunces', Georgia, serif; letter-spacing: -.02em; }
  .big em { font-style: italic; font-weight: 400; }
  .lede { font: 400 18px/1.55 'Hanken Grotesk', sans-serif; color: var(--gray9); max-width: 56ch; margin-top: 18px; }
  .center { text-align: center; margin-inline: auto; }

  /* ---- capabilities accordion ---- */
  .acc { margin-top: 44px; border-top: 1px solid rgba(4, 63, 46, 0.18); }
  .acc-item { border-bottom: 1px solid rgba(4, 63, 46, 0.18); transition: background .2s ease-in-out; }
  .acc-item.open { background: var(--g2); }
  .acc-head {
    width: 100%; display: flex; align-items: center; gap: 18px;
    background: none; border: 0; cursor: pointer; text-align: left;
    padding: 22px clamp(16px, 2.5vw, 28px); font-family: 'Hanken Grotesk', sans-serif;
  }
  .acc-head .num { font: 500 13px/1 'Hanken Grotesk', sans-serif; color: var(--g4); width: 2ch; }
  .acc-head .t { font: 500 clamp(20px, 2.4vw, 28px)/1.1 'Hanken Grotesk', sans-serif; color: var(--g5); flex: 1; }
  .acc-head .plus { font: 400 22px/1 'Hanken Grotesk', sans-serif; transition: transform .25s ease; }
  .acc-item.open .plus { transform: rotate(45deg); }
  .acc-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .acc-item.open .acc-body { grid-template-rows: 1fr; }
  .acc-inner { overflow: hidden; }
  .acc-cols {
    display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: center;
    padding: 0 clamp(16px, 2.5vw, 28px) 26px calc(clamp(16px, 2.5vw, 28px) + 2ch + 18px);
  }
  .acc-cols p { font: 400 16px/1.6 'Hanken Grotesk', sans-serif; max-width: 46ch; }
  .acc-cols img { border-radius: var(--r); width: 100%; }

  /* ---- two audiences ---- */
  .white { background: var(--white); }
  .duo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px); margin-top: 48px; }
  .duo-col h3 { font: 500 clamp(24px, 2.6vw, 32px)/1.1 'Fraunces', Georgia, serif; margin-bottom: 14px; }
  .duo-col p { font: 400 16px/1.65 'Hanken Grotesk', sans-serif; color: var(--gray9); }
  .tag {
    display: inline-block; font: 600 12px/1 'Hanken Grotesk', sans-serif;
    letter-spacing: .1em; text-transform: uppercase; color: var(--g4);
    background: var(--g1); border-radius: 4px; padding: 8px 12px; margin-bottom: 18px;
  }

  /* ---- stack diagram ---- */
  .stack { max-width: 860px; margin: 48px auto 0; display: flex; flex-direction: column; gap: 10px; }
  .srow {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    border-radius: var(--r); padding: 18px 24px;
    font: 500 16px/1 'Hanken Grotesk', sans-serif;
  }
  .srow.mode {
    background: var(--g5); color: var(--white); justify-content: space-between;
    padding: 22px 28px; font-size: 20px; font-weight: 600;
  }
  .srow.mode .chip { background: var(--g2); color: var(--g5); font: 600 11px/1 'Hanken Grotesk', sans-serif; letter-spacing: .08em; text-transform: uppercase; padding: 7px 10px; border-radius: 4px; }
  .srow.b1 { background: var(--white); }
  .srow.b2 { background: var(--gray2); }
  .srow.b3 { background: var(--gray3); }
  .srow.b4 { background: var(--gray5); }
  .srow.dim { opacity: .75; }
  .stack-links { display: flex; gap: 12px; justify-content: center; margin-top: 36px; flex-wrap: wrap; }

  /* ---- logos ---- */
  .logos-sec { background: var(--white); padding: clamp(48px, 6vw, 80px) 0; }
  .logos-head { text-align: center; font: 600 13px/1 'Hanken Grotesk', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--gray7); margin-bottom: 36px; }
  .logos { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(28px, 5vw, 64px); }
  .logos span { font: 700 clamp(16px, 2vw, 22px)/1 'Hanken Grotesk', sans-serif; color: var(--gray5); letter-spacing: -.01em; }

  /* ---- quote ---- */
  .quote-sec { text-align: center; }
  .quote-sec blockquote {
    font: 400 clamp(24px, 3.2vw, 36px)/1.2 'Fraunces', Georgia, serif; font-style: italic;
    max-width: 880px; margin: 0 auto;
  }
  .q-who { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 32px; }
  .q-who .av { width: 48px; height: 48px; border-radius: 50%; background: var(--g2); display: grid; place-items: center; font: 600 16px/1 'Hanken Grotesk', sans-serif; }
  .q-who .nm { text-align: left; }
  .q-who b { display: block; font: 600 15px/1.2 'Hanken Grotesk', sans-serif; }
  .q-who i { font: 400 13px/1.2 'Hanken Grotesk', sans-serif; font-style: normal; color: var(--gray8); }

  /* ---- demo card ---- */
  .demo-sec { padding-top: 0; }
  .demo-card {
    background: var(--white); border-radius: 20px; padding: clamp(36px, 5vw, 64px);
    display: grid; grid-template-columns: 1.2fr .8fr; gap: 32px; align-items: center;
    box-shadow: 0 24px 48px rgba(4, 63, 46, 0.08);
  }
