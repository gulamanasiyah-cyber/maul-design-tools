<script is:inline>
  // Interactive Question Jar Form auto-filler
  const select = document.getElementById('questionSelect');
  const textarea = document.getElementById('message');
  const form = document.getElementById('questionForm');
  const success = document.getElementById('formSuccess');

  if (select && textarea) {
    select.addEventListener('change', (e) => {
      const val = e.target.value;
      if (val === 'fees') {
        textarea.value = 'I would like a free fee diagnostic on my current 401(k) / IRA accounts to see how much I am paying in management and expense ratios.';
      } else if (val === '401k') {
        textarea.value = 'I am trying to decide whether to continue contributing pre-tax to my 401(k) or start converting balances into a Roth IRA.';
      } else if (val === 'taxes') {
        textarea.value = 'What tax diversification strategies can I implement now to reduce my tax liability once Required Minimum Distributions (RMDs) kick in?';
      } else if (val === 'returns') {
        textarea.value = 'What is a realistic and conservative rate of return I can rely on to ensure my savings last throughout my entire retirement?';
      } else if (val === 'annuities') {
        textarea.value = 'I want to understand how a fixed indexed annuity can guarantee my principal against market loss while still capturing market upside.';
      } else if (val === 'pyramids') {
        textarea.value = 'While you are solving my retirement plan, can you also explain who built the pyramids? 😉';
      }
    });
  }

  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      success.style.display = 'block';
      form.reset();
      setTimeout(() => {
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 100);
    });
  }
</script>
