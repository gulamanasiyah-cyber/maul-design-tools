        </label>
        <span class="sep"></span>
        <label class="field">
          <span class="fi"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#1B4D3E" stroke-width="1.7"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20 C5.5 15.8 8.3 13.6 12 13.6 C15.7 13.6 18.5 15.8 18.5 20"/></svg></span>
