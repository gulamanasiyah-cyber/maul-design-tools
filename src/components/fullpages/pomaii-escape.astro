        <svg viewBox="0 0 90 44" width="62" height="30"><path d="M2 34 C18 14 40 6 64 10 C52 20 32 30 12 34Z" fill="#1B4D3E"/><path d="M4 34 C22 16 44 8 66 12" stroke="#0F2A24" stroke-width="0.9" fill="none"/><path d="M20 26 L14 14 M34 20 L30 8" stroke="#0F2A24" stroke-width="0.8"/></svg>
      </span>

      <!-- copy on the white wave -->
      <div class="hero-copy">
        <span class="eyebrow">EXPLORE THE WORLD</span>
        <h1><span class="ink">Discover Nature.</span><span class="green">Find Your <em>Escape.</em></span></h1>
        <p>Breathtaking places, unforgettable<br/>experiences, crafted just for you.</p>
        <a class="cta" href="#destinations">Explore Now <span>→</span></a>
      </div>

      <!-- floating search on image -->
      <form class="search" onsubmit="return false">
        <label class="field">
