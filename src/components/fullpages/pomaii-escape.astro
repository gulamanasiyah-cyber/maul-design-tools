---
// Pomaii Escape — meticulous 1:1 recreation of the warm travel reference:
// full-bleed wavy hero (white organic cutouts left/right/bottom), copy on the
// white wave, floating pill search ON the image, trust strip, 4 destination
// cards (orange prices), category pills, beige guides box, dark offer banner
// with curved divider + lily, stats row and 5-column footer.
---

<div class="page">
  <!-- NAV -->
  <header class="nav">
    <a class="brand" href="#top">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 28 28" width="30" height="30"><defs><clipPath id="pmark"><circle cx="14" cy="14" r="12"/></clipPath></defs><circle cx="14" cy="14" r="12.5" fill="#fff" stroke="rgba(22,51,43,0.08)"/><g clip-path="url(#pmark)"><path d="M14 2 C20 3 24 7 24 13 C24 18 20 22 14 26 C8 22 4 18 4 13 C4 7 8 3 14 2Z" fill="#F28C28"/><path d="M4 16 C7 14 12 11 15 17 C11 22 6 24 3 20Z" fill="#0F4A3A"/><circle cx="18" cy="9" r="2.4" fill="#F2C14E"/></g></svg>
      </span>
      <span class="bt"><b>Pomaii</b><em>Explore. Dream. Discover.</em></span>
    </a>
    <nav class="links" aria-label="Primary">
      <a class="on" href="#top">Home</a>
      <a href="#destinations">Destinations</a>
      <a href="#destinations">Tours</a>
      <a href="#guides">Travel Guide</a>
      <a href="#guides">Blog</a>
      <a href="#contact">About Us</a>
