<style>
  .page{
    background:#FFFBF3;
    color:#0F2A24;
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
    overflow-x:clip;
  }
  /* nav */
  .nav{
    max-width:1240px;
    margin:0 auto;
    padding:12px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    position:sticky;
    top:0;
    background:rgba(255,251,243,0.92);
    backdrop-filter:blur(10px);
    z-index:6;
  }
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#0F2A24;}
  .bt{display:flex;flex-direction:column;line-height:1;}
  .bt b{font-size:19px;letter-spacing:-0.02em;}
  .bt em{font-style:normal;font-size:9px;letter-spacing:0.05em;color:#8A9A95;margin-top:2px;}
  .mark.sm{width:24px;height:24px;}
  .links{display:flex;gap:24px;align-items:center;}
  .links a{font-size:13px;font-weight:500;color:#5E6E68;text-decoration:none;padding-bottom:5px;border-bottom:2px solid transparent;}
  .links a.on{color:#F28C28;border-bottom-color:#F28C28;}
  .links a:hover{color:#0F2A24;}
  .nav-actions{display:flex;align-items:center;gap:6px;}
  .plain-btn{width:34px;height:34px;border:0;background:transparent;color:#16332B;display:grid;place-items:center;cursor:pointer;font-size:15px;border-radius:50%;}
  .plain-btn:hover{background:rgba(22,51,43,0.05);}
  .menu-btn{width:36px;height:36px;border:1px solid rgba(22,51,43,0.10);background:#fff;color:#16332B;display:grid;place-items:center;cursor:pointer;font-size:15px;border-radius:11px;}
  /* hero */
  .hero{max-width:1240px;margin:0 auto;padding:4px 28px 0;}
  .stage{
    position:relative;
    height:584px;
    border-radius:26px;
    overflow:hidden;
    background:#D6E8E6;
  }
  .stage-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  .wave{position:absolute;pointer-events:none;}
  .wave-left{left:0;top:0;height:100%;width:52%;}
  .wave-right{right:0;top:11%;height:54%;width:19%;}
  .wave-bottom{left:0;right:0;bottom:-1px;height:19%;width:100%;}
  .dots-grid{position:absolute;top:14px;right:34px;display:grid;grid-template-columns:repeat(3,4px);gap:5px;opacity:0.28;}
  .dots-grid i{width:3.5px;height:3.5px;border-radius:50%;background:#16332B;display:block;}
  .sprig{position:absolute;pointer-events:none;}
  .sprig-tl{top:12px;left:10px;}
  .sprig-bl{bottom:96px;left:16px;}
  .hero-copy{position:absolute;top:66px;left:54px;z-index:2;max-width:420px;}
  .eyebrow{
    display:inline-block;
    font-size:10.5px;font-weight:700;letter-spacing:0.22em;color:#3E5F54;
  }
  .eyebrow .spark{color:#F2C14E;}
  .eyebrow.light{color:rgba(255,255,255,0.85);}
  .hero-copy h1{margin:12px 0 0;font-size:clamp(30px,3.9vw,46px);line-height:1.04;letter-spacing:-0.025em;}
  .hero-copy h1 span{display:block;}
  .ink{color:#0F2A24;}
  .green{color:#1B4D3E;}
  .green em{font-style:normal;position:relative;}
  .green em::after{content:"";position:absolute;left:-2px;right:-2px;bottom:2px;height:7px;background:rgba(242,140,40,0.32);border-radius:999px;transform:rotate(-0.8deg);}
  .hero-copy p{margin:16px 0 20px;font-size:13.5px;line-height:1.65;color:#5E6E68;}
  .cta{
    display:inline-flex;align-items:center;gap:9px;
    background:#F28C28;color:#fff;
    font-size:13px;font-weight:700;
    padding:10px 12px 10px 20px;border-radius:999px;
    text-decoration:none;
