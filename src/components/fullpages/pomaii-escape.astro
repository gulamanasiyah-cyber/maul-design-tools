        <path d="M0 0 H242 C286 62 290 130 254 184 C226 226 228 272 198 314 C170 352 110 374 60 368 C36 365 14 356 0 345 Z" fill="#FFFBF3"/>
      </svg>
      <svg class="wave wave-right" viewBox="0 0 200 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M200 0 C128 32 88 92 95 162 C100 224 142 262 200 292 Z" fill="#FFFBF3"/>
      </svg>
      <svg class="wave wave-bottom" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 74 C150 32 330 20 490 46 C668 74 866 80 1024 50 C1104 35 1164 26 1200 32 L1200 120 L0 120 Z" fill="#FFFBF3"/>
      </svg>

      <!-- decor -->
      <span class="dots-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="sprig sprig-tl" aria-hidden="true">
        <svg viewBox="0 0 44 74" width="30" height="50"><path d="M22 72 C20 46 8 30 6 16 C10 19 18 30 22 36 C26 30 34 19 38 16 C36 30 24 46 22 72Z" fill="#6FA97C"/><path d="M22 72 L22 8" stroke="#4E8A60" stroke-width="1.4" fill="none"/><path d="M22 34 C15 30 9 23 7 16 C14 20 20 27 22 34Z" fill="#9CC7A6"/><path d="M22 34 C29 27 35 20 38 16 C33 23 27 30 22 34Z" fill="#9CC7A6"/></svg>
      </span>
