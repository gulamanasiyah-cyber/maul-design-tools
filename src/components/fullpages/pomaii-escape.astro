      <a href="#destinations"><i class="ci"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#1B4D3E" stroke-width="1.5"><path d="M12 19.5 C12 19.5 5 15 5 10.2 C5 7.3 7.4 5.4 9.8 6.6 L12 8 L14.2 6.6 C16.6 5.4 19 7.3 19 10.2 C19 15 12 19.5 12 19.5Z"/></svg></i> Honeymoon</a>
      <a href="#destinations"><i class="ci"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#1B4D3E" stroke-width="1.5"><circle cx="9" cy="7.5" r="2.8"/><circle cx="15.5" cy="8.5" r="2.3"/><path d="M3.8 19 C3.8 15.2 6 13.2 9 13.2 C12 13.2 14.2 15.2 14.2 19"/><path d="M15 13.6 C17.8 13.6 19.8 15.4 19.8 18.6"/></svg></i> Family</a>
