  .spark { position: absolute; color: #d6ff3b; line-height: 1; z-index: 3; }
  .sp1 { top: 2%; right: 4%; font-size: 44px; color: transparent; -webkit-text-stroke: 1.5px #d6ff3b; }
  .sp2 { top: 16%; left: 3%; font-size: 18px; }
  .sp3 { bottom: 6%; right: 12%; font-size: 26px; }

  .h-side { justify-self: end; max-width: 210px; }
  .h-side p { margin: 0 0 20px; font-size: 12.5px; line-height: 1.7; color: rgba(255, 255, 255, 0.85); }

