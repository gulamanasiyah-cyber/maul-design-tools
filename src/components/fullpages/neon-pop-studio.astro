  .page section { scroll-margin-top: 80px; }
  .wrap {
    max-width: 1220px;
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 48px);
    padding-right: clamp(20px, 4vw, 48px);
  }
  h1, h2, .giant {
    font-family: 'Anton', 'Arial Narrow', sans-serif;
    font-weight: 400;
    margin: 0;
    text-transform: uppercase;
  }
  .giant { font-size: clamp(30px, 3.8vw, 48px); line-height: 1.04; letter-spacing: 0.015em; }
  .st { color: #d6ff3b; font-style: normal; }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #d6ff3b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .dark-label { color: #111; }

  /* ---- pills ---- */
  .lime-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #d6ff3b;
    color: #111;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 12px 12px 12px 22px;
    border-radius: 999px;
    white-space: nowrap;
    cursor: pointer;
  }
  .lime-pill.big { font-size: 13px; padding: 14px 14px 14px 26px; }
  .arr {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #111;
    color: #d6ff3b;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 13px;
  }
  .arr.lime { background: #d6ff3b; color: #111; }
  .ghost-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 12px 12px 12px 22px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ring {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(214, 255, 59, 0.75);
    color: #d6ff3b;
    display: grid;
    place-items: center;
    font-size: 16px;
    flex: none;
    transition: all 0.2s ease;
  }
  .ring.white { border-color: rgba(255, 255, 255, 0.75); color: #fff; }
  .ring.big { width: 52px; height: 52px; }

  /* ============ HERO ============ */
  .hero { background: #2b2bf0; padding-bottom: 84px; }
