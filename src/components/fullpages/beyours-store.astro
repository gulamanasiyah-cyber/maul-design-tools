---
// Be Yours Beauty Store — Full-page recreation of the live "Be Yours" skincare storefront (RoarTheme).
// Palettes: Pure White #FFFFFF, Near-White #F5F5F5, Black #000000 / Ink #1B1B18, Acid Lime #DFFF4F,
// Sale Red #FF2D16. Fonts: Jost (display headings), Assistant (body).
// Sections: countdown announcement, header + search, hero slideshow, new arrivals, color fan,
// skin quiz → routine, bestseller tabs, shop-the-look, before/after, value props, marquee,
// testimonials, photo feed, newsletter, footer + mobile dock.
---

<div class="beyours-store">

  <!-- ==================== ANNOUNCEMENT COUNTDOWN ==================== -->
  <aside class="announcement-bar">
    <div class="countdown-row">
      <span class="cd">ENDS IN <b>02</b> : <b>14</b> : <b>09</b> — HURRY</span>
      <span class="ship-msg">Complimentary shipping on orders over $100</span>
    </div>
  </aside>

  <!-- ==================== HEADER ==================== -->
  <header class="main-header">
    <div class="container header-container">
      <button class="drawer-btn" aria-label="Menu">☰</button>
      <div class="brand-logo">BE&nbsp;YOURS</div>
      <div class="search-inline">
        <svg viewBox="0 0 21 21" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8.75" cy="8.75" r="6.5"/><path d="M14 14l5 5"/></svg>
        <span>Search</span>
      </div>
      <nav class="header-nav">
        <a href="#" class="nav-item">Brands</a>
        <a href="#" class="nav-item on">Skincare</a>
        <a href="#" class="nav-item">Baby &amp; Kids</a>
        <a href="#" class="nav-item">Hair Care</a>
        <a href="#" class="nav-item">Body Care</a>
        <a href="#" class="nav-item">Explore</a>
        <a href="#" class="nav-item">Our stores</a>
      </nav>
      <div class="header-right">
        <button class="icon-btn" aria-label="Account">
          <svg viewBox="0 0 21 21" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="5.75" r="3.25"/><path d="M3.5 18.5a7 7 0 0114 0"/></svg>
        </button>
        <button class="icon-btn cart-btn" aria-label="Cart">
          <svg viewBox="0 0 21 21" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h13l-1.2 10.2A1.5 1.5 0 0114.3 17.5H6.7a1.5 1.5 0 01-1.5-1.3L4 6z"/><path d="M7.5 6V5a3.5 3.5 0 017 0v1"/></svg>
          <span class="cart-count">2</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== HERO SLIDESHOW ==================== -->
  <section class="hero">
    <div class="hero-image">
      <span class="hero-swatch s1"></span>
      <span class="hero-swatch s2"></span>
      <span class="hero-swatch s3"></span>
      <span class="hero-swatch s4"></span>
    </div>
    <div class="hero-copy">
