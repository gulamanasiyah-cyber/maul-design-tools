          <div class="step">
            <div class="step-thumb st2"></div>
            <div class="step-meta"><b>2 · Hyaluronic Serum</b><span>Three HA weights on damp skin</span></div>
            <span class="step-price">$42</span>
          </div>
          <div class="step">
            <div class="step-thumb st3"></div>
            <div class="step-meta"><b>3 · Face Cream</b><span>Seals it all in overnight</span></div>
            <span class="step-price">$24</span>
          </div>
        </div>
        <button class="btn btn-dark btn-full">ADD ROUTINE · $82.00</button>
      </div>
    </div>
  </section>

  <!-- ==================== BESTSELLERS TABS ==================== -->
  <section class="section section-tabs">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Bestsellers</h2>
      </div>
      <div class="tabs">
        <span class="tab on">All</span>
        <span class="tab">Cleanse</span>
        <span class="tab">Treat</span>
        <span class="tab">Protect</span>
      </div>
      <div class="grid-4">
        <article class="p-card slim">
          <div class="p-media pm5"><span class="badge lime">Just dropped</span></div>
          <div class="p-body">
            <h3 class="p-name">Glow Drops</h3>
            <div class="p-buy"><span class="p-price">$34</span><button class="add-btn">+</button></div>
          </div>
        </article>
        <article class="p-card slim">
          <div class="p-media pm6"></div>
          <div class="p-body">
            <h3 class="p-name">Hyaluronic Serum</h3>
            <div class="p-buy"><span class="p-price">$42</span><button class="add-btn">+</button></div>
          </div>
        </article>
        <article class="p-card slim">
          <div class="p-media pm7"><span class="badge ink">Selling fast</span></div>
          <div class="p-body">
            <h3 class="p-name">Night Serum</h3>
            <div class="p-buy"><span class="p-price">$44</span><span class="cd-chip">ENDS 02:14:09</span><button class="add-btn">+</button></div>
          </div>
        </article>
        <article class="p-card slim">
          <div class="p-media pm8"></div>
          <div class="p-body">
            <h3 class="p-name">Anti-Pollution Drops</h3>
            <div class="p-buy"><span class="p-price">$34</span><button class="add-btn">+</button></div>
          </div>
        </article>
      </div>
      <div class="center"><a href="#" class="btn btn-outline">VIEW ALL</a></div>
    </div>
  </section>

  <!-- ==================== SHOP THE LOOK ==================== -->
  <section class="section section-look">
    <div class="container">
      <h2 class="section-title lg center">Love Your Skin <span class="scribble">Naturally</span></h2>
      <div class="look-grid">
        <div class="look-media">
          <span class="hot h1">+</span>
          <span class="hot h2">+</span>
          <span class="hot h3">+</span>
        </div>
        <div class="look-list">
          <div class="look-item">
            <div class="lk-thumb lt1"></div>
            <div><b>Hyaluronic Serum</b><span class="lk-sub">Dr. Elowen Liz</span></div>
            <span class="lk-price">$42</span>
            <button class="add-btn">ADD +</button>
          </div>
          <div class="look-item">
            <div class="lk-thumb lt2"></div>
            <div><b>Cleanser</b><span class="lk-sub">Dr. Elowen Liz</span></div>
            <span class="lk-price">$22</span>
            <button class="add-btn">ADD +</button>
          </div>
          <div class="look-item">
            <div class="lk-thumb lt3"></div>
            <div><b>Face Cream</b><span class="lk-sub">Dr. Elowen Liz</span></div>
            <span class="lk-price">$24</span>
            <button class="add-btn">ADD +</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== BEFORE & AFTER ==================== -->
  <section class="section section-compare">
    <div class="container">
      <h2 class="section-title lg center">Before &amp; After</h2>
      <div class="compare">
        <div class="compare-before">
          <span class="compare-label">BEFORE</span>
        </div>
        <div class="compare-after">
          <span class="compare-label">AFTER</span>
        </div>
        <div class="compare-handle">⇔</div>
      </div>
      <div class="center compare-cta"><span class="micro">Drag the handle to compare results</span></div>
    </div>
  </section>

  <!-- ==================== VALUE PROPS ==================== -->
  <section class="section section-values">
    <div class="container">
      <h2 class="section-title lg center">Our promise</h2>
      <div class="grid-4">
        <div class="value-card"><span class="v-emoji">🌿</span><h4>Clean formulas</h4><p>Clean and natural skincare with safe, transparent ingredients.</p></div>
        <div class="value-card"><span class="v-emoji">🚚</span><h4>Global delivery</h4><p>Fast tracked shipping, no hidden import duties.</p></div>
        <div class="value-card"><span class="v-emoji">♻️</span><h4>Sustainability</h4><p>Recyclable, biodegradable signature packaging.</p></div>
        <div class="value-card"><span class="v-emoji">✅</span><h4>Authorised retailer</h4><p>We carry only officially authorised brands.</p></div>
      </div>
    </div>
  </section>

  <!-- ==================== MARQUEE PROMOTION ==================== -->
  <section class="marquee">
    <div class="marquee-track">
      <span>✦ SHOW US YOUR RITUAL #BEYOURSRITUAL ✦ FREE SHIPPING OVER $100 ✦ WE ARE AUTHORISED RETAILERS ✦ CLEAN FORMULAS ✦</span>
      <span>✦ SHOW US YOUR RITUAL #BEYOURSRITUAL ✦ FREE SHIPPING OVER $100 ✦ WE ARE AUTHORISED RETAILERS ✦ CLEAN FORMULAS ✦</span>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS ==================== -->
  <section class="section section-testi">
    <div class="container">
      <h2 class="section-title lg center">What customers say</h2>
      <div class="testi-grid">
        <div class="avatar-row">
          <span class="av a1"></span><span class="av a2 on"></span><span class="av a3"></span><span class="av a4"></span>
        </div>
        <div class="testi-card">
          <div class="stars">★★★★★</div>
          <p class="quote">“Fantastic cleanser! My skin is clean &amp; fresh, ready to absorb the rest of my routine.”</p>
          <cite class="author">Claire Cooper</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PHOTO FEED ==================== -->
  <section class="section section-feed">
    <div class="container">
      <div class="grid-4 feed-grid">
        <div class="feed-card fc1"><span class="feed-handle">@glow.diary</span></div>
        <div class="feed-card fc2"><span class="feed-handle">@linh.skin</span></div>
        <div class="feed-card fc3"><span class="feed-handle">@morning.layers</span></div>
        <div class="feed-card fc4"><span class="feed-handle">@bare.rituals</span></div>
      </div>
    </div>
  </section>

  <!-- ==================== NEWSLETTER ==================== -->
  <section class="section section-newsletter">
    <div class="container narrow">
      <h2 class="nl-title">One email a month</h2>
      <p class="nl-sub">How to use what you bought, what's new in the lab, and nothing else.</p>
