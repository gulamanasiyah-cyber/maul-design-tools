      <h1 class="hero-title">BEAUTY <span class="lime">YOU</span><br/>COLLECTION</h1>
      <a href="#" class="btn btn-dark">VIEW COLLECTION</a>
    </div>
    <div class="hero-dots"><i class="on"></i><i></i><i></i></div>
  </section>

  <!-- ==================== NEW ARRIVALS ==================== -->
  <section class="section section-products">
