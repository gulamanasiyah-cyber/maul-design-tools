<style>
  /* ==================== BASE STYLES ==================== */
  .beyours-store {
    font-family: 'Assistant', system-ui, -apple-system, sans-serif;
    color: #000000;
    background: #FFFFFF;
    line-height: 1.5;
    overflow-x: hidden;
  }

  * { box-sizing: border-box; }

  .container { max-width: 1360px; margin: 0 auto; padding: 0 32px; }
  .center { text-align: center; }
  a { text-decoration: none; color: inherit; }
  .lime { background: #DFFF4F; padding: 0 0.18em; display: inline-block; border-radius: 3px; line-height: 1.05; }

  .section { padding: 64px 0; }
  .section-title {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3vw, 38px);
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }
  .section-title.lg { font-size: clamp(30px, 3.6vw, 46px); }
  .section-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 22px;
  }
  .sub-head { color: #555555; font-size: 16px; }
  .eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; opacity: 0.85; }
  .scribble {
    font-style: italic;
    position: relative;
    white-space: nowrap;
  }
  .scribble::after {
    content: "";
    position: absolute; left: -2%; right: -2%; bottom: 0.02em;
    height: 0.12em; background: #DFFF4F; z-index: -1; transform: rotate(-1deg);
  }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Jost', sans-serif;
    font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 12px 26px; border: 1px solid transparent; cursor: pointer;
    transition: opacity 0.2s;
  }
  .btn:hover { opacity: 0.82; }
  .btn-dark { background: #000000; color: #FFFFFF; }
  .btn-lime { background: #DFFF4F; color: #000000; }
  .btn-outline { border-color: #000000; color: #000000; background: none; }
  .btn-full { width: 100%; }
  .btn-lg { padding: 15px 32px; font-size: 14px; }

  .micro { font-size: 12px; color: #888888; letter-spacing: 0.06em; }

  /* Badges */
  .badge {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; padding: 4px 9px; border-radius: 3px;
  }
  .badge.lime { background: #DFFF4F; color: #000000; }
  .badge.ink { background: #000000; color: #DFFF4F; }
  .badge.white { background: #FFFFFF; color: #000000; border: 1px solid #E5E5E5; }
  .badge.sale { background: #FF2D16; color: #FFFFFF; }

  .cd-chip { font-size: 10px; font-weight: 700; color: #FF2D16; background: #FFF1ED; padding: 3px 7px; border-radius: 3px; white-space: nowrap; }

  /* ==================== ANNOUNCEMENT ==================== */
  .announcement-bar { background: #000000; color: #FFFFFF; }
  .countdown-row {
    display: flex; align-items: center; justify-content: center; gap: 28px;
    padding: 12px 32px; font-size: 13px; flex-wrap: wrap;
  }
  .countdown-row .cd { font-weight: 700; font-family: 'Jost', sans-serif; }
  .countdown-row .cd b { font-style: normal; color: #DFFF4F; }
  .countdown-row .ship-msg { opacity: 0.78; font-weight: 500; }

  /* ==================== HEADER ==================== */
  .main-header { background: #FFFFFF; border-bottom: 1px solid #F0F0F0; position: relative; z-index: 10; }
  .header-container { display: flex; align-items: center; gap: 28px; padding: 16px 32px; }
  .drawer-btn { background: none; border: none; font-size: 22px; line-height: 1; cursor: pointer; }
  .brand-logo { font-family: 'Jost', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: 0.16em; white-space: nowrap; }
  .search-inline {
    flex: 1; display: flex; align-items: center; gap: 8px;
    background: #F5F5F5; border-radius: 12px; padding: 9px 14px; max-width: 300px;
    color: #000; font-size: 14px; opacity: 0.85;
  }
  .header-nav { display: flex; gap: 24px; flex: 1; justify-content: center; }
  .nav-item { font-size: 14px; font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }
  .nav-item.on { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; text-decoration-color: #DFFF4F; }
  .header-right { display: flex; align-items: center; gap: 14px; }
  .icon-btn { background: none; border: none; cursor: pointer; position: relative; padding: 0; }
  .cart-count {
    position: absolute; top: -6px; right: -8px; background: #DFFF4F; color: #000;
    font-size: 10px; font-weight: 700; border-radius: 50%; width: 16px; height: 16px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Hero */
  .hero { position: relative; height: min(78vh, 680px); min-height: 420px; overflow: hidden; }
  .hero-image { position: absolute; inset: 0; display: flex; }
  .hero-swatch.s1 { flex: 3; background: linear-gradient(150deg,#F3E8D8,#DCC39A 55%,#B98E55); }
  .hero-swatch.s2 { flex: 1.6; background: linear-gradient(155deg,#EEDBD2,#CCA79B 60%,#A9786B); filter: brightness(0.96); }
  .hero-swatch.s3 { flex: 2.4; background: linear-gradient(140deg,#F2E6B4,#D3B75A 55%,#A68A2C); filter: brightness(0.94) saturate(1.05); }
  .hero-swatch.s4 { flex: 1.8; background: linear-gradient(150deg,#D8E7ED,#9FBAC8 55%,#6D93A9); filter: brightness(0.9); }
  .hero-copy {
    position: absolute; left: 5%; bottom: 12%; color: #000000; z-index: 2; max-width: 540px;
  }
  .hero-eyebrow { font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 600; opacity: 0.8; }
  .hero-title { font-family: 'Jost', sans-serif; font-weight: 700; font-size: clamp(40px, 5.4vw, 74px); line-height: 1.0; margin: 14px 0 22px; letter-spacing: -0.01em; }
  .hero-dots { position: absolute; right: 5%; bottom: 8%; display: flex; gap: 8px; z-index: 2; }
  .hero-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(0,0,0,0.3); }
  .hero-dots i.on { background: #000000; }

  /* Products */
