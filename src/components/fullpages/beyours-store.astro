        <input class="nl-input" placeholder="Enter email here" />
        <button class="btn btn-dark">SUBSCRIBE →</button>
      </div>
    </div>
  </section>

  <!-- ==================== FOOTER ==================== -->
  <footer class="footer">
    <div class="container footer-grid">
      <div class="f-col">
        <h4 class="f-head">BE&nbsp;YOURS</h4>
        <p class="f-tag">Clean beauty, guided routines, and nothing else.</p>
      </div>
      <div class="f-col"><h4 class="f-head">Shop</h4><a href="#">Bestsellers</a><a href="#">Serums</a><a href="#">Cleaners</a><a href="#">Kits &amp; Sets</a></div>
      <div class="f-col"><h4 class="f-head">Explore</h4><a href="#">Our story</a><a href="#">Journal</a><a href="#">FAQ</a><a href="#">Our stores</a></div>
      <div class="f-col"><h4 class="f-head">More</h4><a href="#">My account</a><a href="#">Contact</a><a href="#">Privacy</a><a href="#">Shipping &amp; Returns</a></div>
