      <div class="section-head">
        <h2 class="section-title">New Arrivals</h2>
        <div class="nav-arrows"><button>←</button><button>→</button></div>
      </div>
      <div class="grid-4">
        <!-- Card 1 -->
        <article class="p-card">
          <div class="p-media pm1">
            <span class="badge lime">Just dropped</span>
          </div>
          <div class="p-body">
            <h3 class="p-name">Glow Drops</h3>
            <div class="p-highlights">
              <span>🌿 Wild Rose + Bistorta · Light liquid · 12 mo</span>
            </div>
            <div class="p-buy">
              <span class="p-price">$34.00</span>
              <button class="add-btn">ADD TO CART +</button>
            </div>
          </div>
        </article>
        <!-- Card 2 -->
        <article class="p-card">
          <div class="p-media pm2">
            <span class="badge ink">Selling fast</span>
            <span class="badge sale">–20%</span>
          </div>
          <div class="p-body">
            <h3 class="p-name">The Vitamin C Serum</h3>
            <div class="p-highlights">
              <span>🌿 Vitamin C 15% · Silky serum · 6 mo</span>
            </div>
            <div class="p-buy">
              <span class="p-price sale-price">$28.00 <s>$34.00</s></span>
              <span class="cd-chip">ENDS 02:14:09</span>
              <button class="add-btn">ADD TO CART +</button>
            </div>
          </div>
        </article>
        <!-- Card 3 -->
        <article class="p-card">
          <div class="p-media pm3">
            <span class="badge white">TikTok fave</span>
          </div>
          <div class="p-body">
            <h3 class="p-name">Calming Serum</h3>
            <div class="p-highlights">
              <span>🌿 Centella + Chamomile · Gel-liquid · 12 mo</span>
            </div>
            <div class="p-buy">
              <span class="p-price">$52.00</span>
              <button class="add-btn">ADD TO CART +</button>
            </div>
          </div>
        </article>
        <!-- Card 4 -->
        <article class="p-card">
          <div class="p-media pm4">
            <span class="badge lime">Just dropped</span>
          </div>
          <div class="p-body">
            <h3 class="p-name">Sun Drops</h3>
            <div class="p-highlights">
              <span>🌿 SPF serum · Dewy finish · 12 mo</span>
            </div>
            <div class="p-buy">
              <span class="p-price">$38.00</span>
              <button class="add-btn">ADD TO CART +</button>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== COLOR FAN ==================== -->
  <section class="section section-fan">
    <div class="container center">
      <h2 class="section-title lg">One formula, <span class="scribble">every tone</span></h2>
      <p class="sub-head">Tested across skin tones</p>
      <div class="fan">
        <span class="fan-card f1">Porcelain</span>
        <span class="fan-card f2">Sand</span>
        <span class="fan-card f3">Amber</span>
        <span class="fan-card f4">Umber</span>
      </div>
    </div>
  </section>

  <!-- ==================== SKIN QUIZ → ROUTINE ==================== -->
  <section class="section section-quiz">
    <div class="container quiz-box">
      <div class="quiz-text">
        <span class="eyebrow">THE FOUR-QUESTION EDIT</span>
        <h2 class="quiz-heading">Which routine is yours?</h2>
        <p class="quiz-sub">Four questions, one screen each, always a way back — and the result comes before we ask for an email.</p>
        <button class="btn btn-lime btn-lg">TAKE THE QUIZ →</button>
      </div>
      <div class="quiz-result">
        <h3 class="qr-title">Your barrier needs rebuilding</h3>
        <p class="qr-sub">Tight, flaky skin usually means the barrier is losing water faster than it can hold it. Three gentle steps, one active, eight weeks.</p>
        <div class="routine-steps">
          <div class="step">
            <div class="step-thumb st1"></div>
            <div class="step-meta"><b>1 · Enzyme Cleanser</b><span>Cleanses without stripping</span></div>
