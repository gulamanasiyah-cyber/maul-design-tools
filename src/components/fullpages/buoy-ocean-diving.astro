---
// Buoy Ocean Diving — Full-page recreation of the scuba diving & underwater expedition reference.
// Features: warm sand cream (#FBF7EC) paired with vibrant ocean azure blue (#2B8BF5),
// playful retro cartoon scuba mascots (diver frog, octopus inside letters), hand-drawn seaweed line art,
// mission photo deck, 3 blue stat cards, shipwreck exploration split, doodle-rich course CTA banner,
// 5-card underwater travels carousel, license accordion, interactive world map, and giant buoy footer.
---

<div class="buoy-page">
  <!-- ==================== HEADER ==================== -->
  <header class="header">
    <div class="header-inner">
      <a href="#" class="brand-logo">
        <span class="logo-text">bu<span class="logo-o">o</span>y</span>
      </a>

      <nav class="nav-menu">
        <a href="#about" class="nav-link">ABOUT</a>
        <a href="#tours" class="nav-link">TOURS</a>
        <a href="#pricing" class="nav-link">PRICING</a>
        <a href="#contact" class="nav-link">CONTACT</a>
        <a href="#faq" class="nav-link">FAQ</a>
      </nav>

      <div class="header-right">
        <span class="lang-tag">EN / RU</span>
        <a href="#contact" class="btn-book">BOOK NOW</a>
      </div>
    </div>
  </header>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section" id="about">
    <div class="hero-content">
      <h1 class="hero-title">
        <span>DIVE BEYON<span class="hero-mascot-wrap">D<svg class="frog-diver" viewBox="0 0 80 80" fill="none"><circle cx="40" cy="35" r="20" fill="#2B8BF5" /><circle cx="34" cy="30" r="7" fill="#FFFFFF" /><circle cx="34" cy="30" r="3" fill="#11161D" /><circle cx="48" cy="30" r="7" fill="#FFFFFF" /><circle cx="48" cy="30" r="3" fill="#11161D" /><path d="M30 42 Q40 50 50 42" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" fill="none" /><ellipse cx="40" cy="18" rx="14" ry="4" fill="#54C5F8" /><rect x="36" y="8" width="8" height="12" rx="4" fill="#FFCC00" /></svg></span></span>
        <span>THE HORIZON</span>
      </h1>
      <p class="hero-subtitle">
        Embark on an unforgettable journey into the depths with professional instructors, modern equipment, and breathtaking dive sites.
      </p>
    </div>

    <!-- Decorative Seaweed Illustration Line Art -->
    <div class="seaweed-band">
      <svg viewBox="0 0 1200 140" fill="none" preserveAspectRatio="none" class="seaweed-svg">
        <path d="M40 140 C50 80, 20 40, 60 10 C80 50, 70 100, 90 140" stroke="#2B8BF5" stroke-width="2.5" />
        <path d="M80 140 C100 90, 130 60, 110 20 C130 70, 150 110, 140 140" stroke="#2B8BF5" stroke-width="2" />
        <circle cx="60" cy="10" r="4" fill="#2B8BF5" />
        <circle cx="110" cy="20" r="3.5" fill="#2B8BF5" />
        <path d="M220 140 Q250 50 210 20 Q240 80 260 140" stroke="#2B8BF5" stroke-width="2" />
        <circle cx="210" cy="20" r="4" fill="#2B8BF5" />
        <!-- Coral & Kelp right -->
        <path d="M960 140 C940 80, 980 40, 950 10 C930 60, 920 100, 910 140" stroke="#2B8BF5" stroke-width="2.5" />
        <circle cx="950" cy="10" r="4" fill="#2B8BF5" />
        <path d="M1040 140 C1070 90, 1030 50, 1080 15 C1090 70, 1110 110, 1100 140" stroke="#2B8BF5" stroke-width="2" />
        <circle cx="1080" cy="15" r="4" fill="#2B8BF5" />
        <path d="M1140 140 Q1170 60 1150 25 Q1180 80 1190 140" stroke="#2B8BF5" stroke-width="2.5" />
      </svg>
    </div>
  </section>

  <!-- ==================== MISSION DEEP BLUE BLOCK ==================== -->
  <section class="mission-section">
    <div class="container">
      <p class="mission-quote">
        BUOY IS NOT JUST A DIVING COMPANY, IT IS YOUR GUIDE TO THE AMAZING UNDERWATER WORLD, WHERE EVERY METER OF DEPTH OPENS UP NEW HORIZONS
      </p>

      <div class="mission-photo-deck">
        <div class="deck-card c1">
          <img src="/assets/buoy/sunbeams.jpg" alt="Diver in crystal sunbeams" />
        </div>
        <div class="deck-card c2">
          <img src="/assets/buoy/abyss.jpg" alt="Deep blue ocean abyss light rays" />
        </div>
        <div class="deck-card c3">
          <img src="/assets/buoy/manta.jpg" alt="Diver with manta ray" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== REPUTATION & STATS ==================== -->
  <section class="reputation-section">
    <div class="container">
      <div class="rep-header">
        <h2 class="rep-title">
          OUR REPUTATION IS BUILT ON PROFESSIONALISM, ATTENTION TO DETAIL AND SINCERE LOVE FOR THE OCEAN
        </h2>
        <p class="rep-sub">
          We pride ourselves on offering world-class certified scuba education, small group guided diving, and unmatched safety standards across all our marine locations.
        </p>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-number">45+</span>
          <span class="stat-desc">dive sites</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">12</span>
          <span class="stat-desc">years experience</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">8</span>
          <span class="stat-desc">certified instructors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SUNKEN SHIPS & TOURS ==================== -->
  <section class="tours-section" id="tours">
    <div class="container">
      <div class="tours-header">
        <h2 class="tours-title">
          WE CONDUCT FASCINATING DIVING TOURS TO THE MOST PICTURESQUE CORNERS OF THE PLANET — FROM CORAL REEFS TO SUNKEN SHIPS
        </h2>
        <a href="#tours" class="btn-tours-pill">VIEW ALL TOURS</a>
      </div>

      <div class="tours-gallery">
        <div class="tour-img-wrap t-left">
          <img src="/assets/buoy/cave.jpg" alt="Diver exploring underwater cavern" />
        </div>
        <div class="tour-img-wrap t-center">
          <img src="/assets/buoy/ship-detail.jpg" alt="Sunken shipwreck interior" />
        </div>
        <div class="tour-img-wrap t-right">
          <img src="/assets/buoy/shipwreck.jpg" alt="Massive coral covered sunken shipwreck" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== COURSE CTA DOODLE BANNER ==================== -->
  <section class="course-banner-section" id="pricing">
    <div class="doodle-overlay">
      <svg viewBox="0 0 1000 300" fill="none" class="doodle-svg">
        <!-- White decorative sea line art -->
        <path d="M50 80 Q70 40 90 80 T130 80" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
        <path d="M120 220 C140 180 180 180 200 220" stroke="rgba(255,255,255,0.3)" stroke-width="2" />
        <circle cx="80" cy="180" r="8" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" />
        <circle cx="95" cy="165" r="4" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" />
        <!-- Starfish right -->
        <polygon points="900,60 908,80 930,82 912,96 918,118 900,104 882,118 888,96 870,82 892,80" stroke="rgba(255,255,255,0.4)" stroke-width="2" fill="none" />
        <path d="M840 220 Q870 160 900 220" stroke="rgba(255,255,255,0.3)" stroke-width="2" />
      </svg>
    </div>

    <div class="container course-content">
      <h2 class="course-title">NOT ENOUGH LEVEL TO DIVE? SIGN UP FOR OUR COURSE!</h2>
      <p class="course-sub">
        Begin your scuba adventure with our internationally recognized SSI and PADI certification courses, guided by expert master divers.
      </p>
      <a href="#contact" class="btn-course-white">SIGN UP FOR A COURSE</a>
    </div>
  </section>

  <!-- ==================== SEE OUR TRAVELS ==================== -->
  <section class="travels-section">
    <div class="container">
      <div class="travels-head">
        <h3 class="travels-title">SEE OUR TRAVELS</h3>
        <div class="carousel-nav">
          <button class="c-btn" aria-label="Prev">←</button>
          <button class="c-btn active" aria-label="Next">→</button>
        </div>
      </div>

      <div class="travels-grid">
        <div class="travel-card">
          <img src="/assets/buoy/cave.jpg" alt="Cavern diving" />
        </div>
        <div class="travel-card">
          <img src="/assets/buoy/statue.jpg" alt="Underwater museum sculptures" />
        </div>
        <div class="travel-card">
          <img src="/assets/buoy/manta.jpg" alt="Manta ray encounter" />
        </div>
        <div class="travel-card">
          <img src="/assets/buoy/shark.jpg" alt="Pelagic shark diving" />
        </div>
        <div class="travel-card">
          <img src="/assets/buoy/dolphin.jpg" alt="Dolphin interaction" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LICENSES ACCORDION ==================== -->
  <section class="licenses-section">
    <div class="container">
      <div class="accordion-list">
        <div class="acc-row">
          <span class="acc-label">CERTIFICATES OF INTERNATIONAL ASSOCIATIONS</span>
          <span class="acc-arrow">▲</span>
        </div>
        <div class="acc-row">
          <span class="acc-label">DOCUMENTS FOR INSTRUCTORS</span>
          <span class="acc-arrow">▲</span>
        </div>
        <div class="acc-row active-blue">
          <div class="acc-ssi-badge">SSI</div>
          <span class="acc-label text-white">LICENSE TO CONDUCT EDUCATIONAL ACTIVITIES</span>
          <span class="acc-check">✓</span>
        </div>
        <div class="acc-row">
          <span class="acc-label">CERTIFICATES FOR EQUIPMENT</span>
          <span class="acc-arrow">▲</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FIND US ALL OVER THE WORLD ==================== -->
  <section class="world-section" id="faq">
    <div class="container">
      <h3 class="world-title">FIND US ALL OVER THE WORLD</h3>
      <div class="country-tabs">
        <span class="c-tab active">Australia</span>
        <span class="c-tab">Egypt</span>
        <span class="c-tab">Maldives</span>
        <span class="c-tab">Indonesia</span>
        <span class="c-tab">Mexico</span>
        <span class="c-tab">Thailand</span>
      </div>

      <div class="world-map-wrap">
        <!-- Floating Info Card -->
        <div class="map-floating-card">
          <div class="flag-row">
            <span class="flag-icon">🇦🇺</span>
            <span class="flag-country">Australia</span>
          </div>
          <p class="map-addr">12 Ocean View Drive, Cairns QLD 4870, Australia</p>
          <span class="map-phone">+61 4 0025 3890</span>
        </div>

        <!-- Minimalist Dotted Vector World Map -->
        <svg viewBox="0 0 900 420" fill="none" class="world-svg">
          <!-- Continents abstract shapes -->
          <path d="M120 80 Q180 60 220 100 T190 180 T130 140 Z" fill="#EAE5D8" />
          <path d="M180 200 Q220 220 230 280 T190 340 T160 250 Z" fill="#EAE5D8" />
          <path d="M420 70 Q520 60 580 110 T520 180 T420 120 Z" fill="#EAE5D8" />
          <path d="M440 180 Q490 200 500 270 T450 330 T420 230 Z" fill="#EAE5D8" />
          <path d="M600 90 Q720 70 780 130 T740 220 T610 160 Z" fill="#EAE5D8" />
          <!-- Highlighted Australia in Azure Blue -->
          <path d="M680 270 Q750 250 780 290 Q770 340 730 350 Q670 330 680 270 Z" fill="#2B8BF5" />
          <!-- Pin -->
          <circle cx="730" cy="300" r="5" fill="#FFFFFF" />
          <circle cx="730" cy="300" r="10" stroke="#FFFFFF" stroke-width="2" opacity="0.6" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ==================== CONTACT US WITH OCTOPUS MASCOT ==================== -->
  <section class="contact-section" id="contact">
    <div class="container">
      <div class="contact-center">
        <h2 class="contact-giant-title">
          C<span class="octopus-letter"><svg class="octopus-mascot" viewBox="0 0 100 100"><circle cx="50" cy="50" r="34" fill="#2B8BF5" /><circle cx="40" cy="45" r="6" fill="#FFFFFF" /><circle cx="40" cy="45" r="3" fill="#11161D" /><circle cx="60" cy="45" r="6" fill="#FFFFFF" /><circle cx="60" cy="45" r="3" fill="#11161D" /><path d="M42 62 Q50 70 58 62" stroke="#FFFFFF" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M25 78 Q20 90 35 90 T45 80" fill="none" stroke="#2B8BF5" stroke-width="5" stroke-linecap="round" /><path d="M75 78 Q80 90 65 90 T55 80" fill="none" stroke="#2B8BF5" stroke-width="5" stroke-linecap="round" /></svg></span>NTACT US
        </h2>

        <p class="contact-sub">Any questions? We will be glad to answer them!</p>

        <form class="contact-form" onsubmit="event.preventDefault()">
          <input type="text" placeholder="Your Name" class="c-input" required />
          <input type="email" placeholder="E-mail" class="c-input" required />
          <textarea placeholder="Your Message" class="c-input c-area" rows="3" required></textarea>
          <button type="submit" class="btn-send">SEND</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ==================== GIANT BUOY FOOTER ==================== -->
  <footer class="footer">
    <div class="container">
      <div class="footer-links-row">
        <div class="f-col">
          <h5 class="f-title">TOURS</h5>
          <ul>
            <li><a href="#">Wreck Diving</a></li>
            <li><a href="#">Reef Safari</a></li>
            <li><a href="#">Night Diving</a></li>
          </ul>
        </div>
        <div class="f-col">
          <h5 class="f-title">CERTIFICATIONS</h5>
          <ul>
            <li><a href="#">SSI Open Water</a></li>
            <li><a href="#">Advanced Adventurer</a></li>
            <li><a href="#">Nitrox Specialty</a></li>
          </ul>
        </div>
        <div class="f-col">
          <h5 class="f-title">CONTACTS</h5>
          <ul>
            <li><a href="#">info@buoydive.com</a></li>
            <li><a href="#">+61 4 0025 3890</a></li>
            <li><a href="#">Cairns, Australia</a></li>
          </ul>
        </div>
        <div class="f-col">
          <h5 class="f-title">NAVIGATION</h5>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#tours">Tours</a></li>
            <li><a href="#pricing">Pricing</a></li>
          </ul>
        </div>
      </div>

      <!-- Giant Wordmark Bleed -->
      <div class="footer-giant-wordmark">
        <span>buoy</span>
      </div>
    </div>
  </footer>
</div>

<style>
  /* ==================== GLOBAL BASE ==================== */
  .buoy-page {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: #11161D;
    background: #FBF7EC;
    line-height: 1.45;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ==================== HEADER ==================== */
  .header {
    background: #FBF7EC;
    padding: 20px 0;
    border-bottom: 1px solid rgba(43, 139, 245, 0.15);
  }

  .header-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo .logo-text {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #11161D;
  }

  .nav-menu {
    display: flex;
    gap: 28px;
  }

  .nav-link {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #11161D;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #2B8BF5;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lang-tag {
    font-size: 11px;
    font-weight: 800;
    color: #7A828B;
  }

  .btn-book {
    background: #54C5F8;
    color: #11161D;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 8px 18px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn-book:hover {
    background: #38A4F8;
    transform: translateY(-1px);
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    padding: 80px 24px 60px;
    text-align: center;
    background: #FBF7EC;
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 950;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #11161D;
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  .hero-title span {
    display: block;
  }

  .hero-mascot-wrap {
    position: relative;
    display: inline-block;
  }

  .frog-diver {
    position: absolute;
    top: -38px;
    right: -24px;
    width: 64px;
    height: 64px;
  }

  .hero-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: #5A626A;
    max-width: 580px;
    margin: 0 auto;
  }

  .seaweed-band {
    width: 100%;
    margin-top: 40px;
    line-height: 0;
  }

  .seaweed-svg {
    width: 100%;
    height: 90px;
  }

  /* ==================== MISSION SECTION ==================== */
  .mission-section {
    background: #2B8BF5;
    color: #FFFFFF;
    padding: 88px 0 96px;
    text-align: center;
  }

  .mission-quote {
    font-size: clamp(20px, 2.8vw, 36px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-width: 880px;
    margin: 0 auto 56px;
    text-transform: uppercase;
  }

  .mission-photo-deck {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .deck-card {
    width: 240px;
    height: 280px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0,0,0,0.2);
    border: 3px solid rgba(255, 255, 255, 0.4);
  }

  .deck-card.c2 {
    transform: translateY(-16px);
  }

  .deck-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ==================== REPUTATION & STATS ==================== */
  .reputation-section {
    background: #FBF7EC;
    padding: 88px 0;
  }

  .rep-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 48px;
  }

  .rep-title {
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #11161D;
    margin: 0 0 16px;
  }

  .rep-sub {
    font-size: 14px;
    line-height: 1.6;
    color: #6A727A;
    margin: 0;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 820px;
    margin: 0 auto;
  }

  .stat-box {
    background: #2B8BF5;
    color: #FFFFFF;
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(43, 139, 245, 0.25);
  }

  .stat-number {
    font-size: 48px;
    font-weight: 950;
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-desc {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ==================== TOURS ==================== */
  .tours-section {
    background: #FBF7EC;
    padding: 40px 0 88px;
  }

  .tours-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 48px;
  }

  .tours-title {
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #11161D;
    margin: 0 0 24px;
  }

  .btn-tours-pill {
    display: inline-block;
    background: #54C5F8;
    color: #11161D;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 10px 24px;
    border-radius: 999px;
    text-decoration: none;
  }

  .tours-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr 1.6fr;
    gap: 20px;
  }

  .tour-img-wrap {
    height: 320px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .tour-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ==================== COURSE CTA BANNER ==================== */
  .course-banner-section {
    position: relative;
    background: #2B8BF5;
    color: #FFFFFF;
    padding: 96px 24px;
    text-align: center;
    overflow: hidden;
  }

  .doodle-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .doodle-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .course-content {
    position: relative;
    z-index: 5;
    max-width: 680px;
  }

  .course-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 950;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }

  .course-sub {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 auto 32px;
  }

  .btn-course-white {
    display: inline-block;
    background: #FFFFFF;
    color: #2B8BF5;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 12px 28px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* ==================== SEE OUR TRAVELS ==================== */
  .travels-section {
    background: #FBF7EC;
    padding: 80px 0;
  }

  .travels-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .travels-title {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #11161D;
    margin: 0;
  }

  .carousel-nav {
    display: flex;
