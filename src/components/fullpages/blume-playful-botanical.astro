---
// Blume Playful Botanical — Full-page recreation of the cheerful D2C seed kit brand.
// Features: lush dandelion meadow hero with giant lowercase blume* wordmark,
// 3-pill floating nav, ticker ribbon, 4 illustrated smiley seed pouches with stepper add buttons,
// organic scalloped cloud manifesto on grass texture, and blume box variety kit flatlay.
---

<div class="blume-page">
  <!-- ==================== HERO ==================== -->
  <section class="hero-section">
    <div class="hero-bg-wrap">
      <img src="/assets/blume/meadow.jpg" alt="Lush green meadow with wildflowers and dandelions" class="hero-bg" />
      <div class="hero-overlay"></div>
    </div>

    <!-- 3 Floating Pills Nav -->
    <header class="hero-nav">
      <a href="#home" class="nav-pill pill-dark">home</a>
      <a href="#shop" class="nav-pill pill-light active">shop</a>
      <a href="#learn" class="nav-pill pill-dark">learn</a>
    </header>

    <!-- Giant Brand Display -->
    <div class="hero-brand">
      <h1 class="brand-title">blume<span class="asterisk">*</span></h1>
      <p class="brand-subtitle">gardens for everyone</p>
    </div>
  </section>

  <!-- ==================== MARQUEE RIBBON ==================== -->
  <div class="ticker-bar">
    <div class="ticker-track">
      <span>no yard doesn't have to mean no garden! let your flowers blume*</span>
      <span>no yard doesn't have to mean no garden! let your flowers blume*</span>
    </div>
  </div>

  <!-- ==================== PRODUCT SEED KITS ==================== -->
  <section class="section product-section" id="shop">
    <div class="container">
      <div class="product-grid">
        <!-- Pouch 1: Mood Boost -->
        <div class="product-col">
          <div class="pouch-card">
            <div class="pouch-header">
              <span class="pouch-seed-kit">seed<br />kit</span>
              <span class="pouch-brand">blume*</span>
            </div>
            <h3 class="pouch-name">mood<br />boost</h3>
            <div class="pouch-illustration">
              <svg class="smiley-flower" viewBox="0 0 100 100">
                <!-- 5 lime petals -->
                <circle cx="50" cy="22" r="16" fill="#A3E635" />
                <circle cx="76" cy="40" r="16" fill="#84CC16" />
                <circle cx="66" cy="74" r="16" fill="#65A30D" />
                <circle cx="34" cy="74" r="16" fill="#65A30D" />
                <circle cx="24" cy="40" r="16" fill="#84CC16" />
                <!-- White center smiley -->
                <circle cx="50" cy="50" r="16" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
                <circle cx="44" cy="46" r="2" fill="#18181B" />
                <circle cx="56" cy="46" r="2" fill="#18181B" />
                <path d="M42 54 Q50 62 58 54" stroke="#18181B" stroke-width="2" fill="none" stroke-linecap="round" />
              </svg>
            </div>
            <div class="pouch-botanicals">
              <span>rosemary</span>
              <span>jasmine</span>
              <span>peony</span>
            </div>
          </div>
          <div class="pouch-actions">
            <button class="btn-weight">
              <span class="arrow-down">↓</span> 50g $10
            </button>
            <div class="btn-stepper">
              <span class="step-btn">-</span>
              <span class="step-val">1</span>
              <span class="step-btn">+</span>
              <span class="step-sep">|</span>
              <span class="step-add">add</span>
            </div>
          </div>
        </div>

        <!-- Pouch 2: Good Cookin' -->
        <div class="product-col">
          <div class="pouch-card">
            <div class="pouch-header">
              <span class="pouch-seed-kit">seed<br />kit</span>
              <span class="pouch-brand">blume*</span>
            </div>
            <h3 class="pouch-name">good<br />cookin'</h3>
            <div class="pouch-illustration">
              <svg class="smiley-flower" viewBox="0 0 100 100">
                <!-- 4 green herb leaves -->
                <circle cx="50" cy="24" r="17" fill="#22C55E" />
                <circle cx="74" cy="50" r="17" fill="#16A34A" />
                <circle cx="50" cy="76" r="17" fill="#15803D" />
                <circle cx="26" cy="50" r="17" fill="#16A34A" />
                <!-- White center smiley -->
                <circle cx="50" cy="50" r="16" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
                <circle cx="44" cy="46" r="2" fill="#18181B" />
                <circle cx="56" cy="46" r="2" fill="#18181B" />
                <path d="M42 54 Q50 62 58 54" stroke="#18181B" stroke-width="2" fill="none" stroke-linecap="round" />
              </svg>
            </div>
            <div class="pouch-botanicals">
              <span>rosemary</span>
              <span>thyme</span>
              <span>cilantro</span>
              <span>oregano</span>
            </div>
          </div>
          <div class="pouch-actions">
            <button class="btn-weight">
              <span class="arrow-down">↓</span> 50g $10
            </button>
            <div class="btn-stepper">
              <span class="step-btn">-</span>
              <span class="step-val">1</span>
              <span class="step-btn">+</span>
              <span class="step-sep">|</span>
              <span class="step-add">add</span>
            </div>
          </div>
        </div>

        <!-- Pouch 3: Clean Air -->
        <div class="product-col">
          <div class="pouch-card">
            <div class="pouch-header">
              <span class="pouch-seed-kit">seed<br />kit</span>
              <span class="pouch-brand">blume*</span>
            </div>
            <h3 class="pouch-name">clean<br />air</h3>
            <div class="pouch-illustration">
              <svg class="smiley-flower" viewBox="0 0 100 100">
                <!-- Multi-petal daisy -->
                <g fill="#A1A1AA">
                  <ellipse cx="50" cy="18" rx="7" ry="15" />
                  <ellipse cx="72" cy="28" rx="7" ry="15" transform="rotate(45 72 28)" />
                  <ellipse cx="82" cy="50" rx="7" ry="15" transform="rotate(90 82 50)" />
                  <ellipse cx="72" cy="72" rx="7" ry="15" transform="rotate(135 72 72)" />
                  <ellipse cx="50" cy="82" rx="7" ry="15" />
                  <ellipse cx="28" cy="72" rx="7" ry="15" transform="rotate(225 28 72)" />
                  <ellipse cx="18" cy="50" rx="7" ry="15" transform="rotate(270 18 50)" />
                  <ellipse cx="28" cy="28" rx="7" ry="15" transform="rotate(315 28 28)" />
                </g>
                <!-- Center smiley -->
                <circle cx="50" cy="50" r="16" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
                <circle cx="44" cy="46" r="2" fill="#18181B" />
                <circle cx="56" cy="46" r="2" fill="#18181B" />
                <path d="M42 54 Q50 62 58 54" stroke="#18181B" stroke-width="2" fill="none" stroke-linecap="round" />
              </svg>
            </div>
            <div class="pouch-botanicals">
              <span>lavender</span>
              <span>daisy</span>
              <span>chamomile</span>
            </div>
          </div>
          <div class="pouch-actions">
            <button class="btn-weight">
              <span class="arrow-down">↓</span> 50g $10
            </button>
            <div class="btn-stepper">
              <span class="step-btn">-</span>
              <span class="step-val">1</span>
              <span class="step-btn">+</span>
              <span class="step-sep">|</span>
              <span class="step-add">add</span>
            </div>
          </div>
        </div>

        <!-- Pouch 4: Just For Fun -->
        <div class="product-col">
          <div class="pouch-card">
            <div class="pouch-header">
              <span class="pouch-seed-kit">seed<br />kit</span>
              <span class="pouch-brand">blume*</span>
            </div>
            <h3 class="pouch-name">just for<br />fun</h3>
            <div class="pouch-illustration">
              <svg class="smiley-flower" viewBox="0 0 100 100">
                <!-- Colorful petals -->
                <circle cx="50" cy="22" r="16" fill="#F43F5E" />
                <circle cx="76" cy="40" r="16" fill="#FBBF24" />
                <circle cx="66" cy="74" r="16" fill="#38BDF8" />
                <circle cx="34" cy="74" r="16" fill="#34D399" />
                <circle cx="24" cy="40" r="16" fill="#A855F7" />
                <!-- Center grinning smiley -->
                <circle cx="50" cy="50" r="16" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
                <circle cx="44" cy="46" r="2" fill="#18181B" />
                <circle cx="56" cy="46" r="2" fill="#18181B" />
                <path d="M40 52 Q50 64 60 52 Z" fill="#18181B" />
                <path d="M42 54 Q50 60 58 54" stroke="#FFFFFF" stroke-width="1.5" fill="none" />
              </svg>
            </div>
            <div class="pouch-botanicals">
              <span>sunflower</span>
              <span>marigold</span>
              <span>zinnia</span>
            </div>
          </div>
          <div class="pouch-actions">
            <button class="btn-weight">
              <span class="arrow-down">↓</span> 50g $10
            </button>
            <div class="btn-stepper">
              <span class="step-btn">-</span>
              <span class="step-val">1</span>
              <span class="step-btn">+</span>
              <span class="step-sep">|</span>
              <span class="step-add">add</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CLOUD QUOTE ON GRASS ==================== -->
  <section class="cloud-quote-section" id="learn">
    <div class="grass-bg-wrap">
      <img src="/assets/blume/grass.jpg" alt="Lush green grass background" class="grass-bg" />
      <div class="grass-overlay"></div>
    </div>

    <div class="container cloud-container">
      <div class="cloud-speech-bubble">
        <p class="cloud-text">
          Greenery in your home is more than just decoration; it's a breath of life within your living space. It's a connection to the natural world, a source of tranquility, and a reminder of the beauty and simplicity that nature offers.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== BLUME BOX VARIETY KIT ==================== -->
  <section class="section box-section">
    <div class="container">
      <div class="box-grid">
        <!-- Left: Flatlay Graphic / Mockup -->
        <div class="box-visual">
          <div class="flatlay-wrap">
            <!-- Pouch fan -->
            <div class="fan-pouch p1"><span class="fp-title">good<br />cookin'</span></div>
            <div class="fan-pouch p2"><span class="fp-title">mood<br />boost</span></div>
            <div class="fan-pouch p3"><span class="fp-title">just for<br />fun</span></div>
            <div class="fan-pouch p4"><span class="fp-title">clean<br />air</span></div>
            <div class="fan-pouch p5"><span class="fp-title">aroma<br />therapy</span></div>

            <!-- Box Container -->
            <div class="blume-packaging-box">
              <div class="box-lid">
                <span class="box-brand">blume<br />box</span>
                <span class="box-sub">variety pack</span>
                <div class="box-mascot">
                  <svg viewBox="0 0 60 60" width="48" height="48">
                    <circle cx="30" cy="30" r="18" fill="#18181B" />
                    <circle cx="24" cy="26" r="2.5" fill="#FFFFFF" />
                    <circle cx="36" cy="26" r="2.5" fill="#FFFFFF" />
                    <path d="M24 34 Q30 40 36 34" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round" />
                    <ellipse cx="30" cy="8" rx="6" ry="4" fill="#18181B" />
                  </svg>
                </div>
              </div>
              <div class="box-tray">
                <div class="tray-sachet s1">plant food</div>
                <div class="tray-sachet s2">plant food</div>
              </div>
            </div>

            <!-- Foldout Guide -->
            <div class="foldout-guide">
              <div class="guide-header">what is it?</div>
              <p class="guide-desc">easy steps to grow your very own countertop garden.</p>
              <div class="guide-steps">
                <span>1. plant</span> → <span>2. water</span> → <span>3. blume*</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Giant Typography -->
        <div class="box-content">
          <h2 class="box-giant-title">
            <span>blume<span class="asterisk">*</span></span>
            <span>box</span>
          </h2>
          <p class="box-tagline">try them all!</p>
          <div class="box-cta-wrap">
            <button class="btn-box-order">order variety pack $35</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* ==================== BASE STYLES ==================== */
  .blume-page {
    font-family: 'Plus Jakarta Sans', -apple-system, system-ui, sans-serif;
    color: #18181B;
    background: #FAF8F5;
    line-height: 1.5;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: 72px 0;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 32px 24px 80px;
    overflow: hidden;
    text-align: center;
  }

  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #3B7E3E;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  /* 3 Nav Pills */
  .hero-nav {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 900px;
  }

  .nav-pill {
    padding: 8px 26px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-pill:hover {
    transform: scale(1.05);
  }

  .pill-dark {
    background: #18181B;
    color: #FFFFFF;
  }

  .pill-light {
    background: #FFFFFF;
    color: #18181B;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }

  /* Giant Brand Title */
  .hero-brand {
    position: relative;
    z-index: 10;
    margin: auto 0;
  }

  .brand-title {
    font-size: clamp(80px, 16vw, 210px);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin: 0 0 12px;
    text-shadow: 0 4px 30px rgba(0,0,0,0.25);
  }

  .asterisk {
    display: inline-block;
    vertical-align: super;
    font-size: 0.6em;
    margin-left: 2px;
  }

  .brand-subtitle {
    font-size: clamp(18px, 2.8vw, 36px);
    font-weight: 400;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    margin: 0;
    text-shadow: 0 2px 14px rgba(0,0,0,0.3);
  }

  /* ==================== TICKER RIBBON ==================== */
  .ticker-bar {
    background: #FFFFFF;
    border-top: 1px solid #E4E4E7;
    border-bottom: 1px solid #E4E4E7;
    padding: 12px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .ticker-track {
    display: flex;
    gap: 48px;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #27272A;
  }

  /* ==================== PRODUCT SEED KITS ==================== */
  .product-section {
    background: #FAF8F5;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* Seed Pouch Card */
  .pouch-card {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1 / 1.35;
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E4E4E7;
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    position: relative;
  }

  .pouch-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .pouch-seed-kit {
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    text-align: left;
    text-transform: uppercase;
    color: #71717A;
  }

  .pouch-brand {
    font-size: 10px;
    font-weight: 800;
    color: #18181B;
  }

  .pouch-name {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #18181B;
    margin: 0;
  }

  .pouch-illustration {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 6px 0;
  }

  .smiley-flower {
    width: 76px;
    height: 76px;
  }

  .pouch-botanicals {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 9px;
    color: #71717A;
    font-weight: 500;
  }

  /* Pouch Action Buttons */
  .pouch-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 180px;
  }

  .btn-weight {
    background: #FFFFFF;
    border: 1px solid #18181B;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 700;
    color: #18181B;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
  }

  .arrow-down {
    font-size: 12px;
  }

  .btn-stepper {
    background: #18181B;
    color: #FFFFFF;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
  }

  .step-btn {
    opacity: 0.8;
    padding: 0 4px;
  }

  .step-val {
    font-size: 11px;
  }

  .step-sep {
    opacity: 0.3;
  }

  .step-add {
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* ==================== CLOUD QUOTE ==================== */
  .cloud-quote-section {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 24px;
    overflow: hidden;
  }

  .grass-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #2E7233;
  }

  .grass-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grass-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }

  .cloud-container {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
  }

  /* Organic Scalloped Cloud Shape */
  .cloud-speech-bubble {
    background: #FFFFFF;
    padding: 56px 64px;
    max-width: 820px;
    border-radius: 90px 90px 80px 80px / 70px 70px 60px 60px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.18);
    position: relative;
  }

  .cloud-speech-bubble::before {
    content: '';
    position: absolute;
    inset: -12px -16px;
    background: #FFFFFF;
    border-radius: 50% 50% 45% 45%;
    z-index: -1;
    filter: blur(1px);
  }

  .cloud-text {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.65;
    color: #18181B;
    font-weight: 500;
    margin: 0;
    text-align: left;
  }

  /* ==================== BLUME BOX VARIETY KIT ==================== */
  .box-section {
    background: #FAF8F5;
    padding: 96px 0;
  }

  .box-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
  }

  /* Flatlay Mockup */
  .flatlay-wrap {
    position: relative;
    min-height: 380px;
    background: #F4F1EA;
    border-radius: 24px;
    padding: 40px;
    overflow: hidden;
    border: 1px solid #E5E0D5;
  }

  .fan-pouch {
    position: absolute;
    width: 90px;
    height: 120px;
    background: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 8px;
    padding: 10px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  }

  .fp-title {
    font-size: 11px;
    font-weight: 800;
    line-height: 1.1;
    color: #18181B;
  }

  .fan-pouch.p1 { top: 40px; left: 30px; transform: rotate(-22deg); }
  .fan-pouch.p2 { top: 30px; left: 110px; transform: rotate(-8deg); z-index: 2; }
  .fan-pouch.p3 { top: 30px; left: 190px; transform: rotate(10deg); z-index: 1; }
  .fan-pouch.p4 { top: 120px; left: 100px; transform: rotate(18deg); z-index: 3; }
  .fan-pouch.p5 { top: 100px; left: 180px; transform: rotate(-12deg); z-index: 2; }

  .blume-packaging-box {
    position: absolute;
    left: 40px;
    bottom: 30px;
    width: 220px;
    background: #FFFFFF;
    border: 2px solid #18181B;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    z-index: 4;
  }

  .box-lid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .box-brand {
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
  }

  .box-sub {
    font-size: 10px;
    color: #71717A;
  }

  .box-mascot {
    margin-top: 8px;
    display: flex;
    justify-content: flex-end;
  }

  .box-tray {
    margin-top: 10px;
    display: flex;
    gap: 6px;
  }

  .tray-sachet {
    background: #84CC16;
    color: #FFFFFF;
    font-size: 8px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .foldout-guide {
    position: absolute;
    right: 30px;
    bottom: 40px;
    width: 190px;
