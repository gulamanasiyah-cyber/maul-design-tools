<style>
  /* ==================== GLOBAL BASE ==================== */
  .balky-page {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: #111111;
    background: #EFECE6;
    line-height: 1.45;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .kicker-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 28px;
  }

  .kicker-tag.text-light {
    color: #888888;
  }

  /* ==================== HEADER ==================== */
  .header {
    background: #0A0A0A;
    color: #FFFFFF;
    padding: 20px 0;
    border-bottom: 1px solid #1C1C1C;
  }

  .header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #FF5500;
  }

  .logo-sub {
    font-size: 10px;
    color: #888888;
    letter-spacing: 0.04em;
  }

  .nav-pill-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    background: #181818;
    border: 1px solid #282828;
    border-radius: 999px;
    padding: 6px 8px 6px 20px;
  }

  .nav-item {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #CCCCCC;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: #FFFFFF;
  }

  .btn-touch {
    background: #FFFFFF;
    color: #0A0A0A;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 8px 16px;
    border-radius: 999px;
    text-decoration: none;
  }

  .header-right {
    text-align: right;
  }

  .time-tag {
    font-size: 10px;
    color: #888888;
    line-height: 1.3;
  }

  .time-tag strong {
    color: #FFFFFF;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    background: #0A0A0A;
    color: #FFFFFF;
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 64px 32px 36px;
    overflow: hidden;
  }

  .glitch-matrix {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, rgba(255, 85, 0, 0.18) 0%, rgba(0, 200, 100, 0.08) 35%, transparent 70%);
    pointer-events: none;
  }

  .matrix-pixels {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .hero-center {
    position: relative;
    z-index: 5;
    text-align: center;
    margin: auto 0;
  }

  .hero-giant-title {
    font-size: clamp(84px, 16vw, 220px);
    font-weight: 950;
    letter-spacing: -0.04em;
    line-height: 0.88;
    color: #FFFFFF;
    margin: 0 0 16px;
    text-shadow:
      -2px 0 rgba(255, 85, 0, 0.7),
      2px 0 rgba(0, 220, 130, 0.7);
  }

  .reg-mark {
    font-size: 0.35em;
    vertical-align: super;
  }

  .hero-subtitle {
    font-size: clamp(16px, 2.2vw, 26px);
    font-weight: 600;
    color: #CCCCCC;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .hero-meta-bar {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr;
    gap: 24px;
    border-top: 1px solid #1C1C1C;
    padding-top: 24px;
    font-size: 11px;
    color: #888888;
    line-height: 1.4;
  }

  .barcode-lines {
    font-family: monospace;
    letter-spacing: -1px;
    color: #FFFFFF;
    display: block;
    margin-bottom: 2px;
  }

  .barcode-text {
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .meta-right {
    text-align: right;
  }

  .copy-tag {
    display: block;
    color: #666666;
    margin-top: 4px;
  }

  /* ==================== WHY WE EXIST (ORANGE BLOCK) ==================== */
  .why-exist-section {
    background: #FF5500;
    color: #111111;
    padding: 96px 0;
  }

  .why-headline {
    font-size: clamp(32px, 4.4vw, 58px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 64px;
    max-width: 1020px;
  }

  .why-bottom-grid {
    display: grid;
