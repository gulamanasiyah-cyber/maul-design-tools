---
// Solara Clean Energy — Full-page recreation of the solar & renewable energy reference landing page.
// Features: giant sky-integrated "Solara" wordmark hero with wind turbine overlap,
// earth-toned stats bar, 3-card why-solara grid with blue hero card,
// arch-portal solutions section, expandable project case study with metrics table,
// branded pastel customer testimonials, FAQ split layout, golden hour CTA banner,
// and deep navy footer with giant bottom typography bleed.
---

<div class="solara-page">
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="hero-bg-wrap">
      <img src="/assets/solara/hero-wind.jpg" alt="Vast blue sky with clouds over rolling green hills and wind turbine" class="hero-bg-img" />
      <div class="hero-sky-gradient"></div>
    </div>

    <header class="hero-header">
      <nav class="hero-nav">
        <a href="#solutions">SOLUTIONS</a>
        <a href="#projects">PROJECTS</a>
        <a href="#financing">FINANCING</a>
        <a href="#about">ABOUT</a>
        <a href="#resources">RESOURCES</a>
      </nav>
      <a href="#contact" class="btn-quote">GET A SOLAR QUOTE</a>
    </header>

    <div class="hero-brand-wrap">
      <h1 class="hero-giant-wordmark">Solara</h1>
    </div>

    <!-- Earth tone bottom hero bar -->
    <div class="hero-bottom-bar">
      <div class="hero-bar-col hero-bar-headline">
        Power your home with the sun not rising utility bills
      </div>
      <div class="hero-bar-col hero-bar-desc">
        Premium solar systems designed to lower energy costs, increase property value, and provide decades of reliable clean power.
      </div>
      <div class="hero-bar-col hero-bar-stats">
        <div class="stat-item">
          <span class="stat-num">25 Y</span>
          <span class="stat-lbl">performance warranty</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">48 K</span>
          <span class="stat-lbl">systems installed</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">30 D</span>
          <span class="stat-lbl">installed days</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHY SOLARA ==================== -->
  <section class="section why-section" id="about">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow-tag">/ WHY SOLARA</span>
        <h2 class="why-headline">
          <span class="text-dark">A better solar experience from consultation to installation.</span>
          <span class="text-muted"> We build energy systems that maximize savings, resilience, and long-term performance.</span>
        </h2>
      </div>

      <div class="why-grid">
        <!-- Card 1: Lower monthly energy costs -->
        <div class="why-card">
          <div class="why-card-img-wrap">
            <img src="/assets/solara/wind-turbine.jpg" alt="Wind turbine on rolling hill" />
          </div>
          <div class="why-card-content">
            <h3 class="why-card-title">Lower monthly energy costs</h3>
            <p class="why-card-desc">
              Most customers reduce electricity bills by 55–85%, with many reaching near-net-zero energy usage.
            </p>
          </div>
        </div>

        <!-- Card 2: End-to-end (Blue Hero Card) -->
        <div class="why-card why-card-blue">
          <div class="blue-card-top">
            <div class="blue-icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5" />
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
              </svg>
            </div>
            <h3 class="why-card-title text-white">End-to-end project management</h3>
            <p class="why-card-desc text-white-80">
              Solar-equipped homes typically sell faster and command higher resale values in energy-conscious markets.
            </p>
          </div>
          <div class="blue-card-img-wrap">
            <img src="/assets/solara/solar-worker.jpg" alt="Technician inspecting solar panels" />
          </div>
        </div>

        <!-- Card 3: Increase home value -->
        <div class="why-card">
          <div class="why-card-img-wrap">
            <img src="/assets/solara/solar-roof.jpg" alt="Residential house with rooftop solar" />
          </div>
          <div class="why-card-content">
            <h3 class="why-card-title">Increase home value</h3>
            <p class="why-card-desc">
              Solar-equipped homes typically sell faster and command higher resale values in energy-conscious markets.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SOLUTIONS ==================== -->
  <section class="section solutions-section" id="solutions">
    <div class="container">
      <div class="center-intro">
        <span class="eyebrow-tag">/ SOLUTIONS</span>
        <h2 class="section-title">Solar designed for every property type</h2>
        <p class="section-subtitle">
          Whether you're powering a home, a growing business, or a new development, Solara delivers systems tailored to your energy profile.
        </p>
      </div>

      <div class="solutions-layout">
        <!-- Left Features -->
        <div class="sol-col sol-left">
          <div class="sol-item">
            <div class="sol-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
            </div>
            <h4 class="sol-title">Residential solar</h4>
            <p class="sol-desc">Custom rooftop systems that reduce bills and increase energy independence.</p>
            <span class="sol-meta">Average payback: 5–8 years</span>
          </div>

          <div class="sol-item">
            <div class="sol-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2">
                <path d="M12 22v-9" />
                <path d="M9 13a4.5 4.5 0 0 1 6-3 4.5 4.5 0 0 1-6 3z" />
                <path d="M12 9a4.5 4.5 0 0 0-6-3 4.5 4.5 0 0 0 6 3z" />
              </svg>
            </div>
            <h4 class="sol-title">Commercial solar</h4>
            <p class="sol-desc">Scalable energy solutions for offices, warehouses, retail, and industrial facilities.</p>
            <span class="sol-meta">Lower operating costs and sustainability</span>
          </div>
        </div>

        <!-- Center Arch Portal -->
        <div class="sol-center-arch">
          <div class="arch-frame">
            <img src="/assets/solara/arch-wind.jpg" alt="Solitary wind turbine under blue gradient sky" class="arch-img" />
          </div>
        </div>

        <!-- Right Features -->
        <div class="sol-col sol-right">
          <div class="sol-item">
            <div class="sol-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2">
                <rect x="2" y="7" width="16" height="12" rx="2" />
                <line x1="6" y1="11" x2="6" y2="15" />
                <line x1="10" y1="11" x2="10" y2="15" />
                <line x1="22" y1="11" x2="22" y2="15" />
              </svg>
            </div>
            <h4 class="sol-title">Battery storage</h4>
            <p class="sol-desc">Store excess solar energy for nighttime use and backup power during outages.</p>
            <span class="sol-meta">Smart energy management</span>
          </div>

          <div class="sol-item">
            <div class="sol-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M3 9h18M9 21V9" />
              </svg>
            </div>
            <h4 class="sol-title">Residential solar</h4>
            <p class="sol-desc">Custom rooftop systems that reduce bills and increase energy independence.</p>
            <span class="sol-meta">Average payback: 5–8 years</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED PROJECTS ==================== -->
  <section class="section projects-section" id="projects">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow-tag">/ FEATURED PROJECTS</span>
        <h2 class="section-title">Systems built for performance and designed to last</h2>
        <p class="section-subtitle">
          A selection of recent installations across residential and commercial properties.
        </p>
      </div>

      <div class="projects-accordion">
        <!-- Item 01 Collapsed -->
        <div class="proj-item">
          <div class="proj-header">
            <span class="proj-num">01</span>
            <span class="proj-name">LAKESIDE RESIDENCE</span>
            <span class="proj-spec">12.4 kW residential system with battery backup</span>
            <span class="proj-arrow">›</span>
          </div>
        </div>

        <!-- Item 02 Expanded Card -->
        <div class="proj-item active-proj">
          <div class="proj-header">
            <span class="proj-num">02</span>
            <span class="proj-name">NORTHPOINT LOGISTICS CENTER</span>
            <span class="proj-spec">186 kW commercial rooftop installation</span>
            <a href="#" class="btn-learn-blue">LEARN MORE ›</a>
          </div>

          <div class="proj-expanded-body">
            <div class="proj-img-wrap">
              <span class="proj-tag">COMMERCIAL</span>
              <img src="/assets/solara/project-villa.jpg" alt="Northpoint commercial solar rooftop" />
            </div>

            <div class="proj-metrics-table">
              <div class="metric-row">
                <span class="metric-label">ANNUAL SAVINGS</span>
                <span class="metric-val">$64,200</span>
              </div>
              <div class="metric-row">
                <span class="metric-label">ENERGY OFFSET</span>
                <span class="metric-val">71%</span>
              </div>
              <div class="metric-row">
                <span class="metric-label">CO₂ REDUCTION</span>
                <span class="metric-val">214 TONS/YEAR</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Item 03 Collapsed -->
        <div class="proj-item">
          <div class="proj-header">
            <span class="proj-num">03</span>
            <span class="proj-name">LAKESIDE RESIDENCE</span>
            <span class="proj-spec">12.4 kW residential system with battery backup</span>
            <span class="proj-arrow">›</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CUSTOMER STORIES ==================== -->
  <section class="section stories-section">
    <div class="container">
      <div class="center-intro">
        <span class="eyebrow-tag">/ CUSTOMER STORIES</span>
        <h2 class="section-title">Trusted by the teams building what's next.</h2>
        <p class="section-subtitle">
          From manufacturing facilities to logistics centers, Hellon works with businesses that need solar infrastructure built around real operational demands.
        </p>
      </div>

      <div class="stories-grid">
        <!-- Story 1: Photo card -->
        <div class="story-card story-portrait-card">
          <img src="/assets/solara/avatar-man.jpg" alt="Daniel Mercer" class="portrait-img" />
          <div class="portrait-overlay">
            <p class="story-quote-short">“They studied our energy consumption and production schedule.”</p>
            <span class="story-author-small">Daniel Mercer</span>
          </div>
        </div>

        <!-- Story 2: Pale Green Amplitude Card -->
        <div class="story-card card-pale-green">
          <div class="story-brand-logo">
            <svg viewBox="0 0 140 24" fill="currentColor">
              <circle cx="10" cy="12" r="5" />
              <text x="24" y="17" font-weight="700" font-size="16" letter-spacing="-0.02em">Amplitude</text>
            </svg>
          </div>
          <p class="story-quote">
            “Solara didn't approach this as a standard solar installation. They studied our energy consumption, production schedule, and facility infrastructure before designing the system. The entire process felt engineered around our business.”
          </p>
          <div class="story-author-block">
            <strong class="author-name">Daniel Mercer</strong>
            <span class="author-title">Chief Operations Officer, Amplitude Logistics</span>
          </div>
        </div>

        <!-- Story 3: Pale Blue Segment Card -->
        <div class="story-card card-pale-blue">
          <div class="story-brand-logo">
            <svg viewBox="0 0 130 24" fill="currentColor">
              <path d="M4 12 L12 4 L20 12 L12 20 Z" fill="none" stroke="currentColor" stroke-width="2.5" />
              <text x="28" y="17" font-weight="700" font-size="16" letter-spacing="-0.02em">segment</text>
            </svg>
          </div>
          <p class="story-quote">
            “Our biggest concern was keeping the facility operational during construction. Hellon's team planned every stage carefully and coordinated around our schedule without disrupting daily operations.”
          </p>
          <div class="story-author-block">
            <strong class="author-name">Sarah Mitchell</strong>
            <span class="author-title">VP of Facilities, Segment Manufacturing</span>
          </div>
        </div>

        <!-- Story 4: Female Photo card -->
        <div class="story-card story-portrait-card">
          <img src="/assets/solara/avatar-woman.jpg" alt="Sarah Mitchell" class="portrait-img" />
          <div class="portrait-overlay">
            <p class="story-quote-short">“Coordinated around our schedule without disrupting daily operations.”</p>
            <span class="story-author-small">Sarah Mitchell</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ SECTION ==================== -->
  <section class="section faq-section" id="resources">
    <div class="container">
      <div class="faq-layout">
        <!-- Left Sidebar Card -->
        <div class="faq-sidebar-card">
          <div class="faq-sidebar-img">
            <img src="/assets/solara/faq-wind.jpg" alt="Wind turbine in green meadow" />
          </div>
          <div class="faq-sidebar-content">
            <h4 class="faq-sidebar-title">Still evaluating your options?</h4>
            <p class="faq-sidebar-desc">Let's determine whether solar makes sense for your business.</p>
            <a href="#contact" class="btn-assessment">START A PROJECT ASSESSMENT ›</a>
          </div>
        </div>

        <!-- Right Accordion List -->
        <div class="faq-main-content">
          <span class="eyebrow-tag">/ FREQUENTLY ASKED QUESTIONS</span>
          <h2 class="faq-title">Clear answers before your project begins.</h2>
          <p class="faq-subtitle">
            Large-scale solar is a significant business decision. Here are answers to the questions facility owners, operators, and energy teams ask us most often.
          </p>

          <div class="faq-accordion-list">
            <div class="faq-item">
              <span class="faq-q">Is commercial solar a good fit for our facility?</span>
              <span class="faq-toggle">⌄</span>
            </div>
            <div class="faq-item">
              <span class="faq-q">How much can a commercial solar system save?</span>
              <span class="faq-toggle">⌄</span>
            </div>
            <div class="faq-item">
              <span class="faq-q">How large can you make a solar system?</span>
              <span class="faq-toggle">⌄</span>
            </div>
            <div class="faq-item">
              <span class="faq-q">Will installation disrupt our business operations?</span>
              <span class="faq-toggle">⌄</span>
            </div>
            <div class="faq-item">
              <span class="faq-q">Do you handle permits and utility approvals?</span>
              <span class="faq-toggle">⌄</span>
            </div>
            <div class="faq-item">
              <span class="faq-q">Can solar be combined with battery storage?</span>
              <span class="faq-toggle">⌄</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PRE-FOOTER CTA BANNER ==================== -->
  <section class="cta-banner-section" id="financing">
    <div class="cta-bg-wrap">
      <img src="/assets/solara/cta-turbines.jpg" alt="Wind turbines at golden hour" class="cta-banner-img" />
    </div>

    <div class="container cta-container">
      <div class="cta-glass-card">
        <h2 class="cta-title">Your roof could be generating power within the next month</h2>
        <p class="cta-desc">
          Get a personalized solar assessment, production estimate, and financing options with no obligation.
        </p>
        <a href="#contact" class="btn-cta-blue">BOOK MY FREE CONSULTATION ›</a>
      </div>
    </div>
  </section>

  <!-- ==================== FOOTER ==================== -->
  <footer class="solara-footer" id="contact">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand-summary">
          <p class="footer-mission">
            Premium solar energy systems for homes, businesses, and future-ready communities.
          </p>
          <p class="footer-copy">© 2026 SOLARA ENERGY. ALL RIGHTS RESERVED.</p>
        </div>

        <div class="footer-nav-col">
          <h5 class="footer-heading">Solutions</h5>
          <ul>
            <li><a href="#">RESIDENTIAL SOLAR</a></li>
            <li><a href="#">COMMERCIAL SOLAR</a></li>
            <li><a href="#">BATTERY STORAGE</a></li>
            <li><a href="#">SYSTEM MONITORING</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <h5 class="footer-heading">Company</h5>
          <ul>
            <li><a href="#">ABOUT SOLARA</a></li>
            <li><a href="#">PROJECTS</a></li>
            <li><a href="#">FINANCING</a></li>
            <li><a href="#">RESOURCES</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <h5 class="footer-heading">Contact</h5>
          <ul>
            <li><a href="mailto:HELLO@SOLARA.ENERGY">HELLO@SOLARA.ENERGY</a></li>
            <li><a href="tel:8882047712">(888) 204-7712</a></li>
            <li><span class="footer-hours">MON–FRI: 8:00 AM–6:00 PM</span></li>
          </ul>
        </div>
      </div>

      <!-- Certifications & Legal Links -->
      <div class="footer-badges-bar">
        <div class="badges-left">
          <span class="cert-pill">NABCEP certified</span>
          <span class="cert-pill">Fully licensed & insured</span>
          <span class="cert-pill">25-year warranty</span>
        </div>
