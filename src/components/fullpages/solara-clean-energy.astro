<style>
  /* ==================== BASE STYLES ==================== */
  .solara-page {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    color: #12161A;
    background: #FFFFFF;
    line-height: 1.5;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: 96px 0;
  }

  .eyebrow-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #4B5563;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .section-title {
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #111827;
    margin: 0 0 16px;
  }

  .section-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: #6B7280;
    max-width: 640px;
    margin: 0;
  }

  .center-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }

  .center-intro .section-subtitle {
    margin: 0 auto;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    min-height: 94vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: #4B78A8;
  }

  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-sky-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(25, 60, 95, 0.4) 0%,
      rgba(25, 60, 95, 0.1) 40%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .hero-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 40px;
  }

  .hero-nav {
    display: flex;
    gap: 28px;
  }

  .hero-nav a {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .hero-nav a:hover {
    opacity: 0.8;
  }

  .btn-quote {
    background: #FFFFFF;
    color: #111827;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn-quote:hover {
    background: #F3F4F6;
    transform: translateY(-1px);
  }

  .hero-brand-wrap {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 40px 20px;
    user-select: none;
  }

  .hero-giant-wordmark {
    font-size: clamp(100px, 20vw, 290px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    line-height: 0.85;
    margin: 0;
    text-shadow: 0 4px 40px rgba(0,0,0,0.25);
  }

  /* Bottom Earth Bar */
  .hero-bottom-bar {
    position: relative;
    z-index: 10;
    background: rgba(62, 58, 32, 0.94);
    backdrop-filter: blur(12px);
    display: grid;
    grid-template-columns: 1.2fr 1.5fr 1.3fr;
    gap: 32px;
    padding: 24px 40px;
    color: #FFFFFF;
    align-items: center;
  }

  .hero-bar-headline {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero-bar-desc {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 24px;
  }

  .hero-bar-stats {
    display: flex;
    justify-content: space-between;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 24px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
    color: #FFFFFF;
    margin-bottom: 4px;
  }

  .stat-lbl {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.2;
    max-width: 80px;
  }

  /* ==================== WHY SOLARA ==================== */
  .why-section {
    background: #FFFFFF;
  }

  .section-intro {
    max-width: 880px;
    margin-bottom: 56px;
  }

  .why-headline {
    font-size: clamp(26px, 3.2vw, 42px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .text-dark {
    color: #111827;
  }

  .text-muted {
