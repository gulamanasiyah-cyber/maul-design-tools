---
// Somefolk Creative Director — Full-page recreation of the acid-editorial portfolio for an art director & creative developer.
// Features: ultra-tall condensed typography, high-voltage acid lime (#C5F82A) on deep void forest (#0A0F0D),
// retro 1930s rubber-hose cartoon mascots (boy carrying monstera, boy holding hands with vintage CRT monitor),
// cursive script accents, editorial fashion photography, stacked project cards with maroon Critical Danger feature,
// circular Webflow badge seal, magazine grid, and solid lime contact block paired with sunny tennis court group portrait.
---

<div class="somefolk-page">
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="hero-bg-wrap">
      <img src="/assets/somefolk/hero-model.jpg" alt="Cinematic fashion portrait with spotlight" class="hero-bg" />
      <div class="hero-overlay"></div>
    </div>

    <header class="hero-nav">
      <a href="#about" class="nav-text">INFO</a>
      <a href="#work" class="nav-text">WORK</a>
    </header>

    <div class="hero-center-badge">
      <div class="y2k-logo-wrap">
        <span class="logo-y2k">SOMEFOLK<span class="reg">®</span></span>
        <span class="logo-script">by Somefolk</span>
      </div>
    </div>

    <div class="hero-bottom-bar">
      <div class="hb-col">
        <span class="meta-tag">BRAND DIRECTION DIGITAL</span>
      </div>
      <div class="hb-col center">
        <span class="meta-desc">WORKING WITH PASSIONATE PEOPLE & AMBITIOUS BRANDS</span>
      </div>
      <div class="hb-col right">
        <span class="meta-tag">DOMINIQUE SIDE</span>
      </div>
    </div>
  </section>

  <!-- ==================== GIANT BIO DISPLAY ==================== -->
  <section class="bio-display-section" id="about">
    <div class="container">
      <h1 class="bio-giant-title">
        <span>LONDON—BASED ART</span>
        <span>DIRECTOR | DESIGNER</span>
        <span>CREATIVE DEVELOPER</span>
      </h1>
      <p class="bio-manifesto-sub">
        TELLING MEANINGFUL STORIES THAT NEED TO BE TOLD (BY HUMANS, NOT AI)
      </p>
    </div>
  </section>

  <!-- ==================== MASCOT & CAPABILITIES ==================== -->
  <section class="mascot-capabilities-section">
    <div class="container">
      <div class="capabilities-grid">
        <!-- Left Column -->
        <div class="cap-col">
          <h4 class="cap-heading">BRAND IDENTITY</h4>
          <h4 class="cap-heading">BRAND STRATEGY</h4>
          <h4 class="cap-heading">TYPOGRAPHY</h4>
        </div>

        <!-- Center Mascot Column -->
        <div class="mascot-center-col">
          <div class="rubberhose-mascot-wrap">
            <!-- Vintage Rubber-Hose Boy Carrying Monstera Plant -->
            <svg class="rubberhose-svg" viewBox="0 0 160 160" fill="none">
              <!-- Monstera Leaves -->
              <path d="M75 35 C65 15, 95 10, 105 25 C115 15, 135 30, 125 45 C135 55, 120 70, 105 60 C95 70, 75 55, 75 35 Z" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
              <path d="M90 25 L105 45 L95 55" stroke="#0A0F0D" stroke-width="2" />
              <!-- Pot -->
              <polygon points="85,60 120,60 115,80 90,80" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
              <!-- Boy Body & Pie-Eyes Face -->
              <circle cx="65" cy="80" r="16" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
              <circle cx="60" cy="78" r="2.5" fill="#0A0F0D" />
              <circle cx="68" cy="78" r="2.5" fill="#0A0F0D" />
              <path d="M58 86 Q64 92 70 86" stroke="#0A0F0D" stroke-width="2" stroke-linecap="round" fill="none" />
              <!-- Cheerful curved cap -->
              <ellipse cx="65" cy="67" rx="14" ry="5" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
              <!-- Arms holding pot -->
              <path d="M52 88 Q65 100 86 75" stroke="#C5F82A" stroke-width="7" stroke-linecap="round" />
              <path d="M52 88 Q65 100 86 75" stroke="#0A0F0D" stroke-width="3" stroke-linecap="round" fill="none" />
              <!-- Legs & Big cartoon boots -->
              <path d="M58 96 L50 125 M72 96 L78 125" stroke="#0A0F0D" stroke-width="4" stroke-linecap="round" />
              <ellipse cx="44" cy="128" rx="10" ry="6" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
              <ellipse cx="84" cy="128" rx="10" ry="6" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
            </svg>
          </div>

          <div class="version-tag">
            <h3 class="v-title">V2.0 (2K23)</h3>
            <span class="v-script">by Somefolk</span>
          </div>

          <p class="mascot-desc">
            An independent creative studio creating brand identities and digital experiences rooted in human storytelling and bespoke craftsmanship.
          </p>

          <a href="#contact" class="btn-more-about">MORE ABOUT ME</a>
        </div>

        <!-- Right Column -->
        <div class="cap-col right">
          <h4 class="cap-heading">ART DIRECTION</h4>
          <h4 class="cap-heading">DIGITAL DESIGN</h4>
          <h4 class="cap-heading">DEVELOPMENT</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== GIANT WORK DISPLAY ==================== -->
  <section class="work-section" id="work">
    <div class="work-title-wrap">
      <h2 class="work-giant-title">WORK</h2>
    </div>

    <!-- Stacked Project Deck -->
    <div class="container project-stack-container">
      <div class="tab-header-strip">
        <span class="deck-tab t1">DOMINIQUE SIDE</span>
        <span class="deck-tab t2">HALO MEDIA</span>
        <span class="deck-tab t3">I KILLED A CACTUS</span>
      </div>

      <!-- Featured Project Card: Critical Danger -->
      <div class="featured-project-card">
        <div class="card-header">
          <span class="project-name-red">CRITICAL DANGER</span>
        </div>

        <div class="card-visual-wrap">
          <img src="/assets/somefolk/orangutan.jpg" alt="Orangutan in wild rainforest" class="project-main-img" />
          <div class="critical-state-badge">
            <span class="badge-line1">CRITICAL STATE</span>
            <span class="badge-line2">REAL DANGER</span>
          </div>
        </div>

        <div class="card-footer-meta">
          <span>BRAND STRATEGY / ART DIRECTION / DIGITAL DESIGN</span>
          <span>CREATIVE CRAFT: BESPOKE</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== BESPOKE WEBSITES & CRT MASCOT ==================== -->
  <section class="bespoke-section">
    <div class="container">
      <div class="bespoke-header">
        <h2 class="bespoke-giant-title">
          <span>WORKING WITH STARTUPS & SMES</span>
          <span>TO CREATE MEMORABLE BRANDS</span>
        </h2>

        <!-- Mascot: Boy holding hands with CRT computer monitor -->
        <div class="crt-mascot-center">
          <svg class="crt-mascot-svg" viewBox="0 0 200 120" fill="none">
            <!-- CRT Computer -->
            <rect x="20" y="25" width="55" height="48" rx="8" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
            <rect x="26" y="31" width="43" height="34" rx="4" fill="#0A0F0D" />
            <!-- Smiling CRT face -->
            <circle cx="38" cy="45" r="2.5" fill="#C5F82A" />
            <circle cx="58" cy="45" r="2.5" fill="#C5F82A" />
            <path d="M42 54 Q48 60 54 54" stroke="#C5F82A" stroke-width="2" stroke-linecap="round" fill="none" />
            <!-- CRT legs -->
            <path d="M35 73 L30 95 M60 73 L65 95" stroke="#0A0F0D" stroke-width="3" stroke-linecap="round" />
            <ellipse cx="26" cy="97" rx="8" ry="4" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
            <ellipse cx="69" cy="97" rx="8" ry="4" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
            <!-- Holding hands line -->
            <path d="M75 50 Q100 65 118 45" stroke="#0A0F0D" stroke-width="3" stroke-linecap="round" />
            <!-- Cartoon Boy Right -->
            <circle cx="135" cy="40" r="14" fill="#C5F82A" stroke="#0A0F0D" stroke-width="3" />
            <circle cx="130" cy="38" r="2" fill="#0A0F0D" />
            <circle cx="138" cy="38" r="2" fill="#0A0F0D" />
            <path d="M128 46 Q134 50 140 46" stroke="#0A0F0D" stroke-width="2" fill="none" />
            <!-- Boy body & waving arm -->
            <path d="M135 54 L135 80" stroke="#0A0F0D" stroke-width="6" />
            <path d="M135 58 Q155 45 160 30" stroke="#0A0F0D" stroke-width="3" stroke-linecap="round" />
            <!-- Boy Legs -->
            <path d="M128 80 L124 105 M142 80 L146 105" stroke="#0A0F0D" stroke-width="3" stroke-linecap="round" />
            <ellipse cx="118" cy="107" rx="8" ry="4" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
            <ellipse cx="152" cy="107" rx="8" ry="4" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
          </svg>
        </div>

        <h2 class="bespoke-giant-title">
          <span>& HIGHLY BESPOKE WEBSITES</span>
        </h2>

        <p class="bespoke-sub">ALWAYS BESPOKE. NEVER OFF-THE-SHELF.</p>
      </div>

      <!-- Mockup Collage -->
      <div class="mockup-collage-wrap">
        <img src="/assets/somefolk/mockups.jpg" alt="Editorial device and paper print mockups" class="mockup-img" />
      </div>
    </div>
  </section>

  <!-- ==================== DARK EDITORIAL HOODED MODEL ==================== -->
  <section class="editorial-hooded-section">
    <div class="container">
      <div class="hooded-header">
        <h2 class="hooded-title">
          OFFERING CREATIVE-LED DESIGN AND DEVELOPMENT FOR AMBITIOUS BRANDS THAT WANT TO EXPAND AND CREATE
          <span class="script-accent">lasting change</span>
        </h2>
      </div>

      <div class="hooded-visual-grid">
        <div class="hooded-img-wrap">
          <img src="/assets/somefolk/fleece.jpg" alt="Moody model in green fuzzy fleece jacket" class="fleece-img" />
          <div class="f-circle-badge">F</div>
        </div>

        <div class="services-two-col">
          <div class="s-col">
            <h3 class="s-head">DIGITAL FIRST BRANDING</h3>
            <ul class="s-list">
              <li>IDENTITY SYSTEMS</li>
              <li>BRAND STRATEGY</li>
              <li>ART DIRECTION</li>
              <li>TYPOGRAPHY</li>
              <li>BRAND GUIDELINES</li>
            </ul>
          </div>

          <div class="s-col">
            <h3 class="s-head">WEBSITES + COMMERCE</h3>
            <ul class="s-list">
              <li>UI / UX DESIGN</li>
              <li>CREATIVE WEB DEVELOPMENT</li>
              <li>WEBFLOW DEVELOPMENT</li>
              <li>E-COMMERCE EXPERIENCES</li>
              <li>MOTION & INTERACTION</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== HUMAN MANIFESTO STATEMENT ==================== -->
  <section class="human-manifesto-section">
    <div class="container">
      <h2 class="manifesto-text">
        AS ARTIFICIAL INTELLIGENCE BECOMES A BUZZWORD FOR REPLACING HUMAN ABILITY, IT'S MORE IMPORTANT THAN EVER TO TELL YOUR STORY IN AN AUTHENTIC WAY
      </h2>
    </div>
  </section>

  <!-- ==================== MAGAZINE EDITORIAL GRID ==================== -->
  <section class="magazine-grid-section">
    <div class="container magazine-grid">
      <!-- Left: Rotating Webflow Seal Badge -->
      <div class="mag-col-left">
        <div class="seal-badge-wrap">
          <svg class="seal-svg" viewBox="0 0 200 200">
            <!-- Concentric dashed circles -->
            <circle cx="100" cy="100" r="90" stroke="#C5F82A" stroke-width="2" stroke-dasharray="6 4" fill="none" />
            <circle cx="100" cy="100" r="76" stroke="#C5F82A" stroke-width="1.5" fill="none" />
            <circle cx="100" cy="100" r="62" stroke="#C5F82A" stroke-width="1.5" stroke-dasharray="4 3" fill="none" />
            <!-- Center Seal Text -->
            <text x="100" y="94" font-size="14" font-weight="900" fill="#C5F82A" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif">ACCEPTING B2B</text>
            <text x="100" y="112" font-size="14" font-weight="900" fill="#C5F82A" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif">OBJECTS THROUGH</text>
            <text x="100" y="128" font-size="12" font-weight="700" fill="#C5F82A" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif">WEBFLOW</text>
          </svg>
        </div>
      </div>

      <!-- Right Column Stack -->
      <div class="mag-col-right">
        <!-- Enquiries Card -->
        <div class="mag-card enquiries-card">
          <h4 class="card-kicker">I'M CURRENTLY TAKING ENQUIRIES FOR PROJECTS STARTING IN OCTOBER 2023</h4>
          <p class="card-sub">Let's craft something unforgettable together.</p>
          <div class="card-photo">
            <img src="/assets/somefolk/coral-model.jpg" alt="Model in coral trench coat against pink background" />
          </div>
        </div>

        <!-- Recognition -->
        <div class="mag-card recognition-card">
          <h4 class="card-kicker">RECOGNITION</h4>
          <div class="recog-table">
            <div class="recog-row"><span>Awwwards Site of the Day</span><span class="r-year">2023</span></div>
            <div class="recog-row"><span>CSS Design Awards</span><span class="r-year">2023</span></div>
            <div class="recog-row"><span>Mindsparkle Mag Feature</span><span class="r-year">2022</span></div>
            <div class="recog-row"><span>FWA of the Day</span><span class="r-year">2022</span></div>
          </div>
        </div>

        <!-- Nature Primate Photo -->
        <div class="mag-card nature-photo-card">
          <img src="/assets/somefolk/monkey.jpg" alt="Moody primate in dark rainforest tree" />
        </div>

        <!-- Social Links -->
        <div class="mag-card social-card">
          <h4 class="card-kicker">SOCIAL INACTIVITY</h4>
          <div class="social-links-list">
            <a href="#">INSTAGRAM ↗</a>
            <a href="#">BEHANCE ↗</a>
            <a href="#">LINKEDIN ↗</a>
            <a href="#">DRIBBBLE ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LIME CONTACT BLOCK & TENNIS GROUP ==================== -->
  <section class="contact-split-section" id="contact">
    <div class="contact-split-grid">
      <!-- Left: Acid Lime Form -->
      <div class="lime-form-col">
        <h3 class="form-title">WHAT ARE YOU WAITING FOR?<br />LET'S DO THIS.</h3>

        <form class="lime-form" onsubmit="event.preventDefault()">
          <div class="form-field">
            <label>WHAT'S YOUR NAME?</label>
            <input type="text" placeholder="John Doe" class="l-input" required />
          </div>
          <div class="form-field">
            <label>AND YOUR EMAIL ADDRESS?</label>
            <input type="email" placeholder="john@example.com" class="l-input" required />
          </div>
          <div class="form-field">
            <label>HOW CAN I HELP?</label>
            <input type="text" placeholder="Tell me about your project..." class="l-input" required />
          </div>

          <button type="submit" class="btn-send-black">SEND IT!</button>
        </form>
      </div>

      <!-- Right: Sunny Tennis Court Group Portrait -->
      <div class="tennis-photo-col">
        <img src="/assets/somefolk/tennis-group.jpg" alt="Fashion group portrait outdoors on sunny tennis court" class="tennis-img" />
      </div>
    </div>
  </section>

  <!-- ==================== GIANT LET'S COLLABORATE FOOTER ==================== -->
  <footer class="footer">
    <div class="container footer-inner">
      <h2 class="footer-giant-title">LET'S COLLABORATE</h2>
      <p class="footer-spirit-title">AUTHENTIC TALES OF HUMAN SPIRIT</p>
      <span class="footer-script">by Somefolk</span>

      <div class="footer-bottom-deck">
        <div class="f-pill-card">
          <p>IF YOU'VE GOT A STORY THAT NEEDS TO BE TOLD, PLEASE GET IN TOUCH</p>
          <span class="f-email">HELLO@SOMEFOLK.STUDIO</span>
        </div>

        <!-- Potted Monstera Illustration Center -->
        <div class="f-plant-center">
          <svg class="plant-svg" viewBox="0 0 100 100" fill="none">
            <path d="M50 20 C40 5, 60 5, 50 20 C35 15, 45 35, 50 40 C65 30, 60 15, 50 20 Z" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
            <polygon points="40,55 60,55 57,75 43,75" fill="#C5F82A" stroke="#0A0F0D" stroke-width="2.5" />
            <line x1="50" y1="35" x2="50" y2="55" stroke="#0A0F0D" stroke-width="2.5" />
          </svg>
        </div>

        <div class="f-brand-stamp">
          <span class="stamp-logo">SOMEFOLK<span class="reg">®</span></span>
          <span class="stamp-copy">© 2024 SOMEFOLK STUDIO. LONDON, UK.</span>
        </div>
      </div>
    </div>
  </footer>
</div>

<style>
  /* ==================== BASE STYLES ==================== */
  .somefolk-page {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: #C5F82A;
    background: #0A0F0D;
    line-height: 1.45;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px 36px;
    overflow: hidden;
  }

  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 15, 13, 0.4) 0%,
      rgba(10, 15, 13, 0.2) 40%,
      rgba(10, 15, 13, 0.85) 100%
    );
  }

  .hero-nav {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
  }

  .nav-text {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .hero-center-badge {
    position: relative;
    z-index: 10;
    text-align: center;
    margin: auto 0;
  }

  .y2k-logo-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .logo-y2k {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 950;
    letter-spacing: 0.12em;
    color: #C5F82A;
    text-shadow: 0 0 20px rgba(197, 248, 42, 0.6);
  }

  .reg {
    font-size: 0.4em;
    vertical-align: super;
  }

  .logo-script {
    font-family: 'Caveat', cursive, sans-serif;
    font-size: 26px;
    color: #FFFFFF;
    transform: rotate(-3deg);
    margin-top: -6px;
  }

  .hero-bottom-bar {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 20px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .hb-col.center {
    text-align: center;
  }

  .hb-col.right {
    text-align: right;
  }

  /* ==================== GIANT BIO DISPLAY ==================== */
  .bio-display-section {
    background: #0A0F0D;
    padding: 80px 0 40px;
    text-align: center;
  }

  .bio-giant-title {
    font-size: clamp(48px, 8.2vw, 112px);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #C5F82A;
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  .bio-giant-title span {
    display: block;
  }

  .bio-manifesto-sub {
    font-size: clamp(13px, 1.4vw, 16px);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin: 0;
  }

  /* ==================== MASCOT & CAPABILITIES ==================== */
  .mascot-capabilities-section {
    background: #0A0F0D;
    padding: 40px 0 88px;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 32px;
    align-items: center;
  }

  .cap-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cap-col.right {
    text-align: right;
  }

  .cap-heading {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #C5F82A;
    margin: 0;
  }

  .mascot-center-col {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rubberhose-mascot-wrap {
    width: 140px;
    height: 140px;
    margin-bottom: 12px;
  }

  .rubberhose-svg {
    width: 100%;
    height: 100%;
  }

  .version-tag {
    margin-bottom: 12px;
  }

  .v-title {
    font-size: 32px;
    font-weight: 950;
    letter-spacing: -0.02em;
    color: #C5F82A;
    margin: 0;
  }

  .v-script {
    font-family: 'Caveat', cursive, sans-serif;
    font-size: 20px;
    color: #FFFFFF;
  }

  .mascot-desc {
    font-size: 12px;
    line-height: 1.6;
    color: #7B9B82;
    max-width: 340px;
    margin: 0 0 20px;
  }

  .btn-more-about {
    border: 1px solid #C5F82A;
    color: #C5F82A;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 8px 20px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-more-about:hover {
    background: #C5F82A;
    color: #0A0F0D;
  }

  /* ==================== WORK SECTION ==================== */
  .work-section {
    background: #0A0F0D;
    padding: 64px 0 96px;
  }

  .work-title-wrap {
    text-align: center;
    margin-bottom: 40px;
  }

  .work-giant-title {
    font-size: clamp(84px, 18vw, 240px);
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 0.85;
    color: #C5F82A;
    margin: 0;
  }

  .project-stack-container {
    max-width: 960px;
  }

  .tab-header-strip {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .deck-tab {
