---
// Kidu Playful Kids Store — Full-page recreation of the Shopify toy & kids brand storefront.
// Palettes: Fuchsia #CE126E, Plum #584592, Mint #99EBEB, Pink Cloud #FDE9F3, Light Sand #FFF0D8, Off-white #F4F4F4.
// Font: Nunito rounded sans-serif.
---

<div class="kidu-page">
  <!-- ==================== ANNOUNCEMENT TICKER ==================== -->
  <aside class="announcement-bar">
    <div class="ticker-inner">
      <div class="ticker-timer">
        <span class="timer-label">Limited-time offer!</span>
        <div class="timer-digits">
          <span><strong>02</strong>d</span>
          <span><strong>14</strong>h</span>
          <span><strong>45</strong>m</span>
          <span><strong>19</strong>s</span>
        </div>
      </div>
      <div class="ticker-marquee">
        <div class="marquee-track">
          <span class="m-item"><em>#WELCOME :</em> Explore Deals & Offers <a href="#catalog">SHOP NOW!</a></span>
          <span class="m-item"><em>#KiduSafeStyle :</em> Elevate Your Safety in Style 😷 <a href="#catalog">SHOP NOW!</a></span>
          <span class="m-item"><em>#KiduFunTime :</em> Explore exclusive deals at Kidu! <a href="#catalog">SHOP NOW!</a></span>
          <span class="m-item"><em>#WELCOME :</em> Explore Deals & Offers <a href="#catalog">SHOP NOW!</a></span>
          <span class="m-item"><em>#KiduSafeStyle :</em> Elevate Your Safety in Style 😷 <a href="#catalog">SHOP NOW!</a></span>
        </div>
      </div>
    </div>
  </aside>

  <!-- ==================== MAIN HEADER ==================== -->
  <header class="main-header">
    <div class="container header-container">
      <div class="logo-wrap">
        <a href="/" class="logo-link">
          <img src="/assets/kidu/logo-kidu.svg" alt="Kidu" class="logo-img" />
        </a>
      </div>

      <nav class="nav-menu">
        <a href="#" class="nav-link active">Home</a>
        <div class="nav-dropdown-wrap">
          <a href="#catalog" class="nav-link">Catalog <span class="caret">▾</span></a>
        </div>
        <div class="nav-dropdown-wrap">
          <a href="#sale" class="nav-link">Sale <span class="nav-badge flash-badge">FLASH</span> <span class="caret">▾</span></a>
        </div>
        <a href="#snap-deal" class="nav-link">Snap Deal <span class="nav-badge wow-badge">WOW</span></a>
        <a href="#categories" class="nav-link">Shop by Category <span class="caret">▾</span></a>
        <a href="#resources" class="nav-link">Resources <span class="caret">▾</span></a>
      </nav>

      <div class="header-actions">
        <div class="currency-pill">
          <span class="flag">🇺🇸</span>
          <span>USD $</span>
          <span class="caret">▾</span>
        </div>
        <div class="lang-pill">
          <span>English</span>
          <span class="caret">▾</span>
        </div>
        <button class="icon-circle" aria-label="Account">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M10 10a4 4 0 100-8 4 4 0 000 8zm-7 8a7 7 0 0114 0H3z" />
          </svg>
        </button>
        <button class="icon-circle cart-circle" aria-label="Cart">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 6h12l-1 11H5L4 6z" />
            <path d="M7 6V4a3 3 0 016 0v2" />
          </svg>
          <span class="cart-count">2</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== UTILITY BAR / SEARCH ==================== -->
  <div class="utility-bar">
    <div class="container utility-container">
      <button class="new-arrival-btn">
        <svg viewBox="0 0 13 13" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="3" cy="3" r="2" />
          <circle cx="10" cy="3" r="2" />
          <circle cx="3" cy="10" r="2" />
          <circle cx="10" cy="10" r="2" />
        </svg>
        New Arrival
      </button>

      <div class="search-input-wrap">
        <svg class="search-ico" viewBox="0 0 18 17" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="7" cy="7" r="5" />
          <path d="M11 11l4 4" />
        </svg>
        <input type="search" placeholder="Search here for toys, plushes, masks..." class="search-input" />
      </div>

      <div class="store-locator-btn">
        <svg viewBox="0 0 22 22" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="9" r="4" />
          <path d="M11 2a7 7 0 00-7 7c0 5 7 11 7 11s7-6 7-11a7 7 0 00-7-7z" />
        </svg>
        <span>Store Locations</span>
      </div>
    </div>
  </div>

  <!-- ==================== HERO BANNER SLIDESHOW ==================== -->
  <section class="hero-slideshow">
    <div class="container">
      <div class="hero-slide-card">
        <!-- Slide 1 Content -->
        <div class="slide-left-img">
          <img src="/assets/kidu/slide-1-1.png" alt="Happy child playing with plush" class="hero-child-img" />
        </div>

        <div class="slide-center-copy">
          <span class="slide-pill">New Arrivals</span>
          <h1 class="slide-headline">Kidu - Explore the World of Play</h1>
          <p class="slide-sub">Discover endless joy with our latest toys, plushies & creative collections.</p>
          <div class="slide-ctas">
            <a href="#catalog" class="btn btn-mint">Shop now</a>
            <a href="#about" class="btn-link-white">Learn more <span class="arrow">→</span></a>
          </div>
        </div>

        <div class="slide-right-img">
          <img src="/assets/kidu/slide-1-2.png" alt="Toy items showcase" class="hero-toy-img" />
        </div>

        <!-- Carousel Pagination Dots -->
        <div class="hero-pager">
          <span class="dot active"></span>
          <span class="dot"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MARQUEE BRAND LOGOS ==================== -->
  <section class="brand-logos-section">
    <div class="container">
      <div class="logos-track">
        <img src="/assets/kidu/brand-1.svg" alt="Brand 1" class="brand-logo" />
        <img src="/assets/kidu/brand-2.svg" alt="Brand 2" class="brand-logo" />
        <img src="/assets/kidu/brand-3.svg" alt="Brand 3" class="brand-logo" />
        <img src="/assets/kidu/brand-4.svg" alt="Brand 4" class="brand-logo" />
        <img src="/assets/kidu/brand-5.svg" alt="Brand 5" class="brand-logo" />
        <img src="/assets/kidu/brand-1.svg" alt="Brand 1" class="brand-logo" />
      </div>
    </div>
  </section>

  <!-- ==================== HIGHLIGHT VALUE STRIP ==================== -->
  <section class="value-ticker-strip">
    <div class="marquee-track-smooth">
      <div class="v-pill">
        <span class="v-dot"></span>
        <strong>NEXT DAY DELIVERY - ORDER BY 6PM</strong>
      </div>
      <div class="v-pill">
        <span class="v-dot"></span>
        <strong>Get an extra 5% off with code 'XMAS5'</strong>
      </div>
      <div class="v-pill">
        <span class="v-dot"></span>
        <strong>Premier Toys: A Decade of Excellence</strong>
      </div>
      <div class="v-pill">
        <span class="v-dot"></span>
        <strong>LAST CHANCE TO BUY!</strong>
      </div>
    </div>
  </section>

  <!-- ==================== TOP COLLECTIONS (SQUARE CARDS) ==================== -->
  <section class="top-collections-section" id="categories">
    <div class="container">
      <h2 class="section-heading-center">Shop our top collections</h2>

      <div class="collections-grid-5">
        <a href="#plush" class="collection-square-card">
          <div class="card-media">
            <img src="/assets/kidu/cat-plush.jpg" alt="Mini Plush" />
          </div>
          <h3 class="card-name">Mini Plush</h3>
        </a>

        <a href="#lights" class="collection-square-card">
          <div class="card-media">
            <img src="/assets/kidu/cat-lights.jpg" alt="Little Lights" />
          </div>
          <h3 class="card-name">Little Lights</h3>
        </a>

        <a href="#accessories" class="collection-square-card">
          <div class="card-media">
            <img src="/assets/kidu/cat-acc.png" alt="Accessories" />
          </div>
          <h3 class="card-name">Accessories</h3>
        </a>

        <a href="#masks" class="collection-square-card">
          <div class="card-media card-media-pink">
            <img src="/assets/kidu/cat-mask.jpg" alt="Face Masks" />
            <span class="badge-must-have">Must have</span>
          </div>
          <h3 class="card-name">Face Masks</h3>
        </a>

        <a href="#stickers" class="collection-square-card">
          <div class="card-media">
            <img src="/assets/kidu/cat-tape.png" alt="Stickers" />
          </div>
          <h3 class="card-name">Stickers</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== PROMO BANNERS COLLAGE 1 ==================== -->
  <section class="promo-collage-1">
    <div class="container">
      <div class="collage-grid-1">
        <!-- Large Left Banner (Water Bottles) -->
        <a href="#bottles" class="promo-banner-card b-tall">
          <img src="/assets/kidu/banner-1-1.png" alt="Water bottles & travel gear collection" />
        </a>

        <!-- Top Right Banner (Mini Plush) -->
        <a href="#plush" class="promo-banner-card b-wide-top">
          <img src="/assets/kidu/banner-1-2.png" alt="Mini plush cuteness" />
        </a>

        <!-- Bottom Right Banner (Little Lights) -->
        <a href="#lights" class="promo-banner-card b-wide-bottom">
          <img src="/assets/kidu/banner-1-3.png" alt="Little lights bedside companion" />
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== SHOP BY AGE (ECLIPSE PILLS) ==================== -->
  <section class="shop-by-age-section">
    <div class="container">
      <h2 class="section-heading-center">Shop by age</h2>

      <div class="age-pills-grid">
        <a href="#age-1" class="age-card">
          <div class="age-oval">
            <img src="/assets/kidu/age-1.png" alt="1-12 months" />
          </div>
          <span class="age-label">1 - 12 months</span>
        </a>

        <a href="#age-2" class="age-card">
          <div class="age-oval">
            <img src="/assets/kidu/age-2.png" alt="2-3 years" />
          </div>
          <span class="age-label">2 - 3 years</span>
        </a>

        <a href="#age-3" class="age-card">
          <div class="age-oval">
            <img src="/assets/kidu/age-3.png" alt="4-5 years" />
          </div>
          <span class="age-label">4 - 5 years</span>
        </a>

        <a href="#age-4" class="age-card">
          <div class="age-oval">
            <img src="/assets/kidu/age-4.png" alt="6-7 years" />
          </div>
          <span class="age-label">6 - 7 years</span>
        </a>

        <a href="#age-5" class="age-card">
          <div class="age-oval">
            <img src="/assets/kidu/age-5.png" alt="Older Kids" />
          </div>
          <span class="age-label">Older Kids</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== TRUST TICKER (FUCHSIA) ==================== -->
  <section class="trust-ticker-fuchsia">
    <div class="marquee-track-smooth">
      <span class="t-item">Parent-Approved Toy Safety Standards •</span>
      <span class="t-item">Low Price Guarantee •</span>
      <span class="t-item">No Hassle Returns •</span>
      <span class="t-item">Parent-Approved Toy Safety Standards •</span>
      <span class="t-item">Low Price Guarantee •</span>
      <span class="t-item">No Hassle Returns •</span>
    </div>
  </section>

  <!-- ==================== 4-GRID ACTION BANNERS ==================== -->
  <section class="action-banners-4">
    <div class="container">
      <div class="action-grid-4">
        <div class="action-card ac-pink">
          <img src="/assets/kidu/banner-2-1.png" alt="Explore Toys" />
          <a href="#catalog" class="action-btn">Explore Toys <span class="arrow">→</span></a>
        </div>
        <div class="action-card ac-fuchsia">
          <img src="/assets/kidu/banner-2-2.png" alt="Unlock Deals" />
          <a href="#sale" class="action-btn">Unlock Deals <span class="arrow">→</span></a>
        </div>
        <div class="action-card ac-fuchsia">
          <img src="/assets/kidu/banner-2-3.png" alt="Gift Cards" />
          <a href="#giftcards" class="action-btn">Gift Cards <span class="arrow">→</span></a>
        </div>
        <div class="action-card ac-fuchsia">
          <img src="/assets/kidu/banner-2-4.png" alt="Latest News" />
          <a href="#blog" class="action-btn">Latest News <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FLASH SALE PRODUCT GRID ==================== -->
  <section class="flash-sale-section" id="sale">
    <div class="container">
      <div class="flash-sale-header">
        <div class="header-left">
          <h2 class="section-title-left">Flash Sale</h2>
          <span class="discount-sub">Take 20% off all items starting today!</span>
        </div>
        <div class="flash-timer">
          <span class="time-box"><strong>02</strong> days</span>
          <span class="time-box"><strong>14</strong> hours</span>
          <span class="time-box"><strong>45</strong> mins</span>
          <span class="time-box"><strong>19</strong> secs</span>
        </div>
      </div>

      <div class="products-grid-4">
        <!-- Product 1: Riceminty Little Light -->
        <article class="product-item-card">
          <div class="p-thumb-wrap">
            <img src="/assets/kidu/riceminty.jpg" alt="Riceminty Little Light" class="p-img" />
            <span class="p-save-chip">Save $4.00</span>
            <div class="p-swatches-top">
              <span class="sw-dot sw-pink active"></span>
              <span class="sw-dot sw-green"></span>
              <span class="sw-dot sw-red"></span>
              <span class="sw-dot sw-gray"></span>
            </div>
          </div>
          <div class="p-info">
            <span class="p-stock-tag">In stock</span>
            <div class="p-prices">
              <span class="p-price-now">From $38.00</span>
              <s class="p-price-old">$42.00</s>
            </div>
            <h3 class="p-title">Riceminty Little Light</h3>
            <span class="p-vendor">noodoll</span>
            <button class="quick-add-btn">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h12l-1 11H5L4 6z" />
                <path d="M7 6V4a3 3 0 016 0v2" />
              </svg>
              Quick Add
            </button>
          </div>
        </article>

        <!-- Product 2: Ricepudding Little Light -->
        <article class="product-item-card">
          <div class="p-thumb-wrap">
            <img src="/assets/kidu/ricecarrot.jpg" alt="Ricepudding Little Light" class="p-img" />
            <span class="p-save-chip">Save $4.00</span>
            <div class="p-swatches-top">
              <span class="sw-dot sw-yellow active"></span>
              <span class="sw-dot sw-blue"></span>
              <span class="sw-dot sw-green"></span>
              <span class="sw-dot sw-red"></span>
            </div>
          </div>
          <div class="p-info">
            <span class="p-stock-tag">In stock</span>
            <div class="p-prices">
              <span class="p-price-now">From $36.00</span>
              <s class="p-price-old">$42.00</s>
            </div>
            <h3 class="p-title">Ricepudding Little Light</h3>
            <span class="p-vendor">noodoll</span>
            <button class="quick-add-btn">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h12l-1 11H5L4 6z" />
                <path d="M7 6V4a3 3 0 016 0v2" />
              </svg>
              Quick Add
            </button>
          </div>
        </article>

        <!-- Product 3: Strawberry Ricespud Mini Plush -->
        <article class="product-item-card">
          <div class="p-thumb-wrap">
            <img src="/assets/kidu/strawberry-ricespud.jpg" alt="Strawberry Ricespud Mini Plush" class="p-img" />
            <span class="p-save-chip">Save $5.00</span>
            <div class="p-swatches-top">
              <span class="sw-dot sw-pink active"></span>
              <span class="sw-dot sw-green"></span>
              <span class="sw-dot sw-purple"></span>
            </div>
          </div>
          <div class="p-info">
            <span class="p-stock-tag">In stock</span>
            <div class="p-prices">
              <span class="p-price-now">From $24.00</span>
              <s class="p-price-old">$29.00</s>
            </div>
            <h3 class="p-title">Strawberry Ricespud Mini Plush</h3>
            <span class="p-vendor">noodoll</span>
            <button class="quick-add-btn">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h12l-1 11H5L4 6z" />
                <path d="M7 6V4a3 3 0 016 0v2" />
              </svg>
              Quick Add
            </button>
          </div>
        </article>

        <!-- Product 4: The Mushroom Collection -->
        <article class="product-item-card">
          <div class="p-thumb-wrap">
            <img src="/assets/kidu/mushroom.jpg" alt="The Mushroom Collection" class="p-img" />
            <span class="p-save-chip">Save $2.00</span>
            <div class="p-swatches-top">
              <span class="sw-dot sw-red active"></span>
              <span class="sw-dot sw-brown"></span>
              <span class="sw-dot sw-pink"></span>
            </div>
          </div>
          <div class="p-info">
            <span class="p-stock-tag">In stock</span>
            <div class="p-prices">
              <span class="p-price-now">From $23.00</span>
              <s class="p-price-old">$25.00</s>
            </div>
            <h3 class="p-title">The Mushroom Collection</h3>
            <span class="p-vendor">noodoll</span>
            <button class="quick-add-btn">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h12l-1 11H5L4 6z" />
                <path d="M7 6V4a3 3 0 016 0v2" />
              </svg>
              Quick Add
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== MEDIA WITH TEXT (SAND / OATMEAL) ==================== -->
  <section class="media-with-text-section" id="about">
    <div class="container">
      <div class="mwt-card-sand">
        <div class="mwt-media">
          <img src="/assets/kidu/media-with-text.png" alt="Quality stuffed toys" class="mwt-img" />
          <div class="video-play-btn">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="#FFFFFF">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>

        <div class="mwt-copy">
          <span class="mwt-tag">Unmatched Quality</span>
          <h2 class="mwt-title">Our Commitment to Excellence</h2>
          <p class="mwt-desc">
            Explore worry-free play with Kidu. Our toys meet the highest safety standards, crafted from non-toxic, hypoallergenic materials, and we guarantee your child's satisfaction. For trusted quality, whimsy and boundless joy, choose us.
          </p>
          <a href="#catalog" class="btn btn-dark">
            <span class="arrow">→</span> Explore Kidu
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED COLLECTION TABSET ==================== -->
  <section class="featured-tabset-section">
    <div class="container">
      <h2 class="section-title-left">Shop by Category</h2>

      <div class="tabset-layout">
        <!-- 6-Product Thumbnail Grid -->
        <div class="tab-products-column">
          <div class="tab-product-header">
            <h3 class="tab-title-cur">Little Lights</h3>
            <a href="#lights" class="view-all-link">View All <span class="arrow">→</span></a>
          </div>

          <div class="thumbs-grid-6">
            <div class="thumb-item"><img src="/assets/kidu/cat-lights.jpg" alt="Ricelogi" /></div>
            <div class="thumb-item"><img src="/assets/kidu/ricecarrot.jpg" alt="Ricepudding" /></div>
            <div class="thumb-item"><img src="/assets/kidu/riceminty.jpg" alt="Ricepuffy" /></div>
            <div class="thumb-item"><img src="/assets/kidu/ricemogu.jpg" alt="Ricemogu" /></div>
            <div class="thumb-item"><img src="/assets/kidu/strawberry-ricespud.jpg" alt="Ricedino" /></div>
            <div class="thumb-item"><img src="/assets/kidu/riceminty.jpg" alt="Riceminty" /></div>
          </div>
        </div>

        <!-- Sidebar Category Switcher Card -->
        <aside class="tab-sidebar-card">
          <div class="sidebar-img-wrap">
            <img src="/assets/kidu/featured-tab-img.png" alt="Categories illustration" />
          </div>
          <div class="sidebar-tabs-list">
            <button class="s-tab-btn active">
              <span>Little Lights</span>
              <span class="arrow">→</span>
            </button>
            <button class="s-tab-btn">
              <span>Face Masks</span>
              <span class="arrow">→</span>
            </button>
            <button class="s-tab-btn">
              <span>Stickers</span>
              <span class="arrow">→</span>
            </button>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ==================== 4-COLUMN VALUE PROPS ==================== -->
  <section class="value-props-section">
    <div class="container">
      <div class="value-props-grid-4">
        <div class="vp-item">
          <div class="vp-icon">🚚</div>
          <h4 class="vp-title">Free shipping over $200</h4>
          <p class="vp-desc">Enjoy the freedom of free shipping on all orders over $200.</p>
        </div>
        <div class="vp-item">
          <div class="vp-icon">🌍</div>
          <h4 class="vp-title">We ship worldwide</h4>
          <p class="vp-desc">Experience global reach with our fast, tracked international shipping.</p>
        </div>
        <div class="vp-item">
          <div class="vp-icon">🪡</div>
          <h4 class="vp-title">Free repairs for life</h4>
          <p class="vp-desc">Rest easy knowing your beloved plush purchase includes free repairs for life.</p>
        </div>
        <div class="vp-item">
          <div class="vp-icon">⭐</div>
          <h4 class="vp-title">Satisfaction guaranteed</h4>
          <p class="vp-desc">Your little one's happiness is our unwavering promise — guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== GIFT CARDS CAROUSEL ==================== -->
  <section class="giftcards-section" id="giftcards">
    <div class="container">
      <div class="gift-header">
        <h2 class="section-title-left">Gift Cards</h2>
        <span class="gift-sub">Send gift cards to your loved ones anywhere in the world.</span>
      </div>

      <div class="giftcards-grid-4">
        <div class="gift-card-item">
