<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  :root {
    --w-primary: #0075FF;
    --w-primary-hover: #0060D6;
    --w-text-dark: #0F172A;
    --w-text-muted: #64748B;
    --w-bg-light: #F8FAFC;
    --w-card-border: #E2E8F0;
    --w-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --w-font-script: 'Caveat', cursive;
  }

  .wanderly-page {
    font-family: var(--w-font);
    color: var(--w-text-dark);
    background: #FFFFFF;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .w-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* BUTTONS */
  .w-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--w-font);
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    border: none;
  }

  .w-btn-primary {
    background: var(--w-primary);
    color: #FFFFFF;
    padding: 10px 22px;
    font-size: 14px;
  }

  .w-btn-primary:hover {
    background: var(--w-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 117, 255, 0.35);
  }

  .w-btn-lg {
    padding: 12px 30px;
    font-size: 15px;
    border-radius: 9px;
  }

  /* NAVIGATION */
  .w-navbar-wrapper {
    position: relative;
    width: 100%;
    background: #FFFFFF;
    border-bottom: 1px solid rgba(226, 232, 240, 0.7);
    z-index: 50;
  }

  .w-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .w-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--w-text-dark);
  }

  .w-logo-icon {
    width: 32px;
    height: 32px;
  }

  .w-logo-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .w-logo-text {
    display: flex;
    flex-direction: column;
  }

  .w-brand-name {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #0F172A;
  }

  .w-brand-tagline {
    font-size: 9.5px;
    font-weight: 500;
    color: #64748B;
    letter-spacing: 0.02em;
  }

  .w-nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .w-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 14.5px;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
    position: relative;
    padding: 6px 0;
  }

  .w-nav-link:hover {
    color: var(--w-primary);
  }

  .w-nav-link.active {
    color: var(--w-primary);
    font-weight: 600;
  }

  .w-nav-indicator {
    width: 100%;
    height: 2.5px;
    background: var(--w-primary);
    border-radius: 999px;
    margin-top: 3px;
    position: absolute;
    bottom: 0;
  }

  .w-nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .w-icon-btn {
    background: transparent;
    border: none;
    color: #334155;
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .w-icon-btn:hover {
    background: #F1F5F9;
    color: var(--w-primary);
  }

  /* HERO SECTION */
  .w-hero-section {
    position: relative;
    min-height: 520px;
    padding: 44px 0 54px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .w-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .w-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .w-hero-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.96) 0%,
      rgba(255, 255, 255, 0.88) 38%,
      rgba(255, 255, 255, 0.3) 65%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .w-hero-container {
    position: relative;
    z-index: 2;
  }

  .w-hero-content {
    max-width: 500px;
    margin-bottom: 36px;
  }

  .w-hero-script {
    font-family: var(--w-font-script);
    font-size: 34px;
    color: #0284C7;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 2px;
    line-height: 1;
  }

  .w-hero-title {
    font-size: clamp(40px, 4.8vw, 58px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #0F172A;
    margin: 6px 0 14px;
  }

  .w-hero-subtitle {
    font-size: 14.5px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
    max-width: 440px;
  }

  /* SEARCH WIDGET */
  .w-search-widget {
    background: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1), 0 4px 10px rgba(15, 23, 42, 0.04);
    display: flex;
    align-items: center;
    padding: 10px 12px;
    max-width: 780px;
    border: 1px solid rgba(226, 232, 240, 0.85);
  }

  .w-search-field {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 14px;
  }

  .w-field-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .w-field-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .w-field-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.2;
  }

  .w-field-sub {
    font-size: 12px;
    color: #94A3B8;
    white-space: nowrap;
  }

  .w-field-input {
    border: none;
    outline: none;
    font-size: 12px;
    color: #334155;
    padding: 0;
    background: transparent;
    font-family: var(--w-font);
    width: 100%;
  }

  .w-field-input::placeholder {
    color: #94A3B8;
  }

  .w-field-divider {
    width: 1px;
    height: 32px;
    background: #E2E8F0;
    flex-shrink: 0;
  }

  .w-search-submit {
    background: var(--w-primary);
    color: #FFFFFF;
    padding: 12px 30px;
    font-size: 14.5px;
    font-weight: 600;
    border-radius: 10px;
    flex-shrink: 0;
    margin-left: 6px;
  }

  .w-search-submit:hover {
    background: var(--w-primary-hover);
    box-shadow: 0 4px 14px rgba(0, 117, 255, 0.35);
  }

  /* SECTION SPACING */
  .w-section {
    padding: 44px 0;
  }

  .w-section-sm {
    padding: 22px 0;
  }

  .w-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .w-section-title {
    font-size: 23px;
    font-weight: 750;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .w-section-link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--w-primary);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .w-section-link:hover {
    text-decoration: underline;
    opacity: 0.85;
  }

  /* POPULAR DESTINATIONS */
  .w-popular-grid {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 30px;
    align-items: center;
  }

  .w-benefit-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .w-benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .w-benefit-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-blue {
    background: #EFF6FF;
  }

  .icon-green {
    background: #F0FDF4;
  }

  .icon-indigo {
    background: #EEF2FF;
  }

  .w-benefit-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 2px;
  }

  .w-benefit-desc {
    font-size: 12px;
    color: #64748B;
    margin: 0;
  }

  .w-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .w-carousel-nav {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #334155;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .w-carousel-nav:hover {
    background: var(--w-primary);
    color: #FFFFFF;
    border-color: var(--w-primary);
  }

  .w-carousel-nav.w-prev {
    left: -18px;
  }

  .w-carousel-nav.w-next {
    right: -18px;
  }

  .w-destination-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    width: 100%;
  }

  .w-dest-card {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #F1F5F9;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .w-dest-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.1);
  }

  .w-dest-img-box {
    width: 100%;
    height: 155px;
    overflow: hidden;
  }

  .w-dest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .w-dest-card:hover .w-dest-img {
    transform: scale(1.05);
  }

  .w-dest-info {
    padding: 12px 14px;
  }

  .w-dest-top-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 5px;
  }

  .w-dest-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #0F172A;
    margin: 0;
  }

  .w-dest-price {
    font-size: 14.5px;
    font-weight: 750;
    color: var(--w-primary);
  }

  .w-price-prefix {
    font-size: 11px;
    font-weight: 500;
    color: #64748B;
    margin-right: 2px;
  }

  .w-dest-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
  }

  .w-stars {
    display: flex;
    color: #F59E0B;
    font-size: 12px;
    line-height: 1;
  }

  .w-rating-val {
    font-weight: 700;
    color: #0F172A;
