---
// Wanderly Travel Landing Page
---

<div class="wanderly-page">
  <!-- Top Navigation -->
  <header class="w-navbar-wrapper">
    <div class="w-container w-navbar">
      <a href="#home" class="w-logo">
        <div class="w-logo-icon">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="16" cy="16" r="14" stroke="#0075FF" stroke-width="2" />
            <circle cx="16" cy="16" r="7" stroke="#0075FF" stroke-width="1.5" />
            <path d="M16 2V6M16 26V30M2 16H6M26 16H30" stroke="#0075FF" stroke-width="2" stroke-linecap="round" />
            <path d="M21 11L14 14L11 21L18 18L21 11Z" fill="#0075FF" />
          </svg>
        </div>
        <div class="w-logo-text">
          <span class="w-brand-name">Wanderly</span>
          <span class="w-brand-tagline">Explore. Dream. Discover.</span>
        </div>
      </a>

      <nav class="w-nav-links">
        <a href="#home" class="w-nav-link active">
          <span>Home</span>
          <span class="w-nav-indicator"></span>
        </a>
        <a href="#destinations" class="w-nav-link">Destinations</a>
        <a href="#tours" class="w-nav-link">Tours</a>
        <a href="#about" class="w-nav-link">About Us</a>
        <a href="#blog" class="w-nav-link">Blog</a>
        <a href="#contact" class="w-nav-link">Contact</a>
      </nav>

      <div class="w-nav-actions">
        <button class="w-icon-btn" aria-label="Search" title="Search">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <button class="w-icon-btn" aria-label="Account" title="My Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </button>
        <a href="#book" class="w-btn w-btn-primary">Book Now</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="w-hero-section" id="home">
    <div class="w-hero-bg">
      <img
        src="/assets/wanderly/hero-santorini.jpg"
        alt="Woman overlooking ocean and Santorini"
        class="w-hero-img"
        loading="eager"
      />
      <div class="w-hero-gradient"></div>
    </div>

    <div class="w-container w-hero-container">
      <div class="w-hero-content">
        <span class="w-hero-script">Explore the World</span>
        <h1 class="w-hero-title">
          Adventure<br />
          Awaits You
        </h1>
        <p class="w-hero-subtitle">
          Discover breathtaking destinations, unforgettable experiences and create memories that last a lifetime.
        </p>
      </div>

      <!-- Floating Search Bar -->
      <div class="w-search-widget">
        <div class="w-search-field">
          <div class="w-field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="w-field-text">
            <span class="w-field-label">Where to?</span>
            <input type="text" class="w-field-input" placeholder="Search destinations" value="" />
          </div>
        </div>

        <div class="w-field-divider"></div>

        <div class="w-search-field">
          <div class="w-field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="w-field-text">
            <span class="w-field-label">Check In</span>
            <span class="w-field-sub">Add dates</span>
          </div>
        </div>

        <div class="w-field-divider"></div>

        <div class="w-search-field">
          <div class="w-field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="w-field-text">
            <span class="w-field-label">Check Out</span>
            <span class="w-field-sub">Add dates</span>
          </div>
        </div>

        <div class="w-field-divider"></div>

        <div class="w-search-field">
          <div class="w-field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="w-field-text">
            <span class="w-field-label">Travelers</span>
            <span class="w-field-sub">2 Travelers</span>
          </div>
        </div>

        <button class="w-btn w-search-submit">Search</button>
      </div>
    </div>
  </section>

  <!-- Popular Destinations Section -->
  <section class="w-section" id="destinations">
    <div class="w-container">
      <div class="w-section-header">
        <h2 class="w-section-title">Popular Destinations</h2>
        <a href="#destinations" class="w-section-link">View All Destinations</a>
      </div>

      <div class="w-popular-grid">
        <!-- Left Column: 3 Benefit Features -->
        <div class="w-benefit-list">
          <div class="w-benefit-item">
            <div class="w-benefit-icon icon-blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="w-benefit-content">
              <h3 class="w-benefit-title">Top Rated Places</h3>
              <p class="w-benefit-desc">Handpicked top destinations</p>
            </div>
          </div>

          <div class="w-benefit-item">
            <div class="w-benefit-icon icon-green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                <circle cx="12" cy="12" r="9" stroke="#16A34A" stroke-width="1.5" fill="none"></circle>
              </svg>
            </div>
            <div class="w-benefit-content">
              <h3 class="w-benefit-title">Best Price Guarantee</h3>
              <p class="w-benefit-desc">Get the best deals always</p>
            </div>
          </div>

          <div class="w-benefit-item">
            <div class="w-benefit-icon icon-indigo">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </div>
            <div class="w-benefit-content">
              <h3 class="w-benefit-title">24/7 Travel Support</h3>
              <p class="w-benefit-desc">We are here to help you</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Carousel Destination Cards -->
        <div class="w-carousel-wrapper">
          <button class="w-carousel-nav w-prev" aria-label="Previous destination">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="w-destination-cards">
            <!-- Card 1: Bali -->
            <div class="w-dest-card">
              <div class="w-dest-img-box">
                <img src="/assets/wanderly/bali.jpg" alt="Bali, Indonesia" class="w-dest-img" />
              </div>
              <div class="w-dest-info">
                <div class="w-dest-top-row">
                  <h4 class="w-dest-title">Bali, Indonesia</h4>
                  <span class="w-dest-price"><span class="w-price-prefix">From</span> $499</span>
                </div>
                <div class="w-dest-meta">
                  <div class="w-stars">
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                  </div>
                  <span class="w-rating-val">4.8</span>
                  <span class="w-rating-count">(1.2k)</span>
                </div>
              </div>
            </div>

            <!-- Card 2: Switzerland -->
            <div class="w-dest-card">
              <div class="w-dest-img-box">
                <img src="/assets/wanderly/switzerland.jpg" alt="Switzerland" class="w-dest-img" />
              </div>
              <div class="w-dest-info">
                <div class="w-dest-top-row">
                  <h4 class="w-dest-title">Switzerland</h4>
                  <span class="w-dest-price"><span class="w-price-prefix">From</span> $899</span>
                </div>
                <div class="w-dest-meta">
                  <div class="w-stars">
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                  </div>
                  <span class="w-rating-val">4.9</span>
                  <span class="w-rating-count">(980)</span>
                </div>
              </div>
            </div>

            <!-- Card 3: Santorini -->
            <div class="w-dest-card">
              <div class="w-dest-img-box">
                <img src="/assets/wanderly/santorini.jpg" alt="Santorini, Greece" class="w-dest-img" />
              </div>
              <div class="w-dest-info">
                <div class="w-dest-top-row">
                  <h4 class="w-dest-title">Santorini, Greece</h4>
                  <span class="w-dest-price"><span class="w-price-prefix">From</span> $699</span>
                </div>
                <div class="w-dest-meta">
                  <div class="w-stars">
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                    <span class="w-star">★</span>
                  </div>
                  <span class="w-rating-val">4.7</span>
                  <span class="w-rating-count">(1.5k)</span>
                </div>
              </div>
            </div>
          </div>

          <button class="w-carousel-nav w-next" aria-label="Next destination">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore by Category Section -->
  <section class="w-section" id="tours">
    <div class="w-container">
      <div class="w-section-header">
        <h2 class="w-section-title">Explore by Category</h2>
        <a href="#categories" class="w-section-link">View All Categories</a>
      </div>

      <div class="w-categories-grid">
        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-beach.jpg" alt="Beach Holidays" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">Beach Holidays</h4>
          <span class="w-cat-count">132 Tours</span>
        </div>

        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-mountain.jpg" alt="Mountain Adventures" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">Mountain Adventures</h4>
          <span class="w-cat-count">98 Tours</span>
        </div>

        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-city.jpg" alt="City Breaks" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">City Breaks</h4>
          <span class="w-cat-count">76 Tours</span>
        </div>

        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-cultural.jpg" alt="Cultural Tours" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">Cultural Tours</h4>
          <span class="w-cat-count">54 Tours</span>
        </div>

        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-safari.jpg" alt="Wildlife Safaris" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">Wildlife Safaris</h4>
          <span class="w-cat-count">42 Tours</span>
        </div>

        <div class="w-cat-card">
          <div class="w-cat-img-box">
            <img src="/assets/wanderly/cat-cruise.jpg" alt="Cruise Trips" class="w-cat-img" />
          </div>
          <h4 class="w-cat-title">Cruise Trips</h4>
          <span class="w-cat-count">36 Tours</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics / Stats Strip -->
  <section class="w-stats-section">
    <div class="w-container">
      <div class="w-stats-bar">
        <div class="w-stat-item">
          <div class="w-stat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="w-stat-info">
            <span class="w-stat-number">10K+</span>
            <span class="w-stat-label">Happy Travelers</span>
          </div>
        </div>

        <div class="w-stat-item">
          <div class="w-stat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </div>
          <div class="w-stat-info">
            <span class="w-stat-number">150+</span>
            <span class="w-stat-label">Destinations</span>
          </div>
        </div>

        <div class="w-stat-item">
          <div class="w-stat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
              <line x1="6" y1="12" x2="6.01" y2="12"></line>
              <line x1="10" y1="12" x2="14" y2="12"></line>
              <line x1="18" y1="12" x2="18.01" y2="12"></line>
            </svg>
          </div>
          <div class="w-stat-info">
            <span class="w-stat-number">500+</span>
            <span class="w-stat-label">Tours & Activities</span>
          </div>
        </div>

        <div class="w-stat-item">
          <div class="w-stat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="w-stat-info">
            <span class="w-stat-number">98%</span>
            <span class="w-stat-label">Positive Reviews</span>
          </div>
        </div>

        <div class="w-stat-item">
          <div class="w-stat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0075FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="w-stat-info">
            <span class="w-stat-number">24/7</span>
            <span class="w-stat-label">Customer Support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Promo Banner Section -->
  <section class="w-section-sm" id="promo">
    <div class="w-container">
      <div class="w-promo-banner">
        <div class="w-promo-content">
          <span class="w-promo-badge">Limited Time Offer</span>
          <h2 class="w-promo-title">Adventure is Calling!</h2>
          <p class="w-promo-desc">Get up to 30% off on selected tours.</p>
          <a href="#book" class="w-btn w-btn-primary w-btn-lg">Book Now</a>
        </div>
        <div class="w-promo-image-box">
          <img src="/assets/wanderly/promo-diver.jpg" alt="Scuba diving adventure" class="w-promo-img" />
          <div class="w-promo-fade"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Best Travel Deals Section -->
  <section class="w-section" id="deals">
    <div class="w-container">
      <div class="w-section-header">
        <h2 class="w-section-title">Best Travel Deals</h2>
        <a href="#deals" class="w-section-link">View All Deals</a>
      </div>

      <div class="w-deals-grid">
        <!-- Deal 1 -->
        <div class="w-deal-card">
          <div class="w-deal-img-box">
            <span class="w-deal-badge">-20%</span>
            <img src="/assets/wanderly/deal-maldives.jpg" alt="Maldives Escape" class="w-deal-img" />
          </div>
          <div class="w-deal-content">
            <h4 class="w-deal-title">Maldives Escape</h4>
            <span class="w-deal-duration">5 Days / 4 Nights</span>
            <div class="w-deal-price-row">
              <span class="w-deal-price-curr">$799</span>
              <span class="w-deal-price-old">$999</span>
            </div>
          </div>
        </div>

        <!-- Deal 2 -->
        <div class="w-deal-card">
          <div class="w-deal-img-box">
            <span class="w-deal-badge">-15%</span>
            <img src="/assets/wanderly/deal-paris.jpg" alt="European Highlights" class="w-deal-img" />
          </div>
          <div class="w-deal-content">
            <h4 class="w-deal-title">European Highlights</h4>
            <span class="w-deal-duration">7 Days / 6 Nights</span>
            <div class="w-deal-price-row">
              <span class="w-deal-price-curr">$1,199</span>
              <span class="w-deal-price-old">$1,399</span>
            </div>
          </div>
        </div>

        <!-- Deal 3 -->
        <div class="w-deal-card">
          <div class="w-deal-img-box">
            <span class="w-deal-badge">-10%</span>
            <img src="/assets/wanderly/deal-dubai.jpg" alt="Dubai Getaway" class="w-deal-img" />
          </div>
          <div class="w-deal-content">
            <h4 class="w-deal-title">Dubai Getaway</h4>
            <span class="w-deal-duration">4 Days / 3 Nights</span>
            <div class="w-deal-price-row">
              <span class="w-deal-price-curr">$599</span>
              <span class="w-deal-price-old">$699</span>
            </div>
          </div>
        </div>

        <!-- Deal 4 -->
        <div class="w-deal-card">
          <div class="w-deal-img-box">
            <span class="w-deal-badge">-25%</span>
            <img src="/assets/wanderly/deal-iceland.jpg" alt="Iceland Northern Lights" class="w-deal-img" />
          </div>
          <div class="w-deal-content">
            <h4 class="w-deal-title">Iceland Northern Lights</h4>
            <span class="w-deal-duration">6 Days / 5 Nights</span>
            <div class="w-deal-price-row">
              <span class="w-deal-price-curr">$1,049</span>
              <span class="w-deal-price-old">$1,399</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Travel News & Tips Section -->
  <section class="w-section" id="blog">
    <div class="w-container">
      <div class="w-section-header">
        <h2 class="w-section-title">Travel News & Tips</h2>
        <a href="#blog" class="w-section-link">View All Articles</a>
      </div>

      <div class="w-articles-grid">
        <!-- Article 1 -->
        <article class="w-article-card">
          <img src="/assets/wanderly/blog-huts.jpg" alt="10 Tips for a Hassle-Free International Trip" class="w-article-bg" />
          <div class="w-article-overlay"></div>
          <div class="w-article-content">
            <span class="w-article-category">TIPS & GUIDE</span>
            <h3 class="w-article-title">10 Tips for a Hassle-Free International Trip</h3>
            <span class="w-article-meta">May 10, 2024 &bull; 5 min read</span>
          </div>
        </article>

        <!-- Article 2 -->
        <article class="w-article-card">
          <img src="/assets/wanderly/blog-gems.jpg" alt="Top 7 Hidden Gems You Must Visit in 2024" class="w-article-bg" />
          <div class="w-article-overlay"></div>
          <div class="w-article-content">
            <span class="w-article-category">DESTINATIONS</span>
            <h3 class="w-article-title">Top 7 Hidden Gems You Must Visit in 2024</h3>
            <span class="w-article-meta">May 8, 2024 &bull; 6 min read</span>
          </div>
        </article>

        <!-- Article 3 -->
