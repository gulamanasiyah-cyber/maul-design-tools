<script>
  const burb = document.querySelector('.burb');
  if (burb) {
    // Hide header on scroll down, show on scroll up
    const header = burb.querySelector('#burbHeader');
    let lastTop = 0;
    window.addEventListener('scroll', () => {
      const st = window.scrollY || document.documentElement.scrollTop;
      if (Math.abs(lastTop - st) <= 5) return;
      if (st > lastTop && lastTop > 0) header.classList.add('hidden');
      else header.classList.remove('hidden');
      lastTop = st;
    }, { passive: true });

    // Mobile nav
    const burger = burb.querySelector('#burbBurger');
    burger?.addEventListener('click', () => burb.classList.toggle('nav-open'));
    burb.querySelectorAll('.nav-link').forEach((l) =>
      l.addEventListener('click', () => burb.classList.remove('nav-open'))
    );

    // Signup modal
    const modal = burb.querySelector('#burbModal');
    burb.querySelector('#burbLogin')?.addEventListener('click', () => modal?.classList.add('open'));
    burb.querySelector('#burbModalClose')?.addEventListener('click', () => modal?.classList.remove('open'));
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });
  }
</script>
