---
// Burb — How Creators Grow Community. Full recreation of the Webflow landing page.
// Palette: Black #000000, White #FFFFFF, pastel Green #CEEFD0, pastel Orange #FFD6C0,
// pastel Pink #FFE1E1, Salmon #FBC5C4, Green #AFD7B3, Peach #F0B38C.
// Fonts: Ginto Nord (display) → Archivo Black, Neue Montreal (body) → Inter.
// Sections: glass pill header (hide on scroll), black hero with photo-chip headline +
// dashboard shot + marquee, pastel feature-card bento, black how-it-works panel with
// overlapping steps, green testimonials wall, black integrations box with dotted arc,
// join banner with hover invert + footer.
const A = '/assets/burb';

const marqueeItems = [
  'Courses', 'Learning management platforms', 'Email marketing', 'Automation',
  'Scaling Courses', 'Public social', 'Community', 'Social apps', 'Online Chat',
  'Learning community', 'Membership Communities', 'Forums', 'Teaching', 'Online forums'
];
const loop = [...marqueeItems, ...marqueeItems];

const tools = [
  { name: 'Slack', cat: 'Community Platform', logo: `${A}/slack.svg`, bg: '#4a154b' },
  { name: 'Circle', cat: 'Community Platform', logo: `${A}/circle.svg`, bg: '#506bf0' },
  { name: 'Discord', cat: 'Community Platform', logo: `${A}/discord.svg`, bg: '#5865f2' },
  { name: 'Google Workspace', cat: 'Productivity and Communication', logo: `${A}/google.svg`, bg: '#f4f4f4' },
  { name: 'ConvertKit', cat: 'Email Marketing', logo: `${A}/convertkit.svg`, bg: '#fb6970' },
  { name: 'Typeform', cat: 'Forms App', logo: `${A}/typeform.png`, bg: '#000000' },
  { name: 'Thinkific', cat: 'Learning Managment System', logo: `${A}/thinkific.svg`, bg: '#1a365d' },
  { name: 'Teachable', cat: 'Learning Managment System', logo: `${A}/teachable.svg`, bg: '#21cd9c' }
];

const cards = [
  {
    mod: 'greenbg', layout: 'text-top', title: 'Avoid that awkward radio silence.',
    body: 'Start discussions in your channels, spaces, groups, or with members directly in Slack, Circle, Discord, and email—either pre-scheduled or in real-time.',
    img: `${A}/fashion-school.webp`, srcset: `${A}/fashion-school-500.webp 500w, ${A}/fashion-school.webp 800w`, alt: 'Fashion school community'
  },
  {
    mod: 'orangebg', layout: 'img-top', title: 'Let us get everyone settled.',
    body: 'Automatically add members to community spaces or give them access to content in Thinkific, Teachable, and more—without lifting a finger.',
    img: `${A}/group.webp`, srcset: `${A}/group-500.webp 500w, ${A}/group-800.webp 800w, ${A}/group.webp 1228w`, alt: 'Group of creators'
  },
  {
    mod: 'orangebg', layout: 'img-top', title: 'Gather everything you need under one roof.',
    body: 'Access all your member details in one central spot with rich profiles across all apps.',
    img: `${A}/gather-everything.webp`, srcset: `${A}/gather-everything-500.webp 500w, ${A}/gather-everything-800.webp 800w, ${A}/gather-everything.webp 1228w`, alt: 'Gather member profiles'
  },
  {
    mod: 'greenbg', layout: 'text-top', title: 'Declunkify.',
    body: 'Skip the messy workarounds. Sync everything for a unified view of member activity across community platforms, learning management systems, and email marketing platforms.',
    img: `${A}/declunkify.webp`, srcset: `${A}/declunkify-500.webp 500w, ${A}/declunkify-800.webp 800w, ${A}/declunkify.webp 1228w`, alt: 'Unified member view'
  }
];

const steps = [
  { img: `${A}/step1.webp`, srcset: `${A}/step1-500.webp 500w, ${A}/step1.webp 750w`, title: 'Step 1', text: 'Connect your community, marketing, and online course platforms.' },
  { img: `${A}/step2.webp`, srcset: `${A}/step2-500.webp 500w, ${A}/step2.webp 752w`, title: 'Step 2', text: "Understand the full range of your members' journeys, engagement, and activities." },
  { img: `${A}/step3.webp`, srcset: `${A}/step3-500.webp 500w, ${A}/step3.webp 750w`, title: 'Step 3', text: 'Create workflows, schedule messages, and track the success of your community-building strategies.' }
];

const quotes = [
  {
    name: 'Tatiana Figueiredo', role: 'Build A Community Business', logo: null, tint: '#fbc5c4',
    img: `${A}/tatiana-figueiredo.png`, alt: 'Tatiana Figueiredo',
    text: 'A thoughtful tool by great, community-minded humans.'
  },
  {
    name: 'Jillian Benbow', role: 'Senior Community Manager', logo: `${A}/spi.svg`, tint: '#ceefd0',
    img: `${A}/jillian-benbow.png`, alt: 'Jillian Benbow',
    text: 'Burb gives us the tools to make intelligent engagement decisions and get real time analytics.'
  },
  {
    name: 'Bryony Cole', role: 'Founder', logo: `${A}/sextech-school.png`, tint: '#fbc5c4',
    img: `${A}/bryony-cole.png`, alt: 'Bryony Cole',
    text: 'Burb allowed me to serve 50 people at once instead of 12.'
  },
  {
    name: 'Carrie Melissa Jones', role: 'Entrepreneur', logo: `${A}/cmj.png`, tint: '#afd7b3',
    img: `${A}/carrie-melissa-jones.png`, alt: 'Carrie Melissa Jones',
    text: 'Burb helps me build deeper relationships with my community members, and their team is INCREDIBLE!'
  }
];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" />

<div class="burb">
  <!-- ==================== HEADER ==================== -->
  <header class="header" id="burbHeader">
    <div class="head-container">
      <div class="header-row">
        <a href="#top" class="brand"><img src={`${A}/logo.svg`} alt="Burb" /></a>
        <nav class="nav-menu" id="burbNav">
          <div class="nav-list">
            <a href="#creators" class="nav-link">Product</a>
            <a href="#how" class="nav-link">Blog</a>
            <a href="#customers" class="nav-link">Resources</a>
            <a href="#integrations" class="nav-link">Pricing</a>
          </div>
          <div class="nav-box" id="burbLogin">Log In</div>
        </nav>
        <button class="navmenu-icon" id="burbBurger" aria-label="Menu">
          <img src={`${A}/menu.svg`} alt="" class="ic-open" />
          <img src={`${A}/close-menu.svg`} alt="" class="ic-close" />
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== SIGNUP MODAL ==================== -->
  <div class="modal-wrapper" id="burbModal">
    <button class="close-modal-button" id="burbModalClose" aria-label="Close">
      <img src={`${A}/modal-close.webp`} alt="" />
    </button>
    <div class="detail-form-modal">
      <h2 class="heading5-2">Tell us a little more about yourself</h2>
      <form class="details-form" onsubmit="return false">
        <input type="text" class="input-default" placeholder="Full Name" />
        <input type="email" class="input-default" placeholder="Email" required />
        <input type="text" class="input-default" placeholder="Twitter Handle (optional)" />
        <button type="submit" class="button-3 w100">Continue</button>
      </form>
    </div>
  </div>

  <!-- ==================== HERO ==================== -->
  <section class="hero-section" id="top">
    <div class="container pr">
      <div class="hero-head">
        <div class="headingbox">
          <h1 class="heading2 white">How</h1>
          <div class="box106"><img src={`${A}/lady.webp`} alt="Lady" width="106" /></div>
          <h1 class="heading2 white"><span class="orangetext whitetext">Creators</span></h1>
        </div>
        <div class="headingbox padding">
          <h1 class="heading2 white"><span class="green-text whitetext">Operate</span></h1>
          <div class="box80"><img src={`${A}/handwrench.png`} alt="Hand holding a wrench" width="106" class="pineappleimg" /></div>
        </div>
        <h1 class="heading2 white pad">Community.</h1>
      </div>
      <div class="hero-row">
        <div class="hero-img">
          <img
            src={`${A}/hero-img.webp`}
            srcset={`${A}/hero-img-500.webp 500w, ${A}/hero-img-800.webp 800w, ${A}/hero-img.webp 1628w`}
            sizes="(max-width: 991px) 93vw, 50vw"
            width="814" alt="Burb dashboard" class="heroimg"
          />
        </div>
        <div class="hero-detail">
          <h3 class="heading3 white none">How Creators Operate Community.</h3>
          <p class="hero-p">Easy automation and analytics for your community on Circle, Slack, and Discord.</p>
          <a href="#creators" class="button-3 w100">
            <span class="btn-text">Learn More</span>
            <span class="btn-icon"><i class="bi bi-t"></i><i class="bi bi-b"></i><i class="bi bi-big"></i></span>
          </a>
        </div>
      </div>
    </div>
    <div class="marquee hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        {loop.map((t) => <span class="hero-item"><span class="herotext">{t}</span></span>)}
      </div>
    </div>
    <div class="roundicon">
      <img
        src={`${A}/dot.webp`}
        srcset={`${A}/dot-500.png 500w, ${A}/dot-1080.png 1080w, ${A}/dot-1600.webp 1600w, ${A}/dot.webp 2976w`}
        sizes="100vw" width="1488" alt="" loading="lazy"
      />
    </div>
  </section>

  <!-- ==================== FEATURE CARDS ==================== -->
  <section class="slider-section" id="creators">
    <div class="container pr max1608">
      <div class="communityhead">
        <h3 class="heading4">Top educational creators have engaged communities <br /> <span class="pinktext">now you can too!</span></h3>
      </div>
      <div class="community-list">
        <div class="community-item fullitem">
          <div class="community-box max560">
            <h5 class="heading5">Take a peek around.</h5>
            <p class="p20 mb40">Peruse insights from community activity, online courses, and private spaces to really understand how to get—and keep—your members engaged.</p>
            <a href="#how" class="button-link">
              <span>Learn More</span>
              <span class="linkiconbox"><i class="li li-one"></i><i class="li li-two"></i><i class="li li-three"></i></span>
            </a>
          </div>
          <div class="community-img communityimg">
            <img
              src={`${A}/chart2x-800.webp`}
              srcset={`${A}/chart2x-500.webp 500w, ${A}/chart2x-800.webp 800w`}
              sizes="(max-width: 991px) 100vw, 41vw"
              width="896" alt="Line graph of new members and course enrollments" class="fullimg" loading="lazy"
            />
          </div>
        </div>

        {cards.map((c) => (
          <div class={`community-item ${c.mod}`}>
            {c.layout === 'img-top' && (
              <div class="community-img pb40">
                <img src={c.img} srcset={c.srcset} sizes="(max-width: 991px) 100vw, 38vw" width="614" alt={c.alt} loading="lazy" />
              </div>
            )}
            <div class="community-box pb40">
              <h5 class="heading5">{c.title}</h5>
              <p class="p20 mb40 max500">{c.body}</p>
              <a href="#how" class="button-link">
                <span>Learn More</span>
                <span class="linkiconbox"><i class="li li-one"></i><i class="li li-two"></i><i class="li li-three"></i></span>
              </a>
            </div>
            {c.layout === 'text-top' && (
              <div class="community-img">
                <img src={c.img} srcset={c.srcset} sizes="(max-width: 991px) 100vw, 38vw" width="614" alt={c.alt} loading="lazy" />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== HOW IT WORKS ==================== -->
  <section class="community-section" id="how">
    <div class="container pr2">
      <div class="communityicon">
        <img src={`${A}/team.webp`} srcset={`${A}/team-500.webp 500w, ${A}/team.webp 684w`} sizes="(max-width: 991px) 200px, 342px" width="342" alt="A graphic of a team of people" loading="lazy" />
      </div>
      <div class="howitworksbox">
        <h2 class="heading3 white"><span class="pr20">Here's how</span> <span class="green-text">it works</span></h2>
        <div class="heading5 white">You're busy, so we'll make this easy.</div>
      </div>
      <div class="steplist">
        {steps.map((s) => (
          <div class="stepitem">
            <div class="stepbox">
              <img src={s.img} srcset={s.srcset} sizes="(max-width: 991px) 86vw, 23vw" width="375" alt={s.title} loading="lazy" />
            </div>
            <div class="heading5">{s.title}</div>
            <p class="p24 mb0 font20">{s.text}</p>
          </div>
        ))}
      </div>
      <div class="blackbox"><div class="blackbg"></div></div>
    </div>
  </section>

  <!-- ==================== CUSTOMERS ==================== -->
  <section class="customer-section" id="customers">
    <div class="container pr">
      <div class="customer-row">
        <div class="customer-head">
          <h1 class="heading lh110"><span class="font200">Our</span> <span class="font112">customers</span></h1>
          <h1 class="heading white font40">
            l<span class="box89" style={`background-image:url(${A}/gabrielle.png)`}></span>ve us.
          </h1>
        </div>
        <div class="customertwo-wrap">
          <div class="customertwo-item pb40">
            <div class="customer-box max470">
              <div class="customerrow">
                <div class="customer-img" style="background-color:#ffd6c0">
                  <img src={`${A}/nivi-achanta.png`} alt="Nivi Achanta" class="customerimg" />
                </div>
                <div class="customer-detail">
                  <div class="subheading2 bold">Nivi Achanta</div>
                  <div class="customer-logo"><div class="customer-text">Founder &amp; CEO at Soapbox Project</div></div>
                </div>
              </div>
              <div class="p20 richtext">
                <p>Burb has been designed with true human connection in mind - it's helping me scale not just community operations, but also thoughtful leadership, gratitude, and joy within the Soapbox Project community. <a href="#customers" class="case-link"><sub>Read case study.</sub></a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="customer-wrap">
        {quotes.map((q) => (
          <div class="customer-item">
            <div class="customer-box">
              <div class="customerrow">
                <div class="customer-img" style={`background-color:${q.tint}`}>
                  <img src={q.img} alt={q.alt} class="customerimg" loading="lazy" />
                </div>
                <div class="customer-detail">
                  <div class="subheading2 bold font18">{q.name}</div>
                  <div class="customer-logo">
                    <div class="customer-text">{q.role}</div>
                    {q.logo && <img src={q.logo} alt="" loading="lazy" />}
                  </div>
                </div>
              </div>
              <div class="p20 richtext"><p>{q.text}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="marquee customer-marquee" aria-hidden="true">
      <div class="marquee-track">
        {loop.map((t) => <span class="hero-item"><span class="herotext blacktext">{t}</span></span>)}
      </div>
    </div>
  </section>

  <!-- ==================== INTEGRATIONS ==================== -->
  <section class="integration-section" id="integrations">
    <div class="greenboxbg"></div>
    <div class="integrationbg">
      <div class="integrationbox">
        <div class="container">
          <h2 class="heading2 white mb40"><span class="orangetext">Integrations<br /></span>We've got 'em</h2>
          <div class="integrationrow">
            <h5 class="heading5 white max570 font20">Don't worry, we play nice with the tools you're already using.</h5>
          </div>
          <div class="tools-list">
            {tools.map((t) => (
              <div class="toolsitem">
                <div class="tools-item">
                  <div class="toolsimg" style={`background-color:${t.bg}`}>
                    <img src={t.logo} alt={t.name} width="175" loading="lazy" />
                  </div>
                  <div class="toolsbox">
                    <div class="subheading2 bold">{t.name}</div>
                    <div>{t.cat}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="integrationdotimgbox">
        <img src={`${A}/dot-arc.svg`} alt="" class="integrationdotimg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ==================== FOOTER ==================== -->
  <section class="footer">
    <div class="joinblock">
      <div class="container">
        <div class="joinrow">
          <div class="joinushead">
            <div class="joinuscol1">
              <h1 class="heading white mb0">Join us in the <span class="pinktext">'burbs</span></h1>
            </div>
            <div class="joinuscol2">
              <div class="subheading pb15">We'll manage the mundane so you have the space (and brainpower) to create an experience your community can't get enough of.</div>
              <a href="#top" class="button-3 w100">
                <span class="btn-text">Learn More</span>
                <span class="btn-icon"><i class="bi bi-t"></i><i class="bi bi-b"></i><i class="bi bi-big"></i></span>
              </a>
            </div>
          </div>
          <div class="joinimg">
            <img
              src={`${A}/jointeam.webp`}
              srcset={`${A}/jointeam-500.webp 500w, ${A}/jointeam-800.webp 800w, ${A}/jointeam.webp 2628w`}
              sizes="(max-width: 991px) 88vw, 85vw" alt="Join the team" class="img" loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="footerblock">
      <div class="container1680">
        <div class="footerrow">
          <div class="footercol1">
            <div class="max750">
              <div class="footeritem pr165">
                <div class="subheading2 bold white">Company</div>
                <div class="footerlist">
                  <a href="#top" class="footlink">About Us</a>
                  <a href="#how" class="footlink">Blog</a>
                  <a href="#creators" class="footlink">Use Cases</a>
                  <span class="footlink nolink">Docs</span>
                </div>
              </div>
              <div class="footeritem"><div class="subheading2 bold white">Socials</div></div>
              <div class="socialbox-2">
                <a href="https://twitter.com/burbteam" target="_blank" rel="noopener noreferrer" class="socialicon-2 w88">
                  <img src={`${A}/twittericon.svg`} alt="Twitter" />
                </a>
                <a href="https://www.instagram.com/burbteam/" target="_blank" rel="noopener noreferrer" class="socialicon-2">
                  <img src={`${A}/instagram.webp`} alt="Instagram" width="35" />
                </a>
              </div>
              <div class="socialbox-2">
                <a href="https://www.tiktok.com/@burbteam" target="_blank" rel="noopener noreferrer" class="socialicon-2">
                  <img src={`${A}/tiktok.svg`} alt="TikTok" class="image-15" />
                </a>
                <a href="https://twitter.com/burbteam" target="_blank" rel="noopener noreferrer" class="socialicon-2 w88">
                  <img src={`${A}/facebook.svg`} alt="Facebook" />
                </a>
              </div>
            </div>
          </div>
          <div class="footercol2">
            <div class="footercolbox">
              <div class="subheading2 bold white mb25">Contact</div>
              <a href="mailto:hello@burb.co" class="footerlink">hello@burb.co</a>
              <div class="footerlink hovernone">2323 Broadway Oakland, CA 94612</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="footerbottom">
      <div class="container1680 p0">
        <div class="footerrow auto">
          <div class="footercol1 p30">
            <div class="foottext">© 2023 Burb Inc. Copyrights</div>
            <div class="policynav">
              <a href="#top" class="footlink mr60 font16">Terms of Services</a>
              <a href="#top" class="footlink mb0 font16">Privacy Policy</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* ============ BASE ============ */
  .burb {
    font-family: 'Inter', 'Neue Montreal', sans-serif;
    color: #000;
    font-size: 18px;
    line-height: 32px;
    font-weight: 400;
    background: #fff;
    overflow-x: clip;
  }
  .burb * { box-sizing: border-box; }
  .burb h1, .burb h2, .burb h3, .burb h5, .burb p { margin: 0; }
  .burb a { color: inherit; text-decoration: none; }
  .burb img { max-width: 100%; display: inline-block; }
  .white { color: #fff; }
  .orangetext { color: #f0b38c; }
  .orangetext.whitetext { color: #fff; }
  .green-text { color: #afd7b3; }
  .green-text.whitetext { color: #fff; padding-right: 10px; }
  .pinktext { color: #fbc5c4; }
  .pr20 { padding-right: 20px; }
  .pb15 { padding-bottom: 15px; }
  .pb40 { padding-bottom: 40px; }
  .mb0 { margin-bottom: 0; }
  .mb25 { margin-bottom: 25px; }
  .mb40 { margin-bottom: 40px; }
  .max500 { max-width: 500px; }
  .max570 { max-width: 610px; padding-right: 15px; }
  .font18 { font-size: 18px; }
  .font20 { font-size: 20px; line-height: 28px; }

  .container { max-width: 1548px; margin: 0 auto; padding: 0 30px; }
  .container.pr { position: relative; }
  .container.max1608 { max-width: 1608px; padding: 0 60px 40px; }
  .container1680 { max-width: 1680px; margin: 0 auto; padding: 0 40px; }
  .container1680.p0 { padding: 0; }

  /* ============ TYPO ============ */
  .heading2, .heading3, .heading4, .heading {
    font-family: 'Archivo Black', 'Ginto Nord', sans-serif;
    font-weight: 400;
  }
  .heading2 { font-size: 96px; line-height: 96px; }
  .heading3 { font-size: 80px; line-height: 88px; margin-bottom: 16px; }
  .heading4 { font-size: 72px; line-height: 88px; margin-bottom: 16px; }
  .heading { font-size: 140px; line-height: 140px; }
  .heading.lh110 { line-height: 110px; }
  .font200 { font-size: 200px; line-height: 200px; }
  .font112 { font-size: 112px; line-height: 112px; }
  .heading.white.font40 { font-size: 40px; line-height: 40px; }
  .heading5 { color: #000; font-size: 40px; line-height: 48px; font-weight: 700; }
  .subheading2 { font-size: 24px; line-height: 30px; font-weight: 400; }
  .subheading2.bold { font-weight: 700; }
  .subheading2.bold.white { color: #fff; }
  .p20 { font-size: 20px; line-height: 32px; }
  .p24 { font-size: 24px; line-height: 32px; }
  .p24.mb0 { margin-bottom: 0; }

  /* ============ HEADER ============ */
  .header {
    position: fixed; left: 0; right: 0; top: 0; z-index: 100;
    padding-bottom: 24px;
    transition: top 0.3s ease-in-out;
  }
  .header.hidden { top: -120px; }
  .head-container { max-width: 1708px; margin: 0 auto; padding: 24px 30px 0; }
  .header-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 12px 12px 20px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .brand { display: flex; align-items: flex-end; flex: 0 0 246px; padding: 0 20px 0 10px; }
  .nav-menu {
    display: flex; align-items: center; justify-content: space-between;
    flex: 1; height: 85px; padding: 16px 16px 16px 64px;
    border-left: 1px solid rgba(255, 255, 255, 0.5);
  }
