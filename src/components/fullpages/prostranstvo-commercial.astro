---
// Prostranstvo Commercial — Full-page recreation (ENGLISH)
// Dusty-blue outer frame (#9AB6D1) + white sheet, inset rounded hero with
// blue wash, About + stats + logostrip, catalog, How we work with badge,
// testimonials, dark contact CTA and full footer. Faithful to the RU reference.
---

<div class="page">
  <div class="shell">
    <!-- NAV -->
    <header class="nav" id="top">
      <a class="brand" href="#top" aria-label="Prostranstvo home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 24" width="32" height="24"><rect x="2" y="10" width="9" height="12" rx="1" fill="#0E141E"/><rect x="12" y="4" width="9" height="18" rx="1" fill="#2E3D52"/><rect x="22" y="0" width="8" height="22" rx="1" fill="#8AAECC"/><rect x="4" y="14" width="5" height="2" fill="#fff" opacity="0.85"/><rect x="4" y="18" width="5" height="2" fill="#fff" opacity="0.55"/></svg>
        </span>
        <span class="brand-text">
          <b>Prostranstvo</b>
          <em>commercial real estate</em>
        </span>
      </a>
      <nav class="links" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#catalog">Listings</a>
        <a href="#how">Process</a>
        <a href="#reviews">Reviews</a>
        <a href="#contact">Contacts</a>
      </nav>
      <div class="nav-actions">
        <a class="nav-phone" href="tel:+12125551234">+1 (212) 555-1234</a>
        <a class="nav-cta" href="#contact">Get in touch</a>
        <button class="burger" aria-label="Open menu">☰</button>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-media" aria-hidden="true">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80" alt="" loading="eager" />
        <span class="hero-wash"></span>
      </div>
      <div class="hero-copy">
        <h1>Real estate<br />for business</h1>
        <p>Leasing, sales and hand-picked spaces —<br />from offices to warehouses.</p>
        <a class="pill pill--white" href="#contact">Start a partnership</a>
        <span class="hero-note">Free consultation · Response within 15 minutes</span>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="about-main">
        <div class="about-left">
          <h2>About us</h2>
          <p>
            We are commercial real-estate specialists helping businesses find the right
            space to lease or buy. From shortlisting and viewings to full legal support —
            every step is handled by one dedicated team.
          </p>
        </div>
        <div class="stats">
          <div class="stat"><b>10+</b><span>years on the market</span></div>
          <div class="stat"><b>1,000+</b><span>happy clients</span></div>
          <div class="stat"><b>4,000+</b><span>properties in portfolio</span></div>
          <div class="stat"><b>95%</b><span>deals closed successfully</span></div>
        </div>
      </div>
      <div class="logostrip" aria-label="Trusted by">
        <span><i>⬢</i> Logoipsum</span>
        <span><i>⬣</i> Logoipsum</span>
        <span><i>✦</i> Logoipsum</span>
        <span><i>⬔</i> Logoipsum</span>
        <span><i>◆</i> Logoipsum</span>
      </div>
    </section>

    <!-- CATALOG -->
    <section class="catalog" id="catalog">
      <div class="catalog-head">
        <div>
          <h2>Property<br />catalog</h2>
          <p>A wide selection of spaces<br />for your business needs</p>
        </div>
        <div class="catalog-actions">
          <button class="circle ghost" aria-label="Previous">‹</button>
          <button class="circle dark" aria-label="Next">›</button>
        </div>
      </div>
      <div class="cards">
        <a class="card" href="#catalog">
          <span class="card-img">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80" alt="Office spaces" loading="lazy" />
          </span>
          <b>Office spaces</b>
          <em>4,000+ listings · City centre to business park</em>
        </a>
        <a class="card" href="#catalog">
          <span class="card-img">
            <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80" alt="Warehouses" loading="lazy" />
          </span>
          <b>Warehouses</b>
          <em>1,000+ listings · Logistics & light industrial</em>
        </a>
        <a class="card" href="#catalog">
          <span class="card-img">
            <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80" alt="Land plots" loading="lazy" />
          </span>
          <b>Land plots</b>
          <em>2,000+ listings · Commercial & mixed use</em>
        </a>
      </div>
    </section>

    <!-- HOW WE WORK -->
    <section class="how" id="how">
      <div class="how-head">
        <h2>How we work</h2>
        <p>We made working with us<br />as simple and transparent as possible</p>
      </div>
      <div class="how-grid">
        <div class="how-visual">
          <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=900&q=80" alt="Modern office building" loading="lazy" />
          <span class="consult-badge">Free<br />consultation</span>
        </div>
        <ol class="steps">
          <li class="step">
            <span class="ic">◎</span>
            <span class="step-text">
              <b>Consultation & needs analysis</b>
              <em>We clarify your requirements — size, location, budget and timeline — in one call.</em>
            </span>
          </li>
          <li class="step">
            <span class="ic">⌕</span>
            <span class="step-text">
              <b>Sourcing & shortlisting</b>
              <em>Only verified properties that truly match your goals and budget make the shortlist.</em>
            </span>
          </li>
          <li class="step">
            <span class="ic">◐</span>
            <span class="step-text">
              <b>Viewings & valuation</b>
              <em>We arrange tours and provide full data on condition, costs and potential.</em>
            </span>
          </li>
          <li class="step">
            <span class="ic">⬔</span>
            <span class="step-text">
              <b>Due diligence & paperwork</b>
              <em>Comprehensive checks of all documents, title and ownership before you sign.</em>
            </span>
          </li>
          <li class="step">
            <span class="ic">◆</span>
            <span class="step-text">
              <b>Deal closing & support</b>
              <em>Negotiation, contract and handover — with support at every stage.</em>
            </span>
          </li>
        </ol>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="reviews" id="reviews">
      <div class="reviews-head">
        <h2>What our clients say</h2>
        <span class="reviews-sub">Real feedback from businesses we helped move, expand and save</span>
      </div>
      <div class="review-grid">
        <article class="quote-card">
          <span class="q">“</span>
          <p>Huge thanks to Prostranstvo — they found us a downtown office in 5 days, checked every document and closed without a single surprise. Highly recommended.</p>
          <div class="who">
            <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=200&q=80" alt="" />
            <span><b>Ekaterina Ivanova</b><em>CEO, TechNova</em></span>
          </div>
        </article>
        <article class="quote-card alt">
          <span class="q">“</span>
          <p>We needed an 800 m² warehouse for logistics. They brought three honest options with clear pros and cons — we saved 18% on annual rent.</p>
          <div class="who">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80" alt="" />
            <span><b>Alex Morozov</b><em>Operations Director, LogistPro</em></span>
          </div>
        </article>
        <article class="quote-card">
          <span class="q">“</span>
          <p>Transparent, fast and accurate. The valuation was spot-on and the legal check caught an issue that would have cost us months.</p>
          <div class="who">
            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80" alt="" />
            <span><b>Sophie Laurent</b><em>Founder, Atelier L.</em></span>
          </div>
        </article>
      </div>
    </section>

    <!-- CONTACT CTA -->
    <section class="contact" id="contact">
      <div class="contact-card">
        <div class="contact-copy">
          <h2>Let's talk about<br />your next space</h2>
          <p>Leave a request and we will get back to you within 15 minutes. We will match properties to your tasks and budget — no spam, no pushy sales.</p>
          <ul class="contact-meta">
            <li><i>✆</i> +1 (212) 555-1234</li>
            <li><i>✉</i> hello@prostranstvo.com</li>
            <li><i>◉</i> New York · 10 Madison Ave, 12th floor</li>
          </ul>
          <div class="contact-trust">
            <span><b>4.9/5</b> avg. client rating</span>
            <span><b>48h</b> avg. time to shortlist</span>
          </div>
        </div>
        <form class="form" onsubmit="return false" aria-label="Contact form">
          <label><span>Full name</span><input placeholder="Jane Doe" autocomplete="name" /></label>
          <label><span>Phone number</span><input placeholder="+1 (___) ___-____" autocomplete="tel" /></label>
          <label><span>Property type</span>
            <select>
              <option>Office</option><option>Warehouse</option><option>Land plot</option><option>Retail</option><option>Other</option>
            </select>
          </label>
          <label><span>Message (optional)</span><textarea rows="3" placeholder="Tell us about size, location or timing…"></textarea></label>
          <button class="pill pill--white block" type="button">Send request</button>
          <em class="form-note">By sending, you agree to our privacy policy. We never share your data.</em>
        </form>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="foot">
      <div class="foot-main">
        <div class="foot-brand">
          <span class="foot-logo"><i>⬢</i> Prostranstvo</span>
          <p>Commercial real estate brokerage — offices, warehouses and land for growing businesses. One team, from search to handover.</p>
          <div class="foot-social" aria-label="Social">
            <a href="#top" aria-label="Instagram">◎</a>
            <a href="#top" aria-label="LinkedIn">in</a>
            <a href="#top" aria-label="Email">✉</a>
          </div>
        </div>
        <nav class="foot-col">
          <b>Navigate</b>
          <a href="#about">About us</a>
          <a href="#catalog">Catalog</a>
          <a href="#how">How we work</a>
          <a href="#reviews">Reviews</a>
        </nav>
        <nav class="foot-col">
          <b>Properties</b>
          <a href="#catalog">Office spaces</a>
          <a href="#catalog">Warehouses</a>
          <a href="#catalog">Land plots</a>
          <a href="#contact">Request a tour</a>
        </nav>
        <div class="foot-col foot-contact">
          <b>Contacts</b>
          <a href="tel:+12125551234">+1 (212) 555-1234</a>
          <a href="mailto:hello@prostranstvo.com">hello@prostranstvo.com</a>
          <span>Mon–Fri 9:00–19:00 · New York</span>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© 2026 Prostranstvo. Commercial real estate.</span>
        <span class="foot-links"><a href="#top">Privacy</a> · <a href="#top">Sitemap</a> · <a href="#top">Legal notice</a></span>
      </div>
    </footer>
  </div>
</div>

<style>
  .page{
    background:#FFFFFF;
    padding:0;
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
    color:#0E141E;
  }
  .shell{
    max-width:1160px;
    margin:0 auto;
    background:#FFFFFF;
    border-radius:0;
    overflow:visible;
    box-shadow:none;
  }
  /* nav */
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:16px 28px 14px;
    border-bottom:1px solid rgba(14,20,30,0.06);
    position:sticky;
    top:0;
    background:rgba(255,255,255,0.94);
    backdrop-filter:blur(10px);
    z-index:5;
  }
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#0E141E;}
  .brand-text{display:flex;flex-direction:column;line-height:1;}
  .brand-text b{font-size:16px;letter-spacing:-0.01em;}
  .brand-text em{font-style:normal;font-size:10px;letter-spacing:0.08em;color:#8A95A5;text-transform:uppercase;margin-top:2px;}
  .links{display:flex;gap:20px;}
  .links a{font-size:13px;font-weight:500;color:#6B7480;text-decoration:none;letter-spacing:0.01em;}
  .links a:hover{color:#0E141E;}
  .nav-actions{display:flex;align-items:center;gap:12px;}
  .nav-phone{font-size:12.5px;font-weight:700;color:#0E141E;text-decoration:none;white-space:nowrap;}
  .nav-phone:hover{color:#2E3D52;}
  .nav-cta{
    display:inline-flex;align-items:center;
    font-size:12.5px;font-weight:700;
    color:#0E141E;
    border:1px solid rgba(14,20,30,0.12);
    padding:8px 16px;border-radius:999px;
    text-decoration:none;
    white-space:nowrap;
    transition:all 0.18s ease;
  }
  .nav-cta:hover{background:#0E141E;color:#fff;border-color:#0E141E;}
  .burger{display:none;border:0;background:#0E141E;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;}
  /* hero */
  .hero{
    position:relative;
    margin:14px 16px 0;
    border-radius:22px;
    overflow:hidden;
    min-height:440px;
    background:#DDE6F0;
    display:flex;
    align-items:center;
  }
  .hero-media{position:absolute;inset:0;}
  .hero-media img{width:100%;height:100%;object-fit:cover;display:block;}
  .hero-wash{
    position:absolute;inset:0;
    background:linear-gradient(90deg,rgba(125,150,185,0.92) 0%,rgba(125,150,185,0.58) 38%,rgba(125,150,185,0.08) 74%);
  }
  .hero-copy{
    position:relative;z-index:2;
    padding:40px 38px;
    max-width:540px;
  }
  .hero-copy h1{
    margin:0;
    font-size:clamp(30px,4.2vw,46px);
    line-height:0.96;
    letter-spacing:-0.03em;
    color:#fff;
    text-shadow:0 4px 18px rgba(0,0,0,0.16);
  }
  .hero-copy p{
    margin:14px 0 18px;
    font-size:13.5px;line-height:1.55;
    color:rgba(255,255,255,0.94);
    max-width:380px;
  }
  .pill{
    display:inline-flex;align-items:center;justify-content:center;
    background:#FFFFFF;color:#0E141E;
    font-size:13px;font-weight:700;
    padding:12px 20px;border-radius:999px;
    text-decoration:none;
    border:0;
    cursor:pointer;
    box-shadow:0 8px 22px rgba(0,0,0,0.14);
    transition:transform 0.18s ease, box-shadow 0.18s ease;
    white-space:nowrap;
  }
  .pill:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(0,0,0,0.16);}
  .pill.block{width:100%;}
  .pill--white{background:#fff;color:#0E141E;}
  .hero-note{display:block;margin-top:10px;font-size:11px;color:rgba(255,255,255,0.82);letter-spacing:0.01em;}
  /* about */
  .about{padding:30px 28px 0;}
  .about-main{
    display:grid;
    grid-template-columns:1.2fr 0.9fr;
    gap:32px;
    align-items:start;
  }
  .about-left h2{margin:0;font-size:26px;letter-spacing:-0.02em;}
  .about-left p{margin:10px 0 0;font-size:13px;line-height:1.7;color:#6B7480;max-width:500px;}
  .stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px 28px;
  }
  .stat b{display:block;font-size:28px;line-height:1;letter-spacing:-0.02em;}
  .stat span{display:block;margin-top:4px;font-size:11px;letter-spacing:0.04em;color:#8A95A5;}
  .logostrip{
    margin-top:22px;
    display:flex;gap:18px;flex-wrap:wrap;
    align-items:center;
    border-top:1px solid rgba(14,20,30,0.07);
    border-bottom:1px solid rgba(14,20,30,0.07);
    padding:16px 0;
    color:#8A95A5;
  }
  .logostrip span{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;font-weight:700;letter-spacing:0.01em;
  }
  .logostrip i{font-style:normal;width:22px;height:22px;border-radius:50%;background:#0E141E;color:#fff;display:grid;place-items:center;font-size:11px;}
  /* catalog */
  .catalog{padding:28px 28px 0;}
  .catalog-head{
    display:flex;align-items:flex-end;justify-content:space-between;gap:16px;
    margin-bottom:18px;
  }
  .catalog-head h2{margin:0;font-size:26px;line-height:1;letter-spacing:-0.02em;}
  .catalog-head p{margin:8px 0 0;font-size:12.5px;line-height:1.5;color:#8A95A5;}
  .catalog-actions{display:flex;gap:10px;}
  .circle{
    width:38px;height:38px;border-radius:50%;
    display:grid;place-items:center;
    font-size:18px;line-height:1;
    border:1px solid transparent;
    cursor:pointer;
    transition:all 0.18s ease;
  }
  .circle.ghost{background:#fff;border-color:rgba(14,20,30,0.12);color:#0E141E;}
  .circle.dark{background:#0E141E;color:#fff;}
  .circle:hover{transform:translateY(-1px);}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .card{
    text-decoration:none;color:#0E141E;
    display:flex;flex-direction:column;gap:8px;
  }
  .card-img{
    display:block;
    height:220px;
    border-radius:16px;
    overflow:hidden;
    background:#EEF2F7;
  }
  .card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.28s ease;}
  .card:hover .card-img img{transform:scale(1.03);}
  .card b{font-size:13.5px;line-height:1.2;}
  .card em{font-style:normal;font-size:11.5px;color:#8A95A5;line-height:1.4;}
  /* how */
  .how{padding:32px 28px 0;}
  .how-head{margin-bottom:16px;}
  .how-head h2{margin:0;font-size:26px;letter-spacing:-0.02em;}
  .how-head p{margin:8px 0 0;font-size:12.5px;line-height:1.55;color:#8A95A5;}
  .how-grid{
    display:grid;
    grid-template-columns:0.95fr 1.22fr;
    gap:24px;
    align-items:start;
  }
  .how-visual{
    position:relative;
    border-radius:16px;
    overflow:hidden;
    background:#EEF2F7;
    height:440px;
  }
  .how-visual img{width:100%;height:100%;object-fit:cover;display:block;}
  .consult-badge{
    position:absolute;
    top:14px;right:14px;
    width:112px;height:112px;border-radius:50%;
    background:#8AAECC;color:#fff;
    display:grid;place-items:center;
    text-align:center;
    font-size:12px;font-weight:800;line-height:1.2;
    box-shadow:0 10px 26px rgba(0,0,0,0.16);
  }
  .steps{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;}
  .step{
    display:grid;
    grid-template-columns:36px 1fr;
    gap:14px;
    padding:16px 0;
    border-bottom:1px solid rgba(14,20,30,0.07);
    align-items:start;
  }
  .step:last-child{border-bottom:0;}
  .ic{
    width:36px;height:36px;border-radius:50%;
    background:#0E141E;color:#fff;
    display:grid;place-items:center;
    font-size:14px;
    flex:none;
  }
  .step-text b{display:block;font-size:13px;line-height:1.3;}
  .step-text em{display:block;margin-top:4px;font-style:normal;font-size:12px;line-height:1.55;color:#8A95A5;}
  /* reviews */
  .reviews{padding:30px 28px 0;}
  .reviews-head{margin-bottom:16px;}
  .reviews-head h2{margin:0;font-size:22px;letter-spacing:-0.02em;}
  .reviews-sub{display:block;margin-top:6px;font-size:12.5px;color:#8A95A5;}
  .review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .quote-card{
    background:#F6F7F9;
    border:1px solid rgba(14,20,30,0.06);
    border-radius:16px;
    padding:18px 18px 16px;
    display:flex;
    flex-direction:column;
  }
  .quote-card.alt{background:#FFFFFF;}
  .quote-card .q{font-family:Georgia,serif;font-size:28px;line-height:1;color:#8AAECC;}
  .quote-card p{margin:8px 0 14px;font-size:12.5px;line-height:1.65;color:#3A4556;flex:1;}
  .who{display:flex;align-items:center;gap:10px;border-top:1px solid rgba(14,20,30,0.07);padding-top:12px;}
  .who img{width:32px;height:32px;border-radius:50%;object-fit:cover;}
  .who b{display:block;font-size:12px;}
  .who em{font-style:normal;font-size:11px;color:#8A95A5;}
  /* contact */
  .contact{padding:28px 28px 0;}
  .contact-card{
    background:#0E141E;
    color:#fff;
    border-radius:18px;
    padding:26px;
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:28px;
    align-items:start;
  }
  .contact-copy h2{margin:0;font-size:26px;line-height:1.05;letter-spacing:-0.02em;}
  .contact-copy p{margin:10px 0 16px;font-size:12.5px;line-height:1.6;color:rgba(255,255,255,0.72);max-width:420px;}
  .contact-meta{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:12.5px;color:rgba(255,255,255,0.92);}
  .contact-meta i{font-style:normal;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,0.10);display:inline-grid;place-items:center;margin-right:6px;font-size:10px;}
  .contact-trust{margin-top:16px;display:flex;gap:18px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,0.10);padding-top:14px;}
  .contact-trust span{font-size:11.5px;color:rgba(255,255,255,0.72);}
  .contact-trust b{color:#fff;font-size:13px;}
