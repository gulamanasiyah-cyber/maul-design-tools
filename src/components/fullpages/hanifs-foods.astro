---
// Hanif's Foods — native full-page recreation of hanifsfoods.com (Framer).
// Palette: Cream #F6F0D3, Pale Yellow #FFE594, Orange #F77F00, Brown #462905,
// Saffron #FFC300, Deep Brown #9A4F00, Off-White #FCFAF8 + 8 pastel product tints.
// Fonts: Bricolage Grotesque (display, via Google Fonts), Feeling Passionate
// (script accents, local woff2), Inter (body, via Google Fonts).
// Sections: sticky nav + copy-email chip, yellow product swiper hero with
// U-shape divider, about collage, orange marquee band, 8 pastel product cards,
// recipe scroll-snap carousel, 3 U-shape store cards, testimonial cards,
// Instagram mosaic, closing form + footer. Vanilla JS only.
const A = '/assets/hanifs';

const slides = [
  { name: 'Crispy Onions', sub: 'For all Kind of Toppings', img: `${A}/prod-crispy-onions.webp`, sticker: `${A}/sticker-crispy.webp`, tint: '#F4D69F' },
  { name: 'Basmati Rice', sub: 'Fluffy and Fragrant Grains', img: `${A}/prod-basmati-rice.webp`, sticker: `${A}/sticker-rice.png`, tint: '#DDCCAE' },
  { name: 'Tamarind Concentrate', sub: 'Tangy and Bold', img: `${A}/prod-tamarind.png`, sticker: `${A}/sticker-tamarind.png`, tint: '#DBC8AA' },
  { name: 'Alphonso Mango Puree', sub: 'Deliciously Sweet and Refreshing', img: `${A}/prod-mango-puree.png`, sticker: `${A}/sticker-mango-puree.png`, tint: '#F2D39A' },
  { name: 'Demerara Sugar', sub: 'For a Golden Crunch and Texture', img: `${A}/prod-demerara.webp`, sticker: `${A}/sticker-demerara.png`, tint: '#F3CF9C' },
  { name: 'Mango Chutney', sub: 'Complements Any Dish', img: `${A}/prod-mango-chutney.webp`, sticker: `${A}/sticker-mango-chutney.png`, tint: '#DBF093' },
  { name: 'Saffron Threads', sub: 'For a luxurious pinch of flavour', img: `${A}/prod-saffron.webp`, sticker: `${A}/sticker-saffron.webp`, tint: '#F1B695' },
  { name: 'Muscovado Sugar', sub: 'For Soft and Chewy Baking', img: `${A}/prod-muscovado.webp`, sticker: `${A}/sticker-muscovado.png`, tint: '#F1CA89' },
];

const products = [
  { name: 'Crispy Onions', blurb: 'Perfect topping for sushi, poke bowls, sandwiches and salads.', img: `${A}/prod-crispy-onions.webp`, sticker: `${A}/sticker-crispy.webp`, tint: '#F4D69F' },
  { name: 'Basmati Rice', blurb: 'The finest quality rice for all uses', img: `${A}/prod-basmati-rice.webp`, sticker: `${A}/sticker-rice.png`, tint: '#DDCCAE' },
  { name: 'Tamarind Concentrate', blurb: 'Delicious in curries, sauces, drinks and desserts', img: `${A}/prod-tamarind.png`, sticker: `${A}/sticker-tamarind.png`, tint: '#DBC8AA' },
  { name: 'Alphonso Mango Puree', blurb: 'The perfect base for drinks, desserts and puddings', img: `${A}/prod-mango-puree.png`, sticker: `${A}/sticker-mango-puree.png`, tint: '#F2D39A' },
  { name: 'Demerara Sugar', blurb: 'Adds the perfect crunchy texture to bakes, crumbles and cookies', img: `${A}/prod-demerara.webp`, sticker: `${A}/sticker-demerara.png`, tint: '#F3CF9C' },
  { name: 'Mango Chutney', blurb: 'Perfect topping for biryani, curries, and everyday meals.', img: `${A}/prod-mango-chutney.webp`, sticker: `${A}/sticker-mango-chutney.png`, tint: '#DBF093' },
  { name: 'Saffron Threads', blurb: 'Fragrant and luxurious topping for dishes and desserts', img: `${A}/prod-saffron.webp`, sticker: `${A}/sticker-saffron.webp`, tint: '#F1B695' },
  { name: 'Muscovado Sugar', blurb: 'Great in cookies, cakes and desserts', img: `${A}/prod-muscovado.webp`, sticker: `${A}/sticker-muscovado.png`, tint: '#F1CA89' },
];

const recipes = [
  { title: 'Tangy Tamarind Glazed Chicken Wings', blurb: 'Sweet and sour glaze for delicious grilled meat.', img: `${A}/recipe-wings.webp` },
  { title: 'Beef Taco Bowl with Crispy Onions', blurb: 'Adds a wonderful texture and savory flavor boost.', img: `${A}/recipe-taco.webp` },
  { title: 'Creamy Mango Lassi Smoothie', blurb: 'A refreshing, sweet, and tropical yogurt drink.', img: `${A}/recipe-lassi.webp` },
  { title: 'Sparkling Demerara Sugar Cookie', blurb: 'Adds a delicate crunch and molasses sweetness.', img: `${A}/recipe-cookie.webp` },
  { title: 'Spicy Mango Chutney Cheese Toastie', blurb: 'A sweet and savory relish, perfect with cheese.', img: `${A}/recipe-toastie.webp` },
  { title: 'Fragrant Basmati Rice with Cardamom', blurb: 'Aromatic, long-grain rice, great side dish.', img: `${A}/recipe-rice.webp` },
];

const stores = [
  { name: "Stong's Market", addr: '4221 Dunbar St, Vancouver, BC V6S 2G1, Canada', phone: '+1 604-266-1401', hours: ['Sunday – Saturday 7 AM – 9 PM'], logo: `${A}/store-logo-1.png`, img: `${A}/store-photo-1.webp` },
  { name: 'Fresh Is Best on Broadway', addr: '2908 W Broadway, Vancouver, BC V6K 2G8, Canada', phone: null, hours: ['Sunday – Monday 12 AM – 5 PM', 'Tuesday – Saturday 10 AM – 6 PM'], logo: `${A}/store-logo-2.png`, img: `${A}/store-photo-2.webp` },
  { name: 'East West Market', addr: '2181 W 41st Ave, Vancouver, BC V6M 3Y3, Canada', phone: null, hours: ['Sunday – Saturday 9 AM – 7:30 PM'], logo: `${A}/store-logo-3.png`, img: `${A}/store-photo-3.webp` },
];

const quotes = [
  { text: 'I am writing to offer my compliments on your crispy onions. I saw them at my local green grocer and decided to take a chance on trying them. I am so glad that I did! They are delicious. I put them on all kinds of food items/meals, etc. and have recommended them to and given them to family and friends.', who: 'Cathy, Vancouver, BC', ill: `${A}/ill-line-1.webp`, tint: '#A7D599' },
  { text: "We've used Hanif's mango pulp for years in ice cream and smoothies. The quality is dependable and produces just the right results.", who: 'Geoff, Vancouver', ill: `${A}/ill-line-2.webp`, tint: '#FFF3E2' },
  { text: "Your rice has the perfect grain length and doesn't get sticky.", who: 'Simran, Surrey', ill: `${A}/ill-line-3.webp`, tint: '#D3A69A' },
  { text: "Hanif's has been a trusted supplier for many years. Their products have never let us down.", who: 'Andrew, Toronto, ON', ill: `${A}/ill-line-4.webp`, tint: '#FFE594' },
];

const posts = [
  { img: `${A}/insta-story.webp`, cls: 'story' },
  { img: `${A}/insta-landscape-1.webp`, cls: 'wide' },
  { img: `${A}/insta-portrait-1.webp`, cls: 'tall' },
  { img: `${A}/insta-square.webp`, cls: 'sq' },
  { img: `${A}/insta-landscape-2.webp`, cls: 'wide' },
  { img: `${A}/insta-portrait-2.png`, cls: 'tall' },
  { img: `${A}/insta-landscape-3.png`, cls: 'wide' },
];

const bandItems = Array.from({ length: 6 }, () => 'What People Say');
---

<div class="hanifs-foods">

  <!-- ==================== NAV ==================== -->
  <header class="nav">
    <a href="#top" class="logo"><img src={`${A}/logo.png`} alt="Hanif's Foods" /></a>
    <nav class="links">
      <a href="#about">About us</a>
      <a href="#recipes">Recipes</a>
      <a href="#testimonials">Testimonials</a>
      <a href="#contact">Contact</a>
      <a href="#social">Blog</a>
    </nav>
    <div class="nav-right">
      <button class="email-chip" data-email="hanif@hanifsfoods.com" type="button">
        <span class="ec-label">Email Address</span>
        <span class="ec-value">hanif@hanifsfoods.com</span>
        <span class="ec-action">Copy to Clipboard</span>
      </button>
      <a href="#products" class="btn-yellow">Shop all <img src={`${A}/arrow-cta-1.png`} alt="" /></a>
    </div>
  </header>

  <!-- ==================== HERO SWIPER ==================== -->
  <section class="hero" id="top">
    <div class="texture" aria-hidden="true"></div>
    {slides.map((s, i) => (
      <div class={`slide${i === 0 ? ' on' : ''}`} data-slide={i}>
        <div class="big-circle" style={`background:${s.tint}`}></div>
        <img class="sticker" src={s.sticker} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
        <img class="prod" src={s.img} alt={s.name} loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="stars"><img src={`${A}/stars-2.png`} alt="" loading="lazy" /></div>
      </div>
    ))}
    <div class="hero-copy">
      <div class="kicker"><img src={`${A}/arrow-doodle-1.png`} alt="" /> Since 1985</div>
      <h1 class="hero-h">Loved in <em class="script">Homes</em><br />&amp; <em class="script">Restaurants.</em></h1>
      <p class="hero-name" id="heroName">Crispy Onions</p>
      <p class="hero-sub" id="heroSub">For all Kind of Toppings</p>
      <div class="hero-ctas">
        <a href="#products" class="btn-yellow big">Order now <img src={`${A}/arrow-cta-2.png`} alt="" /></a>
        <div class="dots" id="heroDots" role="tablist" aria-label="Products"></div>
      </div>
    </div>
    <div class="hero-arrows">
      <button class="arr" id="heroPrev" aria-label="Previous product" type="button"><img src={`${A}/arrow-back.svg`} alt="" /></button>
      <button class="arr" id="heroNext" aria-label="Next product" type="button"><img src={`${A}/arrow-next.svg`} alt="" /></button>
    </div>
    <div class="u-down" aria-hidden="true"></div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="about" id="about">
    <div class="about-head">
      <div class="kicker dark"><img src={`${A}/arrow-doodle-2.png`} alt="" /> Since 1985</div>
      <h2 class="h2">Loved <em>in</em><br />Homes <em>&amp;</em><br /><span class="script">Restaurants.</span></h2>
    </div>
    <div class="about-body">
      <div class="collage">
        <img class="c1" src={`${A}/about-founder.webp`} alt="Hanif founder" loading="lazy" />
        <img class="c2" src={`${A}/about-kitchen.webp`} alt="A man standing in a kitchen" loading="lazy" />
        <img class="c3" src={`${A}/about-cooking.webp`} alt="People cooking" loading="lazy" />
        <img class="c-stars" src={`${A}/stars-1.png`} alt="" loading="lazy" />
      </div>
      <div class="about-text">
        <p>Hanif&rsquo;s is a family-owned business based in Vancouver, Canada. Since 1985, we have supplied a wide range of staple goods, spices and premium world foods to leading restaurants, caterers, supermarkets and independent stores.</p>
        <p>Our products are loved and trusted by thousands of professional and home chefs worldwide. Our range is always evolving to match the latest trends in kitchens, and we have an extensive network of leading suppliers worldwide, so contact us for any other items you&rsquo;d like to discuss</p>
        <a href="#products" class="btn-yellow">Our products <img src={`${A}/arrow-cta-3.png`} alt="" /></a>
      </div>
    </div>
  </section>

  <!-- ==================== MARQUEE BAND ==================== -->
  <div class="band" aria-hidden="true">
    <div class="band-track">
      {[...bandItems, ...bandItems].map((t) => (
        <span class="band-item"><span class="script">{t}</span> <img src={`${A}/stars-3.png`} alt="" /></span>
      ))}
    </div>
  </div>

  <!-- ==================== PRODUCTS ==================== -->
  <section class="products" id="products">
    <div class="sec-head">
      <h2 class="h2">Products <em>made</em><br />with <span class="script">real</span><br />ingredients</h2>
      <img class="head-bird" src={`${A}/bird.png`} alt="" loading="lazy" />
    </div>
    <div class="prod-grid">
      {products.map((p) => (
        <article class="p-card" style={`background:${p.tint}`}>
          <img class="p-sticker" src={p.sticker} alt="" loading="lazy" />
          <img class="p-img" src={p.img} alt={p.name} loading="lazy" />
          <h3 class="p-name">{p.name}</h3>
          <p class="p-blurb">{p.blurb}</p>
          <a href="#products" class="btn-black">View Products <img src={`${A}/arrow-cta-4.png`} alt="" /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- ==================== RECIPES ==================== -->
  <section class="recipes" id="recipes">
    <div class="sec-head">
      <div class="sec-head-left">
        <div class="kicker dark"><img src={`${A}/arrow-doodle-1.png`} alt="" /> <span class="script kick-script">Hop into my kitchen!</span></div>
        <h2 class="h2">Recipe <em>Ideas</em></h2>
      </div>
      <div class="carousel-arrows">
        <button class="arr" id="recPrev" aria-label="Previous recipes" type="button"><img src={`${A}/arrow-back.svg`} alt="" /></button>
        <button class="arr" id="recNext" aria-label="Next recipes" type="button"><img src={`${A}/arrow-next.svg`} alt="" /></button>
      </div>
    </div>
    <div class="rec-track" id="recTrack">
      {recipes.map((r) => (
        <article class="r-card">
          <img class="r-img" src={r.img} alt={r.title} loading="lazy" />
          <h3 class="r-name">{r.title}</h3>
          <p class="r-blurb">{r.blurb}</p>
          <a href="#recipes" class="btn-black">View Product <img src={`${A}/arrow-cta-5.png`} alt="" /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- ==================== STORES ==================== -->
  <section class="stores" id="stores">
    <div class="sec-head">
      <h2 class="h2">Where <em>to</em><br /><span class="script">Buy</span></h2>
    </div>
    <div class="store-grid">
      {stores.map((s) => (
        <article class="s-card">
          <img class="s-photo" src={s.img} alt={s.name} loading="lazy" />
          <div class="s-body">
            <img class="s-logo" src={s.logo} alt={`${s.name} logo`} loading="lazy" />
            <h3 class="s-name">{s.name}</h3>
            <p class="s-addr">{s.addr}</p>
            {s.phone && (
              <div class="s-row"><img src={`${A}/icon-phone.png`} alt="" /> <span>Phone: {s.phone}</span></div>
            )}
            <div class="s-row"><span class="s-h">Hours:</span></div>
            {s.hours.map((h) => <p class="s-hours">{h}</p>)}
            <a href="#contact" class="btn-black">Get Directions <img src={`${A}/arrow-cta-6.png`} alt="" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ==================== TESTIMONIALS ==================== -->
  <section class="testi" id="testimonials">
    <div class="sec-head">
      <div class="kicker light">What Our Customers Say</div>
      <h2 class="h2">Taste <em class="em-yellow">the</em><br /><span class="script script-yellow">Difference.</span></h2>
    </div>
    <div class="quote-grid">
      {quotes.map((q) => (
        <article class="q-card" style={`background:${q.tint}`}>
          <img class="q-ill" src={q.ill} alt="" loading="lazy" />
          <p class="q-text">{q.text}</p>
          <div class="q-who">{q.who}</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ==================== SOCIAL ==================== -->
  <section class="social" id="social">
    <div class="sec-head">
      <h2 class="h2">Loved <em>for</em><br />Generations.<br /><em>Made</em> <em>for</em><br />Today.</h2>
      <a href="#social" class="btn-yellow">Follow on Instagram <img src={`${A}/arrow-cta-1.png`} alt="" /></a>
    </div>
    <div class="insta-grid">
      {posts.map((p) => (
        <a href="#social" class={`ig ${p.cls}`}>
          <img src={p.img} alt="Instagram post" loading="lazy" />
          <span class="ig-cta">View Post</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ==================== CLOSING + FOOTER ==================== -->
  <footer class="footer" id="contact">
    <div class="close-wrap">
      <h2 class="h2">Loved <em>for</em><br />Generations.<br /><em>Made</em> <em>for</em><br />Today.</h2>
      <form class="news" onsubmit="return false">
        <input type="email" class="news-input" placeholder="Email Address" required aria-label="Email Address" />
        <button type="submit" class="btn-yellow">Submit <img src={`${A}/arrow-cta-2.png`} alt="" /></button>
      </form>
      <img class="close-ill" src={`${A}/ill-food-bowl.webp`} alt="" loading="lazy" />
    </div>
    <div class="foot-links">
      <div class="fl">
        <a href="#top">Home</a><a href="#products">Products</a><a href="#stores">Where to Buy</a><a href="#recipes">Recipes</a>
      </div>
      <div class="fl">
        <a href="#about">About Us</a><a href="#contact">Contact Us</a><a href="#testimonials">Testimonials</a><a href="#social">Social Media</a>
      </div>
    </div>
    <div class="foot-bottom">
      <button class="email-chip" data-email="hanif@hanifsfoods.com" type="button">
        <span class="ec-label">Email Address</span>
        <span class="ec-value">hanif@hanifsfoods.com</span>
        <span class="ec-action">Copy to Clipboard</span>
      </button>
      <div class="copyright">Copyright &copy; 2026 Hanif foods. All Rights Reserved<br />Engineered by Foundrline | Digital Experience Architect</div>
    </div>
  </footer>
</div>

<style>
  @font-face {
    font-family: 'Feeling Passionate';
    src: url('/assets/hanifs/feeling-passionate.woff2') format('woff2');
    font-display: swap;
    font-weight: 400;
  }

  .hanifs-foods {
    font-family: 'Inter', system-ui, sans-serif;
    background: #f6f0d3;
    color: #462905;
    font-size: 17px;
    line-height: 1.6;
    overflow-x: clip;
  }
  .hanifs-foods * { box-sizing: border-box; }
  .hanifs-foods h1, .hanifs-foods h2, .hanifs-foods h3, .hanifs-foods p { margin: 0; }
  .hanifs-foods a { color: inherit; text-decoration: none; }
  .hanifs-foods img { max-width: 100%; }
  .hanifs-foods .script { font-family: 'Feeling Passionate', 'Segoe Script', cursive; font-weight: 400; }
  .hanifs-foods em { font-style: normal; color: #f77f00; }
  .hanifs-foods .em-yellow { color: #ffc300; }
  .hanifs-foods .script-yellow { color: #ffc300; }

  .hanifs-foods .h2 {
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 800;
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .hanifs-foods .kicker {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 600; font-size: 15px; letter-spacing: 0.08em;
    text-transform: uppercase; color: #462905;
    margin-bottom: 18px;
  }
  .hanifs-foods .kicker img { width: 34px; }
  .hanifs-foods .kicker.light { color: #ffe594; }
  .hanifs-foods .kick-script { text-transform: none; letter-spacing: 0; font-size: 30px; }

  .hanifs-foods .btn-yellow, .hanifs-foods .btn-black {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 700; font-size: 16px;
    padding: 14px 26px; border-radius: 999px; border: 0; cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .hanifs-foods .btn-yellow { background: #ffc300; color: #462905; }
  .hanifs-foods .btn-yellow:hover { background: #f3af11; transform: translateY(-2px); }
  .hanifs-foods .btn-black { background: #1d1305; color: #fff3e2; }
  .hanifs-foods .btn-black:hover { background: #9a4f00; transform: translateY(-2px); }
  .hanifs-foods .btn-yellow img, .hanifs-foods .btn-black img { width: 20px; }
  .hanifs-foods .btn-yellow.big { padding: 18px 34px; font-size: 18px; }

  /* ============ NAV ============ */
  .hanifs-foods .nav {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 16px 40px; background: #f6f0d3;
  }
  .hanifs-foods .logo img { height: 52px; display: block; }
  .hanifs-foods .links { display: flex; gap: 32px; font-weight: 500; font-size: 16px; }
  .hanifs-foods .links a { transition: color 0.2s ease; }
  .hanifs-foods .links a:hover { color: #f77f00; }
  .hanifs-foods .nav-right { display: flex; align-items: center; gap: 16px; }
  .hanifs-foods .email-chip {
    display: flex; flex-direction: column; align-items: flex-start;
    background: #fff3e2; border: 1.5px solid #462905; border-radius: 16px;
    padding: 8px 16px; cursor: pointer; font-family: inherit; text-align: left; color: inherit;
  }
  .hanifs-foods .ec-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
  .hanifs-foods .ec-value { font-weight: 700; font-size: 15px; }
  .hanifs-foods .ec-action { font-size: 11px; color: #f77f00; font-weight: 600; }
  .hanifs-foods .email-chip.copied .ec-action { color: #462905; }

  /* ============ HERO ============ */
  .hanifs-foods .hero {
    position: relative; overflow: hidden;
    background: #ffe594;
    padding: 90px 40px 200px;
    border-radius: 0 0 50% 50% / 0 0 120px 120px;
  }
  .hanifs-foods .texture {
    position: absolute; inset: 0; opacity: 0.5; pointer-events: none;
    background-image: radial-gradient(rgba(70, 41, 5, 0.08) 1.5px, transparent 1.6px);
    background-size: 26px 26px;
  }
  .hanifs-foods .hero-copy { position: relative; z-index: 3; max-width: 720px; }
  .hanifs-foods .hero-h {
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(56px, 8.5vw, 128px);
    line-height: 0.96;
    margin: 0 0 18px;
  }
  .hanifs-foods .hero-name {
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em;
    font-size: clamp(22px, 2.6vw, 34px);
    min-height: 1.3em;
  }
  .hanifs-foods .hero-sub { font-size: clamp(17px, 2vw, 24px); font-weight: 500; margin-bottom: 30px; min-height: 1.6em; }
  .hanifs-foods .hero-ctas { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .hanifs-foods .dots { display: flex; gap: 8px; }
  .hanifs-foods .dots button {
    width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    background: rgba(70, 41, 5, 0.25); transition: all 0.2s ease;
  }
  .hanifs-foods .dots button.on { background: #462905; width: 28px; border-radius: 999px; }

  .hanifs-foods .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; pointer-events: none; }
  .hanifs-foods .slide.on { opacity: 1; }
  .hanifs-foods .big-circle {
