<script>
  const root = document.querySelector('.hanifs-foods');
  if (root) {
    // ---------- HERO SWIPER ----------
    const slidesEls = [...root.querySelectorAll('.slide')];
    const dotsWrap = root.querySelector('#heroDots');
    const nameEl = root.querySelector('#heroName');
    const subEl = root.querySelector('#heroSub');
    const data = slidesEls.map((s) => ({
      name: s.querySelector('.prod')?.getAttribute('alt') || '',
      sub: '',
    }));
    const subs = [
      'For all Kind of Toppings', 'Fluffy and Fragrant Grains', 'Tangy and Bold',
      'Deliciously Sweet and Refreshing', 'For a Golden Crunch and Texture',
      'Complements Any Dish', 'For a luxurious pinch of flavour', 'For Soft and Chewy Baking',
    ];
    let cur = 0;
    let timer;
    slidesEls.forEach((_, i) => {
      const d = document.createElement('button');
      d.type = 'button';
      d.setAttribute('role', 'tab');
      d.setAttribute('aria-label', `Product ${i + 1}`);
      if (i === 0) d.classList.add('on');
      d.addEventListener('click', () => { go(i); restart(); });
      dotsWrap?.appendChild(d);
    });
    const dots = [...(dotsWrap?.children || [])];
    function go(i) {
      cur = (i + slidesEls.length) % slidesEls.length;
      slidesEls.forEach((s, k) => s.classList.toggle('on', k === cur));
      dots.forEach((d, k) => d.classList.toggle('on', k === cur));
      if (nameEl) nameEl.textContent = data[cur]?.name || '';
      if (subEl) subEl.textContent = subs[cur] || '';
    }
    function restart() { clearInterval(timer); timer = setInterval(() => go(cur + 1), 5000); }
    root.querySelector('#heroNext')?.addEventListener('click', () => { go(cur + 1); restart(); });
    root.querySelector('#heroPrev')?.addEventListener('click', () => { go(cur - 1); restart(); });
    restart();

    // ---------- RECIPE CAROUSEL ----------
    const track = root.querySelector('#recTrack');
    const step = 406;
    root.querySelector('#recNext')?.addEventListener('click', () => track?.scrollBy({ left: step, behavior: 'smooth' }));
    root.querySelector('#recPrev')?.addEventListener('click', () => track?.scrollBy({ left: -step, behavior: 'smooth' }));

    // ---------- COPY EMAIL ----------
    root.querySelectorAll('.email-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const email = chip.getAttribute('data-email') || '';
        const action = chip.querySelector('.ec-action');
        const done = () => {
          if (action) {
            action.textContent = 'Copied!';
            chip.classList.add('copied');
            setTimeout(() => { action.textContent = 'Copy to Clipboard'; chip.classList.remove('copied'); }, 1600);
          }
        };
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(email).then(done, done);
        else done();
      });
    });
  }
</script>
