---
// Paper Skies Travel — FULL-PAGE recreation: sky-gradient hero with 3D paper
// plane + low-poly peaks + landmark silhouettes, floating search widget,
// feature row, popular packages, pricing tiers, how-to-book steps,
// stats + testimonial bar, footer.
---

<div class="page">
  <!-- ============ SKY HERO ============ -->
  <section class="sky">
    <div class="art">
      <svg class="trail" viewBox="0 0 260 150" fill="none">
        <path d="M250 34 C190 108 140 24 110 62 C92 86 124 102 140 86" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 11" opacity="0.9"/>
      </svg>
      <svg class="plane" viewBox="0 0 200 140">
        <polygon points="8,74 192,8 122,92" fill="#ffffff"/>
        <polygon points="8,74 122,92 96,134" fill="#d8e9f8"/>
        <polygon points="122,92 192,8 146,98" fill="#b9d7f0"/>
      </svg>
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <span class="cloud c3"></span>
      <svg class="marks" viewBox="0 0 200 120">
        <g fill="#ffffff" opacity="0.97">
          <path d="M28 118 L38 44 L44 44 L46 24 L50 44 L56 44 L66 118 L52 118 L50 96 L44 96 L42 118 Z"/>
          <rect x="96" y="34" width="20" height="84" rx="2"/>
          <rect x="99" y="40" width="14" height="12" rx="2" fill="#bcd9f2"/>
          <path d="M150 118 C150 70 162 52 176 44 C172 70 172 96 176 118 Z"/>
        </g>
      </svg>
      <svg class="peaks" viewBox="0 0 1440 130" preserveAspectRatio="none">
        <polygon points="0,130 120,52 260,130" fill="#eef6fd"/>
        <polygon points="180,130 340,24 520,130" fill="#ffffff"/>
        <polygon points="430,130 580,60 740,130" fill="#e2effb"/>
        <polygon points="640,130 830,18 1030,130" fill="#f8fbff"/>
        <polygon points="950,130 1090,66 1240,130" fill="#e8f3fc"/>
        <polygon points="1160,130 1290,40 1440,130" fill="#ffffff"/>
        <polygon points="1330,130 1400,84 1440,130" fill="#dcecf9"/>
      </svg>
    </div>

    <header class="nav">
      <span class="brand">
        <svg class="mini-plane" viewBox="0 0 40 28"><polygon points="2,14 38,2 24,16" fill="#fff"/><polygon points="2,14 24,16 18,26" fill="#cfe4f7"/><polygon points="24,16 38,2 28,19" fill="#a9cdec"/></svg>
        <span class="bt">TRAVEL<em>AROUND THE WORLD</em></span>
      </span>
      <nav class="links">
        <a class="on" href="#top">Home</a>
        <a href="#packages">Packages</a>
        <a href="#packages">Destinations</a>
        <a href="#book">Bookings</a>
        <a href="#footer">About Us</a>
        <a href="#footer">Contact</a>
      </nav>
      <span class="signin">Sign In <img src="/assets/paper-skies-travel/icons/user.png" alt="" /></span>
    </header>

    <div class="hero-copy" id="top">
      <h1>TRAVEL<span>AROUND THE WORLD</span></h1>
      <p class="script">Explore. Dream. Discover.</p>
      <p class="sub">Exclusive travel packages to the world's most breathtaking destinations.</p>
      <a class="cta" href="#packages">Explore Packages ✈</a>
    </div>

    <!-- ============ SEARCH WIDGET ============ -->
    <div class="search">
      <div class="tabs">
        <span class="tab on"><img src="/assets/paper-skies-travel/icons/airplane.png" alt="" /> Flights</span>
        <span class="tab"><img src="/assets/paper-skies-travel/icons/hotel.png" alt="" /> Hotels</span>
        <span class="tab"><img src="/assets/paper-skies-travel/icons/car.png" alt="" /> Cars</span>
        <span class="tab"><img src="/assets/paper-skies-travel/icons/tickets.png" alt="" /> Experiences</span>
      </div>
      <div class="fields">
        <span class="fld"><em>From</em><b>New York, USA</b></span>
        <span class="swap">⇄</span>
        <span class="fld"><em>To</em><b>Paris, France</b></span>
        <span class="fld"><em>Depart</em><b>12 Jun, 2025 <img class="cal" src="/assets/paper-skies-travel/icons/calendar.png" alt="" /></b></span>
        <span class="fld"><em>Return</em><b>20 Jun, 2025 <img class="cal" src="/assets/paper-skies-travel/icons/calendar.png" alt="" /></b></span>
        <span class="fld"><em>Travelers</em><b>2 Adults ▾</b></span>
        <span class="go">Search</span>
      </div>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="feats">
    <span class="feat"><img src="/assets/paper-skies-travel/icons/airplane.png" alt="" /><span><b>Best Price Guarantee</b><em>Get the best deals or watch it.</em></span></span>
    <span class="feat"><img src="/assets/paper-skies-travel/icons/shield.png" alt="" /><span><b>Secure Booking</b><em>Your data is safe with us.</em></span></span>
    <span class="feat"><img src="/assets/paper-skies-travel/icons/headset.png" alt="" /><span><b>24/7 Customer Support</b><em>We're here to help, anytime.</em></span></span>
    <span class="feat"><img src="/assets/paper-skies-travel/icons/luggage.png" alt="" /><span><b>Custom Travel Packages</b><em>Tailored experiences just for you.</em></span></span>
  </section>

  <!-- ============ POPULAR PACKAGES ============ -->
  <section class="packages" id="packages">
    <div class="pack-head">
      <b>POPULAR PACKAGES</b>
      <em>View All Packages →</em>
    </div>
    <div class="pack-grid">
      <article class="pack">
        <img src="/assets/paper-skies-travel/santorini.jpg" alt="" />
        <h3>Greek Islands Escape</h3>
        <p class="meta"><span>📍 Greece</span><span>⏱ 6 Days / 5 Nights</span></p>
        <div class="prow">
          <span class="price">$1,299<em>Per Person</em></span>
          <span class="rate">★ 4.8</span>
          <span class="arr">→</span>
        </div>
      </article>
      <article class="pack">
        <img src="/assets/paper-skies-travel/maldives.jpg" alt="" />
        <h3>Maldives Paradise</h3>
        <p class="meta"><span>📍 Maldives</span><span>⏱ 5 Days / 4 Nights</span></p>
        <div class="prow">
          <span class="price">$1,599<em>Per Person</em></span>
          <span class="rate">★ 4.9</span>
          <span class="arr">→</span>
        </div>
      </article>
      <article class="pack">
        <img src="/assets/paper-skies-travel/rockies.jpg" alt="" />
        <h3>Canadian Rockies</h3>
        <p class="meta"><span>📍 Canada</span><span>⏱ 7 Days / 6 Nights</span></p>
        <div class="prow">
          <span class="price">$1,799<em>Per Person</em></span>
          <span class="rate">★ 4.7</span>
          <span class="arr">→</span>
        </div>
      </article>
      <article class="pack">
        <img src="/assets/paper-skies-travel/japan.jpg" alt="" />
        <h3>Japan Discovery</h3>
        <p class="meta"><span>📍 Japan</span><span>⏱ 8 Days / 7 Nights</span></p>
        <div class="prow">
          <span class="price">$2,199<em>Per Person</em></span>
          <span class="rate">★ 4.9</span>
          <span class="arr">→</span>
        </div>
      </article>
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section class="pricing">
    <svg class="p-plane" viewBox="0 0 200 140">
      <polygon points="8,74 192,8 122,92" fill="#ffffff" opacity="0.95"/>
      <polygon points="8,74 122,92 96,134" fill="#c8e0f6"/>
      <polygon points="122,92 192,8 146,98" fill="#a9cdec"/>
    </svg>
    <svg class="p-peaks" viewBox="0 0 400 90" preserveAspectRatio="none">
      <polygon points="0,90 60,30 130,90" fill="#ffffff" opacity="0.9"/>
      <polygon points="90,90 170,14 260,90" fill="#ffffff" opacity="0.7"/>
      <polygon points="210,90 280,40 360,90" fill="#ffffff" opacity="0.5"/>
    </svg>
    <span class="p-cloud c1"></span>
    <span class="p-cloud c2"></span>
    <b class="p-title">PRICING DETAILS</b>
    <div class="tiers">
      <article class="tier">
        <h3>Economy</h3>
        <p class="t-sub">Great value for smart travelers</p>
        <p class="t-price">$499<em>Per Person</em></p>
        <ul>
          <li>✓ Economy Class Flights</li>
          <li>✓ 20kg Baggage</li>
          <li>✓ Standard Hotels</li>
          <li>✓ Airport Transfers</li>
        </ul>
        <span class="select">Select Plan</span>
      </article>
      <article class="tier hot">
        <span class="badge">Most Popular</span>
        <h3>Premium</h3>
        <p class="t-sub">Comfort and convenience</p>
        <p class="t-price">$899<em>Per Person</em></p>
        <ul>
          <li>✓ Premium Economy Flights</li>
          <li>✓ 23kg Baggage</li>
          <li>✓ 4-Star Hotels</li>
          <li>✓ Airport Transfers</li>
          <li>✓ City Tours</li>
        </ul>
        <span class="select solid">Select Plan</span>
      </article>
      <article class="tier">
        <h3>Business</h3>
        <p class="t-sub">Luxury and flexibility</p>
        <p class="t-price">$1,499<em>Per Person</em></p>
        <ul>
          <li>✓ Business Class Flights</li>
          <li>✓ 32kg Baggage</li>
          <li>✓ 5-Star Hotels</li>
          <li>✓ Airport Transfers</li>
          <li>✓ City Tours</li>
          <li>✓ Lounge Access</li>
        </ul>
        <span class="select">Select Plan</span>
      </article>
      <article class="tier">
        <h3>Luxury</h3>
        <p class="t-sub">The ultimate travel experience</p>
        <p class="t-price">$2,499<em>Per Person</em></p>
        <ul>
          <li>✓ First Class Flights</li>
          <li>✓ 33kg Baggage</li>
          <li>✓ Premium Hotels/Villas</li>
          <li>✓ Private Transfers</li>
          <li>✓ Exclusive Experiences</li>
          <li>✓ 24/7 Concierge</li>
        </ul>
        <span class="select">Select Plan</span>
      </article>
    </div>
  </section>

  <!-- ============ HOW TO BOOK ============ -->
  <section class="steps" id="book">
    <b class="s-title">HOW TO BOOK</b>
    <div class="step-bar">
      <div class="step">
        <img src="/assets/paper-skies-travel/icons/pin.png" alt="" />
        <span><b>1. Choose Destination</b><em>Pick your dream destination.</em></span>
      </div>
      <span class="dash"></span>
      <div class="step">
        <img src="/assets/paper-skies-travel/icons/package.png" alt="" />
        <span><b>2. Select Package</b><em>Choose the best package for you.</em></span>
      </div>
      <span class="dash"></span>
      <div class="step">
        <img src="/assets/paper-skies-travel/icons/card.png" alt="" />
        <span><b>3. Make Payment</b><em>Secure your booking with easy payment.</em></span>
      </div>
      <span class="dash"></span>
      <div class="step">
        <img src="/assets/paper-skies-travel/icons/depart.png" alt="" />
        <span><b>4. Enjoy Your Trip</b><em>Pack your bags and make memories!</em></span>
      </div>
    </div>
  </section>

  <!-- ============ STATS + TESTIMONIAL ============ -->
  <section class="statsbar">
    <img class="heart" src="/assets/paper-skies-travel/icons/heart.png" alt="" />
    <div class="stats">
      <div class="stat"><img src="/assets/paper-skies-travel/icons/airplane.png" alt="" /><b>150+</b><em>Destinations</em></div>
      <div class="stat"><img src="/assets/paper-skies-travel/icons/people.png" alt="" /><b>10K+</b><em>Happy Travelers</em></div>
      <div class="stat"><img src="/assets/paper-skies-travel/icons/package.png" alt="" /><b>500+</b><em>Travel Packages</em></div>
      <div class="stat"><img src="/assets/paper-skies-travel/icons/headset.png" alt="" /><b>24/7</b><em>Support</em></div>
    </div>
    <div class="quote">
      <span class="qmark">❝</span>
      <p>The best travel experience we've ever had! Everything was perfectly organized.</p>
      <b>— Sarah J.</b>
      <em>New York, USA</em>
      <span class="stars">★★★★★</span>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="foot" id="footer">
    <div class="foot-grid">
      <div class="f-brand">
        <span class="brand">
          <svg class="mini-plane" viewBox="0 0 40 28"><polygon points="2,14 38,2 24,16" fill="#fff"/><polygon points="2,14 24,16 18,26" fill="#cfe4f7"/><polygon points="24,16 38,2 28,19" fill="#a9cdec"/></svg>
          <span class="bt">TRAVEL<em>AROUND THE WORLD</em></span>
        </span>
        <p>Exclusive travel packages to the world's most breathtaking destinations.</p>
      </div>
      <div class="f-col"><b>Company</b><a href="#footer">About Us</a><a href="#footer">Careers</a><a href="#footer">Press</a><a href="#footer">Blog</a></div>
      <div class="f-col"><b>Support</b><a href="#footer">Help Center</a><a href="#footer">Cancellation</a><a href="#footer">Safety</a><a href="#footer">Contact</a></div>
      <div class="f-col"><b>Top Destinations</b><a href="#packages">Greece</a><a href="#packages">Maldives</a><a href="#packages">Canada</a><a href="#packages">Japan</a></div>
    </div>
    <div class="foot-bar">© 2026 Travel Around The World — Explore. Dream. Discover.</div>
  </footer>
</div>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap" />

<style>
  .page {
    --blue: #2e7cd6;
    --blue-deep: #2568b8;
    --ink: #16324f;
    --muted: #5e7893;
    --soft: #eaf3fc;
    background: #f4f9fe;
    color: var(--ink);
    font-family: 'Nunito Sans', system-ui, sans-serif;
    overflow-x: clip;
  }
  .page img { display: block; }
  .page section { scroll-margin-top: 80px; }

  /* ============ SKY HERO ============ */
  .sky {
    position: relative;
    background: linear-gradient(180deg, #3d8fe0 0%, #6fb6f0 46%, #b8ddf8 78%, #eef6fd 100%);
    padding-bottom: 56px;
  }
  .art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .plane {
    position: absolute;
    top: 90px;
    right: 7%;
    width: 230px;
    filter: drop-shadow(0 18px 30px rgba(20, 80, 150, 0.35));
    animation: floaty 5s ease-in-out infinite alternate;
  }
  @keyframes floaty { to { transform: translateY(-14px) rotate(-2deg); } }
  .trail { position: absolute; top: 60px; right: 22%; width: 280px; }
  .cloud { position: absolute; background: #fff; border-radius: 999px; opacity: 0.9; }
  .c1 { width: 190px; height: 46px; left: 46%; bottom: 210px; }
  .c2 { width: 120px; height: 32px; left: 40%; bottom: 250px; opacity: 0.7; }
  .c3 { width: 150px; height: 38px; right: 6%; bottom: 260px; opacity: 0.75; }
  .marks { position: absolute; bottom: 205px; right: 5%; width: 230px; height: 140px; }
  .peaks { position: absolute; bottom: -2px; left: 0; width: 100%; height: 150px; }

  .nav {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 22px 24px 0;
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .mini-plane { width: 42px; height: 30px; }
  .bt {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #fff;
    font-size: 21px;
    letter-spacing: 0.12em;
    line-height: 1;
  }
  .bt em {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: 8px;
    letter-spacing: 0.3em;
    opacity: 0.9;
    margin-top: 4px;
  }
  .links { display: flex; gap: 28px; }
  .links a {
    color: rgba(255, 255, 255, 0.94);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .links a.on, .links a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .signin {
    background: rgba(255, 255, 255, 0.16);
    border: 1.5px solid rgba(255, 255, 255, 0.65);
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .signin img { width: 15px; height: 15px; object-fit: contain; }

  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 24px 40px;
  }
  .hero-copy h1 {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #fff;
    font-size: clamp(44px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-shadow: 0 4px 24px rgba(20, 80, 150, 0.35);
  }
  .hero-copy h1 span { display: block; font-size: 0.56em; letter-spacing: 0.05em; }
  .script {
    margin: 16px 0 10px;
    font-family: 'Dancing Script', cursive;
    font-weight: 600;
    font-size: clamp(24px, 2.4vw, 34px);
    color: #f2f9ff;
  }
  .hero-copy .sub {
    margin: 0 0 26px;
    color: rgba(255, 255, 255, 0.95);
    font-size: 15px;
    line-height: 1.65;
    max-width: 340px;
  }
  .cta {
    display: inline-block;
    background: #fff;
    color: var(--blue);
    font-size: 14px;
    font-weight: 800;
    padding: 13px 26px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 10px 26px rgba(20, 80, 150, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(20, 80, 150, 0.34); }

  /* search widget — folder tabs */
  .search {
    position: relative;
    z-index: 4;
    max-width: 1180px;
    margin: 26px auto 0;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(20, 80, 150, 0.22);
    padding: 0 22px 20px;
  }
  .tabs {
    display: flex;
    gap: 6px;
    padding: 10px 12px 0;
    background: #f0f7fe;
    border-radius: 18px 18px 0 0;
    margin: 0 -22px;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted);
    padding: 12px 24px;
    border-radius: 12px 12px 0 0;
  }
  .tab img { width: 17px; height: 17px; object-fit: contain; }
  .tab.on {
    background: #fff;
    color: var(--blue);
    font-weight: 800;
    position: relative;
  }
  .fields { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; padding-top: 16px; }
  .fld {
    flex: 1;
    min-width: 130px;
    border: 1.5px solid #e3edf7;
    border-radius: 10px;
    padding: 8px 12px;
    background: #fbfdff;
  }
  .fld em { display: block; font-style: normal; font-size: 10.5px; color: #8aa2b8; font-weight: 800; letter-spacing: 0.04em; }
  .fld b { font-size: 13.5px; color: var(--ink); font-weight: 800; }
  .fld b .cal { width: 14px; height: 14px; object-fit: contain; vertical-align: -2px; margin-left: 3px; }
  .swap {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--soft);
    color: var(--blue);
    display: grid;
    place-items: center;
    font-size: 14px;
    margin-bottom: 4px;
    flex: none;
  }
  .go {
    background: var(--blue);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    padding: 12px 30px;
    border-radius: 10px;
    cursor: pointer;
  }
  .go:hover { background: var(--blue-deep); }

  /* ============ FEATURES ============ */
  .feats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 34px 24px 10px;
  }
  .feat {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 10px 26px rgba(30, 90, 160, 0.08);
  }
  .feat img {
    width: 46px;
    height: 46px;
    object-fit: contain;
    background: var(--soft);
    border-radius: 13px;
    padding: 8px;
    box-sizing: border-box;
    flex: none;
  }
  .feat b { display: block; font-size: 13.5px; color: var(--ink); line-height: 1.25; }
  .feat em { display: block; font-style: normal; font-size: 11.5px; color: var(--muted); margin-top: 3px; }
  /* ============ PACKAGES ============ */
  .packages {
    max-width: 1240px;
    margin: 26px auto 0;
    background: #fff;
    border-radius: 24px;
    padding: 30px 30px 34px;
    box-shadow: 0 18px 50px rgba(30, 90, 160, 0.1);
  }
  .pack-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .pack-head b {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .pack-head em { font-style: normal; font-size: 13px; font-weight: 800; color: var(--blue); }
  .pack-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .pack {
    border: 1px solid #edf3fa;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .pack:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(30, 90, 160, 0.16); }
  .pack img { width: 100%; height: 150px; object-fit: cover; }
  .pack h3 { margin: 14px 14px 8px; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 15.5px; color: var(--ink); }
  .meta { display: flex; justify-content: space-between; gap: 8px; margin: 0 14px 12px; font-size: 11.5px; font-weight: 700; color: var(--muted); }
  .prow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 14px 16px;
    border-top: 1px solid #eef4fb;
    padding-top: 12px;
  }
  .price { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 19px; color: var(--blue); line-height: 1; }
