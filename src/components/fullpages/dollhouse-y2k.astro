<style>
  .page {
    --pink: #ff6ec7;
    --lav: #b78ef2;
    --blue: #6cb8e8;
    background: #fdf8f3;
    color: #333;
    font-family: Tahoma, Verdana, sans-serif;
    padding-bottom: 46px;
    overflow-x: clip;
  }
  .page img { display: block; }

  /* ============ win98 window ============ */
  .win {
    background: #fff;
    border: 1px solid #5a5a5a;
    box-shadow:
      inset 1.5px 1.5px 0 #fff,
      inset -1.5px -1.5px 0 #b9b9b9,
      3px 3px 0 rgba(90, 40, 70, 0.12);
  }
  .tb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    font-weight: 700;
    color: #fff;
    padding: 4px 7px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.22);
    letter-spacing: 0.02em;
  }
  .tb-pink { background: linear-gradient(90deg, #ff9ad5, #ff6ec7); }
  .tb-lav { background: linear-gradient(90deg, #d7bdf8, #b78ef2); }
  .tb-blue { background: linear-gradient(90deg, #9cd2f2, #6cb8e8); }
  .btns { display: inline-flex; gap: 3px; }
  .btns i {
    font-style: normal;
    background: #fff;
    color: #666;
    font-size: 9px;
    line-height: 1;
    padding: 1px 4px;
    border: 1px solid #999;
  }

  /* ============ buttons ============ */
  .btn {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 700;
    color: #fff;
    padding: 8px 16px;
    text-decoration: none;
    border: 1px solid #5a5a5a;
    box-shadow: inset 1.5px 1.5px 0 rgba(255, 255, 255, 0.55), 2.5px 2.5px 0 rgba(90, 40, 70, 0.2);
  }
  .btn-pink { background: var(--pink); }
  .btn-blue { background: #a8d8f0; color: #234; }
  .btn-lav { background: var(--lav); }

  /* ============ chrome text ============ */
  .chrome {
    font-family: 'Titan One', sans-serif;
    background: linear-gradient(180deg, #fff 6%, #ffd3ec 28%, #ff6ec7 50%, #fff 54%, #d9c6f5 72%, #8f5fc9 96%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1.5px #e24aa8;
    filter: drop-shadow(3px 4px 0 rgba(160, 60, 120, 0.35));
  }

  /* ============ ticker ============ */
  .ticker {
    position: relative;
    display: flex;
    align-items: center;
    background: #ff9ad5;
    border-bottom: 1px solid #e86ab8;
    height: 30px;
    overflow: hidden;
  }
  .tick-track {
    display: flex;
    width: max-content;
    font: 700 13px 'VT323', monospace;
    letter-spacing: 0.1em;
    color: #7a1257;
    animation: tick 28s linear infinite;
  }
  @keyframes tick { to { transform: translateX(-50%); } }
  .tick-right {
    position: absolute;
    right: 10px;
    font-size: 11px;
    font-weight: 700;
    color: #7a1257;
    background: #ff9ad5;
    padding-left: 12px;
  }

  /* ============ header ============ */
  .hdr {
    display: flex;
    align-items: center;
    gap: 26px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 24px 12px;
  }
  .logo {
    position: relative;
    font-family: 'Titan One', sans-serif;
    font-size: 30px;
    line-height: 1;
    color: var(--pink);
    text-shadow: 2px 2px 0 #fff, 3.5px 3.5px 0 #f7b8dd;
    transform: rotate(-5deg);
    white-space: nowrap;
  }
  .logo i { font-style: normal; font-size: 18px; color: #ff4fb0; }
  .logo sup { font-size: 9px; }
  .logo .spark { position: absolute; top: -10px; right: -16px; font-size: 14px; color: #b78ef2; }
  .nav { display: flex; gap: 22px; flex: 1; justify-content: center; }
  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: #777;
    text-decoration: none;
  }
  .nav a i { font-style: normal; font-size: 14px; }
  .nav a.on, .nav a:hover { color: var(--pink); }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1px solid #c9c9c9;
    box-shadow: inset 1.5px 1.5px 0 #eee;
    font-size: 11.5px;
    color: #999;
    padding: 7px 10px;
  }
  .search b {
    background: var(--pink);
    color: #fff;
    padding: 2px 8px;
    border: 1px solid #d1569f;
  }

  /* ============ main 3col ============ */
  .main {
    display: grid;
    grid-template-columns: 230px 1fr 260px;
    gap: 20px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 22px 24px 44px;
  }
  .col-side, .col-right { display: flex; flex-direction: column; gap: 16px; }
  .qlinks { display: flex; flex-direction: column; padding: 8px; }
  .qlinks span {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #444;
    padding: 9px 8px;
    border-bottom: 1px dotted #eee;
  }
  .qlinks span:hover { background: #ffeef8; color: var(--pink); }
  .qlinks i { font-style: normal; color: var(--pink); width: 16px; text-align: center; }
  .qlinks em { font-style: normal; margin-left: auto; color: #c9c9c9; }

  .welcome { padding: 12px; position: relative; min-height: 128px; }
  .welcome p { margin: 0 0 8px; font-size: 12px; line-height: 1.6; color: #555; max-width: 150px; }
  .welcome b { color: var(--pink); }
  .xoxo { font-style: italic; color: #999 !important; }
  .tamagotchi {
    position: absolute;
    right: 10px;
    bottom: 8px;
    width: 46px;
    height: 58px;
    background: linear-gradient(180deg, #ffb7e2, #ff8ed0);
    border: 2px solid #d1569f;
    border-radius: 50% 50% 46% 54% / 58% 58% 42% 42%;
    padding: 6px 7px;
    box-shadow: 2px 3px 0 rgba(90, 40, 70, 0.2);
  }
  .t-scr {
    display: grid;
    place-items: center;
    height: 24px;
    background: #c9f0d8;
    border: 2px solid #bb6699;
    border-radius: 6px;
    font-size: 11px;
    color: #ff4fb0;
    animation: blink 1.6s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0.55; } }
  .t-btns { display: flex; gap: 3px; margin-top: 6px; }
  .t-btns i { flex: 1; height: 6px; background: #fff; border-radius: 3px; opacity: 0.85; }
  .t-ring {
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 14px;
    height: 14px;
    border: 3px solid #d1569f;
    border-radius: 50%;
  }

  /* hero */
  .hero { position: relative; text-align: center; padding: 56px 225px 56px 10px; }
  .fly { position: absolute; font-size: 32px; z-index: 3; filter: drop-shadow(1px 2px 0 rgba(0,0,0,0.1)); }
  .f1 { top: 6px; left: 8%; transform: rotate(-12deg); }
  .f2 { bottom: 30px; left: 2%; font-size: 22px; transform: rotate(14deg); }
  .deco { position: absolute; color: var(--pink); z-index: 1; }
  .d1 { top: 12px; right: 26%; font-size: 22px; color: #b78ef2; }
  .d2 { bottom: 12px; right: 30%; font-size: 16px; }
  .d3 { top: 46%; left: 4%; font-size: 15px; color: #ff9ad5; }
  .d4 { top: 70%; left: 12%; font-size: 12px; color: #6cb8e8; }
  .cd {
    position: absolute;
    top: -6px;
    right: 224px;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #fdf8f3 0 16%, transparent 16.5%),
      conic-gradient(#f8b6e3, #cde7f7, #f9e3b8, #d9c6f5, #f8b6e3);
    transform: rotate(18deg);
    box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }
  .hero h1 { margin: 0; line-height: 0.96; transform: rotate(-3deg); position: relative; z-index: 2; }
  .hero h1 span { display: block; font-size: clamp(40px, 4.5vw, 62px); white-space: nowrap; }
