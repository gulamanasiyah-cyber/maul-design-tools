      <div class="sbc-scrim"></div>
      
      <div class="container sbc-content-container">
        <h2 class="serif-heading sbc-title">Designed for Every Space</h2>
        
        <nav class="sbc-links-row">
          <a href="#living" class="sbc-nav-item active">Living Room <sup>(14)</sup></a>
          <span class="sbc-dot">·</span>
          <a href="#bedroom" class="sbc-nav-item">Bedroom <sup>(5)</sup></a>
          <span class="sbc-dot">·</span>
          <a href="#dining" class="sbc-nav-item">Dining Room <sup>(5)</sup></a>
          <span class="sbc-dot">·</span>
          <a href="#seating" class="sbc-nav-item">Seating <sup>(11)</sup></a>
          <span class="sbc-dot">·</span>
          <a href="#storage" class="sbc-nav-item">Storage <sup>(5)</sup></a>
          <span class="sbc-dot">·</span>
          <a href="#tables" class="sbc-nav-item">Tables <sup>(7)</sup></a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ==================== TEXT WITH IMAGE (SPLIT EDITORIAL) ==================== -->
  <section class="text-with-image-section">
    <div class="container twi-grid">
      <div class="twi-media-collage">
        <div class="twi-primary">
          <img src="/assets/majestic/twi-primary.png" alt="Crafted for the Way You Live" />
        </div>
        <div class="twi-secondary">
          <img src="/assets/majestic/twi-secondary.png" alt="Lifestyle detail" />
        </div>
      </div>

      <div class="twi-copy">
        <h2 class="serif-heading">Crafted for the Way You Live</h2>
        <p class="twi-desc">
          We believe a home should feel as good as it looks. Every piece we create is designed with intention — balancing timeless aesthetics, everyday comfort, and lasting quality. From quiet mornings to lively evenings, our furniture is made to be part of your life, not just your space.
        </p>
        <a href="#collections" class="btn btn-dark">Discover our collection →</a>
      </div>
    </div>
  </section>

  <!-- ==================== STATEMENT PIECES (CAROUSEL) ==================== -->
  <section class="statement-pieces-section">
    <div class="container">
      <div class="sp-head">
        <h2 class="serif-heading">Statement Pieces</h2>
      </div>

      <div class="sp-grid-4">
        <article class="sp-card">
          <div class="sp-media"><img src="/assets/majestic/p-marble.png" alt="Marble Dining Table" /></div>
          <h3 class="sp-name">Marble Dining Table</h3>
          <span class="sp-price">$3,499.00 USD</span>
        </article>

        <article class="sp-card">
          <div class="sp-media"><img src="/assets/majestic/p-pebble.png" alt="Pebble Ottoman" /></div>
          <h3 class="sp-name">Pebble Ottoman</h3>
          <span class="sp-price">$299.00 USD</span>
        </article>

        <article class="sp-card">
          <div class="sp-media"><img src="/assets/majestic/p-form.png" alt="Form Bookshelf" /></div>
          <h3 class="sp-name">Form Bookshelf</h3>
          <span class="sp-price">$799.00 USD <s class="old">$999.00</s></span>
        </article>

        <article class="sp-card">
          <div class="sp-media"><img src="/assets/majestic/p-reign.png" alt="Reign Dining Chair" /></div>
          <h3 class="sp-name">Reign Dining Chair</h3>
          <span class="sp-price">$449.00 USD</span>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== ROOM TRANSFORMATION (BEFORE / AFTER) ==================== -->
  <section class="room-transform-section">
    <div class="container">
      <div class="section-head-center">
        <span class="sub-kicker">Room transformation</span>
        <h2 class="serif-heading">From empty space to a lived-in home</h2>
        <p class="section-sub">See how thoughtful furniture and balanced layouts completely transform the feel of a room.</p>
      </div>

      <div class="comparison-stage">
        <div class="compare-frame">
          <img src="/assets/majestic/compare-before.png" alt="Before furniture setup" class="compare-img" />
          <span class="tag-before">Before</span>
          <span class="tag-after">After</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TICKER BANNER (MAJESTIC LOGO) ==================== -->
  <section class="logo-ticker-strip">
    <div class="logo-ticker-track">
      <span><img src="/assets/majestic/logo-dark.svg" alt="Majestic" class="t-logo" /></span>
      <span class="t-text">Designed for you</span>
      <span class="t-sep">•</span>
      <span><img src="/assets/majestic/logo-dark.svg" alt="Majestic" class="t-logo" /></span>
      <span class="t-text">Designed for you</span>
      <span class="t-sep">•</span>
      <span><img src="/assets/majestic/logo-dark.svg" alt="Majestic" class="t-logo" /></span>
      <span class="t-text">Designed for you</span>
    </div>
  </section>

  <!-- ==================== FAQ COLLAPSIBLE ROWS ==================== -->
  <section class="faq-section">
    <div class="container faq-grid">
      <div class="faq-media-col">
        <img src="/assets/majestic/faq-main.png" alt="Interior styling" class="faq-main-img" />
      </div>

      <div class="faq-accordion-col">
        <span class="sub-kicker">Frequently asked questions</span>
        <h2 class="serif-heading">Everything You Need to Know</h2>

        <div class="accordion-list">
          <details class="faq-row" open>
            <summary>How long does delivery take? <span class="arrow">▾</span></summary>
            <p>In-stock items usually dispatch within 24–48 hours. Delivery timelines are shown at checkout based on your location.</p>
          </details>
          <details class="faq-row">
            <summary>What is your return policy? <span class="arrow">▾</span></summary>
            <p>You can request a return within 30 days of delivery for eligible products in original condition.</p>
          </details>
          <details class="faq-row">
            <summary>Can I get styling or product help? <span class="arrow">▾</span></summary>
            <p>Yes. Our team can help with sizing, materials, and room planning so you can shop with confidence.</p>
          </details>
          <details class="faq-row">
            <summary>What warranty is included? <span class="arrow">▾</span></summary>
            <p>Our products include a standard manufacturer warranty. Coverage details vary by product and are listed on each product page.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 4-COLUMN VALUE PROPS ==================== -->
