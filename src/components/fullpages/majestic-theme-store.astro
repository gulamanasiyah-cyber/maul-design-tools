    <div class="container">
      <div class="vp-grid-4">
        <div class="vp-card">
          <span class="vp-icon">⏳</span>
          <h3 class="vp-title">Timeless Materials</h3>
          <p class="vp-text">Carefully selected woods, fabrics, and finishes that are made to last and age beautifully over time.</p>
        </div>

        <div class="vp-card">
          <span class="vp-icon">🌿</span>
          <h3 class="vp-title">Everyday Comfort</h3>
          <p class="vp-text">Designed for real living, our pieces offer comfort that feels effortless from morning to night.</p>
        </div>

        <div class="vp-card">
          <span class="vp-icon">★</span>
          <h3 class="vp-title">Refined Aesthetics</h3>
          <p class="vp-text">Sculptural silhouettes and harmonious palettes tailored for modern luxury residences.</p>
        </div>

        <div class="vp-card">
          <span class="vp-icon">↺</span>
          <h3 class="vp-title">Seamless Experience</h3>
          <p class="vp-text">From browsing to delivery, we ensure a smooth and reliable experience at every step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIAL SPOTLIGHT ==================== -->
  <section class="testimonial-spotlight-section">
    <div class="container">
      <div class="section-head-center">
        <span class="sub-kicker">Homes That Speak for Us</span>
        <h2 class="serif-heading">Lived & Loved</h2>
      </div>

      <div class="spotlight-card">
        <div class="spotlight-img-col">
          <img src="/assets/majestic/test-room-1.png" alt="Client living room" class="spotlight-room-img" />
        </div>

        <div class="spotlight-quote-col">
          <div class="stars-gold">★★★★★</div>
          <blockquote class="quote-text">
            "The finish and craftsmanship exceeded our expectations. Every detail feels thoughtful, sculptural and premium."
          </blockquote>
          
