  <!-- ==================== JOURNAL / BLOG POSTS ==================== -->
  <section class="journal-section" id="journal">
    <div class="container">
      <div class="journal-head">
        <h2 class="serif-heading">From the blog</h2>
      </div>

      <div class="journal-grid-4">
        <article class="article-card">
          <div class="art-media"><img src="/assets/majestic/blog-1.png" alt="Dining Table Guide" /></div>
