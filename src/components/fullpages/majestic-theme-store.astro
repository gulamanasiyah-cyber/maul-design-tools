---
// Majestic Luxury Furniture Store — Full-page recreation of the live storefront template.
// Palettes: Pure White #FFFFFF, Off-white Cream #FFF3E1, Charcoal/Black #111111, Accent Gold #89662F, Muted Gray #707070.
// Fonts: Newsreader (italic serif headings), Poppins (clean body), Comfortaa (pill buttons).
---

<div class="majestic-store">
  <!-- ==================== TOP ANNOUNCEMENT TICKER ==================== -->
  <aside class="announcement-bar">
    <div class="ticker-track">
      <div class="ticker-content">
        <span>Use this space for a store update or special offer</span>
        <span class="sep">•</span>
        <span>Free shipping on orders over $150 — Shop now</span>
        <span class="sep">•</span>
        <span>Complimentary in-room delivery & white-glove setup</span>
        <span class="sep">•</span>
        <span>Use this space for a store update or special offer</span>
        <span class="sep">•</span>
        <span>Free shipping on orders over $150 — Shop now</span>
      </div>
    </div>
  </aside>

  <!-- ==================== HEADER WITH LOGO & MEGA MENU ==================== -->
  <header class="main-header">
    <div class="container header-container">
      <!-- Left Logo -->
      <div class="header-left">
        <a href="/" class="brand-logo">
          <img src="/assets/majestic/logo-dark.svg" alt="Majestic" class="logo-svg" />
        </a>
      </div>

      <!-- Center Navigation -->
      <nav class="header-nav">
        <a href="/" class="nav-item active">Home</a>
        <div class="nav-item nav-has-mega">
          <a href="#catalog">Shop All <span class="caret">▾</span></a>
        </div>
        <div class="nav-item nav-has-mega">
          <a href="#collections">Collections <span class="caret">▾</span></a>
        </div>
        <div class="nav-item">
          <a href="#layout">Product Layout <span class="caret">▾</span></a>
        </div>
        <a href="#about" class="nav-item">About</a>
        <a href="#journal" class="nav-item">Journal</a>
        <a href="#contact" class="nav-item">Contact</a>
      </nav>

      <!-- Right Actions -->
      <div class="header-right">
        <div class="region-pill">
          <span class="flag">🇮🇳</span>
          <span class="region-text">India (USD $) / English</span>
        </div>
        <button class="action-btn" aria-label="Search">
          <svg viewBox="0 0 21 21" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8.75" cy="8.75" r="7" />
            <path d="M14 14l5.5 5.5" />
          </svg>
        </button>
        <button class="action-btn" aria-label="Account">
          <svg viewBox="0 0 21 21" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="10.5" cy="5.25" r="3.5" />
            <path d="M3.5 18.5a7 7 0 0114 0" />
          </svg>
        </button>
        <button class="action-btn cart-btn" aria-label="Cart">
          <svg viewBox="0 0 22 21" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M19.25 5.25H16.5a5.5 5.5 0 00-11 0H2.75A2.75 2.75 0 000 8v8.75A4.25 4.25 0 004.25 21h13.5a4.25 4.25 0 004.25-4.25V8a2.75 2.75 0 00-2.75-2.75z" />
          </svg>
          <span class="cart-badge">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== HERO FULL-HEIGHT BANNER ==================== -->
  <section class="hero-section">
    <div class="hero-media-wrapper">
      <img src="/assets/majestic/hero-banner.jpg" alt="Living Room with modern furniture" class="hero-banner-img" />
      <div class="hero-scrim"></div>
      
      <div class="container hero-content-container">
        <div class="hero-content-box">
          <span class="hero-eyebrow">HOME DECOR & LIVING</span>
          <h1 class="hero-title">
            <span>Make Your House</span>
            <em>Feel Like Home</em>
          </h1>
          <p class="hero-subtitle">
            Thoughtfully designed pieces made with premium materials, crafted for comfort, built to last, and styled to feel like home.
          </p>
          <div class="hero-actions">
            <a href="#featured" class="btn btn-white">NEW COLLECTION</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED COLLECTION (TABBED SLIDER) ==================== -->
  <section class="featured-collection-section" id="featured">
    <div class="container">
      <div class="section-head-center">
        <h2 class="serif-heading">Featured collection</h2>
        
        <!-- Category Tabs -->
        <div class="collection-tabs-row">
          <button class="tab-btn active">Chairs</button>
          <button class="tab-btn">Living Room</button>
          <button class="tab-btn">Bedroom</button>
          <button class="tab-btn">Dining Room</button>
        </div>
      </div>

      <!-- 4-Column Product Grid -->
      <div class="product-grid-4">
        <!-- Item 1: Veloura Two-Seater Sofa -->
        <article class="product-card">
          <a href="#product" class="p-card-media">
            <img src="/assets/majestic/p-veloura.png" alt="Veloura Two-Seater Sofa" class="p-img-primary" />
          </a>
          <div class="p-card-info">
            <span class="p-vendor">Majestic</span>
            <h3 class="p-name">Veloura Two-Seater Sofa</h3>
            <div class="p-price-row">
              <span class="p-price">$1,099.00 USD</span>
            </div>
          </div>
        </article>

        <!-- Item 2: Aurelle Swivel Lounge Chair -->
        <article class="product-card">
          <a href="#product" class="p-card-media">
            <img src="/assets/majestic/p-aurelle.png" alt="Aurelle Swivel Lounge Chair" class="p-img-primary" />
          </a>
          <div class="p-card-info">
            <span class="p-vendor">Majestic</span>
            <h3 class="p-name">Aurelle Swivel Lounge Chair</h3>
            <div class="p-price-row">
              <span class="p-price">$599.00 USD</span>
            </div>
          </div>
        </article>

        <!-- Item 3: Verona Accent Lounge Chair -->
        <article class="product-card">
          <a href="#product" class="p-card-media">
            <img src="/assets/majestic/p-verona.png" alt="Verona Accent Lounge Chair" class="p-img-primary" />
          </a>
          <div class="p-card-info">
            <span class="p-vendor">Majestic</span>
            <h3 class="p-name">Verona Accent Lounge Chair</h3>
            <div class="p-price-row">
              <span class="p-price">$699.00 USD</span>
            </div>
          </div>
        </article>

        <!-- Item 4: Arden Wooden Accent Chair -->
        <article class="product-card">
          <a href="#product" class="p-card-media">
            <img src="/assets/majestic/p-arden.png" alt="Arden Wooden Accent Chair" class="p-img-primary" />
          </a>
          <div class="p-card-info">
            <span class="p-vendor">Majestic</span>
            <h3 class="p-name">Arden Wooden Accent Chair</h3>
            <div class="p-price-row">
              <span class="p-price">$459.00 USD</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== SPACES THAT DEFINE (SELECTION CARDS) ==================== -->
  <section class="selection-spaces-section" id="collections">
    <div class="container">
      <h2 class="serif-heading text-center">Spaces That Define Your Home</h2>

      <div class="selection-grid-3">
        <!-- Dining Room -->
        <div class="space-card">
          <div class="space-media">
            <img src="/assets/majestic/sbc-dining.png" alt="Dining Room" />
            <div class="space-overlay">
              <h3 class="space-title">Dining Room</h3>
              <a href="#dining" class="btn btn-white-pill">View Collection</a>
            </div>
          </div>
        </div>

        <!-- Bedroom -->
        <div class="space-card">
          <div class="space-media">
            <img src="/assets/majestic/sel-bedroom.jpg" alt="Bedroom" />
            <div class="space-overlay">
              <h3 class="space-title">Bedroom</h3>
              <a href="#bedroom" class="btn btn-white-pill">View Collection</a>
            </div>
          </div>
        </div>

        <!-- Living Room -->
        <div class="space-card">
          <div class="space-media">
            <img src="/assets/majestic/sbc-living.png" alt="Living room" />
            <div class="space-overlay">
              <h3 class="space-title">Living room</h3>
              <a href="#living" class="btn btn-white-pill">View Collection</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== EDITORIAL STATEMENT ==================== -->
  <section class="editorial-statement-section">
    <div class="container statement-container">
      <h2 class="serif-statement">
        Thoughtfully Designed Furniture for Modern Living That Brings Comfort, Style, and Purpose Into Every Corner
      </h2>
    </div>
  </section>

  <!-- ==================== PRODUCT BUNDLE BUILDER ==================== -->
  <section class="bundle-builder-section">
    <div class="container">
      <div class="bundle-head">
        <span class="sub-kicker">Build Your Perfect Set</span>
        <h2 class="serif-heading">A Cohesive Collection</h2>
      </div>

      <div class="bundle-layout">
        <!-- Left: Summary Tier Box -->
        <aside class="bundle-summary-card">
          <div class="summary-head">
            <h3 class="summary-title">Your bundle</h3>
            <span class="bundle-count">0 / 4</span>
          </div>

          <div class="bundle-tiers-track">
            <div class="tier-step"><span class="t-name">1 Product</span><strong>15% OFF</strong></div>
            <div class="tier-step"><span class="t-name">2 Products</span><strong>30% OFF</strong></div>
            <div class="tier-step"><span class="t-name">3 Products</span><strong>45% OFF</strong></div>
            <div class="tier-step"><span class="t-name">4 Products</span><strong>60% OFF</strong></div>
          </div>

          <div class="summary-rows">
            <div class="s-row"><span>Subtotal</span><strong>$0.00 USD</strong></div>
            <div class="s-row"><span>Savings</span><strong>$0.00 USD</strong></div>
            <div class="s-row s-total"><span>Total</span><strong>$0.00 USD</strong></div>
          </div>

          <button class="btn btn-dark-full" disabled>Add bundle to cart</button>
        </aside>

        <!-- Right: 4-Product Bundle Selectors -->
        <div class="bundle-items-grid">
          <div class="bundle-item">
            <div class="b-img"><img src="/assets/majestic/p-arden.png" alt="Arden Wooden Accent Chair" /></div>
            <h4 class="b-name">Arden Wooden Accent Chair</h4>
            <span class="b-price">$459.00 USD</span>
            <button class="btn-bundle-toggle">+ Add to bundle</button>
          </div>

          <div class="bundle-item">
            <div class="b-img"><img src="/assets/majestic/p-lunara.png" alt="Lunara Round Coffee Table" /></div>
            <h4 class="b-name">Lunara Round Coffee Table</h4>
            <span class="b-price">$549.00 USD</span>
            <button class="btn-bundle-toggle">+ Add to bundle</button>
          </div>

          <div class="bundle-item">
            <div class="b-img"><img src="/assets/majestic/p-verona.png" alt="Verona Accent Lounge Chair" /></div>
            <h4 class="b-name">Verona Accent Lounge Chair</h4>
            <span class="b-price">$699.00 USD</span>
            <button class="btn-bundle-toggle">+ Add to bundle</button>
          </div>

          <div class="bundle-item">
            <div class="b-img"><img src="/assets/majestic/p-solenne.png" alt="Solenne Sideboard Console" /></div>
            <h4 class="b-name">Solenne Sideboard Console</h4>
            <span class="b-price">$799.00 USD</span>
            <button class="btn-bundle-toggle">+ Add to bundle</button>
          </div>
        </div>
      </div>
    </div>
  </section>

