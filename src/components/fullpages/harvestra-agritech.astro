---
// Harvestra AgriTech — Full-page recreation of the agricultural innovation reference landing page.
// Features: lush aerial hero with video play button & floating preview thumbnails,
// tillage & global connection world map, 3-card asymmetric services bento,
// numbered value cards, partners logo row, harvesting split banner, client testimonials,
// AI plant-level detection, expert blog cards, pre-footer CTA, and deep agroveon/farmetic footer.
---

<div class="harvestra-page">
  <!-- ==================== HEADER & HERO ==================== -->
  <header class="header">
    <div class="header-inner">
      <a href="#" class="brand">
        <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L12 22M12 2C8 6 4 11 4 16C4 19.3137 6.68629 22 10 22M12 2C16 6 20 11 20 16C20 19.3137 17.3137 22 14 22" />
        </svg>
        <span class="brand-name">Harvestra</span>
      </a>

      <nav class="nav-links">
        <a href="#home" class="nav-item active">Home</a>
        <a href="#about" class="nav-item">About</a>
        <a href="#services" class="nav-item">Service</a>
        <div class="nav-dropdown">
          <span class="nav-item">Others <span class="chevron">▾</span></span>
        </div>
      </nav>

      <a href="#contact" class="btn-pill-dark">
        <span>Contact us</span>
        <div class="icon-circle">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 12L12 4M12 4H6M12 4V10" />
          </svg>
        </div>
      </a>
    </div>
  </header>

  <section class="hero" id="home">
    <div class="hero-bg-wrap">
      <img src="/assets/harvestra/hero.jpg" alt="Aerial view of green circular farmland" class="hero-bg" />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">
        <span>Next—Gen</span>
        <span>Farming Growth</span>
        <span>Innovation</span>
      </h1>
      <p class="hero-subtitle">
        We don't just grow crops — we grow relationships rooted in trust, innovation, and a shared commitment.
      </p>

      <div class="hero-cta-row">
        <a href="#about" class="btn-pill-light">
          <span>Start growing with us</span>
          <div class="icon-circle-dark">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 12L12 4M12 4H6M12 4V10" />
            </svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Floating Play Button -->
    <button class="hero-play-btn" aria-label="Play video">
      <div class="play-icon">▶</div>
    </button>

    <!-- Floating Image Previews -->
    <div class="hero-thumbnails">
      <div class="thumb-card"><img src="/assets/harvestra/thumb1.jpg" alt="Plowed field" /></div>
      <div class="thumb-card"><img src="/assets/harvestra/thumb2.jpg" alt="Golden wheat field" /></div>
      <div class="thumb-card highlight"><img src="/assets/harvestra/thumb3.jpg" alt="Lush green field" /></div>
    </div>
  </section>

  <!-- ==================== ABOUT & GLOBAL CONNECTION ==================== -->
  <section class="section about-section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <span class="pill-badge">About us</span>
          <h2 class="section-heading">
            We Blend Agricultural Expertise With Technology To Transform In Tillage
          </h2>
          <a href="#services" class="btn-pill-dark">
            <span>About us</span>
            <div class="icon-circle">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 12L12 4M12 4H6M12 4V10" />
              </svg>
            </div>
          </a>

          <div class="global-connection">
            <h4 class="gc-title">Global Connection</h4>
            <div class="gc-pills">
              <span class="gc-pill">Jordan</span>
              <span class="gc-pill">USA</span>
              <span class="gc-pill">Brazil</span>
              <span class="gc-pill">Chile</span>
              <span class="gc-pill">Mexico</span>
              <span class="gc-pill">Poland</span>
              <span class="gc-pill">Greece</span>
              <span class="gc-pill">France</span>
              <span class="gc-pill highlight">Africa</span>
            </div>
          </div>
        </div>

        <div class="about-visual">
          <div class="globe-container">
            <svg class="globe-vector" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="200" cy="200" r="180" stroke="#E2DFD2" stroke-width="1.5" stroke-dasharray="3 3" />
              <ellipse cx="200" cy="200" rx="180" ry="80" stroke="#EAE7DC" stroke-width="1" />
              <ellipse cx="200" cy="200" rx="90" ry="180" stroke="#EAE7DC" stroke-width="1" />
              <!-- Continents abstract mesh -->
              <g fill="#EAE7DC" opacity="0.85">
                <!-- North America -->
                <path d="M120 100 Q150 80 180 110 T160 160 T120 130 Z" />
                <!-- Europe/Asia -->
                <path d="M220 80 Q280 70 320 120 T270 160 T210 120 Z" />
                <!-- Africa -->
                <path d="M210 180 Q250 190 260 250 T220 290 T200 220 Z" fill="#EAE7DC" />
              </g>
              <!-- South America Highlighted in Golden Yellow -->
              <path d="M140 210 Q170 200 180 250 Q170 300 150 320 Q135 280 140 210 Z" fill="#F4CD56" stroke="#DDA824" stroke-width="1.5" />
              <!-- Glow pulse -->
              <circle cx="160" cy="260" r="6" fill="#DDA824" />
              <circle cx="160" cy="260" r="14" stroke="#F4CD56" stroke-width="2" opacity="0.6" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PRACTICAL SERVICES BENTO ==================== -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="center-head">
        <span class="pill-badge">Our Services</span>
        <h2 class="section-heading text-center">
          Practical Impactful Solutions For Modern Agriculture
        </h2>
      </div>

      <div class="services-bento">
        <!-- Top Wide Card -->
        <div class="bento-card bento-wide">
          <img src="/assets/harvestra/service1.jpg" alt="Sustainable irrigation wheat field" class="card-bg-img" />
          <div class="bento-overlay-card">
            <h3 class="overlay-title">Sustainable Irrigation for Smarter Farming</h3>
            <p class="overlay-desc">
              We collaborate closely with clients to understand their unique needs and goals. Our focus is on boosting resilience and ensuring long-term productivity.
            </p>
            <a href="#" class="overlay-link">
              <span>Learn more</span>
              <span class="link-arrow">↗</span>
            </a>
          </div>
        </div>

        <!-- Bottom Left Card -->
        <div class="bento-card bento-half">
          <img src="/assets/harvestra/service2.jpg" alt="Tractor spraying canola field" class="card-bg-img" />
          <div class="bento-bottom-overlay">
            <h3 class="overlay-title">Comprehensive Supply Chain Support</h3>
            <a href="#" class="overlay-link">
              <span>Learn more</span>
              <span class="link-arrow">↗</span>
            </a>
          </div>
        </div>

        <!-- Bottom Right Tall Card -->
        <div class="bento-card bento-half tall">
          <img src="/assets/harvestra/service3.jpg" alt="Revolutionising agriculture tractor" class="card-bg-img" />
          <div class="bento-bottom-overlay">
            <h3 class="overlay-title">Revolutionising Agriculture Farming</h3>
            <a href="#" class="overlay-link">
              <span>Learn more</span>
              <span class="link-arrow">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR VALUE ==================== -->
  <section class="section value-section">
    <div class="container">
      <div class="center-head">
        <span class="pill-badge">Our Value</span>
        <h2 class="section-heading text-center">
          Modern Solutions & Lasting Benefits For Farmers
        </h2>
      </div>

      <div class="value-grid">
        <!-- Card 01 -->
        <div class="value-card">
          <img src="/assets/harvestra/value1.jpg" alt="Hand holding fertile soil" class="val-img" />
          <div class="val-content">
            <div class="val-header">
              <span class="val-num">01</span>
              <span class="val-tm">TM</span>
              <h3 class="val-title">Unlocking the Full Potential of Your Land</h3>
            </div>
            <p class="val-desc">
              Our goal is to get you the best value for the regenerative practices that work best for your land.
            </p>
          </div>
        </div>

        <!-- Card 02 -->
        <div class="value-card">
          <img src="/assets/harvestra/value2.jpg" alt="Furrowed farming soil" class="val-img" />
          <div class="val-content">
            <div class="val-header">
              <span class="val-num">02</span>
              <span class="val-tm">TM</span>
              <h3 class="val-title">Best Prices Delivered with Full Transparency</h3>
            </div>
            <p class="val-desc">
              We deliver the best price, transparently, and pay within the season.
            </p>
          </div>
        </div>

        <!-- Card 03 -->
        <div class="value-card">
          <img src="/assets/harvestra/value3.jpg" alt="Terraced green landscape" class="val-img" />
          <div class="val-content">
            <div class="val-header">
              <span class="val-num">03</span>
              <span class="val-tm">TM</span>
              <h3 class="val-title">Grow Smarter with Agronomic Support</h3>
            </div>
            <p class="val-desc">
              We provide agronomic support to help you improve environmental outcomes and maximize value.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PARTNERS LOGO BAR ==================== -->
  <section class="partners-section">
    <div class="container">
      <p class="partners-label">Partners in our ecosystem.</p>
      <div class="partners-row">
        <div class="partner-logo">
          <svg viewBox="0 0 120 28" fill="currentColor">
            <text x="0" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">calPoint</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 130 28" fill="currentColor">
            <circle cx="12" cy="14" r="8" fill="none" stroke="currentColor" stroke-width="2.5" />
            <text x="28" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">Nietzsche</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 120 28" fill="currentColor">
            <path d="M10 4 L4 16 L12 16 L8 24 L18 12 L11 12 Z" />
            <text x="26" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">Boltshift</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 140 28" fill="currentColor">
            <path d="M8 6 C12 6 16 10 16 18 M16 6 C12 6 8 10 8 18" stroke="currentColor" stroke-width="2" fill="none" />
            <text x="26" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">FeatherDev</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 120 28" fill="currentColor">
            <circle cx="10" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="2.5" />
            <text x="24" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">Quotient</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 130 28" fill="currentColor">
            <text x="0" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">Epicurious</text>
          </svg>
        </div>
        <div class="partner-logo">
          <svg viewBox="0 0 120 28" fill="currentColor">
            <rect x="4" y="8" width="12" height="12" rx="4" fill="currentColor" />
            <text x="24" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" letter-spacing="-0.03em">Capsule</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== HARVESTING SPLIT BANNER ==================== -->
  <section class="harvesting-banner">
    <div class="harvesting-img-col">
      <img src="/assets/harvestra/harvesting.jpg" alt="Aerial harvester in golden wheat field" />
    </div>
    <div class="harvesting-text-col">
      <div class="harvesting-inner">
        <span class="harvesting-accent">Harvesting</span>
        <h2 class="harvesting-title">
          <span>Progress</span>
          <span>Through</span>
          <span>Innovation</span>
          <span>Sustainability</span>
          <span>Expertise</span>
        </h2>
      </div>
    </div>
  </section>

  <!-- ==================== CLIENT TESTIMONIALS ==================== -->
  <section class="section testimonial-section">
    <div class="container">
      <div class="testimonial-header-split">
        <div class="testi-head-left">
          <span class="pill-badge">Our Testimonial</span>
          <h2 class="section-heading">
            What Our Clients Say About Our Solutions
          </h2>
        </div>
        <div class="testi-nav-arrows">
          <button class="arrow-btn" aria-label="Previous">←</button>
          <button class="arrow-btn active" aria-label="Next">→</button>
        </div>
      </div>

      <div class="testi-grid">
        <!-- Card 1 -->
        <div class="testi-card">
          <div class="quote-mark">“</div>
          <p class="testi-text">
            “Their sustainable practices have greatly improved our farm's productivity while being eco-friendly. We couldn't be happier with the results!”
          </p>
          <div class="testi-author">
            <img src="/assets/harvestra/avatar.jpg" alt="Darrell Steward" class="author-img" />
            <div class="author-info">
              <strong class="author-name">Darrell Steward</strong>
              <span class="author-role">Darrell Steward</span>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="testi-card">
          <div class="quote-mark">“</div>
