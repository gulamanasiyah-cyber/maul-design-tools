          <div class="testi-author">
            <img src="/assets/harvestra/avatar.jpg" alt="Darrell Steward" class="author-img" />
            <div class="author-info">
              <strong class="author-name">Darrell Steward</strong>
              <span class="author-role">Darrell Steward</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PLANT TO PLANT (AI DETECTION) ==================== -->
  <section class="section ai-detection-section">
    <div class="container">
      <div class="ai-detection-grid">
        <div class="ai-img-wrap">
          <img src="/assets/harvestra/silage.jpg" alt="Wrapped round silage bales in meadow" class="silage-img" />
        </div>

        <div class="ai-content-wrap">
          <span class="pill-badge">Plant to plant</span>
          <h2 class="section-heading">AI Enables Plant-Level Detection</h2>
          <p class="ai-desc">
            We don't just grow crops — we grow relationships rooted in trust, innovation, and a shared commitment to sustainability. By combining deep agricultural knowledge with forward-thinking practices.
          </p>

          <div class="ai-features-row">
            <div class="ai-feature-item">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 19H17M12 5V19M5 12L12 5L19 12" />
                  <circle cx="12" cy="12" r="10" stroke-width="1.5" />
                </svg>
              </div>
              <div class="feature-text">
                <h4 class="feature-title">Composting</h4>
