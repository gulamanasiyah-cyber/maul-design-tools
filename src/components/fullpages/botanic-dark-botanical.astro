<style>
  .page {
    background: #06110e;
    color: #e8ece6;
    font-family: 'DM Sans', system-ui, sans-serif;
    overflow-x: clip;
  }
  .page h1,
  .page h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    margin: 0;
  }
  .page section {
    scroll-margin-top: 90px;
  }
  img {
    display: block;
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) brightness(0.8);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 60% at 50% 30%, transparent 40%, rgba(6, 17, 14, 0.45) 100%),
      linear-gradient(180deg, rgba(6, 17, 14, 0.5) 0%, rgba(6, 17, 14, 0.35) 40%, rgba(6, 17, 14, 0.82) 78%, #06110e 100%);
  }
  .nav {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px clamp(20px, 5vw, 64px);
  }
  .logo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .logo i {
    font-style: normal;
    font-size: 20px;
  }
  .navpill {
    display: flex;
    gap: 26px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px);
    border-radius: 999px;
    padding: 13px 30px;
  }
  .navpill a {
    color: rgba(255, 255, 255, 0.92);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .navpill a:hover {
    color: #dab76a;
  }
  .car {
    font-size: 9px;
    opacity: 0.7;
  }
  .nav-cta {
    background: #dab76a;
    color: #1a1408;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .hero-body {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: clamp(40px, 9vh, 96px) 24px 150px;
    max-width: 760px;
    margin: 0 auto;
  }
  .hero-body h1 {
    color: #fff;
    font-size: clamp(40px, 5.6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero-body h1 span {
    display: block;
  }
  .brush {
    width: 240px;
    height: 13px;
    margin: 20px auto 22px;
    background: #dab76a;
    border-radius: 999px;
    transform: rotate(-1.6deg);
    box-shadow: 0 10px 24px rgba(218, 183, 106, 0.25);
  }
  .hero-sub {
    color: rgba(232, 236, 230, 0.72);
    font-size: 13.5px;
    line-height: 1.7;
    max-width: 460px;
    margin: 0 auto 28px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 8px 8px 22px;
    border-radius: 999px;
  }
  .play {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    color: #0b2e22;
    display: grid;
    place-items: center;
    font-size: 10px;
  }
  .call {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }
  .call-ic {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #14503b;
    border: 1px solid rgba(255, 255, 255, 0.18);
    display: grid;
    place-items: center;
    font-size: 15px;
  }
  .call-tx em {
    display: block;
    font-style: normal;
    font-size: 11.5px;
    color: rgba(232, 236, 230, 0.62);
  }
  .call-tx b {
    font-size: 14px;
    color: #fff;
  }

  /* ---- floating card ---- */
  .float-wrap {
    position: relative;
    z-index: 4;
    padding: 0 clamp(16px, 4vw, 48px);
  }
  .float-card {
    width: min(940px, 100%);
    margin: -110px auto 0;
    background: linear-gradient(135deg, #14503b 0%, #0f3d2e 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
    padding: 26px;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 24px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .float-left {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .review {
    background: #fff;
    color: #10241c;
    border-radius: 16px;
    padding: 18px 20px;
  }
  .stars {
    display: inline-block;
    background: #0b2e22;
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 7px 14px;
    border-radius: 999px;
  }
  .stars b {
    color: #dab76a;
    font-weight: 700;
  }
  .review p {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: #5c6b64;
  }
  .client {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .client img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.25);
  }
  .who b {
    display: block;
    color: #fff;
    font-size: 14.5px;
  }
  .who em {
    font-style: normal;
    font-size: 11.5px;
    color: rgba(232, 236, 230, 0.6);
  }
  .float-right {
    position: relative;
    min-height: 250px;
  }
  .blob {
    position: absolute;
    right: -6px;
    bottom: -26px;
    width: 78%;
    height: 88%;
    background: #9db66b;
    border-radius: 50% 50% 30% 70% / 60% 40% 60% 40%;
    opacity: 0.95;
  }
  .plant {
    position: absolute;
    left: 50%;
    bottom: -18px;
    transform: translateX(-50%);
    width: 74%;
    height: 92%;
    object-fit: cover;
    border-radius: 58% 42% 52% 48% / 52% 55% 45% 48%;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
  }
  .tag {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #fff;
    color: #16352a;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }
  .tag i {
    font-style: normal;
    color: #14503b;
    font-size: 10px;
  }
  .t1 { right: 2%; top: 6%; }
  .t2 { left: 0; top: 42%; }
  .t3 { left: 14%; bottom: 4%; }

  /* ---- where ---- */
  .where {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(70px, 10vw, 120px) clamp(20px, 5vw, 64px);
    max-width: 1180px;
    margin: 0 auto;
  }
  .where-img {
    position: relative;
  }
  .where-img > img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 20px;
    filter: saturate(0.95);
  }
  .addr {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.94);
    color: #10241c;
    font-size: 11.5px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 999px;
  }
  .badge {
    position: absolute;
    right: -22px;
    bottom: -26px;
    background: linear-gradient(160deg, #14503b, #0f3d2e);
    border: 1px solid rgba(218, 183, 106, 0.25);
    border-radius: 16px;
    padding: 16px 22px 14px;
    color: #fff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  .badge b {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 34px;
    color: #dab76a;
    line-height: 1;
  }
  .badge span {
    display: block;
    font-size: 11px;
    color: rgba(232, 236, 230, 0.75);
    margin-top: 6px;
    line-height: 1.45;
  }
  .badge-line {
    display: block;
    width: 54px;
    height: 2px;
    background: #dab76a;
    margin-top: 8px;
    border-radius: 999px;
  }
  .where-copy h2 {
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.08;
    color: #fff;
  }
  .where-copy p {
    color: #9ba8a3;
    font-size: 13px;
    line-height: 1.75;
    margin: 18px 0 26px;
    max-width: 480px;
  }
  .gold-pill {
    display: inline-block;
    background: #dab76a;
    color: #1a1408;
    font-size: 13px;
    font-weight: 700;
    padding: 13px 28px;
    border-radius: 999px;
  }

  /* ---- best seller ---- */
  .best {
    text-align: center;
    padding: clamp(30px, 5vw, 60px) clamp(20px, 5vw, 64px) clamp(80px, 10vw, 130px);
    max-width: 1180px;
    margin: 0 auto;
  }
  .best h2 {
    font-size: clamp(30px, 3.6vw, 44px);
    color: #fff;
  }
  .sub {
    color: #9ba8a3;
    font-size: 12.5px;
    line-height: 1.7;
    max-width: 520px;
    margin: 14px auto 0;
  }
  .best-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 46px;
    align-items: start;
  }
  .bcard {
    position: relative;
    border-radius: 18px;
    overflow: visible;
  }
  .bcard > img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 18px;
    filter: saturate(0.95) brightness(0.92);
  }
  .bcard.mid > img {
    height: 330px;
  }
  .bcard.mid {
    transform: translateY(-16px);
  }
  .bpill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #fff;
    color: #10241c;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 7px 12px;
    border-radius: 999px;
  }
  .bpill b {
    color: #c9922e;
  }
  .bplus {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    color: #10241c;
    display: grid;
    place-items: center;
    font-size: 17px;
    font-weight: 600;
  }
  .bmeta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    text-align: center;
    color: #fff;
    padding: 0 16px;
  }
  .bmeta b {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 600;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.6);
  }
  .bmeta em {
    display: block;
    font-style: normal;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.75);
    max-width: 210px;
    margin: 6px auto 0;
    line-height: 1.5;
  }
  .olive-label {
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    width: 82%;
    background: #9db66b;
    color: #16240f;
    border-radius: 14px;
    padding: 16px 18px;
    text-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .olive-label b {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: #fff;
  }
  .olive-label em {
    display: block;
    font-style: normal;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    line-height: 1.5;
  }

  /* ---- logobar ---- */
  .logobar {
    background: #dab76a;
    color: #1a1408;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 18px;
    flex-wrap: wrap;
    padding: 20px clamp(20px, 4vw, 56px);
  }
  .logobar span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
  }
  .logobar sup {
    font-size: 8px;
  }
  .logobar svg {
    width: 20px;
    height: 20px;
    fill: #1a1408;
  }
  .logobar svg path,
  .logobar svg rect,
  .logobar svg circle {
    stroke: #1a1408;
  }

  /* ---- services ---- */
  .services {
    text-align: center;
    padding: clamp(70px, 9vw, 110px) clamp(20px, 5vw, 64px);
    max-width: 1180px;
    margin: 0 auto;
