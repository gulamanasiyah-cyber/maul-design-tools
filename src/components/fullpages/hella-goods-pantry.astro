  <!-- ==================== COLLECTION FOCUS CAROUSEL ==================== -->
  <section class="section-focus" id="goods">
    <div class="container text-center">
      <h2 class="heading-headline full_shadow">Our Goods</h2>
      <p class="section-subheading">You'll be cooking like Carmy in no time.</p>

      <!-- 4-Product Focus Carousel -->
      <div class="focus-carousel-wrap">
        <div class="focus-carousel-grid">
          <!-- Slide 1: Crispy Chili Oil (Active Focus) -->
          <div class="focus-slide active">
            <div class="product-media-tile">
              <div class="media-push-shadow">
                <img src="/assets/hella-goods-pantry/chili-oil.png" alt="Crispy Chili Oil" class="prod-img img-primary" />
                <img src="/assets/hella-goods-pantry/chili-oil-hover.png" alt="Crispy Chili Oil Back" class="prod-img img-hover" />
              </div>
              <h3 class="prod-tile-title">Crispy Chili Oil</h3>
              <div class="prod-tile-price">$12.00</div>
            </div>
            <p class="slide-caption">A must-have for everything from stir-fries to noodles, and even as a spicy dip.</p>
            <div class="slide-cta">
              <a href="#" class="push-btn push-btn--yellow">
                <span class="push-btn__surface">Add to Cart</span>
              </a>
            </div>
          </div>

          <!-- Slide 2: Wild Yuzu Garlic Rub -->
          <div class="focus-slide">
            <div class="product-media-tile">
              <div class="media-push-shadow">
                <img src="/assets/hella-goods-pantry/garlic-rub.png" alt="Wild Yuzu Garlic Rub" class="prod-img img-primary" />
                <img src="/assets/hella-goods-pantry/garlic-rub-hover.png" alt="Wild Yuzu Garlic Rub Back" class="prod-img img-hover" />
              </div>
              <h3 class="prod-tile-title">Wild Yuzu Garlic Rub</h3>
              <div class="prod-tile-price">$25.00</div>
            </div>
            <p class="slide-caption">This vibrant blend of tangy yuzu and bold garlic is your ticket to zesting up any dish.</p>
            <div class="slide-cta">
              <a href="#" class="push-btn push-btn--yellow">
                <span class="push-btn__surface">Add to Cart</span>
              </a>
            </div>
          </div>

          <!-- Slide 3: Very Good Spice Rub (Sold Out) -->
          <div class="focus-slide">
            <div class="product-media-tile">
              <div class="sold-out-badge">Sold Out</div>
              <div class="media-push-shadow">
                <img src="/assets/hella-goods-pantry/spice-rub.png" alt="Very Good Spice Rub" class="prod-img img-primary" />
                <img src="/assets/hella-goods-pantry/spice-rub-hover.png" alt="Very Good Spice Rub Back" class="prod-img img-hover" />
              </div>
              <h3 class="prod-tile-title">Very Good Spice Rub</h3>
              <div class="prod-tile-price">$25.00</div>
            </div>
            <p class="slide-caption">For those who savor every bite, rich and savory with a hint of smoky spice.</p>
            <div class="slide-cta">
              <button class="push-btn-disabled" disabled>Sold Out</button>
            </div>
          </div>

          <!-- Slide 4: Umami Chili Salt -->
          <div class="focus-slide">
            <div class="product-media-tile">
              <div class="media-push-shadow">
                <img src="/assets/hella-goods-pantry/chili-salt.png" alt="Umami Chili Salt" class="prod-img img-primary" />
                <img src="/assets/hella-goods-pantry/chili-salt-hover.png" alt="Umami Chili Salt Back" class="prod-img img-hover" />
              </div>
              <h3 class="prod-tile-title">Umami Chili Salt</h3>
              <div class="prod-tile-price">$17.00</div>
            </div>
            <p class="slide-caption">This magical mix of savory umami goodness and spicy chili kick is here to make your taste buds do a happy dance.</p>
            <div class="slide-cta">
              <a href="#" class="push-btn push-btn--yellow">
                <span class="push-btn__surface">Add to Cart</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Carousel Nav Controls -->
        <div class="carousel-nav-arrows">
          <button class="push-btn push-btn--arrow" aria-label="Previous">
            <span class="push-btn__surface">←</span>
          </button>
          <button class="push-btn push-btn--arrow" aria-label="Next">
            <span class="push-btn__surface">→</span>
          </button>
        </div>
      </div>
    </div>
  </section>

