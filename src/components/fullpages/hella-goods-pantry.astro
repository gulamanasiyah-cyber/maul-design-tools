---
// Hella Goods Pantry — FULL-PAGE 1:1 recreation of the live "Shapes" theme pantry storefront.
// Palettes: Red Scheme #FF2524, Yellow Scheme #FFCC36, Neon Green Scheme #5AFF24, White #FFFFFF, Black #000000.
// Fonts: Prompt 900 (display headings), Inter 500/700 (body).
// Authentic Shapes theme components: .push-btn with offset shadow, SVG wavy shape dividers,
// floating parallax stickers, real product images with hover-swap, 3-tab collections,
// comparison table, interactive focus carousel, product of the month, video banner,
// recipe grid, highlight cards with EVOO bottle, merch cards, newsletter, and giant footer wordmark.
---

<div class="hella-store">

  <!-- ==================== HEADER (TRANSPARENT OVER RED HERO) ==================== -->
  <header class="site-header">
    <div class="header-inner">
      <div class="header-left">
        <button class="menu-btn" aria-label="Menu">
          <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M43 38H5m38-14H5m38-14H5"/></svg>
        </button>
        <nav class="nav-links">
          <div class="nav-dropdown">
            <button class="nav-link">Shop <span class="chevron">▼</span></button>
          </div>
          <a href="#restaurant" class="nav-link">Restaurant</a>
          <a href="#recipes" class="nav-link">Recipes</a>
          <a href="#about" class="nav-link">About</a>
        </nav>
      </div>

      <div class="header-center">
        <a href="/" class="header-logo-link">
          <img src="/assets/hella-goods-pantry/logo.svg" alt="Hella Goods" class="header-logo-img" />
        </a>
      </div>

      <div class="header-right">
        <button class="icon-btn search-trigger" aria-label="Search">
          <svg viewBox="0 0 48 48" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="21" cy="21" r="14"/><path d="M43 43l-12-12" stroke-linecap="round"/></svg>
        </button>
        <button class="icon-btn cart-trigger" aria-label="Cart">
          <svg viewBox="0 0 48 48" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M38.3 17H9.7C8.8 17 8 17.7 8 18.7v21.6C8 41.3 8.8 42 9.7 42h28.6c.9 0 1.7-.7 1.7-1.7V18.7c0-.9-.8-1.7-1.7-1.7ZM16 13v-2.5a7.5 7.5 0 0 1 15 0V13"/></svg>
          <span class="cart-badge">0</span>
        </button>
        <a href="#goods" class="push-btn push-btn--yellow header-shop-btn">
          <span class="push-btn__surface">Shop</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ==================== HERO SECTION (SCHEME 2 - RED) ==================== -->
  <section class="section-hero">
    <div class="hero-wrap">
      <!-- Giant SVG Wordmark -->
      <div class="hero-logo-banner">
        <img src="/assets/hella-goods-pantry/logo.svg" alt="Hella Goods" class="hero-logo-svg" />
      </div>

      <!-- Hero Overlapping Food Photo -->
      <div class="hero-media-box">
        <div class="hero-photo-wrap">
          <img src="/assets/hella-goods-pantry/hero-header.png" alt="Hella Goods Pantry Table" class="hero-photo-img" />
        </div>
      </div>

      <!-- Floating Parallax Stickers -->
      <div class="sticker-badge sticker-flavour" style="top: 36%; right: 5%; transform: rotate(24deg);">
        <div class="starburst-shape bg-green">
          <span>Full of<br/>Flavour</span>
        </div>
      </div>

      <div class="sticker-badge sticker-hotstuff" style="top: 48%; left: 4%; transform: rotate(-12deg);">
        <div class="semicircle-shape bg-white">
          <span>Hot stuff!</span>
        </div>
      </div>

      <div class="sticker-badge sticker-chili" style="top: 72%; right: 7%; transform: rotate(-38deg);">
        <img src="/assets/hella-goods-pantry/chili-sticker.png" alt="" class="sticker-img" />
      </div>

      <div class="sticker-badge sticker-star" style="top: 86%; left: 6%; transform: rotate(54deg);">
        <img src="/assets/hella-goods-pantry/star-sticker.png" alt="" class="sticker-img" />
      </div>
    </div>

