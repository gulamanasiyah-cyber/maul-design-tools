<style>
  /* ==================== GLOBAL TOKENS & RESET ==================== */
  .hella-store {
    --red: #FF2524;
    --yellow: #FFCC36;
    --green: #5AFF24;
    --white: #FFFFFF;
    --black: #000000;
    --cream: #FFF9F0;
    --gray-card: #FAFAFA;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--black);
    background: var(--white);
    line-height: 1.4;
    overflow-x: hidden;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  a { text-decoration: none; color: inherit; }
  ul { list-style: none; }

  .container { max-width: 1360px; margin: 0 auto; padding: 0 24px; position: relative; }
  .container.narrow { max-width: 920px; }
  .text-center { text-align: center; }

  /* ==================== SHAPES THEME HEADLINE EFFECTS ==================== */
  .heading-headline {
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.5vw, 64px);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .full_shadow {
    color: var(--yellow);
    -webkit-text-stroke: 2.5px var(--black);
    text-shadow:
      0.02em 0.02em 0 var(--green),
      0.04em 0.04em 0 var(--green),
      0.06em 0.06em 0 var(--green),
      0.08em 0.08em 0 var(--green),
      0.10em 0.10em 0 var(--green);
  }

  .section-subheading {
    font-size: 18px;
    font-weight: 500;
    color: #444;
    margin-top: 14px;
  }

  /* ==================== PUSH BUTTON SYSTEM ==================== */
  .push-btn {
    display: inline-block;
    position: relative;
    background: var(--black);
    border-radius: 9999px;
    padding: 3px 0 0 3px;
    cursor: pointer;
    vertical-align: middle;
  }

  .push-btn__surface {
    display: block;
    background: var(--white);
    color: var(--black);
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 10px 24px;
    border-radius: 9999px;
    border: 2px solid var(--black);
    transform: translate(-3px, -3px);
    transition: transform 0.12s ease;
    white-space: nowrap;
  }

  .push-btn:hover .push-btn__surface {
    transform: translate(-1.5px, -1.5px);
  }

  .push-btn:active .push-btn__surface {
    transform: translate(0, 0);
  }

  .push-btn--yellow .push-btn__surface { background: var(--yellow); }
  .push-btn--green .push-btn__surface { background: var(--green); }
  .push-btn--red .push-btn__surface { background: var(--red); color: var(--white); }

  .push-btn--arrow .push-btn__surface {
    padding: 8px 16px;
    font-size: 18px;
  }

  .push-btn-disabled {
    background: #E5E5E5;
    color: #888;
    border: 2px solid var(--black);
    border-radius: 9999px;
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    padding: 10px 24px;
    cursor: not-allowed;
  }

  /* ==================== PUSH MEDIA SHADOW ==================== */
  .media-push-shadow {
    position: relative;
    background: var(--white);
    border: 3px solid var(--black);
    border-radius: 8px;
    box-shadow: 6px 6px 0 var(--black);
    overflow: hidden;
  }

  /* ==================== SHAPE DIVIDERS ==================== */
  .shape-divider {
    position: relative;
    width: 100%;
    line-height: 0;
    z-index: 10;
  }

  .shape-divider svg {
    display: block;
    width: 100%;
    height: 24px;
  }

  .shape-divider.fill-white { color: var(--white); }
  .shape-divider.fill-yellow { color: var(--yellow); }
  .shape-divider.fill-green { color: var(--green); }
  .shape-divider.fill-red { color: var(--red); }

  .divider-top svg { transform: rotate(180deg); }

  /* ==================== HEADER ==================== */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background: transparent;
  }

  .header-inner {
    max-width: 1820px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left { display: flex; align-items: center; gap: 20px; }
  .menu-btn { background: none; border: none; cursor: pointer; color: var(--black); display: none; }
  @media (max-width: 990px) { .menu-btn { display: block; } .nav-links { display: none !important; } }

  .nav-links { display: flex; align-items: center; gap: 16px; }
  .nav-link {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: none;
    border: none;
    cursor: pointer;
  }
  .chevron { font-size: 9px; vertical-align: middle; margin-left: 2px; }

  .header-center { text-align: center; }
  .header-logo-img { height: 28px; display: block; }

  .header-right { display: flex; align-items: center; gap: 16px; }
  .icon-btn { background: none; border: none; cursor: pointer; color: var(--black); position: relative; }
  .cart-badge {
    position: absolute;
    top: -4px;
    right: -6px;
    background: var(--black);
    color: var(--white);
    font-size: 10px;
    font-weight: 700;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ==================== HERO ==================== */
  .section-hero {
    position: relative;
    background: var(--red);
    padding-top: 80px;
    overflow: hidden;
  }

  .hero-wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 24px 60px;
    position: relative;
    text-align: center;
  }

  .hero-logo-banner {
    max-width: 80%;
    margin: 0 auto 20px;
  }

  .hero-logo-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-media-box {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  .hero-photo-wrap {
    border: 3px solid var(--black);
    border-radius: 8px;
    box-shadow: 10px 10px 0 var(--black);
    overflow: hidden;
    background: var(--white);
  }

  .hero-photo-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Parallax Stickers */
  .sticker-badge {
    position: absolute;
    z-index: 20;
    pointer-events: none;
  }

  .starburst-shape {
    width: 110px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 12px;
    line-height: 1.1;
    text-transform: uppercase;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    border: 2px solid var(--black);
  }

  .semicircle-shape {
    width: 100px;
    height: 60px;
    background: var(--white);
    border: 2px solid var(--black);
    border-radius: 100px 100px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 13px;
  }

  .scallop-shape {
    padding: 14px 20px;
    border: 2px solid var(--black);
    border-radius: 20px;
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 13px;
    text-align: center;
    line-height: 1.1;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--black);
  }

  .bg-green { background: var(--green); color: var(--black); }
  .bg-yellow { background: var(--yellow); color: var(--black); }
  .bg-white { background: var(--white); color: var(--black); }

  .sticker-img { width: 90px; height: auto; display: block; filter: drop-shadow(4px 4px 0 var(--black)); }

  /* ==================== STATEMENT SECTION ==================== */
  .section-statement {
    padding: 70px 0 50px;
    background: var(--white);
    text-align: center;
  }

  .statement-text {
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: clamp(30px, 4vw, 56px);
    line-height: 1.05;
    text-transform: uppercase;
    max-width: 900px;
    margin: 0 auto 28px;
  }

  /* ==================== ICON ROW ==================== */
  .section-icon-row {
    padding: 20px 0 60px;
    background: var(--white);
  }

  .icon-list {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    text-align: center;
  }

  @media (max-width: 768px) { .icon-list { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  .icon-card { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .icon-circle {
    width: 80px;
    height: 80px;
    border: 2.5px solid var(--black);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    transition: transform 0.2s ease;
  }
  .icon-card:hover .icon-circle { transform: scale(1.08); }
  .icon-name { font-weight: 700; font-size: 13px; text-transform: uppercase; }

  /* ==================== FOCUS CAROUSEL ==================== */
  .section-focus {
    padding: 60px 0;
    background: var(--white);
  }

  .focus-carousel-wrap {
    margin-top: 48px;
    position: relative;
  }

  .focus-carousel-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 990px) { .focus-carousel-grid { grid-template-columns: repeat(2, 1fr); } }

  .focus-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .product-media-tile {
    width: 100%;
    position: relative;
    margin-bottom: 16px;
  }

  .prod-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .img-hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .media-push-shadow:hover .img-hover { opacity: 1; }

  .prod-tile-title {
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    margin: 12px 0 4px;
  }

  .prod-tile-price {
    font-size: 16px;
    font-weight: 700;
  }

  .slide-caption {
    font-size: 14px;
    color: #555;
    line-height: 1.4;
    margin-bottom: 16px;
    min-height: 40px;
  }

  .carousel-nav-arrows {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 32px;
  }

  .sold-out-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--black);
    color: var(--white);
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 11px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 9999px;
    z-index: 10;
  }

  .sale-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--green);
    color: var(--black);
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 11px;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 1.5px solid var(--black);
    border-radius: 9999px;
    z-index: 10;
  }

  /* ==================== TESTIMONIALS ==================== */
  .section-testimonials {
    background: var(--green);
    position: relative;
  }

  .py-section { padding: 60px 0; }
  .testi-card-wrap { max-width: 800px; margin: 40px auto 24px; }
  .testi-stars { font-size: 24px; letter-spacing: 4px; margin-bottom: 16px; }
  .testi-text {
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: clamp(22px, 3vw, 36px);
    line-height: 1.2;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .testi-author {
    font-family: 'Prompt', sans-serif;
    font-weight: 900;
    font-size: 16px;
    text-transform: uppercase;
  }
  .testi-arrows { display: flex; justify-content: center; gap: 12px; margin-top: 16px; }

  /* ==================== TABBED COLLECTIONS ==================== */
  .section-collections {
    padding: 60px 0;
    background: var(--white);
  }

  .collection-tabs {
    display: flex;
    justify-content: center;
