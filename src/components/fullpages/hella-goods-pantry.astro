    </div>
  </section>

  <!-- ==================== FEATURE STATEMENT ==================== -->
  <section class="section-statement">
    <div class="container narrow">
      <h2 class="statement-text">Everyday pantry goods for the everyday chef.</h2>
      <div class="statement-cta">
        <a href="#goods" class="push-btn">
          <span class="push-btn__surface">Shop Now</span>
        </a>
      </div>
    </div>
  </section>

