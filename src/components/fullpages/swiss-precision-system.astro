---
// Swiss Precision System — Full-page recreation of the Swiss International Typographic Style landing page.
// Features: 100% full-width edge-to-edge responsive layout, rigid hairline grid borders,
// high-contrast black & white typography with electric Swiss red-orange (#FF3E00),
// grayscale architectural hero split, uppercase marquee band, metric trust columns, chaos vs structured solution,
// 6-cell capability matrix, case studies, 3-step workflow, high-impact red-orange Pro pricing card, Q&A, and dark brutalist CTA.
---

<div class="swiss-page">
  <!-- ==================== HEADER ==================== -->
  <header class="header">
    <div class="header-inner">
      <a href="#" class="brand">
        <span class="brand-square"></span>
        <span class="brand-name">SWISS APP</span>
      </a>

      <nav class="nav-links">
        <a href="#work" class="nav-item">WORK</a>
        <a href="#studio" class="nav-item">STUDIO</a>
        <a href="#news" class="nav-item">NEWS</a>
        <a href="#contact" class="nav-item">CONTACT</a>
        <span class="nav-divider">|</span>
        <span class="lang-switch">DE / EN</span>
      </nav>

      <a href="#contact" class="btn-start">START PROJECT</a>
    </div>
  </header>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section" id="work">
    <div class="hero-grid">
      <!-- Left Copy -->
      <div class="hero-copy-col">
        <h1 class="hero-headline">
          <span>PRECISION</span>
          <span>DESIGN</span>
          <span class="text-orange">SYSTEM</span>
        </h1>
        <p class="hero-subtext">
          Rigorous execution of design principles adapted for a modern web interface. Function over form. Minimalist aesthetic.
        </p>
        <div class="hero-actions">
          <a href="#explore" class="btn-black">EXPLORE SYSTEM</a>
          <a href="#docs" class="btn-outline">VIEW DOCUMENTATION</a>
        </div>
      </div>

      <!-- Right Architecture Photo -->
      <div class="hero-img-col">
        <img src="/assets/swiss/arch.jpg" alt="Modern brutalist architecture grid facade" class="grayscale-img" />
      </div>
    </div>
  </section>

  <!-- ==================== RUNNING BAND ==================== -->
  <div class="marquee-band">
    <div class="marquee-track">
      <span>EFFICIENCY + CLARITY + STRUCTURE + GRID SYSTEMS + TYPOGRAPHY + FUNCTION + EFFICIENCY + CLARITY + STRUCTURE + GRID SYSTEMS + FUNCTION +</span>
    </div>
  </div>

  <!-- ==================== METRICS & TRUST BAR ==================== -->
  <section class="metrics-section">
    <div class="metrics-grid">
      <!-- Col 1: Logos -->
      <div class="metric-col logos-col">
        <span class="metric-label">TRUSTED BY LEADERS</span>
        <div class="logo-skeletons">
          <div class="sk-bar"></div>
          <div class="sk-bar"></div>
          <div class="sk-bar"></div>
          <div class="sk-bar"></div>
        </div>
      </div>

      <!-- Col 2: Uptime -->
      <div class="metric-col">
        <span class="metric-label">SYSTEM UPTIME</span>
        <span class="metric-value">99.9%</span>
      </div>

      <!-- Col 3: Users -->
      <div class="metric-col">
        <span class="metric-label">ACTIVE USERS</span>
        <span class="metric-value">120K</span>
      </div>

      <!-- Col 4: Reach -->
      <div class="metric-col">
        <span class="metric-label">GLOBAL REACH</span>
        <span class="metric-value">45+</span>
      </div>
    </div>
  </section>

  <!-- ==================== PROBLEM VS SOLUTION ==================== -->
  <section class="split-problem-section" id="studio">
    <div class="split-grid">
      <!-- Chaos Block -->
      <div class="problem-box">
        <div class="warning-icon">▲</div>
        <h2 class="problem-title">THE CHALLENGE OF CHAOS</h2>
        <p class="problem-desc">
          Modern interfaces often suffer from visual noise, lack of hierarchy, and inconsistent patterns. This leads to user confusion and reduced conversion rates.
        </p>
      </div>

      <!-- Structured Solution Block -->
      <div class="solution-box">
        <h2 class="solution-title">THE STRUCTURED SOLUTION</h2>
        <p class="solution-desc">
          Our methodology applies strict typographic rules and grid systems to bring order to chaos. We eliminate the unnecessary to focus solely on the essential.
        </p>
        <ul class="solution-points">
          <li><span class="check-icon">✓</span> REDUCED COGNITIVE LOAD</li>
          <li><span class="check-icon">✓</span> VISUAL HIERARCHY</li>
          <li><span class="check-icon">✓</span> CONSISTENT COMPONENTS</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================== 6-GRID CAPABILITIES ==================== -->
  <section class="capabilities-section" id="explore">
    <div class="cap-grid">
      <!-- 1. Modular Grid -->
      <div class="cap-cell">
        <div class="cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />
          </svg>
        </div>
        <h3 class="cap-title">MODULAR GRID</h3>
        <p class="cap-desc">Flexible layouts that adapt to any screen size while maintaining strict alignment.</p>
      </div>

      <!-- 2. Typography First -->
      <div class="cap-cell">
        <div class="cap-icon">
          <span class="tt-icon">Tt</span>
        </div>
        <h3 class="cap-title">TYPOGRAPHY FIRST</h3>
        <p class="cap-desc">Content is king. We prioritize readability and hierarchy using systemic font scales.</p>
      </div>

      <!-- 3. Color Theory -->
      <div class="cap-cell">
        <div class="cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 0 1 9 9 9 9 0 0 1-9 9" fill="currentColor" />
          </svg>
        </div>
        <h3 class="cap-title">COLOR THEORY</h3>
        <p class="cap-desc">Purposeful color application for actions and alerts, keeping the UI clean.</p>
      </div>

      <!-- 4. Performance -->
      <div class="cap-cell">
        <div class="cap-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </div>
        <h3 class="cap-title">PERFORMANCE</h3>
        <p class="cap-desc">Optimized assets and code ensure lightning fast load times across devices.</p>
      </div>

      <!-- 5. Security -->
      <div class="cap-cell">
        <div class="cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h3 class="cap-title">SECURITY</h3>
        <p class="cap-desc">Enterprise-grade security built into every component from the ground up.</p>
      </div>

      <!-- 6. Open API -->
      <div class="cap-cell">
        <div class="cap-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3" />
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
          </svg>
        </div>
        <h3 class="cap-title">OPEN API</h3>
        <p class="cap-desc">Seamless integration with your existing tools through our documented API.</p>
      </div>
    </div>
  </section>

  <!-- ==================== CASE STUDIES ==================== -->
  <section class="case-studies-section" id="news">
    <!-- Case 001: Financial Dashboard -->
    <div class="case-row">
      <div class="case-img-col">
        <img src="/assets/swiss/laptop.jpg" alt="Laptop displaying financial candlestick chart" class="grayscale-img" />
      </div>
      <div class="case-info-col">
        <span class="case-tag">CASE 001</span>
        <h3 class="case-title">FINANCIAL DASHBOARD</h3>
        <p class="case-desc">
          A complex data visualization challenge solved through strict grid alignment and color coding. We reduced the time to insight by 40% for financial analysts.
        </p>
        <a href="#" class="case-link">READ CASE STUDY →</a>
      </div>
    </div>

    <!-- Case 002: Architecture Firm -->
    <div class="case-row">
      <div class="case-img-col">
        <img src="/assets/swiss/desk.jpg" alt="Minimalist concrete desk with notebook and pen" class="grayscale-img" />
      </div>
      <div class="case-info-col">
        <span class="case-tag">CASE 002</span>
        <h3 class="case-title">ARCHITECTURE FIRM</h3>
        <p class="case-desc">
          Showcasing portfolio work requires the interface to step back. We designed an invisible UI that lets the photography speak for itself.
        </p>
        <a href="#" class="case-link">READ CASE STUDY →</a>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS WORKFLOW ==================== -->
  <section class="workflow-section">
    <div class="workflow-inner">
      <div class="section-header-center">
        <h2 class="section-title">PROCESS WORKFLOW</h2>
      </div>

      <div class="workflow-grid">
        <!-- Step 1 -->
        <div class="workflow-card">
          <div class="step-num-badge red-badge">1</div>
          <div class="step-wireframe-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="1.8" class="step-icon">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h4 class="step-title">DISCOVERY</h4>
          <p class="step-desc">
            We begin by analyzing the core constraints and objectives of the project to establish the grid.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="workflow-card">
          <div class="step-num-badge black-badge">2</div>
          <div class="step-wireframe-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="1.8" class="step-icon">
              <path d="M12 2L2 22h20L12 2z" />
              <circle cx="12" cy="14" r="2" />
            </svg>
          </div>
          <h4 class="step-title">STRUCTURE</h4>
          <p class="step-desc">
            Developing the typographic system and layout rules that will govern the entire interface.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="workflow-card">
          <div class="step-num-badge black-badge">3</div>
          <div class="step-wireframe-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="1.8" class="step-icon">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
          </div>
          <h4 class="step-title">EXECUTION</h4>
          <p class="step-desc">
            Rigorous implementation of the design system with pixel-perfect attention to detail.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PRICING ==================== -->
  <section class="pricing-section">
    <div class="pricing-grid">
      <!-- Basic -->
      <div class="price-card">
        <span class="plan-name">BASIC</span>
        <div class="price-val-wrap">
          <span class="price-val">$29</span>
          <span class="price-cycle">/mo</span>
        </div>
        <p class="plan-desc">Essential tools for small projects and individual designers.</p>
        <ul class="plan-features">
          <li><span class="tick">✓</span> 5 Projects</li>
          <li><span class="tick">✓</span> Basic Analytics</li>
          <li><span class="tick">✓</span> 24/7 Support</li>
        </ul>
        <button class="btn-plan-outline">SELECT PLAN</button>
      </div>

      <!-- Pro (Solid Red-Orange) -->
      <div class="price-card pro-card">
        <div class="pro-badge">RECOMMENDED</div>
        <span class="plan-name text-white">PRO</span>
        <div class="price-val-wrap text-white">
          <span class="price-val">$79</span>
          <span class="price-cycle">/mo</span>
        </div>
        <p class="plan-desc text-white-90">Advanced features for growing teams and agencies.</p>
        <ul class="plan-features text-white">
          <li><span class="tick text-white">✓</span> Unlimited Projects</li>
          <li><span class="tick text-white">✓</span> Advanced Analytics</li>
          <li><span class="tick text-white">✓</span> Priority Support</li>
          <li><span class="tick text-white">✓</span> Custom Domains</li>
        </ul>
        <button class="btn-plan-black">SELECT PLAN</button>
      </div>

      <!-- Enterprise -->
      <div class="price-card">
        <span class="plan-name">ENTERPRISE</span>
        <div class="price-val-wrap">
          <span class="price-val custom-text">Custom</span>
        </div>
        <p class="plan-desc">Full-scale solutions for large organizations.</p>
        <ul class="plan-features">
          <li><span class="tick">✓</span> Dedicated Server</li>
          <li><span class="tick">✓</span> SLA Agreement</li>
          <li><span class="tick">✓</span> Account Manager</li>
          <li><span class="tick">✓</span> SSO Integration</li>
        </ul>
        <button class="btn-plan-outline">CONTACT SALES</button>
      </div>
    </div>
  </section>

  <!-- ==================== Q&A ==================== -->
  <section class="qa-section">
    <div class="qa-grid">
      <div class="qa-left">
        <h3 class="qa-heading">Q & A</h3>
        <p class="qa-sub">Common questions about our methodology and platform.</p>
      </div>
      <div class="qa-right">
        <div class="qa-row">
          <span class="qa-q">HOW STRICT IS THE GRID SYSTEM?</span>
          <span class="qa-toggle">⌄</span>
        </div>
        <div class="qa-row">
          <span class="qa-q">CAN I CUSTOMIZE THE PRIMARY COLOR?</span>
          <span class="qa-toggle">⌄</span>
        </div>
        <div class="qa-row">
          <span class="qa-q">IS THIS ACCESSIBLE?</span>
          <span class="qa-toggle">⌄</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA BANNER ==================== -->
  <section class="cta-section" id="contact">
    <div class="cta-inner">
      <h2 class="cta-title">READY TO BUILD?</h2>
      <p class="cta-sub">Start your next project with a solid foundation. Precision, clarity, and speed await.</p>
      <a href="#" class="btn-cta-orange">GET STARTED NOW</a>
    </div>
  </section>
</div>

<style>
  /* ==================== FULL WIDTH BASE ==================== */
  .swiss-page {
    font-family: 'Plus Jakarta Sans', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    color: #111111;
    background: #FFFFFF;
    line-height: 1.45;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  * {
    box-sizing: border-box;
  }

  .text-orange {
    color: #FF3E00;
  }

  .grayscale-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.08);
  }

  /* ==================== HEADER ==================== */
  .header {
    width: 100%;
    border-bottom: 1px solid #111111;
    background: #FFFFFF;
  }

  .header-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 36px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #111111;
  }

  .brand-square {
    width: 14px;
    height: 14px;
    background: #FF3E00;
  }

  .brand-name {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-item {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #111111;
    text-decoration: none;
  }

  .nav-divider {
    color: #D4D4D4;
    font-size: 11px;
  }

  .lang-switch {
    font-size: 11px;
    font-weight: 700;
    color: #737373;
    letter-spacing: 0.06em;
  }

  .btn-start {
    background: #FF3E00;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 8px 18px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .btn-start:hover {
    background: #E03700;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    width: 100%;
    border-bottom: 1px solid #111111;
    background: #FFFFFF;
  }

  .hero-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .hero-copy-col {
    padding: 72px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid #111111;
  }

  .hero-headline {
    font-size: clamp(48px, 6vw, 84px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
    color: #111111;
  }

  .hero-headline span {
    display: block;
  }

  .hero-subtext {
    font-size: 15px;
    line-height: 1.6;
    color: #404040;
    max-width: 480px;
    margin: 0 0 36px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
  }

  .btn-black {
    background: #111111;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 13px 22px;
    text-decoration: none;
  }

  .btn-outline {
    background: transparent;
    color: #111111;
    border: 1px solid #111111;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 13px 22px;
    text-decoration: none;
  }

  .hero-img-col {
    position: relative;
    min-height: 480px;
    background: #F5F5F5;
  }

  /* ==================== MARQUEE BAND ==================== */
  .marquee-band {
    width: 100%;
    background: #111111;
    color: #FFFFFF;
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 1px solid #111111;
  }

  .marquee-track {
    display: flex;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  /* ==================== METRICS ==================== */
  .metrics-section {
    width: 100%;
    border-bottom: 1px solid #E5E5E5;
    background: #FFFFFF;
  }

  .metrics-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
  }

  .metric-col {
    padding: 36px 36px;
    border-right: 1px solid #E5E5E5;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .metric-col:last-child {
    border-right: none;
  }

  .metric-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #737373;
    margin-bottom: 8px;
  }

  .metric-value {
    font-size: 44px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #111111;
  }

  .logo-skeletons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 4px;
  }

  .sk-bar {
    height: 14px;
    background: #D4D4D4;
    border-radius: 2px;
  }

  /* ==================== PROBLEM VS SOLUTION ==================== */
  .split-problem-section {
    width: 100%;
    border-bottom: 1px solid #E5E5E5;
  }

  .split-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.35fr;
  }

  .problem-box {
    background: #111111;
    color: #FFFFFF;
    padding: 64px 56px;
    border-right: 1px solid #111111;
  }

  .warning-icon {
    color: #FF3E00;
    font-size: 16px;
    margin-bottom: 16px;
  }

  .problem-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.04em;
    margin: 0 0 16px;
  }

  .problem-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #A3A3A3;
    margin: 0;
  }

  .solution-box {
    background: #FFFFFF;
    padding: 64px 56px;
  }

  .solution-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #FF3E00;
    margin: 0 0 16px;
  }

  .solution-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #404040;
    margin: 0 0 24px;
  }

  .solution-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .solution-points li {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #111111;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .check-icon {
    color: #FF3E00;
  }

  /* ==================== CAPABILITIES 6-GRID ==================== */
  .capabilities-section {
    width: 100%;
    border-bottom: 1px solid #E5E5E5;
    background: #FFFFFF;
  }

  .cap-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .cap-cell {
    padding: 48px 40px;
    border-right: 1px solid #E5E5E5;
    border-bottom: 1px solid #E5E5E5;
  }

  .cap-cell:nth-child(3n) {
    border-right: none;
  }

  .cap-cell:nth-child(n+4) {
    border-bottom: none;
  }

  .cap-icon {
    width: 28px;
    height: 28px;
    color: #111111;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
  }

  .cap-icon svg {
    width: 22px;
    height: 22px;
  }

  .tt-icon {
    font-size: 16px;
    font-weight: 900;
    border: 1.5px solid #111111;
    padding: 2px 4px;
    line-height: 1;
  }

  .cap-title {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #111111;
    margin: 0 0 10px;
  }

  .cap-desc {
    font-size: 13px;
    line-height: 1.55;
    color: #737373;
    margin: 0;
  }

  /* ==================== CASE STUDIES ==================== */
  .case-studies-section {
    width: 100%;
    border-bottom: 1px solid #E5E5E5;
  }

  .case-row {
    width: 100%;
