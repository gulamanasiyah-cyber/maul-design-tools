---
// Prostranstvo Commercial — dusty-blue framed white sheet, large rounded hero
// with modern building silhouette, About + stats + logostrip, 3 catalog cards,
// and How-we-work block with badge. Pure CSS/SVG, cqw, 16/10. — English edition
---

<div class="scene" aria-hidden="true">
  <div class="sheet">
    <!-- nav -->
    <div class="nav">
      <span class="brand"><i class="sq"></i><b>Prostranstvo</b><em>commercial real estate</em></span>
      <span class="links"><i>About</i><i>Listings</i><i>Process</i><i>Reviews</i><i>Contacts</i></span>
    </div>

    <!-- hero -->
    <div class="hero">
      <svg class="hero-img" viewBox="0 0 520 220" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="g" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8FAECF" stop-opacity="0.95"/>
            <stop offset="55%" stop-color="#A8C0D8" stop-opacity="0.55"/>
            <stop offset="100%" stop-color="#C8D6E8" stop-opacity="0.15"/>
          </linearGradient>
        </defs>
        <rect width="520" height="220" rx="14" fill="#DDE6F0"/>
        <path d="M298 18 L362 52 L362 220 L298 186 Z" fill="#1E2A3A"/>
        <path d="M362 52 L422 24 L422 220 L362 220 Z" fill="#2E3D52"/>
        <path d="M318 62 L342 76 L342 134 L318 120 Z" fill="#3A4E68" opacity="0.95"/>
        <path d="M342 78 L358 70 L358 118 L342 130 Z" fill="#6A7D96" opacity="0.9"/>
        <path d="M370 42 L396 30 L396 220 L370 220 Z" fill="#1A2536" opacity="0.55"/>
        <g fill="rgba(255,255,255,0.86)">
          <rect x="376" y="52" width="10" height="14" rx="1"/><rect x="390" y="46" width="10" height="14" rx="1"/>
          <rect x="376" y="72" width="10" height="14" rx="1"/><rect x="390" y="66" width="10" height="14" rx="1"/>
          <rect x="376" y="92" width="10" height="14" rx="1"/><rect x="390" y="86" width="10" height="14" rx="1"/>
        </g>
        <rect width="520" height="220" rx="14" fill="url(#g)"/>
      </svg>
      <div class="hero-copy">
        <h1>Real estate<br/>for business</h1>
        <p>Leasing, sales & sourcing —<br/>from offices to warehouses</p>
        <span class="pill">Start a partnership</span>
      </div>
    </div>

    <!-- about + stats -->
    <div class="about">
      <div class="about-left">
        <b class="h2">About us</b>
        <p>We are commercial real-estate experts helping businesses find the right space</p>
        <div class="logos"><span>◉ Logoipsum</span><span>⬢ Logoipsum</span><span>✦ Logoipsum</span><span>⬣ Logoipsum</span><span>⬔ Logoipsum</span></div>
      </div>
      <div class="stats">
        <div class="st"><b>10+</b><em>years on the market</em></div>
        <div class="st"><b>1,000+</b><em>happy clients</em></div>
        <div class="st"><b>4,000+</b><em>listings</em></div>
        <div class="st"><b>95%</b><em>deals closed</em></div>
      </div>
    </div>

    <!-- catalog -->
    <div class="catalog">
      <div class="cat-head">
        <b>Property<br/>catalog</b>
        <em>A wide range of spaces<br/>for your business</em>
      </div>
      <div class="cards">
        <div class="card"><span class="ph ph1"></span><b>Office spaces</b><em>4,000+ listings</em></div>
        <div class="card"><span class="ph ph2"></span><b>Warehouses</b><em>1,000+ listings</em></div>
        <div class="card"><span class="ph ph3"></span><b>Land plots</b><em>2,000+ listings</em></div>
      </div>
    </div>

    <!-- how we work -->
    <div class="how">
      <div class="how-left">
        <b class="h2">How we work</b>
        <em class="sub">We made working with us<br/>simple and transparent</em>
        <div class="work-img">
          <svg viewBox="0 0 200 190" xmlns="http://www.w3.org/2000/svg">
            <rect width="200" height="190" rx="10" fill="#DDE6F0"/>
            <path d="M46 190 L46 52 L98 18 L148 52 L148 190 Z" fill="#E8EEF5" stroke="#C9D7E8" stroke-width="2"/>
            <path d="M68 70 L88 70 L88 120 L68 120 Z" fill="#9AB6D1"/><path d="M96 70 L116 70 L116 120 L96 120 Z" fill="#B9CEE6"/>
            <rect x="74" y="136" width="52" height="54" rx="2" fill="#1E2A3A"/><rect x="132" y="96" width="22" height="28" rx="1" fill="#1E2A3A"/>
            <circle cx="28" cy="38" r="2" fill="#9AB6D1" opacity="0.6"/><circle cx="40" cy="28" r="1.5" fill="#9AB6D1" opacity="0.5"/>
          </svg>
          <span class="badge">Free<br/>consultation</span>
        </div>
      </div>
      <div class="steps">
        <div class="step"><span class="ic">◎</span><span><b>Consultation & needs analysis</b><em>We define what kind of property you really need</em></span></div>
        <div class="step"><span class="ic">⌕</span><span><b>Sourcing & shortlisting</b><em>Only verified options that fit your budget and goals</em></span></div>
        <div class="step"><span class="ic">◐</span><span><b>Viewings & valuation</b><em>We arrange viewings and share full property data</em></span></div>
        <div class="step"><span class="ic">⬔</span><span><b>Due diligence & paperwork</b><em>Full legal check of documents and ownership</em></span></div>
        <div class="step"><span class="ic">◆</span><span><b>Deal closing & support</b><em>Guidance through signing and every next step</em></span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .scene{
    position:relative;
    width:100%;
    aspect-ratio:16/10;
    min-height:280px;
    background:#FFFFFF;
    overflow:hidden;
    border-radius:inherit;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:0;
    container-type:inline-size;
  }
  .sheet{
    width:100%;
    background:#FFFFFF;
    border-radius:0;
    overflow:hidden;
    box-shadow:none;
    display:flex;
    flex-direction:column;
  }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:1cqw 1.6cqw 0.8cqw;
  }
  .brand{display:inline-flex;align-items:center;gap:0.6cqw;}
  .brand .sq{width:1.6cqw;height:1.4cqw;border-radius:0.2cqw;background:linear-gradient(135deg,#1E2A3A 0 45%,#8AAECC 45% 60%,#C9D7E8 60% 100%);display:block;}
  .brand b{font-family:'Inter',system-ui,sans-serif;font-size:0.95cqw;letter-spacing:0.01em;color:#0E141E;line-height:1;}
  .brand em{font-style:normal;font-size:0.48cqw;color:#8A95A5;margin-left:0.3cqw;letter-spacing:0.04em;}
  .links{display:flex;gap:1cqw;}
  .links i{font-style:normal;font-size:0.58cqw;color:#6B7480;font-weight:500;letter-spacing:0.02em;}
  .hero{
    position:relative;
    margin:0 1.1cqw;
    height:15.2cqw;
    border-radius:0.9cqw;
    overflow:hidden;
    background:#DDE6F0;
  }
  .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .hero-copy{
    position:relative;z-index:2;
    padding:2.2cqw 2cqw;
    max-width:44%;
  }
  .hero-copy h1{
    margin:0;
    font-family:'Inter',system-ui,sans-serif;
    font-size:1.9cqw;
    line-height:0.98;
    letter-spacing:-0.02em;
    color:#FFFFFF;
    text-shadow:0 0.2cqw 1cqw rgba(0,0,0,0.22);
  }
  .hero-copy p{margin:0.6cqw 0 0.9cqw;font-size:0.56cqw;line-height:1.45;color:rgba(255,255,255,0.9);}
  .pill{
    display:inline-flex;align-items:center;
    background:#FFFFFF;color:#0E141E;
    font-size:0.56cqw;font-weight:700;
    padding:0.55cqw 0.9cqw;border-radius:999px;
    box-shadow:0 0.3cqw 0.8cqw rgba(0,0,0,0.14);
  }
  .about{
    display:grid;grid-template-columns:1.15fr 0.9fr;
    gap:1.2cqw;
    padding:1.4cqw 1.6cqw 0;
  }
  .h2{font-family:'Inter',system-ui,sans-serif;font-size:1.15cqw;line-height:1;color:#0E141E;display:block;}
  .about-left p{margin:0.5cqw 0 0.7cqw;font-size:0.52cqw;line-height:1.6;color:#6B7480;max-width:28cqw;}
  .logos{display:flex;gap:0.8cqw;border-top:1px solid rgba(14,20,30,0.06);padding-top:0.6cqw;margin-top:0.2cqw;}
  .logos span{font-size:0.5cqw;color:#8A95A5;font-weight:700;display:inline-flex;align-items:center;gap:0.25cqw;}
  .stats{
    display:grid;grid-template-columns:1fr 1fr;
    gap:0.4cqw 1cqw;
    align-content:start;
  }
  .st b{display:block;font-family:'Inter',system-ui,sans-serif;font-size:1.4cqw;line-height:1;color:#0E141E;}
  .st em{font-style:normal;font-size:0.45cqw;color:#8A95A5;line-height:1.3;display:block;margin-top:0.15cqw;}
  .catalog{
    display:grid;grid-template-columns:12cqw 1fr;
    gap:1cqw;
    padding:1.2cqw 1.6cqw 0;
    align-items:start;
  }
  .cat-head b{font-family:'Inter',system-ui,sans-serif;font-size:1.15cqw;line-height:1;color:#0E141E;}
  .cat-head em{font-style:normal;font-size:0.5cqw;color:#8A95A5;line-height:1.5;display:block;margin-top:0.4cqw;}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:0.7cqw;}
  .card{display:flex;flex-direction:column;gap:0.4cqw;}
  .ph{height:6.2cqw;border-radius:0.6cqw;display:block;position:relative;overflow:hidden;}
  .ph1{background:linear-gradient(180deg,#E8EEF5,#C9D7E8);box-shadow:inset 0 0 0 1px rgba(0,0,0,0.04);}
  .ph1::after{content:"";position:absolute;right:1cqw;top:0.6cqw;bottom:0.6cqw;width:2.2cqw;background:repeating-linear-gradient(180deg,rgba(30,42,58,0) 0 0.5cqw,rgba(30,42,58,0.85) 0.5cqw 0.65cqw);opacity:0.9;transform:skewY(-18deg);}
  .ph2{background:linear-gradient(135deg,#DDE6F0,#B9CEE6);}
  .ph2::after{content:"";position:absolute;left:30%;right:18%;top:28%;height:34%;background:#2E3D52;border-radius:0.15cqw;box-shadow:6cqw 0 0 -1.2cqw #2E3D52;}
  .ph3{background:linear-gradient(135deg,#E6EAD8,#C9D1B4);}
  .card b{font-size:0.52cqw;color:#0E141E;}
  .card em{font-style:normal;font-size:0.44cqw;color:#8A95A5;}
  .how{
    display:grid;grid-template-columns:1.05fr 1.35fr;
    gap:1cqw;
    padding:1.2cqw 1.6cqw 1.2cqw;
  }
  .how-left .sub{font-style:normal;font-size:0.48cqw;color:#8A95A5;line-height:1.5;display:block;margin:0.35cqw 0 0.7cqw;}
  .work-img{position:relative;width:15cqw;height:11cqw;border-radius:0.7cqw;overflow:hidden;background:#EEF2F7;}
  .work-img svg{width:100%;height:100%;display:block;}
  .badge{
    position:absolute;top:-0.45cqw;right:-0.45cqw;
    width:4.6cqw;height:4.6cqw;border-radius:50%;
    background:#8AAECC;color:#fff;
    display:grid;place-items:center;
    font-size:0.46cqw;font-weight:700;line-height:1.15;text-align:center;
    box-shadow:0 0.3cqw 0.8cqw rgba(0,0,0,0.12);
  }
  .steps{display:flex;flex-direction:column;gap:0.18cqw;}
  .step{
    display:grid;grid-template-columns:1.9cqw 1fr;
    gap:0.6cqw;
    padding:0.52cqw 0;
    border-bottom:1px solid rgba(14,20,30,0.06);
    align-items:start;
  }
  .step:last-child{border-bottom:none;}
  .ic{
    width:1.7cqw;height:1.7cqw;border-radius:50%;
    background:#0E141E;color:#fff;
    display:grid;place-items:center;
    font-size:0.68cqw;line-height:1;
  }
  .step b{font-size:0.54cqw;color:#0E141E;display:block;line-height:1.2;}
  .step em{font-style:normal;font-size:0.46cqw;color:#8A95A5;line-height:1.45;display:block;margin-top:0.15cqw;}
</style>
