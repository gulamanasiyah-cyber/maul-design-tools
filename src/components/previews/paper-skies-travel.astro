---
// Paper Skies Travel — sky-gradient hero with 3D paper plane, dashed trail,
// low-poly mountains + landmark silhouettes, floating search widget, feature
// chips, package cards hint. Pure CSS/SVG, cqw units, 16/10 scene.
---

<div class="scene" aria-hidden="true">
  <header class="nav">
    <span class="brand">
      <svg class="mini-plane" viewBox="0 0 40 28"><polygon points="2,14 38,2 24,16" fill="#fff"/><polygon points="2,14 24,16 18,26" fill="#cfe4f7"/><polygon points="24,16 38,2 28,19" fill="#a9cdec"/></svg>
      <span class="bt">TRAVEL<em>AROUND THE WORLD</em></span>
    </span>
    <span class="links"><b class="on">Home</b><b>Packages</b><b>Destinations</b><b>Bookings</b><b>About Us</b><b>Contact</b></span>
    <span class="signin">Sign In <i>☺</i></span>
  </header>

  <div class="hero">
    <div class="art">
      <svg class="trail" viewBox="0 0 220 120" fill="none"><path d="M210 30 C160 90 120 20 96 52 C80 74 108 88 122 74" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="1 9" opacity="0.9"/></svg>
      <svg class="plane" viewBox="0 0 200 140">
        <polygon points="8,74 192,8 122,92" fill="#ffffff"/>
        <polygon points="8,74 122,92 96,134" fill="#d8e9f8"/>
        <polygon points="122,92 192,8 146,98" fill="#b9d7f0"/>
      </svg>
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <svg class="peaks" viewBox="0 0 400 90" preserveAspectRatio="none">
        <polygon points="0,90 40,38 90,90" fill="#eef6fd"/>
        <polygon points="55,90 120,20 185,90" fill="#ffffff"/>
        <polygon points="150,90 210,44 270,90" fill="#e2effb"/>
        <polygon points="235,90 305,14 380,90" fill="#f8fbff"/>
        <polygon points="330,90 372,50 400,90" fill="#dcecf9"/>
      </svg>
      <svg class="marks" viewBox="0 0 200 120">
        <g fill="#ffffff" opacity="0.96">
          <path d="M28 118 L38 44 L44 44 L46 24 L50 44 L56 44 L66 118 L52 118 L50 96 L44 96 L42 118 Z"/>
          <rect x="96" y="34" width="20" height="84" rx="2"/>
          <rect x="99" y="40" width="14" height="12" rx="2" fill="#bcd9f2"/>
          <path d="M150 118 C150 70 162 52 176 44 C172 70 172 96 176 118 Z"/>
        </g>
      </svg>
    </div>
    <div class="copy">
      <h1>TRAVEL<span>AROUND THE WORLD</span></h1>
      <p class="script">Explore. Dream. Discover.</p>
      <p class="sub">Exclusive travel packages to the world's most breathtaking destinations.</p>
      <span class="cta">Explore Packages ✈</span>
    </div>
  </div>

  <div class="search">
    <div class="tabs">
      <span class="tab on">✈ Flights</span><span class="tab">▤ Hotels</span><span class="tab">◔ Cars</span><span class="tab">✦ Experiences</span>
    </div>
    <div class="fields">
      <span class="fld"><em>From</em><b>New York, USA</b></span>
      <span class="swap">⇄</span>
      <span class="fld"><em>To</em><b>Paris, France</b></span>
      <span class="fld"><em>Depart</em><b>12 Jun, 2025 <i>▤</i></b></span>
      <span class="fld"><em>Return</em><b>20 Jun, 2025 <i>▤</i></b></span>
      <span class="fld"><em>Travelers</em><b>2 Adults ▾</b></span>
      <span class="go">Search</span>
    </div>
  </div>

  <div class="feats">
    <span class="feat"><i>✈</i><span><b>Best Price Guarantee</b><em>Get the best deals or watch it.</em></span></span>
    <span class="feat"><i>✓</i><span><b>Secure Booking</b><em>Your data is safe with us.</em></span></span>
    <span class="feat"><i>☎</i><span><b>24/7 Customer Support</b><em>We're here to help, anytime.</em></span></span>
    <span class="feat"><i>▣</i><span><b>Custom Travel Packages</b><em>Tailored experiences just for you.</em></span></span>
  </div>

  <div class="packs">
    <div class="p-head"><b>POPULAR PACKAGES</b><em>View All Packages →</em></div>
    <div class="p-row">
      <span class="pc"><img src="/assets/paper-skies-travel/santorini.jpg" alt="" /><i>Greek Islands Escape</i></span>
      <span class="pc"><img src="/assets/paper-skies-travel/maldives.jpg" alt="" /><i>Maldives Paradise</i></span>
      <span class="pc"><img src="/assets/paper-skies-travel/rockies.jpg" alt="" /><i>Canadian Rockies</i></span>
      <span class="pc"><img src="/assets/paper-skies-travel/japan.jpg" alt="" /><i>Japan Discovery</i></span>
    </div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 260px;
    background: linear-gradient(180deg, #3d8fe0 0%, #6fb6f0 42%, #b8ddf8 74%, #eef6fd 100%);
    overflow: hidden;
    border-radius: inherit;
    display: flex;
    flex-direction: column;
    font-family: 'Nunito Sans', system-ui, sans-serif;
  }

  /* nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4cqw;
    padding: 1.2cqw 2.4cqw 0;
    position: relative;
    z-index: 5;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6cqw; }
  .mini-plane { width: 2.6cqw; height: 1.9cqw; }
  .bt {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #fff;
    font-size: 1.35cqw;
    letter-spacing: 0.12em;
    line-height: 1;
  }
  .bt em {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: 0.52cqw;
    letter-spacing: 0.3em;
    opacity: 0.9;
    margin-top: 0.25cqw;
  }
  .links { display: flex; gap: 1.5cqw; }
  .links b { color: rgba(255, 255, 255, 0.92); font-size: 0.85cqw; font-weight: 600; }
  .links .on { font-weight: 800; text-decoration: underline; text-underline-offset: 0.4cqw; }
  .signin {
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: #fff;
    font-size: 0.8cqw;
    font-weight: 700;
    padding: 0.5cqw 1.1cqw;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.5cqw;
  }
  .signin i { font-style: normal; font-size: 0.75cqw; }

  /* hero */
  .hero { position: relative; flex: 1; min-height: 0; }
  .copy { position: relative; z-index: 3; padding: 2.6cqw 0 0 2.4cqw; max-width: 34cqw; }
  h1 {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #fff;
    font-size: 3.6cqw;
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-shadow: 0 0.3cqw 1.6cqw rgba(20, 80, 150, 0.35);
  }
  h1 span { display: block; font-size: 2cqw; letter-spacing: 0.06em; }
  .script {
    margin: 0.9cqw 0 0.7cqw;
    font-family: 'Dancing Script', cursive;
    font-size: 1.7cqw;
    color: #eaf5ff;
  }
  .sub { margin: 0 0 1.2cqw; color: rgba(255, 255, 255, 0.92); font-size: 0.85cqw; line-height: 1.55; max-width: 22cqw; }
  .cta {
    display: inline-block;
    background: #fff;
    color: #2e7cd6;
    font-size: 0.85cqw;
    font-weight: 800;
    padding: 0.7cqw 1.4cqw;
    border-radius: 0.7cqw;
    box-shadow: 0 0.6cqw 1.6cqw rgba(20, 80, 150, 0.25);
  }

  .art { position: absolute; inset: 0; z-index: 1; }
  .plane { position: absolute; top: 1cqw; right: 3cqw; width: 12cqw; filter: drop-shadow(0 1cqw 2cqw rgba(20, 80, 150, 0.3)); }
  .trail { position: absolute; top: 0; right: 12cqw; width: 14cqw; }
  .cloud { position: absolute; background: #fff; border-radius: 999px; opacity: 0.85; }
  .c1 { width: 9cqw; height: 2.2cqw; left: 30cqw; bottom: 6cqw; }
  .c2 { width: 6cqw; height: 1.6cqw; left: 24cqw; bottom: 8.5cqw; opacity: 0.7; }
  .peaks { position: absolute; bottom: 0; left: 0; width: 100%; height: 7cqw; }
  .marks { position: absolute; bottom: 0.4cqw; right: 4cqw; width: 12cqw; height: 7cqw; }

  /* search widget */
  .search {
    position: relative;
    z-index: 4;
    margin: 0.6cqw 2.4cqw 0;
    background: #fff;
    border-radius: 1.2cqw;
    box-shadow: 0 1.2cqw 3cqw rgba(20, 80, 150, 0.22);
    padding: 0.9cqw 1.1cqw 1cqw;
  }
  .tabs { display: flex; gap: 0.4cqw; margin-bottom: 0.8cqw; }
  .tab {
    font-size: 0.82cqw;
    font-weight: 700;
    color: #5e7893;
    padding: 0.5cqw 1.2cqw;
    border-radius: 0.6cqw;
  }
  .tab.on { background: #eaf3fc; color: #2e7cd6; }
  .fields { display: flex; align-items: flex-end; gap: 0.7cqw; }
  .fld {
    flex: 1;
    border: 1px solid #e3edf7;
    border-radius: 0.6cqw;
    padding: 0.45cqw 0.8cqw;
    background: #fbfdff;
  }
  .fld em { display: block; font-style: normal; font-size: 0.62cqw; color: #8aa2b8; font-weight: 700; }
  .fld b { font-size: 0.82cqw; color: #16324f; font-weight: 700; }
  .fld b i { font-style: normal; color: #2e7cd6; font-size: 0.7cqw; }
  .swap {
    width: 1.9cqw;
    height: 1.9cqw;
    border-radius: 50%;
    background: #eaf3fc;
    color: #2e7cd6;
    display: grid;
    place-items: center;
    font-size: 0.85cqw;
    margin-bottom: 0.2cqw;
  }
  .go {
    background: #2e7cd6;
    color: #fff;
    font-size: 0.85cqw;
    font-weight: 800;
    padding: 0.75cqw 1.5cqw;
    border-radius: 0.6cqw;
  }

  /* features */
  .feats { display: flex; gap: 1cqw; padding: 1.2cqw 2.4cqw 0; position: relative; z-index: 3; }
  .feat {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    background: rgba(255, 255, 255, 0.75);
    border-radius: 0.9cqw;
    padding: 0.7cqw 0.8cqw;
  }
  .feat i {
    font-style: normal;
    width: 2.3cqw;
    height: 2.3cqw;
    border-radius: 0.7cqw;
    background: #eaf3fc;
    color: #2e7cd6;
    display: grid;
    place-items: center;
    font-size: 1cqw;
    flex: none;
  }
  .feat b { display: block; font-size: 0.78cqw; color: #16324f; line-height: 1.2; }
  .feat em { display: block; font-style: normal; font-size: 0.62cqw; color: #7a92a9; margin-top: 0.15cqw; }

  /* packages hint */
  .packs { padding: 1.1cqw 2.4cqw 1.4cqw; position: relative; z-index: 3; }
  .p-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.7cqw; }
  .p-head b { font-family: 'Poppins', sans-serif; font-size: 1cqw; color: #16324f; letter-spacing: 0.06em; }
  .p-head em { font-style: normal; font-size: 0.72cqw; color: #2e7cd6; font-weight: 700; }
  .p-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9cqw; }
  .pc { background: #fff; border-radius: 0.8cqw; overflow: hidden; box-shadow: 0 0.5cqw 1.4cqw rgba(20, 80, 150, 0.12); }
  .pc img { width: 100%; height: 5.2cqw; object-fit: cover; display: block; }
  .pc i {
    display: block;
    font-style: normal;
    font-size: 0.75cqw;
    font-weight: 800;
    color: #16324f;
    padding: 0.5cqw 0.7cqw;
  }
</style>
