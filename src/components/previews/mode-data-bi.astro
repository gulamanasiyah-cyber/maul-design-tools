    </svg>
    <span class="links"><b>Modern BI</b><b>Why Mode</b><b>Customers</b><b>Plans</b></span>
    <span class="try">Try for free</span>
  </header>

  <div class="hero">
    <span class="pill p1">Business Intelligence</span>
    <span class="pill p2">built around <b>data teams</b></span>
    <span class="btn-sq">Try for free</span>
  </div>

  <div class="shot">
    <div class="chrome"><i></i><i></i><i></i></div>
    <div class="body">
      <svg class="chart" viewBox="0 0 200 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 58 C22 55 36 42 56 44 C78 47 90 26 112 28 C134 30 144 38 162 30 C176 24 188 16 200 10 L200 70 L0 70 Z" fill="#C8F169" opacity="0.5"/>
        <path d="M0 58 C22 55 36 42 56 44 C78 47 90 26 112 28 C134 30 144 38 162 30 C176 24 188 16 200 10" fill="none" stroke="#2A6F2B" stroke-width="3" stroke-linecap="round"/>
        <circle cx="162" cy="30" r="4" fill="#C8F169" stroke="#043F2E" stroke-width="2"/>
      </svg>
      <div class="tiles">
        <span><b>+38%</b></span><span><b>12.4k</b></span>
      </div>
    </div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 260px;
    background: #EEF2E3;
    overflow: hidden;
    border-radius: inherit;
    display: flex;
    flex-direction: column;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  /* lime announcement sliver */
  .bar { height: 1.4cqw; background: #C8F169; flex: none; }

  /* ---- nav ---- */
  .nav {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5cqw;
    padding: 1.3cqw 2.8cqw;
  }
  .mark { height: 1.7cqw; width: auto; flex: none; }
  .links { display: inline-flex; gap: 1.4cqw; }
  .links b { font-size: 0.72cqw; font-weight: 600; color: #043f2e; }
  .try {
    font-size: 0.72cqw; font-weight: 600; color: #C8F169;
    background: #043f2e; border-radius: 0.35cqw;
    padding: 0.65cqw 1.1cqw; flex: none;
  }

  /* ---- hero pills ---- */
  .hero {
    position: relative; flex: 1; min-height: 0;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.7cqw;
    padding: 1.2cqw 2.8cqw 0;
  }
  .pill {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500; color: #043f2e;
    background: #C8F169; border-radius: 0.7cqw;
    font-size: 3.2cqw; line-height: 0.9; letter-spacing: -0.02em;
    padding: 1cqw 1.6cqw; display: inline-block;
  }
  .p1 { border-bottom-right-radius: 0; }
  .p2 { border-top-left-radius: 0; border-top-right-radius: 0; }
  .p2 b { font-weight: 500; }
  .btn-sq {
    position: absolute; right: 2.8cqw; bottom: 9cqw;
    font-size: 0.72cqw; font-weight: 600; color: #043f2e;
    border: 1px solid rgba(4, 63, 46, 0.7); border-radius: 0.35cqw;
    padding: 0.65cqw 1.1cqw;
  }

  /* ---- product shot ---- */
  .shot {
    margin: 1.2cqw 2.8cqw 0 auto;
    width: 62%;
    background: #FCFCFC;
    border-radius: 0.7cqw 0.7cqw 0 0;
    box-shadow: 0 -1.5cqw 3cqw rgba(4, 63, 46, 0.12);
    overflow: hidden;
  }
  .chrome { display: flex; gap: 0.4cqw; padding: 0.7cqw 0.9cqw 0.5cqw; }
  .chrome i { width: 0.55cqw; height: 0.55cqw; border-radius: 50%; background: #E7E7E6; }
  .chrome i:first-child { background: #C8F169; }
  .body { padding: 0 0.9cqw 0.9cqw; }
  .chart { width: 100%; height: 4.6cqw; }
  .tiles { display: flex; gap: 0.6cqw; margin-top: 0.5cqw; }
  .tiles span {
    flex: 1; background: #F3F3F3; border-radius: 0.4cqw;
    padding: 0.5cqw 0.7cqw;
  }
  .tiles b { font-size: 1cqw; font-weight: 700; color: #2A6F2B; }
</style>