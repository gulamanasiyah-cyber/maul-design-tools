---
// Pomaii Escape — warm travel hero with organic white cutouts (left wave,
// right blob, bottom wave), copy on the white area, floating pill search,
// trust strip and mini sections. Pure CSS/SVG, cqw, 16/10.
---

<div class="scene" aria-hidden="true">
  <header class="nav">
    <span class="brand"><i class="mark"></i><b>Pomaii</b></span>
    <span class="links"><b class="on">Home</b><b>Destinations</b><b>Tours</b><b>Travel Guide</b><b>Blog</b><b>About Us</b></span>
    <span class="nav-ic">⌕ ♡ ▭</span>
  </header>

  <div class="stage">
    <svg class="img" viewBox="0 0 640 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <rect width="640" height="300" fill="#C9DFDC"/>
      <path d="M0 168 L64 84 L120 130 L190 44 L262 100 L330 52 L404 106 L468 70 L540 118 L640 88 L640 300 L0 300Z" fill="#8FA9A0"/>
      <path d="M0 200 L70 130 L128 166 L200 84 L272 138 L338 92 L412 142 L478 108 L552 152 L640 128 L640 300 L0 300Z" fill="#5B7A73"/>
      <ellipse cx="330" cy="242" rx="220" ry="38" fill="#0E7A84" opacity="0.94"/>
      <ellipse cx="330" cy="250" rx="160" ry="18" fill="#14A0AE" opacity="0.5"/>
      <ellipse cx="300" cy="112" rx="52" ry="9" fill="#fff" opacity="0.34"/>
      <ellipse cx="420" cy="96" rx="36" ry="7" fill="#fff" opacity="0.26"/>
      <path d="M282 240 L290 198 L298 240Z" fill="#16332B"/>
      <path d="M304 240 L318 184 L332 240Z" fill="#1B4D3E"/>
      <path d="M338 240 L348 202 L358 240Z" fill="#16332B"/>
      <path d="M470 236 L476 214 L482 236Z" fill="#16332B"/>
    </svg>
    <svg class="wave wl" viewBox="0 0 460 560" preserveAspectRatio="none"><path d="M0 0 H242 C286 62 290 130 254 184 C226 226 228 272 198 314 C170 352 110 374 60 368 C36 365 14 356 0 345 Z" fill="#FFFBF3"/></svg>
    <svg class="wave wr" viewBox="0 0 200 400" preserveAspectRatio="none"><path d="M200 0 C128 32 88 92 95 162 C100 224 142 262 200 292 Z" fill="#FFFBF3"/></svg>
    <svg class="wave wb" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0 74 C150 32 330 20 490 46 C668 74 866 80 1024 50 C1104 35 1164 26 1200 32 L1200 120 L0 120 Z" fill="#FFFBF3"/></svg>
    <span class="dots-g"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>

    <div class="copy">
      <span class="eyebrow">EXPLORE THE WORLD</span>
      <h1><span class="ink">Discover Nature.</span><span class="green">Find Your <em>Escape.</em></span></h1>
      <p>Breathtaking places, unforgettable experiences.</p>
      <span class="cta">Explore Now <i>→</i></span>
    </div>

    <div class="search">
      <span><i>◎</i><b>Where to?<em>Any destination</em></b></span>
      <span class="sp"></span>
      <span><i>▭</i><b>Check in<em>Add date</em></b></span>
      <span class="sp"></span>
      <span><i>▭</i><b>Check out<em>Add date</em></b></span>
      <span class="sp"></span>
      <span><i>◯</i><b>Travelers<em>2 Travelers</em></b></span>
      <span class="sbtn">Search <em>⌕</em></span>
    </div>
  </div>

  <div class="trust">
    <span><i>◎</i><span><b>Handpicked Destinations</b><em>Curated places you'll love.</em></span></span>
    <span><i>◇</i><span><b>Best Price Guarantee</b><em>Get the best deals always.</em></span></span>
    <span><i>♡</i><span><b>Safe & Trusted Travel</b><em>Your safety is our priority.</em></span></span>
    <span><i>☎</i><span><b>24/7 Customer Support</b><em>We're here for you anytime.</em></span></span>
  </div>

  <div class="pop">
    <div class="pop-head"><b>Popular Destinations <em class="spark">✦</em></b><em class="va">View All Destinations <i>→</i></em></div>
    <div class="cards">
      <span class="cd c1"><i>★ 4.8</i><b>Banff, Canada</b><em>$699</em></span>
      <span class="cd c2"><i>★ 4.7</i><b>Maldives</b><em>$899</em></span>
      <span class="cd c3"><i>★ 4.9</i><b>Kyoto, Japan</b><em>$799</em></span>
      <span class="cd c4"><i>★ 4.6</i><b>Iceland</b><em>$749</em></span>
    </div>
    <div class="cats"><em><i>▲</i> Adventure</em><em><i>☼</i> Beach</em><em><i>♣</i> Nature</em><em><i>▥</i> Culture</em><em><i>♡</i> Honeymoon</em><em><i>◯</i> Family</em></div>
  </div>

  <div class="guides">
    <span class="g-left"><b>Need Inspiration?</b><strong>Travel Stories & Guides</strong><em>Read Travel Stories →</em></span>
    <span class="g-card"><u></u><b>10 Hidden Gems in Europe</b><em>5 min read</em></span>
    <span class="g-card"><u></u><b>Packing Essentials for Every Trip</b><em>4 min read</em></span>
  </div>

  <div class="banner">
    <span class="b-img"></span>
    <span class="b-copy"><i>SPECIAL OFFER ✦</i><b>Your Next Adventure<br/>Starts Here</b></span>
  </div>
</div>

<style>
  .scene{
    position:relative;
    width:100%;
    aspect-ratio:16/10;
    min-height:280px;
    background:#FFFBF3;
    overflow:hidden;
    border-radius:inherit;
    display:flex;
    flex-direction:column;
    font-family:'Inter',system-ui,sans-serif;
    padding:0 1.5cqw 1.1cqw;
    container-type:inline-size;
  }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0.9cqw 0.4cqw 0.65cqw;
  }
  .brand{display:inline-flex;align-items:center;gap:0.45cqw;font-size:0.88cqw;color:#16332B;}
  .brand .mark{width:1.35cqw;height:1.35cqw;border-radius:50%;background:conic-gradient(from 0deg,#F28C28 0 120deg,#1B4D3E 120deg 240deg,#F2C14E 240deg 360deg);display:block;border:1px solid rgba(0,0,0,0.06);}
  .brand b{font-weight:800;letter-spacing:-0.02em;}
  .links{display:flex;gap:0.85cqw;align-items:center;}
  .links b{font-size:0.5cqw;font-weight:500;color:#5E6E68;}
  .links .on{color:#F28C28;border-bottom:0.13cqw solid #F28C28;padding-bottom:0.18cqw;}
  .nav-ic{font-size:0.56cqw;color:#16332B;letter-spacing:0.34cqw;}
  .stage{
    position:relative;
    height:15.6cqw;
    border-radius:1.15cqw;
    overflow:hidden;
    background:#C9DFDC;
  }
  .img{position:absolute;inset:0;width:100%;height:100%;display:block;}
  .wave{position:absolute;pointer-events:none;}
  .wl{left:0;top:0;height:100%;width:52%;}
  .wr{right:0;top:11%;height:54%;width:19%;}
  .wb{left:0;right:0;bottom:-1px;height:19%;width:100%;}
  .dots-g{position:absolute;top:0.5cqw;right:1.3cqw;display:grid;grid-template-columns:repeat(3,0.16cqw);gap:0.2cqw;opacity:0.28;}
  .dots-g i{width:0.15cqw;height:0.15cqw;border-radius:50%;background:#16332B;display:block;}
  .copy{position:absolute;top:1.7cqw;left:1.9cqw;z-index:2;max-width:17cqw;}
  .eyebrow{font-size:0.42cqw;font-weight:700;letter-spacing:0.2em;color:#3E5F54;}
  .copy h1{margin:0.42cqw 0 0;font-size:1.72cqw;line-height:1.04;letter-spacing:-0.025em;}
  .copy h1 span{display:block;}
  .ink{color:#0F2A24;}
  .green{color:#1B4D3E;}
  .green em{font-style:normal;position:relative;}
  .green em::after{content:"";position:absolute;left:0;right:0;bottom:0.06cqw;height:0.28cqw;background:rgba(242,140,40,0.32);border-radius:999px;transform:rotate(-0.8deg);}
  .copy p{margin:0.55cqw 0 0.75cqw;font-size:0.5cqw;line-height:1.55;color:#5E6E68;}
  .cta{display:inline-flex;align-items:center;gap:0.34cqw;background:#F28C28;color:#fff;font-size:0.48cqw;font-weight:700;padding:0.4cqw 0.44cqw 0.4cqw 0.75cqw;border-radius:999px;}
  .cta i{width:0.9cqw;height:0.9cqw;border-radius:50%;background:#fff;color:#F28C28;display:grid;place-items:center;font-style:normal;font-size:0.48cqw;}
  .search{
    position:absolute;
    bottom:0.95cqw;left:50%;
    transform:translateX(-50%);
    z-index:3;
    background:#fff;
    border-radius:0.62cqw;
    display:flex;
    align-items:center;
    gap:0.1cqw;
    padding:0.34cqw;
    box-shadow:0 0.7cqw 1.7cqw rgba(15,42,36,0.16);
    width:88%;
  }
  .search > span:not(.sp):not(.sbtn){flex:1;display:flex;align-items:center;gap:0.38cqw;padding:0.26cqw 0.5cqw;}
  .search i{width:1.15cqw;height:1.15cqw;border-radius:50%;border:1px solid rgba(22,51,43,0.10);color:#1B4D3E;display:grid;place-items:center;font-style:normal;font-size:0.5cqw;flex:none;background:#fff;}
  .search b{font-size:0.44cqw;line-height:1;display:flex;flex-direction:column;color:#0F2A24;}
  .search b em{font-style:normal;font-weight:500;color:#8A9A95;font-size:0.38cqw;margin-top:0.12cqw;}
  .sp{width:1px;height:1.1cqw;background:rgba(22,51,43,0.10);flex:none;}
  .sbtn{background:#16332B;color:#fff;font-size:0.46cqw;font-weight:700;padding:0.4cqw 0.44cqw 0.4cqw 0.8cqw;border-radius:999px;display:inline-flex;align-items:center;gap:0.34cqw;}
  .sbtn em{width:0.85cqw;height:0.85cqw;border-radius:50%;background:#fff;color:#16332B;display:grid;place-items:center;font-style:normal;font-size:0.44cqw;}
  .trust{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:0.45cqw;
    margin-top:0.65cqw;
    background:#fff;
    border:1px solid rgba(22,51,43,0.05);
    border-radius:0.6cqw;
    padding:0.55cqw 0.62cqw;
    box-shadow:0 0.35cqw 1cqw rgba(15,42,36,0.05);
  }
  .trust span{display:flex;align-items:center;gap:0.42cqw;}
  .trust i{width:1.4cqw;height:1.4cqw;border-radius:50%;border:1px solid rgba(22,51,43,0.12);display:grid;place-items:center;font-style:normal;font-size:0.56cqw;color:#1B4D3E;flex:none;background:#fff;}
  .trust b{display:block;font-size:0.44cqw;color:#0F2A24;line-height:1.2;}
  .trust em{display:block;font-style:normal;font-size:0.38cqw;color:#8A9A95;margin-top:0.08cqw;}
  .pop{margin-top:0.85cqw;}
  .pop-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5cqw;}
  .pop-head b{font-size:0.74cqw;color:#0F2A24;}
  .spark{color:#F2C14E;font-style:normal;font-size:0.42cqw;}
  .va{font-style:normal;font-size:0.44cqw;font-weight:600;color:#3E4C46;display:inline-flex;align-items:center;gap:0.28cqw;}
  .va i{width:0.85cqw;height:0.85cqw;border-radius:50%;border:1px solid rgba(22,51,43,0.16);display:grid;place-items:center;font-size:0.42cqw;font-style:normal;background:#fff;}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:0.55cqw;}
  .cd{height:6.4cqw;border-radius:0.6cqw;overflow:hidden;position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding:0.5cqw;color:#fff;}
  .cd::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0.05) 0%,transparent 30%,transparent 46%,rgba(0,0,0,0.66) 100%);}
  .cd i{position:absolute;top:0.42cqw;left:0.42cqw;background:#16332B;color:#fff;font-style:normal;font-size:0.4cqw;font-weight:700;padding:0.18cqw 0.3cqw;border-radius:999px;}
  .cd b{position:relative;font-size:0.48cqw;line-height:1;}
  .cd em{position:relative;font-style:normal;font-size:0.5cqw;font-weight:800;color:#F9A03F;align-self:flex-end;margin-top:-0.9cqw;}
  .c1{background:linear-gradient(160deg,#7FA8BC 0%,#3E6470 55%,#22333B 100%);}
  .c2{background:linear-gradient(160deg,#63D3C9 0%,#1E8C84 60%,#0E5A54 100%);}
  .c3{background:linear-gradient(160deg,#F0C6CB 0%,#C47A88 55%,#7A4048 100%);}
  .c4{background:linear-gradient(160deg,#2E5D52 0%,#12332C 55%,#0A1F1B 100%);}
  .cats{display:flex;gap:0.45cqw;justify-content:center;margin-top:0.62cqw;}
  .cats em{font-style:normal;font-size:0.44cqw;color:#3E4C46;background:#FBFDF9;padding:0.2cqw 0.5cqw 0.2cqw 0.24cqw;border-radius:999px;border:1px solid rgba(22,51,43,0.07);display:inline-flex;align-items:center;gap:0.28cqw;}
  .cats i{width:0.95cqw;height:0.95cqw;border-radius:50%;background:#E4F0E5;color:#1B4D3E;display:grid;place-items:center;font-size:0.44cqw;font-style:normal;}
  .guides{display:grid;grid-template-columns:1.02fr 0.98fr 0.98fr;gap:0.55cqw;margin-top:0.85cqw;background:#F1EEE5;border-radius:0.65cqw;padding:0.68cqw 0.62cqw;align-items:center;}
  .g-left b{display:block;font-size:0.4cqw;color:#8A9A95;font-weight:600;}
  .g-left strong{display:block;font-size:0.68cqw;color:#0F2A24;margin:0.12cqw 0 0.2cqw;}
  .g-left em{display:inline-block;font-style:normal;font-size:0.4cqw;font-weight:700;background:#16332B;color:#fff;padding:0.26cqw 0.5cqw;border-radius:999px;}
  .g-card{height:5.6cqw;background:#fff;border-radius:0.5cqw;overflow:hidden;display:flex;flex-direction:column;border:1px solid rgba(22,51,43,0.05);}
  .g-card u{flex:1;display:block;background:linear-gradient(135deg,#CDE3D2,#8FB8A0);text-decoration:none;}
  .g-card b{padding:0.28cqw 0.45cqw 0;font-size:0.4cqw;color:#0F2A24;line-height:1.2;}
  .g-card em{padding:0 0.45cqw 0.3cqw;font-style:normal;font-size:0.34cqw;color:#8A9A95;}
  .banner{display:grid;grid-template-columns:1.18fr 1fr;gap:0;margin-top:0.85cqw;border-radius:0.65cqw;overflow:hidden;background:#1D4438;min-height:4.6cqw;}
  .b-img{background:linear-gradient(160deg,#7FB4A8 0%,#3E7A6C 60%,#245446 100%);margin-right:-1cqw;border-radius:0 50% 50% 0 / 0 100% 100% 0;}
  .b-copy{padding:0.55cqw 0.7cqw;display:flex;flex-direction:column;justify-content:center;gap:0.16cqw;}
  .b-copy i{font-style:normal;font-size:0.34cqw;letter-spacing:0.14em;color:#F2C14E;}
  .b-copy b{font-size:0.62cqw;line-height:1.1;color:#fff;}
</style>
