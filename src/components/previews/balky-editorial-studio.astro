---
// Balky Editorial Studio — Live card preview scene: dark matrix glitch hero with giant BALKY®,
// solid electric orange statement block, and selected work table hint.
// Pure CSS/SVG, cqw units.
---

<div class="scene" aria-hidden="true">
  <header class="header">
    <span class="brand">BALKY <small>Essentials</small></span>
    <span class="touch-btn">GET IN TOUCH</span>
  </header>

  <div class="hero">
    <div class="glitch-glow"></div>
    <h1 class="title">BALKY<span class="reg">®</span></h1>
    <p class="sub">Design Essentials Made Simple</p>
  </div>

  <div class="orange-strip">
    <span class="kicker">00. WHY WE EXIST</span>
    <p class="statement">We recognized a gap in the creative industry—small businesses often struggle to find high-quality, yet affordable design.</p>
  </div>

  <div class="work-mini">
    <div class="w-row">
      <span class="w-name">Closet Creations</span>
      <span class="w-btn">VISIT ↗</span>
    </div>
    <div class="w-row">
      <span class="w-name">Nightfall VC</span>
      <span class="w-btn">VISIT ↗</span>
    </div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 260px;
    background: #0A0A0A;
    overflow: hidden;
    border-radius: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    container-type: inline-size;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2cqw 2cqw;
    border-bottom: 1px solid #1C1C1C;
    background: #0A0A0A;
  }

  .brand {
    font-size: 0.95cqw;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #FF5500;
  }

  .brand small {
    font-size: 0.65cqw;
    color: #888888;
    font-weight: 600;
  }

  .touch-btn {
    background: #FFFFFF;
    color: #0A0A0A;
    font-size: 0.55cqw;
    font-weight: 800;
    padding: 0.35cqw 0.8cqw;
    border-radius: 999px;
  }

  .hero {
    position: relative;
    text-align: center;
    padding: 1cqw 2cqw;
  }

  .glitch-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255, 85, 0, 0.25) 0%, rgba(0, 200, 100, 0.1) 40%, transparent 70%);
  }

  .title {
    position: relative;
    font-size: 4.8cqw;
    font-weight: 950;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: #FFFFFF;
    margin: 0;
    text-shadow: -1px 0 #FF5500, 1px 0 #00E676;
  }

  .reg {
    font-size: 0.35em;
    vertical-align: super;
  }

  .sub {
    position: relative;
    font-size: 0.72cqw;
    color: #CCCCCC;
    margin: 0.4cqw 0 0;
  }

  .orange-strip {
    background: #FF5500;
    color: #111111;
    padding: 0.8cqw 2cqw;
  }

  .kicker {
    display: block;
    font-size: 0.45cqw;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .statement {
    font-size: 0.65cqw;
    font-weight: 800;
    line-height: 1.3;
    margin: 0.2cqw 0 0;
  }

  .work-mini {
    background: #EFECE6;
    padding: 0.6cqw 2cqw;
    display: flex;
    flex-direction: column;
    gap: 0.4cqw;
  }

  .w-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .w-name {
    font-size: 0.65cqw;
    font-weight: 900;
    color: #111111;
  }

  .w-btn {
    background: #FF5500;
    color: #FFFFFF;
    font-size: 0.48cqw;
    font-weight: 800;
    padding: 0.2cqw 0.5cqw;
    border-radius: 999px;
  }
</style>
