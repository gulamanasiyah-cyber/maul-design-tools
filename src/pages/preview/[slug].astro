---
import { getCollection, type CollectionEntry } from 'astro:content';
import FullPageShell from '../../components/FullPageShell.astro';

export async function getStaticPaths() {
  const entries = await getCollection('references');
  return entries
    .filter((entry) => entry.data.preview)
    .map((entry) => ({
      params: { slug: entry.data.preview! },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<'references'> };
const { entry } = Astro.props;
const ref = entry.data;

const fullpages = import.meta.glob('../../components/fullpages/*.astro', {
  eager: true,
});
const fullMod =
  fullpages[`../../components/fullpages/${entry.id}.astro`] ||
  (ref.preview ? fullpages[`../../components/fullpages/${ref.preview}.astro`] : undefined);
const FullPage = fullMod?.default;

const webFonts = [ref.fonts.heading, ref.fonts.body].filter(Boolean);

const fontQuery = webFonts.length
  ? `https://fonts.googleapis.com/css2?${webFonts
      .map((f) => `family=${f.trim().replace(/\s+/g, '+')}`)
      .join('&')}&display=swap`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{ref.name} — Full-page Preview</title>
    {fontQuery && <link rel="stylesheet" href={fontQuery} />}
    <style>
      /* bare resets only — the component owns the look. */
      html,
      body {
        margin: 0;
        padding: 0;
        background: #FFFFFF;
      }
      body {
        min-height: 100vh;
      }
    </style>
  </head>
  <body class={Astro.url.searchParams.get('v') === 'thumb' ? 'thumb' : ''}>
    <div class="frame">
      {FullPage ? <FullPage /> : <FullPageShell slug={ref.preview} />}
    </div>
  </body>
</html>
